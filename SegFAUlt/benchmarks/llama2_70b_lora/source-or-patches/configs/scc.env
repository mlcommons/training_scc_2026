#!/bin/bash
# Paramètres SCC26 communs aux deux systèmes (ngpu8, ngpu16). Sourcé par les configs (dans le job), submit.sh et tools/.
# Chaque valeur se surcharge depuis l'environnement : TEAM_NAME=MonEquipe ./submit.sh ngpu8

# Nom d'équipe : dossier racine du paquet (<team_name>/) et valeur de submission_org dans les logs MLPerf.
# À FIXER AVANT LES RUNS OFFICIELS : il est écrit dans les logs au moment de l'entraînement.
: "${TEAM_NAME:=SegFAUlt}"

# Recette validée (code NVIDIA NeMo, lanceur Apptainer, conteneur, données, checkpoint), réutilisée sans modification :
#   ${ZEPH_DIR}/helma_runs/run_helma.sub et tools/   lanceur Slurm + Apptainer
#   ${ZEPH_DIR}/nemo/                                code NVIDIA (inchangé) + nvidia-zeph.sif (117 Go)
#   ${ZEPH_DIR}/nemo/scripts/models                  checkpoint Megatron Llama2-70B (129 Go)
#   ${ZEPH_DIR}/data/gov_report                      dataset Scrolls GovReport (train.npy, validation.npy)
# Cluster SegFAUlt (16/11) : recette reconstruite depuis le paquet FAU validé (ngpu16/FAU/.../source-or-patches) ;
# le checkpoint est désigné par MODEL dans segfault_ngpu16/config_scc_segfault_ngpu16.sh.
: "${ZEPH_DIR:=/fs/largenfs/hpc-workspace/data/stephan-llama2_70B/nvidia-zeph}"

# Benchmark tel que nommé par le SCC (dossiers benchmarks/ et results/) et par MLCommons (mlperf_logging). Les slides
# du comité (Benchmarking-Overview-SCC26.pdf, 10/09/2026, p. 23) imposent llama2_70b_lora, le nom MLCommons ;
# benchmarks.md écrivait Llama2_70B_LoRA, que les vérificateurs officiels ignorent.
SCC_BENCHMARK=llama2_70b_lora
MLPERF_BENCHMARK=llama2_70b_lora
MLPERF_RULESET=6.0.0

export TEAM_NAME ZEPH_DIR SCC_BENCHMARK MLPERF_BENCHMARK MLPERF_RULESET
