+class EqualSampleEvalTrainer(Trainer):
+    """Eval loss = average over samples of each sample's own token-averaged loss.
+    Matches the reference metric (eval batch size 1) at any eval batch size."""
+    def compute_loss(self, model, inputs, return_outputs=False):
+        if model.training or "labels" not in inputs:
+            return super().compute_loss(model, inputs, return_outputs)
+        import torch.nn.functional as F
+        inputs = dict(inputs)
+        labels = inputs.pop("labels")
+        outputs = model(**inputs)
+        logits = outputs.logits[:, :-1, :].float()
+        tgt = labels[:, 1:]
+        mask = tgt != -100
+        tok = F.cross_entropy(logits.reshape(-1, logits.size(-1)), tgt.reshape(-1).clamp(min=0),
+                              reduction="none").view(tgt.shape)
+        per_sample = (tok * mask).sum(dim=1) / mask.sum(dim=1).clamp(min=1)
+        loss = per_sample.mean()
+        return (loss, outputs) if return_outputs else loss
+
