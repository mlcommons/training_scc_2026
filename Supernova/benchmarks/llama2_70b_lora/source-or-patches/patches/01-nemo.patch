index 0000000..5c22c9b
--- /dev/null
+++ b/fused_residual.py
@@ -0,0 +1,543 @@
+import inspect
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+FWD_WARPS = 8
+BWD_BLOCK = 4096
+BWD_WARPS = 8
+
+_installed = False
+_te_installed = False
+_pending = None
+_stash = {}
+_next_fork = None
+NORM_BWD_FOLD = True
+_fork_ptr = None
+_pending_bwd = None
+
+
+@triton.jit
+def _add_norm_quant_kernel(r_ptr, o_ptr, w_ptr, s_ptr, q_ptr, rstd_ptr, scale_ptr, amax_ptr, sinv_ptr, EPS,
+                           H: tl.constexpr, BLOCK: tl.constexpr, ROUND_BF16: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+    base = row * H
+    r = tl.load(r_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    o = tl.load(o_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    s = (r + o).to(tl.bfloat16)
+    tl.store(s_ptr + base + offs, s, mask=mask)
+    sf = s.to(tl.float32)
+    ms = tl.sum(sf * sf, axis=0) / H
+    rstd = libdevice.div_rn(1.0, libdevice.sqrt_rn(ms + EPS))
+    tl.store(rstd_ptr + row, rstd)
+    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    y = (sf * rstd) * w
+    if ROUND_BF16:
+        y = y.to(tl.bfloat16).to(tl.float32)
+    tl.atomic_max(amax_ptr, tl.max(tl.abs(y), axis=0))
+    scale = tl.load(scale_ptr)
+    tl.store(q_ptr + base + offs, (y * scale).to(q_ptr.dtype.element_ty), mask=mask)
+    if row == 0:
+        tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+
+
+@triton.jit
+def _add_quant_kernel(a_ptr, b_ptr, g_ptr, q_ptr, scale_ptr, amax_ptr, sinv_ptr, N, BLOCK: tl.constexpr):
+    pid = tl.program_id(0).to(tl.int64)
+    offs = pid * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < N
+    a = tl.load(a_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    g = (a + b).to(tl.bfloat16)
+    tl.store(g_ptr + offs, g, mask=mask)
+    gf = g.to(tl.float32)
+    tl.atomic_max(amax_ptr, tl.max(tl.where(mask, tl.abs(gf), 0.0), axis=0))
+    scale = tl.load(scale_ptr)
+    tl.store(q_ptr + offs, (gf * scale).to(q_ptr.dtype.element_ty), mask=mask)
+    if pid == 0:
+        tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+
+
+@triton.jit
+def _add_kernel(a_ptr, b_ptr, c_ptr, N, BLOCK: tl.constexpr):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < N
+    a = tl.load(a_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    tl.store(c_ptr + offs, (a + b).to(tl.bfloat16), mask=mask)
+
+
+def add_into(a, b, c):
+    n = a.numel()
+    _add_kernel[(triton.cdiv(n, BWD_BLOCK),)](a, b, c, n, BLOCK=BWD_BLOCK, num_warps=BWD_WARPS)
+
+
+_NON_TN = []
+
+
+def _non_tn_fp8_gemm():
+    if not _NON_TN:
+        from transformer_engine.pytorch.utils import is_non_tn_fp8_gemm_supported
+
+        _NON_TN.append(bool(is_non_tn_fp8_gemm_supported()))
+    return _NON_TN[0]
+
+
+_TORCH_FP8 = {}
+
+
+def _torch_fp8(te_dtype):
+    if not _TORCH_FP8:
+        import transformer_engine_torch as tex
+
+        _TORCH_FP8[int(tex.DType.kFloat8E4M3)] = torch.float8_e4m3fn
+        _TORCH_FP8[int(tex.DType.kFloat8E5M2)] = torch.float8_e5m2
+    return _TORCH_FP8[int(te_dtype)]
+
+
+def add_rmsnorm_quant(r, o, w, eps, quantizer, s=None, round_bf16=False):
+    H = w.numel()
+    T = r.numel() // H
+    if s is None:
+        s = torch.empty_like(r)
+    data = torch.empty(T, H, dtype=torch.uint8, device=r.device)
+    rstd = torch.empty(T, dtype=torch.float32, device=r.device)
+    sinv = torch.empty(1, dtype=torch.float32, device=r.device)
+    _add_norm_quant_kernel[(T,)](
+        r, o, w, s, data.view(_torch_fp8(quantizer.dtype)), rstd, quantizer.scale, quantizer.amax, sinv,
+        float(eps),
+        H=H, BLOCK=triton.next_power_of_2(H), ROUND_BF16=round_bf16,
+        num_warps=FWD_WARPS, enable_fp_fusion=False,
+    )
+    return s, data, rstd, sinv
+
+
+def add_quant(a, b, quantizer):
+    g = torch.empty_like(a)
+    data = torch.empty(a.shape, dtype=torch.uint8, device=a.device)
+    sinv = torch.empty(1, dtype=torch.float32, device=a.device)
+    n = a.numel()
+    _add_quant_kernel[(triton.cdiv(n, BWD_BLOCK),)](
+        a, b, g, data.view(_torch_fp8(quantizer.dtype)), quantizer.scale, quantizer.amax, sinv, n,
+        BLOCK=BWD_BLOCK, num_warps=BWD_WARPS, enable_fp_fusion=False,
+    )
+    return g, data, sinv
+
+
+@triton.jit
+def _norm_bwd_add_quant_kernel(dy_ptr, x_ptr, rstd_ptr, w_ptr, r_ptr, g_ptr, q_ptr, scale_ptr, amax_ptr, sinv_ptr,
+                               H: tl.constexpr, BLOCK: tl.constexpr, QUANT: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+    base = row * H
+    dy = tl.load(dy_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    x = tl.load(x_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    rs = tl.load(rstd_ptr + row)
+    y = x * rs
+    dz = dy * w
+    m = tl.sum(dz * y, axis=0) / H
+    dx = (rs * (dz - y * m)).to(tl.bfloat16).to(tl.float32)
+    r = tl.load(r_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    g = (dx + r).to(tl.bfloat16)
+    tl.store(g_ptr + base + offs, g, mask=mask)
+    if QUANT:
+        gf = g.to(tl.float32)
+        tl.atomic_max(amax_ptr, tl.max(tl.where(mask, tl.abs(gf), 0.0), axis=0))
+        scale = tl.load(scale_ptr)
+        tl.store(q_ptr + base + offs, (gf * scale).to(q_ptr.dtype.element_ty), mask=mask)
+        if row == 0:
+            tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+
+
+NBWD_WARPS = 8
+
+
+def norm_bwd_add_quant(dy, x, rstd, w, r, quantizer=None, g=None):
+    H = w.numel()
+    T = x.numel() // H
+    if g is None:
+        g = torch.empty_like(r)
+    if quantizer is not None:
+        data = torch.empty(T, H, dtype=torch.uint8, device=x.device)
+        sinv = torch.empty(1, dtype=torch.float32, device=x.device)
+        q8, scale, amax = data.view(_torch_fp8(quantizer.dtype)), quantizer.scale, quantizer.amax
+    else:
+        data = sinv = None
+        q8 = scale = amax = rstd
+    _norm_bwd_add_quant_kernel[(T,)](
+        dy, x, rstd, w, r, g, q8, scale, amax, sinv if sinv is not None else rstd,
+        H=H, BLOCK=triton.next_power_of_2(H), QUANT=quantizer is not None,
+        num_warps=NBWD_WARPS, enable_fp_fusion=False,
+    )
+    return g, data, sinv
+
+
+def _float8(data, sinv, quantizer, fake_dtype):
+    if quantizer.internal:
+        from transformer_engine.pytorch.tensor.storage.float8_tensor_storage import Float8TensorStorage
+
+        return Float8TensorStorage(data=data, fp8_scale_inv=sinv, fp8_dtype=quantizer.dtype, fake_dtype=fake_dtype,
+                                   data_transpose=None, quantizer=quantizer)
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Tensor
+
+    return Float8Tensor(shape=data.shape, dtype=fake_dtype, data=data, fp8_scale_inv=sinv,
+                        fp8_dtype=quantizer.dtype, requires_grad=False, data_transpose=None,
+                        quantizer=quantizer, device=data.device)
+
+
+def _delayed_quantizer(q, te_dtype):
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+
+    if type(q) is not Float8Quantizer or int(q.dtype) != int(te_dtype):
+        return False
+    if not q.rowwise_usage:
+        return False
+    s, a = q.scale, q.amax
+    return (isinstance(s, torch.Tensor) and isinstance(a, torch.Tensor) and s.numel() == 1 and a.numel() == 1
+            and s.dtype == torch.float32 and a.dtype == torch.float32 and s.is_cuda and a.is_cuda)
+
+
+def _materialize():
+    global _pending
+    p, _pending = _pending, None
+    if p is not None:
+        s, r, o = p
+        add_into(r, o, s)
+
+
+class _DeferredAdd(torch.autograd.Function):
+
+    @staticmethod
+    def forward(ctx, residual, out):
+        global _pending
+        if _pending is not None:
+            raise RuntimeError("fused_residual: a deferred residual add was not consumed before the next one")
+        s = torch.empty_like(residual)
+        _pending = (s, residual, out)
+        return s
+
+    @staticmethod
+    def backward(ctx, g):
+        return g, g
+
+
+def deferred_add(residual, out):
+    return _DeferredAdd.apply(residual, out)
+
+
+class _ResidualFork(torch.autograd.Function):
+
+    @staticmethod
+    def forward(ctx, x, quantizer):
+        global _fork_ptr
+        ctx.quantizer = quantizer
+        if NORM_BWD_FOLD:
+            _fork_ptr = x.data_ptr()
+        return x.view_as(x), x.view_as(x)
+
+    @staticmethod
+    def backward(ctx, ga, gb):
+        global _pending_bwd
+        import transformer_engine_torch as tex
+
+        q = ctx.quantizer
+        p = _pending_bwd
+        if p is not None:
+            if ga is None or ga.data_ptr() != p[0].data_ptr() or ga.numel() != p[0].numel():
+                raise RuntimeError("fused_residual: a deferred RMSNorm backward did not reach its residual fork")
+            _pending_bwd = None
+            _, dy, x, rstd, w = p
+            r = torch.zeros_like(ga) if gb is None else gb.to(torch.bfloat16).contiguous()
+            if q is not None and not _delayed_quantizer_any_usage(q, tex.DType.kFloat8E5M2):
+                q = None
+            g, data, sinv = norm_bwd_add_quant(dy, x, rstd, w, r, q)
+            if q is not None:
+                stash_payload(g, data, sinv, q)
+            return g.view(ga.shape), None
+        return _stock_fork_backward(q, ga, gb), None
+
+
+def _stock_fork_backward(q, ga, gb):
+    import transformer_engine_torch as tex
+
+    if ga is None or gb is None:
+        return gb if ga is None else ga
+    if (q is None or ga.dtype != torch.bfloat16 or gb.dtype != torch.bfloat16 or ga.shape != gb.shape
+            or not ga.is_contiguous() or not gb.is_contiguous()
+            or not _delayed_quantizer_any_usage(q, tex.DType.kFloat8E5M2)):
+        return ga + gb
+    g, data, sinv = add_quant(ga, gb, q)
+    stash_payload(g, data, sinv, q)
+    return g
+
+
+def _delayed_quantizer_any_usage(q, te_dtype):
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+
+    if type(q) is not Float8Quantizer or int(q.dtype) != int(te_dtype):
+        return False
+    s, a = q.scale, q.amax
+    return (isinstance(s, torch.Tensor) and isinstance(a, torch.Tensor) and s.numel() == 1 and a.numel() == 1
+            and s.dtype == torch.float32 and a.dtype == torch.float32 and s.is_cuda and a.is_cuda)
+
+
+def residual_fork(x, quantizer):
+    return _ResidualFork.apply(x, quantizer)
+
+
+def _make_rmsnorm_fwd(stock, module_path=False):
+    def rmsnorm_fwd(x, w, eps, out, quantizer, otype, sm_margin, zero_centered_gamma):
+        global _pending
+        p = _pending
+        if p is not None:
+            s = p[0]
+            if x.data_ptr() != s.data_ptr() or x.numel() != s.numel():
+                if module_path:
+                    return stock(x, w, eps, out, quantizer, otype, sm_margin, zero_centered_gamma)
+                raise RuntimeError("fused_residual: an RMSNorm ran on another tensor while a residual add was deferred")
+            import transformer_engine_torch as tex
+
+            H = w.numel()
