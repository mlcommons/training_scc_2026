+def cyclic_iter_early_reset(iterable):
+    while True:
+        iterator = iter(iterable)
+        while True:
+            try:
+                item = next(iterator)
+            except StopIteration:
+                break
+            if (getattr(iterator, "_tasks_outstanding", None) == 0
+                    and getattr(iterator, "_rcvd_idx", None) == getattr(iterator, "_send_idx", -1)):
+                iterator = iter(iterable)
+            yield item
diff --git a/fp8_checkpoint.py b/fp8_checkpoint.py
new file mode 100644
index 0000000..3796d7f
--- /dev/null
+++ b/fp8_checkpoint.py
@@ -0,0 +1,201 @@
+import logging
+import os
+import re
+
+import torch
+from transformer_engine.pytorch.tensor.float8_tensor import Float8Tensor, Float8Quantizer
+from transformer_engine_torch import DType
+
+logger = logging.getLogger(__name__)
+
+
+def install_cpu_checkpoint_staging():
+    import megatron.core.dist_checkpointing.serialization as serialization
+    from megatron.core.dist_checkpointing.dict_utils import nested_values
+    from megatron.core.fp8_utils import dequantize_fp8_tensor, is_float8tensor
+
+    def stage(sharded_state_dict):
+        with torch.no_grad():
+            for value in nested_values(sharded_state_dict):
+                if hasattr(value, "data") and is_float8tensor(value.data):
+                    value.data = dequantize_fp8_tensor(value.data)
+                    if not _STREAMING:
+                        value.data = value.data.cpu()
+
+    serialization.force_all_tensors_to_non_fp8 = stage
+    _install_streaming_load()
+
+
+def _calibrate(param, source):
+    quantizer = param._get_quantizer()
+    if not isinstance(quantizer, Float8Quantizer):
+        return
+    amax = source.detach().abs().amax().float()
+    fp8_max = 448.0 if quantizer.dtype == DType.kFloat8E4M3 else 57344.0
+    scale = torch.where(amax > 0, fp8_max / amax, torch.ones_like(amax))
+    quantizer.scale.copy_(scale.reshape_as(quantizer.scale))
+    quantizer.amax.copy_(amax.reshape_as(quantizer.amax))
+    param.update_usage(rowwise_usage=True, columnwise_usage=False)
+    quantizer.set_usage(rowwise=True, columnwise=False)
+
+
+def _build_transpose(param):
+    param._transpose = param._data.movedim(-1, 0).contiguous()
+    param._transpose_invalid = False
+    param._get_quantizer().set_usage(rowwise=True, columnwise=True)
+
+
+def _calibrate_loaded_weights(module, state_dict, prefix, local_metadata, strict,
+                              missing_keys, unexpected_keys, error_msgs):
+    del local_metadata, strict, missing_keys, unexpected_keys, error_msgs
+    with torch.no_grad():
+        for name, param in module.named_parameters(recurse=False):
+            if not isinstance(param, Float8Tensor):
+                continue
+            source = state_dict.get(prefix + name)
+            if source is None:
+                continue
+            if source is _LOADED:
+                del state_dict[prefix + name]
+                continue
+            if isinstance(source, Float8Tensor):
+                raise RuntimeError(
+                    "FP8 checkpoint data was quantized before shard assembly; "
+                    "keep Megatron's force_all_tensors_to_non_fp8 load staging enabled")
+            _calibrate(param, source)
+
+
+def _finish_loaded_weights(module, incompatible_keys):
+    if _LOADED_KEYS:
+        incompatible_keys.missing_keys[:] = [
+            k for k in incompatible_keys.missing_keys if k not in _LOADED_KEYS
+        ]
+    for param in module.parameters(recurse=False):
+        if isinstance(param, Float8Tensor) and id(param) not in _LOADED_PARAMS:
+            _build_transpose(param)
+
+
+def prepare_fp8_checkpoint_load(model):
+    count = 0
+    for module in model.modules():
+        params = [p for p in module.parameters(recurse=False)
+                  if isinstance(p, Float8Tensor)]
+        if not params:
+            continue
+        for param in params:
+            param.update_usage(rowwise_usage=True, columnwise_usage=False)
+            param._get_quantizer().set_usage(rowwise=True, columnwise=False)
+        module.register_load_state_dict_pre_hook(_calibrate_loaded_weights)
+        module.register_load_state_dict_post_hook(_finish_loaded_weights)
+        count += len(params)
+    for mname, module in model.named_modules():
+        for pname, param in module.named_parameters(recurse=False):
+            if isinstance(param, Float8Tensor):
+                _FP8_PARAMS[f"{mname}.{pname}" if mname else pname] = param
+    logger.info("FP8 checkpoint load: high-precision staging and calibrated scales for %d weights", count)
+
+
+_FP8_PARAMS = {}
+_LOADED = object()
+_LOADED_KEYS = set()
+_LOADED_PARAMS = set()
+_STREAMING = False
+_LAYER_RE = re.compile(r"(?:^|\.)layers\.(\d+)\.")
+
+
+def _install_streaming_load():
+    import megatron.core.dist_checkpointing as dist_checkpointing
+
+    whole_load = dist_checkpointing.load
+
+    def load(*args, **kwargs):
+        threads = int(os.environ.get("LOAD_THREADS", "1"))
+        if threads == 1:
+            return _load(*args, **kwargs)
+        prev = torch.get_num_threads()
+        torch.set_num_threads(threads)
+        try:
+            return _load(*args, **kwargs)
+        finally:
+            torch.set_num_threads(prev)
+
+    def _load(sharded_state_dict, checkpoint_dir, *args, **kwargs):
+        global _STREAMING
+        model_sd = sharded_state_dict.get("model") if isinstance(sharded_state_dict, dict) else None
+        if (os.environ.get("LOAD_STREAM", "1") != "1" or not _FP8_PARAMS
+                or not isinstance(model_sd, dict)
+                or any(isinstance(v, dict) for v in model_sd.values())):
+            return whole_load(sharded_state_dict, checkpoint_dir, *args, **kwargs)
+        per = int(os.environ.get("LOAD_GROUP_LAYERS", "20"))
+        groups = {}
+        for key in model_sd:
+            m = _LAYER_RE.search(key)
+            groups.setdefault(-1 if m is None else int(m.group(1)) // per, []).append(key)
+        result, tails = {"model": {}}, None
+        kwargs["validate_access_integrity"] = False
+        kwargs["strict"] = "assume_ok_unexpected"
+        _STREAMING = True
+        try:
+            for i, gid in enumerate(sorted(groups)):
+                sub = {"model": {k: model_sd[k] for k in groups[gid]}}
+                if i == 0:
+                    sub.update({k: v for k, v in sharded_state_dict.items() if k != "model"})
+                out = whole_load(sub, checkpoint_dir, *args, **kwargs)
+                if isinstance(out, tuple):
+                    out, rest = out[0], out[1:]
+                    tails = rest if tails is None else tuple(a | b for a, b in zip(tails, rest))
+                applied = 0
+                with torch.no_grad():
+                    for key, value in out["model"].items():
+                        param = _FP8_PARAMS.get(key)
+                        if param is None or not torch.is_tensor(value):
+                            continue
+                        _calibrate(param, value)
+                        param.copy_(value)
+                        _build_transpose(param)
+                        out["model"][key] = _LOADED
+                        _LOADED_KEYS.add(key)
+                        _LOADED_PARAMS.add(id(param))
+                        applied += 1
+                        staged = model_sd[key]
+                        if hasattr(staged, "data") and torch.is_tensor(staged.data):
+                            staged.data = staged.data.new_empty(0)
+                if gid >= 0 and applied == 0:
+                    raise RuntimeError(
+                        "FP8 streaming load: no FP8 weight of layer group "
+                        f"{gid} matched a model parameter (state-dict key mismatch)")
+                result["model"].update(out.pop("model"))
+                result.update(out)
+                del out, sub
+        finally:
+            _STREAMING = False
+        torch.cuda.empty_cache()
+        logger.info("FP8 checkpoint load: streamed %d layer groups", len(groups))
+        return result if tails is None else (result, *tails)
+
+    dist_checkpointing.load = load
+
+
+def install_tensor_properties_compat():
+    from pathlib import Path
+
+    from megatron.core.dist_checkpointing.strategies.torch import (
+        TorchDistLoadShardedStrategy, _get_filesystem_reader)
+    from torch.distributed.checkpoint.metadata import TensorStorageMetadata
+
+    if getattr(TorchDistLoadShardedStrategy.load_tensors_metadata, "_tensor_properties_compat", False):
+        return
+    _orig = TorchDistLoadShardedStrategy.load_tensors_metadata
+
+    def _compat(self, checkpoint_dir: Path, metadata=None):
+        if metadata is None:
+            metadata = _get_filesystem_reader(checkpoint_dir).read_metadata()
+        for tp in metadata.state_dict_metadata.values():
+            if isinstance(tp, TensorStorageMetadata):
+                props = tp.properties.__dict__
+                if props.get("strides", None) is None:
+                    props.pop("strides", None)
+        return _orig(self, checkpoint_dir, metadata)
+
+    _compat._tensor_properties_compat = True
+    TorchDistLoadShardedStrategy.load_tensors_metadata = _compat
