+                    and _delayed_quantizer(quantizer, tex.DType.kFloat8E4M3)
+                    and int(otype) == int(tex.DType.kBFloat16) and x.dtype == torch.bfloat16
+                    and w.dtype == torch.bfloat16 and w.is_contiguous() and x.is_contiguous()
+                    and x.dim() == 2 and x.shape[1] == H and H <= 16384
+                    and p[1].is_contiguous() and p[2].is_contiguous()):
+                _pending = None
+                _, data, rstd, sinv = add_rmsnorm_quant(p[1], p[2], w, eps, quantizer, s=s)
