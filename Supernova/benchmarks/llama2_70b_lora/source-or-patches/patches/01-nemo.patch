+    TransformerLayer.__init__ = __init__
+    TransformerLayer._run_input_layernorm = _run_input_layernorm
+    TransformerLayer._pre_mlp_layernorm_and_residual = _pre_mlp_layernorm_and_residual
+    _installed = True
