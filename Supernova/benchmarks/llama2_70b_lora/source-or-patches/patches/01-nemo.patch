+def _is_last_layer(layer):
+    from megatron.core import parallel_state
+
+    return (parallel_state.get_pipeline_model_parallel_world_size() != 1
+            or layer.layer_number >= layer.config.num_layers)
+
+
+def _branch_grad_quantizer(seq):
+    from transformer_engine.pytorch.ops.basic.basic_linear import BasicLinear
+
+    ops = [m for m in seq.modules() if isinstance(m, BasicLinear)]
+    if not ops:
+        return None
+    try:
+        return ops[-1].get_quantizer("backward", 0)
+    except Exception:
+        return None
+
+
+def _proj_grad_quantizer(layer):
+    lp = getattr(layer.self_attention, "linear_proj", None)
+    br = getattr(lp, "_fused_branches", None)
+    if not br or not getattr(lp, "_adapter_enabled", False):
+        return None
+    return _branch_grad_quantizer(br[0])
+
+
+def _fc2_grad_quantizer(layer):
+    fi = getattr(layer.mlp, "_fused_impl", None)
+    if not fi:
+        return None
+    return _branch_grad_quantizer(fi[0])
+
+
+def _sbh(t):
+    return isinstance(t, torch.Tensor) and t.dtype == torch.bfloat16 and t.dim() == 3 and t.is_contiguous()
+
+
+def _wrap_bda(layer_ref, orig_bda, site):
+    def bda(training, fused):
+        f = orig_bda(training, fused)
+
+        def run(x_with_bias, residual, prob):
+            global _next_fork
+            layer = layer_ref()
+            x, bias = x_with_bias
+            last = _is_last_layer(layer)
+            if (bias is None and prob == 0 and _sbh(x) and _sbh(residual) and x.shape == residual.shape
+                    and ((training and _layer_ok(layer)) or (not training and _layer_eval_ok(layer)))
+                    and not (site == "mlp" and last)):
+                out = deferred_add(residual, x)
+            else:
+                out = f(x_with_bias, residual, prob)
+            if site == "mlp" and not last and _layer_ok(layer):
+                _next_fork = (out, layer.layer_number, _fc2_grad_quantizer(layer))
+            return out
+
+        return run
+
+    return bda
+
