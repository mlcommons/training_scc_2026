+
+    rmsnorm_fwd._fused_residual = True
+    return rmsnorm_fwd
+
+
+def _mark_fork_norm(x, w, result):
+    global _fork_ptr
+    if NORM_BWD_FOLD and _fork_ptr is not None and x.data_ptr() == _fork_ptr:
+        _fork_ptr = None
