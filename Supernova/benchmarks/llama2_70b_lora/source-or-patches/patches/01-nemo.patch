+    return FP8GlobalStateManager.is_fp8_enabled() and FP8GlobalStateManager.get_fp8_recipe().delayed()
+
+
+def _layer_eval_ok(layer):
+    return not layer.training and _layer_cfg_ok(layer)
+
+
+def _layer_ok(layer):
+    return layer.training and torch.is_grad_enabled() and _layer_cfg_ok(layer)
+
+
+def _layer_cfg_ok(layer):
+    cfg = layer.config
+    return (not cfg.fp32_residual_connection
+            and getattr(cfg, "recompute_granularity", None) is None
+            and not getattr(layer, "recompute_input_layernorm", False)
+            and not getattr(layer, "recompute_pre_mlp_layernorm", False)
+            and not getattr(layer, "offload_attn_norm", False)
+            and not getattr(layer, "offload_mlp_norm", False)
+            and _fp8_delayed())
