+
+
+def _make_rmsnorm_bwd(stock):
+    def rmsnorm_bwd(dy, x, rstd, w, sm_margin, zero_centered_gamma):
+        global _pending_bwd
+        H = w.numel()
+        if (getattr(rstd, "_fused_residual_fork", False) and not zero_centered_gamma
+                and dy.dtype == torch.bfloat16 and x.dtype == torch.bfloat16 and w.dtype == torch.bfloat16
+                and rstd.dtype == torch.float32 and dy.is_contiguous() and x.is_contiguous() and w.is_contiguous()
+                and x.dim() == 2 and x.shape[1] == H and dy.shape == x.shape and rstd.numel() == x.shape[0]
+                and H <= 16384):
