diff --git a/transformer_engine/common/comm_gemm_overlap/pre_rs_add.cu b/transformer_engine/common/comm_gemm_overlap/pre_rs_add.cu
new file mode 100644
--- /dev/null
+++ b/transformer_engine/common/comm_gemm_overlap/pre_rs_add.cu
@@ -0,0 +1,64 @@
+#include <algorithm>
+#include <cstdint>
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include "common/util/logging.h"
+
+namespace transformer_engine {
+
+__global__ void pre_rs_add_kernel(__nv_bfloat162 *dst, const __nv_bfloat162 *src, size_t chunk,
+                                  size_t row_pairs, size_t src_row_stride_pairs) {
+  const size_t o = blockIdx.x;
+  __nv_bfloat162 *d = dst + o * row_pairs;
+  const __nv_bfloat162 *s = src + o * src_row_stride_pairs + chunk * row_pairs;
+  for (size_t j = threadIdx.x; j < row_pairs; j += blockDim.x) {
+    d[j] = __hadd2(d[j], s[j]);
+  }
+}
+
+void launch_pre_rs_add(char *dst, const char *src, size_t chunk, size_t n, size_t m, size_t m_chunk,
+                       cudaStream_t stream) {
+  NVTE_CHECK(m % 2 == 0 && m_chunk % 2 == 0,
+             "pre-RS add expects even token counts (BF16 pairs)");
+  const int block = 256;
+  pre_rs_add_kernel<<<static_cast<unsigned int>(n), block, 0, stream>>>(
+      reinterpret_cast<__nv_bfloat162 *>(dst), reinterpret_cast<const __nv_bfloat162 *>(src),
+      chunk, m_chunk / 2, m / 2);
+  NVTE_CHECK_CUDA(cudaGetLastError());
+}
+
+__global__ void pre_rs_add_p2p_kernel(uint4 *dst, const uint4 *src, size_t vecs) {
+  for (size_t i = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < vecs;
+       i += static_cast<size_t>(gridDim.x) * blockDim.x) {
+    uint4 d = dst[i];
+    const uint4 s = src[i];
+    __nv_bfloat162 *dh = reinterpret_cast<__nv_bfloat162 *>(&d);
+    const __nv_bfloat162 *sh = reinterpret_cast<const __nv_bfloat162 *>(&s);
+#pragma unroll
+    for (int k = 0; k < 4; k++) dh[k] = __hadd2(dh[k], sh[k]);
+    dst[i] = d;
+  }
+}
+
+void launch_pre_rs_add_p2p(char *dst, const char *src, size_t c0, size_t n, size_t m,
+                           size_t m_chunk, cudaStream_t stream) {
+  (void)m;
+  const size_t elems = m_chunk * n;
+  NVTE_CHECK(elems % 8 == 0 && (c0 * n) % 8 == 0,
+             "pre-RS add (P2P) expects 16-byte aligned token-major chunks");
+  NVTE_CHECK(reinterpret_cast<uintptr_t>(dst) % 16 == 0 &&
+                 reinterpret_cast<uintptr_t>(src) % 16 == 0,
+             "pre-RS add (P2P) expects 16-byte aligned buffers");
+  const size_t vecs = elems / 8;
+  const int block = 512;
+  const unsigned int grid =
+      static_cast<unsigned int>(std::min<size_t>((vecs + block - 1) / block, 132 * 8));
+  pre_rs_add_p2p_kernel<<<grid, block, 0, stream>>>(
+      reinterpret_cast<uint4 *>(dst),
+      reinterpret_cast<const uint4 *>(src) + (c0 * n) / 8, vecs);
+  NVTE_CHECK_CUDA(cudaGetLastError());
+}
+
+}  // namespace transformer_engine
