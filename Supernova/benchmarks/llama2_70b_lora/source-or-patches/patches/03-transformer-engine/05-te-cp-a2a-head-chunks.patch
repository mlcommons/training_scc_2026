+def _a2a_head_chunks():
+    """NVTE_CP_A2A_HEAD_CHUNKS: head groups the CP all-to-all attention is
+    pipelined over (1 = the stock single exchange). q/out are exchanged in
+    this many chunks; k/v in at most hkv//cp chunks (whole kv heads per rank
+    block, shared by consecutive q chunks), so a GQA group's backward still
+    sees all its q heads in one call."""
+    return int(os.getenv("NVTE_CP_A2A_HEAD_CHUNKS", "1"))
+
+
+def _a2a_kv_chunks(n_chunks, k, cp_size):
+    """k/v exchange chunks: capped at whole kv heads per rank block."""
+    return min(n_chunks, k.shape[-2] // cp_size)
+
+
+def _cp_p2p(ops):
+    """Launch grouped NCCL send/recv ops; returns the works to wait on."""
+    return torch.distributed.batch_isend_irecv(ops) if ops else []
+
+
+def _a2a_pre_launch(x, g, n_chunks, cp_size, cp_group):
+    """Start the before-attention exchange of head chunk g of an sbhd tensor.
+
+    x is [s/cp, b, h, d] holding this rank's two load-balanced sequence chunks
+    (global chunks rank and 2*cp-1-rank, each L = s/(2*cp) long); destination
+    rank r owns heads [r*h/cp, (r+1)*h/cp) and chunk g is the g-th of n_chunks
+    equal head groups in every rank's block. The result is the full sequence in
+    order, [s, b, hc, d]: each received half lands directly in its final
+    sequence position (no reorder pass), and this rank's own halves are copied
+    there. Returns (out, works).
+    """
+    s_local, b, h, d = x.shape
+    hc = h // (cp_size * n_chunks)
+    half = s_local // 2
+    me = torch.distributed.get_rank(cp_group)
+    out = torch.empty(cp_size * s_local, b, hc, d, dtype=x.dtype, device=x.device)
+    blocks = x.view(s_local, b, cp_size, n_chunks, hc, d)
+
+    def final(chunk):
+        return out[chunk * half:(chunk + 1) * half]
+
+    ops, keep = [], []
+    for r in range(cp_size):
+        if r == me:
+            continue
+        send = blocks[:, :, r, g].contiguous()
+        keep.append(send)
+        peer = torch.distributed.get_global_rank(cp_group, r)
+        ops.append(torch.distributed.P2POp(torch.distributed.isend, send[:half], peer, cp_group))
+        ops.append(torch.distributed.P2POp(torch.distributed.isend, send[half:], peer, cp_group))
+        ops.append(torch.distributed.P2POp(torch.distributed.irecv, final(r), peer, cp_group))
+        ops.append(torch.distributed.P2POp(
+            torch.distributed.irecv, final(2 * cp_size - 1 - r), peer, cp_group))
+    works = _cp_p2p(ops)
+    final(me).copy_(blocks[:half, :, me, g])
+    final(2 * cp_size - 1 - me).copy_(blocks[half:, :, me, g])
+    return out, (works, keep)
+
+
+def _a2a_pre_finish(out, handle):
+    """Wait for a before-attention chunk: [s, b, hc, d] in sequence order."""
+    for w in handle[0]:
+        w.wait()
+    return out
+
+
+def _a2a_post_launch(x, cp_size, cp_group):
+    """Start the after-attention exchange of a head chunk x [s, b, hc, d]
+    (sequence order): rank r gets its two chunks r and 2*cp-1-r, which are
+    contiguous slices of x (no pack pass). Returns (recv, works); recv is
+    [cp, s/cp, b, hc, d] with this rank's own slot filled locally."""
+    s, b, hc, d = x.shape
+    half = s // (2 * cp_size)
+    me = torch.distributed.get_rank(cp_group)
+    recv = torch.empty(cp_size, 2 * half, b, hc, d, dtype=x.dtype, device=x.device)
+
+    def chunk(c):
+        return x[c * half:(c + 1) * half]
+
+    ops = []
+    for r in range(cp_size):
+        if r == me:
+            continue
+        peer = torch.distributed.get_global_rank(cp_group, r)
+        ops.append(torch.distributed.P2POp(torch.distributed.isend, chunk(r), peer, cp_group))
+        ops.append(torch.distributed.P2POp(
+            torch.distributed.isend, chunk(2 * cp_size - 1 - r), peer, cp_group))
+        ops.append(torch.distributed.P2POp(torch.distributed.irecv, recv[r, :half], peer, cp_group))
+        ops.append(torch.distributed.P2POp(torch.distributed.irecv, recv[r, half:], peer, cp_group))
+    works = _cp_p2p(ops)
+    recv[me, :half].copy_(chunk(me))
+    recv[me, half:].copy_(chunk(2 * cp_size - 1 - me))
+    return recv, (works, x)
+
+
+def _a2a_post_finish(recv, handle, full, g, n_chunks):
+    """Wait for an after-attention chunk and write it into full [s/cp, b, h, d]:
+    source rank r's heads land at [r*h/cp + g*hc, r*h/cp + (g+1)*hc)."""
+    for w in handle[0]:
+        w.wait()
+    cp, s_local, b, hc, d = recv.shape
+    full.view(s_local, b, cp, n_chunks, hc, d)[:, :, :, g].copy_(recv.movedim(0, 2))
+
