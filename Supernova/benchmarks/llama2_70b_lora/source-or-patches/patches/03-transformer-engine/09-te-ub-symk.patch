+namespace transformer_engine {
+
+// UB_TRANSPORT selects what carries the ring-exchange reduce-scatter: nccl (the stock ring, the default),
+// symk_nccl (a symmetric NCCL window) or tccl (our TMA reduce over the IPC-mapped peer ubuf). One selector,
+// so two transports can never be asked for at once.
+static const std::string &ub_transport() {
+  static const std::string transport = [] {
+    const char *env = std::getenv("UB_TRANSPORT");
+    const std::string v = env != nullptr ? env : "";
+    if (v.empty() || v == "nccl") return std::string("nccl");
+    if (v == "symk_nccl" || v == "tccl") return v;
+    throw std::runtime_error("UB_TRANSPORT must be nccl, symk_nccl or tccl, got: " + v);
+  }();
+  return transport;
+}
+
+static bool ub_symk_enabled() { return ub_transport() == "symk_nccl"; }
+
+void CommOverlapP2PBase::symk_setup(size_t chunk_capacity_bytes, DType buffer_dtype) {
+  const bool rank0 = _rank == 0;
+  if (typeToSize(buffer_dtype) != 2) {
+    if (rank0) printf("!!! [UB_TRANSPORT symk_nccl] buffer dtype is not 16-bit; this RS object keeps the ring\n");
+    return;
+  }
+  if (_ub_comm->nvsize != _tp_size || _ub_comm->nvrank != _tp_id) {
+    if (rank0)
+      printf("!!! [UB_TRANSPORT symk_nccl] UB intra domain (size %d) is not the TP domain (size %d); keeping the ring\n",
+             _ub_comm->nvsize, _tp_size);
+    return;
+  }
+  ncclUniqueId id;
+  memset(&id, 0, sizeof(id));
+  if (_tp_id == 0) {
+    if (ncclGetUniqueId(&id) != ncclSuccess) {
+      printf("!!! [UB_TRANSPORT symk_nccl] ncclGetUniqueId failed on TP rank 0; keeping the ring\n");
+    }
+  }
+  std::vector<ncclUniqueId> ids(_tp_size);
+  _ub_comm->_allgather(reinterpret_cast<void *>(ids.data()), _tp_size * sizeof(ncclUniqueId),
+                       reinterpret_cast<void *>(&id), sizeof(ncclUniqueId), _ub_comm->comm_intra);
+  id = ids[0];
+  ncclResult_t res = ncclCommInitRank(&_symk_comm, _tp_size, id, _tp_id);
+  if (res != ncclSuccess) {
+    if (rank0) printf("!!! [UB_TRANSPORT symk_nccl] ncclCommInitRank failed (%s); keeping the ring\n", ncclGetErrorString(res));
+    _symk_comm = nullptr;
+    return;
+  }
+  _symk_slot_capacity = chunk_capacity_bytes;
+  const size_t bytes = chunk_capacity_bytes * static_cast<size_t>(_tp_size + 1);
+  res = ncclMemAlloc(&_symk_buf, bytes);
+  if (res != ncclSuccess || _symk_buf == nullptr) {
+    if (rank0) printf("!!! [UB_TRANSPORT symk_nccl] ncclMemAlloc(%zu) failed (%s); keeping the ring\n", bytes, ncclGetErrorString(res));
+    _symk_buf = nullptr;
+    return;
+  }
+  res = ncclCommWindowRegister(_symk_comm, _symk_buf, bytes, &_symk_win, NCCL_WIN_COLL_SYMMETRIC);
+  if (res != ncclSuccess || _symk_win == nullptr) {
+    if (rank0)
+      printf("!!! [UB_TRANSPORT symk_nccl] ncclCommWindowRegister failed (%s); keeping the ring\n", ncclGetErrorString(res));
+    _symk_win = nullptr;
+    return;
+  }
+  _symk = true;
+  if (rank0)
+    printf("!!! [UB_TRANSPORT symk_nccl] ring-exchange RS object: symmetric window of %zu bytes (%d shard slots + 1 out) on a "
+           "TP-%d NCCL comm\n", bytes, _tp_size, _tp_size);
+}
+
+using ub_tma_rs_bf16_fn = int (*)(const void *, void *, unsigned long long, int, unsigned long long,
+                                  unsigned long long, int, void *, int);
+using ub_tma_rs_handshake_fn = int (*)(unsigned int *, const unsigned int *, void *, int);
+static ub_tma_rs_bf16_fn ub_tma_rs_bf16 = nullptr;
+static ub_tma_rs_handshake_fn ub_tma_rs_handshake = nullptr;
+
+static bool ub_tccl_enabled() { return ub_transport() == "tccl"; }
+
+// CTAs per TMA launch: a per-GPU budget of 12, split over the peers (4/peer at tp 4, 6 at tp 3, 12 at tp 2),
+// rounded up so every peer keeps at least two TMA issue queues. The budget is the tuned value; the split is
+// arithmetic, so there is nothing to set.
+static constexpr int kTcclCtasPerGpu = 12;
+
+static int ub_tccl_ctas(int npeers) { return std::max(1, (kTcclCtasPerGpu + npeers - 1) / npeers); }
+
+
+void CommOverlapP2PBase::tccl_setup(size_t chunk_capacity_bytes, DType buffer_dtype) {
+  const bool rank0 = _rank == 0;
+  if (_tp_size < 2 || buffer_dtype != DType::kBFloat16) {
+    if (rank0) printf("!!! [UB_TRANSPORT tccl] needs TP>=2 and a bf16 buffer (tp %d); keeping the ring\n", _tp_size);
+    return;
+  }
+  if (_ub_comm->nvsize != _tp_size || _ub_comm->nvrank != _tp_id) {
+    if (rank0) printf("!!! [UB_TRANSPORT tccl] UB intra domain (size %d) is not the TP domain; keeping the ring\n", _ub_comm->nvsize);
+    return;
+  }
+  if (ub_tma_rs_bf16 == nullptr) {
+    const char *lib = std::getenv("TMA_REDUCE_LIB");
+    void *h = lib != nullptr ? dlopen(lib, RTLD_NOW | RTLD_LOCAL) : nullptr;
+    if (h == nullptr) {
+      if (rank0) printf("!!! [UB_TRANSPORT tccl] cannot dlopen TMA_REDUCE_LIB=%s (%s); keeping the ring\n", lib ? lib : "(unset)",
+                        dlerror());
+      return;
+    }
+    ub_tma_rs_bf16 = reinterpret_cast<ub_tma_rs_bf16_fn>(dlsym(h, "tma_rs_bf16"));
+    ub_tma_rs_handshake = reinterpret_cast<ub_tma_rs_handshake_fn>(dlsym(h, "tma_rs_handshake"));
+    if (ub_tma_rs_bf16 == nullptr || ub_tma_rs_handshake == nullptr) {
+      if (rank0) printf("!!! [UB_TRANSPORT tccl] %s lacks tma_rs_bf16 / tma_rs_handshake; keeping the ring\n", lib);
+      ub_tma_rs_bf16 = nullptr;
+      ub_tma_rs_handshake = nullptr;
+      return;
+    }
+  }
+  void *ctl = nullptr;
+  const int reg = register_user_buffer_collective(&ctl, 4096, _ub_comm, true);
+  _tccl_ctl.clear();
+  for (int p = 0; p < _tp_size; ++p) {
+    if (p == _tp_id) continue;
+    _tccl_ctl.emplace_back(reinterpret_cast<unsigned int *>(ctl) + (p - _tp_id - 1 + _tp_size) % _tp_size,
+                           reinterpret_cast<const unsigned int *>(_ub_comm->peer_ptr[reg][p]) +
+                               (_tp_id - p - 1 + _tp_size) % _tp_size);
+  }
+  _tccl_slot_capacity = chunk_capacity_bytes;
+  _tccl = true;
+  if (rank0)
+    printf("!!! [UB_TRANSPORT tccl] ring-exchange RS object: TMA reduce over the IPC-mapped peer ubuf, %d CTAs, control region "
+           "%d\n", ub_tccl_ctas(_tp_size - 1), reg);
+}
+
+void CommOverlapP2PBase::tccl_handshake(cudaStream_t stream, int which) {
+  for (const auto &c : _tccl_ctl)
+    NVTE_CHECK(ub_tma_rs_handshake(c.first, c.second, reinterpret_cast<void *>(stream), which) == 0,
+               "UB_TRANSPORT tccl handshake(", which ? "ready" : "done", ") failed");
+}
