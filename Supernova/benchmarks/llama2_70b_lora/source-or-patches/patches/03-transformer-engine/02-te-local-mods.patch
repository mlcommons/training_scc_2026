+
+namespace transformer_engine::pytorch {
+
+namespace {
+
+using DType = transformer_engine::DType;
+using TensorWrapper = transformer_engine::TensorWrapper;
+
+std::optional<std::string> kernel_config(size_t n, size_t k) {
+  static const std::map<std::pair<size_t, size_t>, std::string> configs = {
+      {{5120, 8192}, "auto"},   // QKV projection
+      {{8192, 4096}, "auto"},   // attention output projection
+      {{28672, 8192}, "auto"},  // FC1 (gated)
+      {{8192, 14336}, "auto"},  // FC2
+  };
+  const auto it = configs.find({n, k});
+  if (it != configs.end()) return it->second;
+  return std::nullopt;
+}
+
+std::vector<size_t> shape_of(const NVTEBasicTensor &t) {
+  return std::vector<size_t>(t.shape.data, t.shape.data + t.shape.ndim);
+}
+
+NVTEBasicTensor per_tensor_scale_inv(const TensorWrapper &t) {
+  const auto rowwise = t.get_rowwise_scale_inv();
+  return rowwise.data_ptr != nullptr ? rowwise : t.get_columnwise_scale_inv();
+}
+
+bool aligned_16(const void *ptr) { return reinterpret_cast<uintptr_t>(ptr) % 16 == 0; }
+
+bool forward_chunk_gemm(const TensorWrapper &A, bool transa, const TensorWrapper &B, bool transb,
+                        TensorWrapper &D, bool grad, int math_sms, cudaStream_t stream) {
+  if (grad || !transa || transb) return false;
+  if (A.scaling_mode() != NVTE_DELAYED_TENSOR_SCALING ||
+      B.scaling_mode() != NVTE_DELAYED_TENSOR_SCALING) {
+    return false;
+  }
+  if (A.dtype() != DType::kFloat8E4M3 || B.dtype() != DType::kFloat8E4M3 ||
+      D.dtype() != DType::kBFloat16) {
+    return false;
+  }
+  if (math_sms <= 1) return false;
+
+  const auto b_data = B.get_rowwise_data();
+  const auto a_data = A.get_rowwise_data();
+  const auto d_data = D.get_rowwise_data();
+  const auto b_scale = per_tensor_scale_inv(B);
+  const auto a_scale = per_tensor_scale_inv(A);
+  if (b_data.data_ptr == nullptr || a_data.data_ptr == nullptr || d_data.data_ptr == nullptr ||
+      b_scale.data_ptr == nullptr || a_scale.data_ptr == nullptr) {
+    return false;
+  }
+  const auto b_shape = shape_of(b_data);
+  const auto a_shape = shape_of(a_data);
+  const auto d_shape = shape_of(d_data);
+  if (b_shape.size() != 2 || a_shape.size() != 2 || d_shape.size() != 2) return false;
+  const size_t m = b_shape[0];
+  const size_t k = b_shape[1];
+  const size_t n = a_shape[0];
+  if (a_shape[1] != k || d_shape[0] != m || d_shape[1] != n) return false;
+  if (m == 0 || n % 128 != 0 || k % 128 != 0) return false;
+  if (!aligned_16(a_data.data_ptr) || !aligned_16(b_data.data_ptr) ||
+      !aligned_16(d_data.data_ptr)) {
+    return false;
+  }
+  const auto config = kernel_config(n, k);
+  if (!config.has_value()) return false;
+
+  const auto device_index = c10::cuda::current_device();
+  int device_sms = 0;
+  NVTE_CHECK_CUDA(
+      cudaDeviceGetAttribute(&device_sms, cudaDevAttrMultiProcessorCount, device_index));
+  const int sms = std::min(math_sms, device_sms);
+
+  const auto device = at::Device(at::kCUDA, device_index);
+  const auto i64 = [](size_t v) { return static_cast<int64_t>(v); };
+  const c10::cuda::CUDAStreamGuard stream_guard(
+      c10::cuda::getStreamFromExternal(stream, device_index));
+  const int saved_sms = deep_gemm::runtime->get_num_sms();
+  deep_gemm::runtime->set_num_sms(sms);
+  bool launched = true;
+  try {
+    const auto fp8_opts = at::dtype(GetATenDType(DType::kFloat8E4M3)).device(device);
+    const auto f32_opts = at::dtype(at::kFloat).device(device);
+    const auto act = at::from_blob(b_data.data_ptr, {i64(m), i64(k)}, fp8_opts);
+    const auto weight = at::from_blob(a_data.data_ptr, {i64(n), i64(k)}, fp8_opts);
+    const auto out = at::from_blob(d_data.data_ptr, {i64(m), i64(n)},
+                                   at::dtype(at::kBFloat16).device(device));
+    const auto act_scale = at::from_blob(b_scale.data_ptr, {1}, f32_opts);
+    const auto weight_scale = at::from_blob(a_scale.data_ptr, {1}, f32_opts);
+    deep_gemm::sm90_fp8_gemm_per_tensor(act, act_scale, weight, weight_scale, out,
+                                        torch::Tensor(), static_cast<int>(m), static_cast<int>(n),
+                                        static_cast<int>(k), cute::UMMA::Major::K,
+                                        cute::UMMA::Major::K, "nk", config);
+  } catch (...) {
+    launched = false;
+  }
+  deep_gemm::runtime->set_num_sms(saved_sms);
+  return launched;
+}
