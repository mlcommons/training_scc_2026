+// Per-tensor-scaled (delayed-scaling) FP8 GEMM: A [M,K] @ B [N,K].T -> D [M,N]
+// (bf16, or e4m3 when scale_d is given), with a single per-tensor dequant
+// multiply (scale_a * scale_b) in the epilogue. Operands may be e4m3 (forward)
+// or e5m2 (dgrad dy x w). Scales are 1-element float32 device tensors read by
+// the kernel at launch (CUDA-graph safe). For e4m3 D, scale_d is the output's
+// FORWARD scale: payload = value * scale_d (satfinite); the caller refreshes
+// scale_inv = 1 / scale_d after the GEMM. With amax_d (fp32[1]), e4m3 D also
+// atomically max-accumulates max |value| into it.
+static void fp8_gemm_nt_per_tensor(const torch::Tensor& a, const torch::Tensor& scale_a,
+                                   const torch::Tensor& b, const torch::Tensor& scale_b,
+                                   const torch::Tensor& d,
+                                   const std::string& compiled_dims = "nk",
+                                   const std::optional<std::string>& config = std::nullopt,
+                                   const torch::Tensor& scale_d = {},
+                                   const torch::Tensor& amax_d = {},
+                                   const torch::Tensor& c = {}) {
+    // Shape must be `[M, K] @ [N, K].T`
+    const auto major_a = get_major_type_ab(a);
+    const auto major_b = get_major_type_ab(b);
+
+    // C/D must be N-major
+    check_major_type_cd(d);
+
+    const auto [m, k] = get_shape<2>(a);
+    const auto [n, k_] = get_shape<2>(b);
+    const auto [m_, n_] = get_shape<2>(d);
+    DG_HOST_ASSERT(m == m_ and n == n_ and k == k_);
+    DG_HOST_ASSERT(k % 128 == 0 and "Per-tensor kernel requires K to be a multiple of 128");
+
+    // Early return for trivial cases (fp8 D must come with its scale).
+    std::optional<torch::Tensor> sfd;
+    if (d.scalar_type() == torch::kFloat8_e4m3fn)
+        sfd = scale_d;
+    if (early_return(m, n, k, d, std::nullopt, sfd))
+        return;
+
+    sm90_fp8_gemm_per_tensor(a, scale_a, b, scale_b, d, scale_d, m, n, k, major_a, major_b, compiled_dims, config, amax_d, c);
