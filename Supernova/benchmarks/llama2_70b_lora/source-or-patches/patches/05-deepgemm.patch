+++ b/csrc/jit_kernels/impls/sm90_fp8_gemm_per_tensor.hpp
@@ -0,0 +1,367 @@
+// Copyright (c) 2026, Billy Cao
+// Host-side entry for the per-tensor-scaled SM90 FP8 GEMM (see
+// deep_gemm/impls/sm90_fp8_gemm_per_tensor.cuh). Derived from DeepGEMM's
+// sm90_fp8_gemm_1d2d.hpp (MIT License, Copyright (c) 2024 DeepSeek).
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <format>
+#include <optional>
+#include <torch/python.h>
+
+#include "../../runtime/runtime.hpp"
+#include "../../utils/exception.hpp"
+#include "../heuristics/sm90.hpp"
+
+#include "runtime_utils.hpp"
+
+namespace deep_gemm {
+
+class SM90FP8GemmPerTensorRuntime final {
+public:
+    struct Args {
+        GemmDesc gemm_desc;
+        GemmConfig gemm_config;
+        deep_jit::cuda::LaunchOptions options;
+
+        const void* scale_a;
+        const void* scale_b;
+        const void* scale_d = nullptr;
+        void* amax_d = nullptr;
+        CUtensorMap tensor_map_a;
+        CUtensorMap tensor_map_b;
+        CUtensorMap tensor_map_d;
+        uint32_t d_store_splits = 1;
+        bool legacy = false;
+        // Overlapped 128-row kernel, BF16 output: amax_d receives max |D| of the bf16-rounded output
+        bool amax_bf16 = false;
+        // Legacy kernel only: D = bf16(scale * A @ B^T) + C, C a BF16 [M, N]
+        // row-major addend with row stride ldc (nullptr = no addend)
+        const void* c = nullptr;
+        uint32_t ldc = 0;
+        // Legacy kernel only, with c: a second BF16 [M, N] addend at the same row stride, added after c
+        // (UB_TCCL: the peer's partial of the shard through its IPC mapping). nullptr = none, and the
+        // kernel instantiation string is then exactly the one-addend kernel's.
+        const void* c2 = nullptr;
+        // With c2: per-piece ready flags (uint32, non-zero = piece of c2 written) and the piece geometry; nullptr
+        // = c2 is complete before launch (UB_TCCL_EPI=1, the peer's mapping) and the kernel waits for nothing.
+        // Flags without c2 (kWaitC): they guard c itself, the single staged addend.
+        const void* c2_flags = nullptr;
+        uint32_t c2_piece_rows = 0, c2_piece_cols = 0;
+    };
+
+    static void compile_and_launch(const std::string& tag, const Args& args) {
+        const auto kernel = jit->compile(tag, std::format(R"(
+#include <deep_gemm/impls/{}>
+
+using namespace deep_gemm;
+
+static void __instantiate_kernel() {{
+    auto ptr = reinterpret_cast<void*>(&{}<
+        {}, {},
+        {}, {}, {},
+        {},
+        {}, {}, {},
+        {}, {}, {},
+        {},
+        {}, {},
+        {}, {},
+        {}, {},
+        {},
+        {}{}
+    >);
+}};
+)",
+        args.legacy ? "sm90_fp8_gemm_per_tensor_legacy.cuh" : "sm90_fp8_gemm_per_tensor.cuh",
+        // Kernel variant: legacy 128-row, 128-row overlapped-epilogue, or 192-row three-math-warp-group
+        args.legacy ? "sm90_fp8_gemm_per_tensor_legacy_impl" :
+            args.gemm_config.layout.block_m == 192 ? "sm90_fp8_gemm_per_tensor_3wg_impl" : "sm90_fp8_gemm_per_tensor_impl",
+        to_string(args.gemm_desc.a_dtype), to_string(args.gemm_desc.b_dtype),
+        get_compiled_dim(args.gemm_desc.m, 'm', args.gemm_desc.compiled_dims),
+        get_compiled_dim(args.gemm_desc.n, 'n', args.gemm_desc.compiled_dims),
+        get_compiled_dim(args.gemm_desc.k, 'k', args.gemm_desc.compiled_dims),
+        args.gemm_desc.num_groups,
+        args.gemm_config.layout.block_m, args.gemm_config.layout.block_n, args.gemm_config.layout.block_k,
+        args.gemm_config.storage_config.swizzle_a_mode, args.gemm_config.storage_config.swizzle_b_mode, args.gemm_config.storage_config.swizzle_cd_mode,
+        args.gemm_config.pipeline_config.num_stages,
+        args.gemm_config.launch_config.num_tma_threads, args.gemm_config.launch_config.num_math_threads,
+        args.gemm_config.layout.get_cluster_size(), args.gemm_config.layout.cluster_n > 1,
+        args.gemm_config.launch_config.num_sms, to_string(args.gemm_desc.gemm_type),
+        to_string(args.gemm_desc.cd_dtype), args.d_store_splits,
+        args.legacy ? std::format(", {}{}", args.c != nullptr,
+                                  args.c2 != nullptr ? ", true"
+                                  : (args.c2_flags != nullptr ? ", false, true" : ""))
+        // Overlapped 128-row kernel with addends (UB_TCCL_EPI=4): <..., kWithC, kWithC2, kWaitC>; without, unchanged
+        : (args.c != nullptr or args.amax_bf16)
+            ? std::format(", {}, {}, {}{}", args.c != nullptr, args.c2 != nullptr,
+                          args.c2 == nullptr and args.c2_flags != nullptr, args.amax_bf16 ? ", true" : "")
+        : std::string()));
+
+        // Launch
+        if (args.legacy) {
+            jit->launch(
+                kernel, args.options,
+                args.scale_a, args.scale_b, args.scale_d, args.amax_d, static_cast<int*>(nullptr),
+                args.gemm_desc.m, args.gemm_desc.n, args.gemm_desc.k,
+                args.tensor_map_a, args.tensor_map_b, args.tensor_map_d,
+                static_cast<const __nv_bfloat16*>(args.c), args.ldc,
+                static_cast<const __nv_bfloat16*>(args.c2),
+                static_cast<const uint32_t*>(args.c2_flags), args.c2_piece_rows, args.c2_piece_cols);
+        } else if (args.gemm_config.layout.block_m == 192) {
+            DG_HOST_ASSERT(args.c == nullptr and "The C addend is not supported by the 192-row kernel");
+            jit->launch(
+                kernel, args.options,
+                args.scale_a, args.scale_b, args.scale_d, args.amax_d, static_cast<int*>(nullptr),
+                args.gemm_desc.m, args.gemm_desc.n, args.gemm_desc.k,
+                args.tensor_map_a, args.tensor_map_b, args.tensor_map_d);
+        } else {
+            jit->launch(
+                kernel, args.options,
+                args.scale_a, args.scale_b, args.scale_d, args.amax_d, static_cast<int*>(nullptr),
+                args.gemm_desc.m, args.gemm_desc.n, args.gemm_desc.k,
+                args.tensor_map_a, args.tensor_map_b, args.tensor_map_d,
+                static_cast<const __nv_bfloat16*>(args.c), args.ldc, static_cast<const __nv_bfloat16*>(args.c2),
+                static_cast<const uint32_t*>(args.c2_flags), args.c2_piece_rows, args.c2_piece_cols);
+        }
+    }
+};
+
+// e5m2 x e5m2 WGMMA only supports N in {8, 16, 32, 64, 96, 128, 192, 256};
+// all other fp8 type combinations support every multiple of 8
+static bool is_block_n_legal_for_dtypes(const at::ScalarType& a_dtype, const at::ScalarType& b_dtype,
+                                        const int& block_n) {
+    if (a_dtype != torch::kFloat8_e5m2 or b_dtype != torch::kFloat8_e5m2)
+        return true;
+    return block_n == 8 or block_n == 16 or block_n == 32 or block_n == 64 or
+           block_n == 96 or block_n == 128 or block_n == 192 or block_n == 256;
+}
+
+struct PerTensorPlan {
+    GemmConfig config;
+    uint32_t d_store_splits;
+    bool legacy;
+};
+
+// Legacy kernel config ("legacy:block_m,block_n,1,1[,num_stages[,d_store_splits]]",
+// BF16 output only): 128-row BF16 staging (split by d_store_splits), full and
+// empty barrier arrays.
+static PerTensorPlan parse_legacy_config(const GemmDesc& desc, const std::string& cfg) {
+    int bm = 0, bn = 0, cm = 0, cn = 0, ns = 0, ds = 1;
+    const auto num_parsed = sscanf(cfg.c_str(), "%d,%d,%d,%d,%d,%d", &bm, &bn, &cm, &cn, &ns, &ds);
+    if (num_parsed < 6) ds = 1;
+    DG_HOST_ASSERT(desc.cd_dtype == torch::kBFloat16 and "Legacy per-tensor kernel: BF16 output only");
+    DG_HOST_ASSERT(num_parsed >= 4 and bm == 128 and bn > 0 and cm == 1 and cn == 1 and
+                   is_block_n_legal_for_dtypes(desc.a_dtype, desc.b_dtype, bn) and
+                   (ds == 1 or ds == 2) and bn % ds == 0 and "Invalid legacy per-tensor GEMM config");
+    const auto layout = Layout{0, bm, bn, 128, cm, cn};
+    auto storage_config = SM90ArchSpec::get_storage_config(desc, layout);
+    auto pipeline_config = SM90ArchSpec::get_pipeline_config(desc, layout, storage_config);
+    auto launch_config = SM90ArchSpec::get_launch_config(desc, layout);
+    const int smem_per_stage = (storage_config.load_block_m + storage_config.load_block_n) * layout.block_k;
+    const int smem_cd = ((bm * bn / ds * 2 + 1023) / 1024) * 1024;
+    const int smem_barriers = 16 * 8 * 2;
+    if (num_parsed >= 5 and ns > 0) {
+        DG_HOST_ASSERT(ns * smem_per_stage + smem_cd + smem_barriers <= 232448 and "Config override stages overflow smem");
+        pipeline_config.num_stages = ns;
+    } else {
+        pipeline_config.num_stages = std::min((232448 - smem_cd - smem_barriers) / smem_per_stage, 16);
+    }
+    pipeline_config.smem_size = smem_cd + smem_barriers + pipeline_config.num_stages * smem_per_stage;
+    return {GemmConfig{layout, storage_config, pipeline_config, launch_config}, static_cast<uint32_t>(ds), true};
+}
+
+// Parse "block_m,block_n,cluster_m,cluster_n[,num_stages[,d_store_splits]]" into a
+// full config override. `d_store_splits` = 2 stores a BF16 D tile through a
+// halved smem staging buffer (two column splits, written during the next
+// tile's mainloop), freeing smem for a deeper A/B pipeline. FP8 output always
+// uses one split (its whole-tile staging is already half the BF16 size).
+static PerTensorPlan parse_config_override(const GemmDesc& desc, const std::string& cfg) {
+    if (cfg.rfind("legacy:", 0) == 0)
+        return parse_legacy_config(desc, cfg.substr(7));
+    int bm = 0, bn = 0, cm = 0, cn = 0, ns = 0, ds = 1;
+    const auto num_parsed = sscanf(cfg.c_str(), "%d,%d,%d,%d,%d,%d", &bm, &bn, &cm, &cn, &ns, &ds);
+    if (num_parsed < 6) ds = 1;
+    const bool fp8_out = desc.cd_dtype == torch::kFloat8_e4m3fn;
+    if (fp8_out) ds = 1;
+    // 192-row BF16 tiles only fit the smem budget with split staging
+    if (bm == 192 and not fp8_out) ds = 2;
+    const int elem_cd = fp8_out ? 1 : 2;
+    DG_HOST_ASSERT(num_parsed >= 4 and (bm == 128 or bm == 192) and bn > 0 and cm == 1 and cn == 1 and
+                   is_block_n_legal_for_dtypes(desc.a_dtype, desc.b_dtype, bn) and
+                   (ds == 1 or ds == 2) and (bn / ds * elem_cd) % 128 == 0 and
+                   "Invalid per-tensor GEMM config override");
+    const auto layout = Layout{0, bm, bn, 128, cm, cn};
+    auto storage_config = SM90ArchSpec::get_storage_config(desc, layout);
+    auto pipeline_config = SM90ArchSpec::get_pipeline_config(desc, layout, storage_config);
+    auto launch_config = SM90ArchSpec::get_launch_config(desc, layout);
+    // One math warp-group per 64 rows; 192-row tiles issue TMA in-band (no producer warp-group)
+    launch_config.num_math_threads = bm / 64 * 128;
+    if (bm == 192)
+        launch_config.num_tma_threads = 0;
+    launch_config.num_threads = launch_config.num_tma_threads + launch_config.num_math_threads;
+
+    const int elem_ab = 1;  // fp8 operands
+    const int smem_per_stage = (storage_config.load_block_m + storage_config.load_block_n) * layout.block_k * elem_ab;
+    // D staging buffer (swizzled, per warp-group halves), possibly split in columns
+    const int smem_cd = bm * bn / ds * elem_cd;
+    const int smem_barriers = 16 * 8 * 3;  // full, empty, WG-ordering barriers (or release counters)
+
+    if (num_parsed >= 5 and ns > 0) {
+        DG_HOST_ASSERT(ns * smem_per_stage + smem_cd + smem_barriers <= 232448 and
+                       "Config override stages overflow smem");
+        pipeline_config.num_stages = ns;
+    } else {
+        pipeline_config.num_stages = std::min((232448 - smem_cd - smem_barriers) / smem_per_stage, 16);
+    }
+    pipeline_config.smem_size = smem_cd + smem_barriers + pipeline_config.num_stages * smem_per_stage;
+    return {GemmConfig{layout, storage_config, pipeline_config, launch_config},
+            static_cast<uint32_t>(ds), false};
+}
+
+// Default config by M and output dtype: 192 x 256 tiles for large M, the
+// overlapped-epilogue 128 x 256 kernel for FP8 output, the legacy 128 x 256
+// kernel for BF16 output; 3 pipeline stages.
+static std::string get_routed_config_per_tensor(const GemmDesc& desc) {
+    if (desc.m >= 6144)
+        return "192,256,1,1,3";
+    if (desc.cd_dtype == torch::kBFloat16)
+        return "legacy:128,256,1,1,3";
+    return "128,256,1,1,3";
+}
+
+static PerTensorPlan get_best_config_per_tensor(const GemmDesc& desc,
+                                             const std::optional<std::string>& config_override) {
+    desc.check_validity();
+
+    // An explicit config (other than "auto") overrides the default
+    if (config_override.has_value() and config_override.value() != "auto")
+        return parse_config_override(desc, config_override.value());
+    return parse_config_override(desc, get_routed_config_per_tensor(desc));
+}
+
+static void sm90_fp8_gemm_per_tensor(const torch::Tensor& a, const torch::Tensor& scale_a,
+                                     const torch::Tensor& b, const torch::Tensor& scale_b,
+                                     const torch::Tensor& d, const torch::Tensor& scale_d,
+                                     const int& m, const int& n, const int& k,
+                                     const cute::UMMA::Major& major_a, const cute::UMMA::Major& major_b,
+                                     const std::string& compiled_dims,
+                                     const std::optional<std::string>& config_override,
+                                     const torch::Tensor& amax_d = {},
+                                     const torch::Tensor& c = {},
+                                     const torch::Tensor& c2 = {},
+                                     const torch::Tensor& c2_flags = {},
+                                     const int& c2_piece_rows = 0, const int& c2_piece_cols = 0) {
+    const bool fp8_out = d.defined() and d.scalar_type() == torch::kFloat8_e4m3fn;
+    DG_HOST_ASSERT(not d.defined() or d.scalar_type() == torch::kBFloat16
+                   or (fp8_out and scale_d.defined()));
+    if (fp8_out) {
+        DG_HOST_ASSERT(scale_d.scalar_type() == torch::kFloat and scale_d.is_cuda()
+                       and scale_d.is_contiguous() and scale_d.numel() == 1);
+    }
+    if (amax_d.defined())
+        DG_HOST_ASSERT(amax_d.scalar_type() == torch::kFloat and amax_d.is_cuda()
+                       and amax_d.numel() == 1);
+    const bool amax_bf16 = amax_d.defined() and not fp8_out;
+    DG_HOST_ASSERT(major_a == cute::UMMA::Major::K and major_b == cute::UMMA::Major::K);
+    DG_HOST_ASSERT(a.scalar_type() == torch::kFloat8_e4m3fn or a.scalar_type() == torch::kFloat8_e5m2);
+    DG_HOST_ASSERT(b.scalar_type() == torch::kFloat8_e4m3fn or b.scalar_type() == torch::kFloat8_e5m2);
+    for (const auto& scale: {scale_a, scale_b}) {
+        DG_HOST_ASSERT(scale.scalar_type() == torch::kFloat and scale.is_cuda() and scale.is_contiguous());
+        DG_HOST_ASSERT(scale.numel() == 1);
+    }
+
+    const auto desc = GemmDesc {
+        .gemm_type = GemmType::Normal,
+        .kernel_type = KernelType::KernelNoSF,
+        .m = m, .n = n, .k = k, .num_groups = 1,
+        .a_dtype = a.scalar_type(), .b_dtype = b.scalar_type(),
+        .cd_dtype = d.defined() ? d.scalar_type() : torch::kBFloat16,
+        .major_a = major_a, .major_b = major_b,
+        .with_accumulation = false,
+        .num_sms = runtime->get_num_sms(),
+        .tc_util = runtime->get_tc_util(),
+        .compiled_dims = compiled_dims
+    };
+    auto [config, d_store_splits, legacy] = get_best_config_per_tensor(desc, config_override);
+    // New kernels: each math warp-group TMA-stores its own 64-row slice through
+    // 128B-swizzled atoms (the legacy kernel stores whole 128-row tiles)
+    if (not legacy) {
+        config.storage_config.swizzle_cd_mode = 128;
+        config.storage_config.store_block_m = 64;
+    }
+
+    DG_HOST_ASSERT(not amax_bf16 or (not legacy and config.layout.block_m == 128 and not c.defined()
+                   and "The BF16 amax needs the overlapped 128-row kernel without the C addend"));
+    if (c.defined()) {
+        DG_HOST_ASSERT((legacy or config.layout.block_m == 128) and not fp8_out and
+                       "The C addend needs a BF16-output 128-row kernel (legacy, or the overlapped one)");
+        DG_HOST_ASSERT(c.scalar_type() == torch::kBFloat16 and c.is_cuda() and c.dim() == 2
+                       and c.size(0) == m and c.size(1) == n and c.stride(1) == 1
+                       and c.stride(0) % 8 == 0
+                       and reinterpret_cast<uintptr_t>(c.data_ptr()) % 16 == 0);
+        DG_HOST_ASSERT(m % config.layout.block_m == 0 and n % config.layout.block_n == 0
+                       and "The C addend needs whole tiles");
+    }
+    DG_HOST_ASSERT(not c2_flags.defined() or c.defined());
+    if (c2.defined()) {
+        DG_HOST_ASSERT(c.defined() and c2.scalar_type() == torch::kBFloat16 and c2.dim() == 2
+                       and c2.size(0) == m and c2.size(1) == n and c2.stride(1) == 1 and c2.stride(0) == c.stride(0)
+                       and reinterpret_cast<uintptr_t>(c2.data_ptr()) % 16 == 0
+                       and "The second addend needs the C addend's shape and row stride");
+    }
+    DG_HOST_ASSERT(not c2_flags.defined() or (c2_flags.scalar_type() == torch::kInt32 and c2_flags.is_contiguous()
+                   and c2_piece_rows > 0 and c2_piece_cols > 0
+                   and c2_piece_rows % config.layout.block_m == 0 and c2_piece_cols % config.layout.block_n == 0
+                   and c2_flags.numel() >= ceil_div(m, c2_piece_rows) * ceil_div(n, c2_piece_cols)
+                   and "Staged-addend flags: int32, one per whole-tile piece"));
+
+    // Requires no TMA splits
+    DG_HOST_ASSERT(config.storage_config.swizzle_a_mode == config.layout.block_k);
+    DG_HOST_ASSERT(config.storage_config.swizzle_b_mode == config.layout.block_k);
+    const auto tensor_map_a = make_tma_a_desc(major_a, a, m, k,
+                                              config.storage_config.load_block_m,
+                                              config.layout.block_k,
+                                              static_cast<int>(a.stride(get_non_contiguous_dim(major_a))), 1,
+                                              config.storage_config.swizzle_a_mode);
+    const auto tensor_map_b = make_tma_b_desc(major_b, b, n, k,
+                                              config.storage_config.load_block_n,
+                                              config.layout.block_k,
+                                              static_cast<int>(b.stride(get_non_contiguous_dim(major_b))), 1,
+                                              config.storage_config.swizzle_b_mode);
+    const auto tensor_map_d = make_tma_cd_desc(d, m, static_cast<int>(d.size(-1)),
+                                               config.storage_config.store_block_m,
+                                               config.storage_config.store_block_n,
+                                               static_cast<int>(d.stride(-2)), 1,
+                                               config.storage_config.swizzle_cd_mode);
+
+    // Compile and launch
+    SM90FP8GemmPerTensorRuntime::compile_and_launch("sm90_fp8_gemm_per_tensor", {
+        .gemm_desc = desc,
+        .gemm_config = config,
+        .options = {
+            .num_smem_bytes = config.pipeline_config.smem_size,
+            .grid_dim = dim3(config.launch_config.num_sms, 1, 1),
+            .block_dim = dim3(config.launch_config.num_threads, 1, 1),
+            .cluster_dim = dim3(config.layout.get_cluster_size(), 1, 1),
+            .enable_pdl = false,
+        },
+        .scale_a = scale_a.data_ptr(),
+        .scale_b = scale_b.data_ptr(),
+        .scale_d = fp8_out ? scale_d.data_ptr() : nullptr,
+        .amax_d = amax_d.defined() ? amax_d.data_ptr() : nullptr,
+        .tensor_map_a = tensor_map_a,
+        .tensor_map_b = tensor_map_b,
+        .tensor_map_d = tensor_map_d,
+        .d_store_splits = d_store_splits,
+        .legacy = legacy,
+        .amax_bf16 = amax_bf16,
+        .c = c.defined() ? c.data_ptr() : nullptr,
+        .ldc = c.defined() ? static_cast<uint32_t>(c.stride(0)) : 0u,
+        .c2 = c2.defined() ? c2.data_ptr() : nullptr,
+        .c2_flags = c2_flags.defined() ? c2_flags.data_ptr() : nullptr,
+        .c2_piece_rows = static_cast<uint32_t>(c2_piece_rows), .c2_piece_cols = static_cast<uint32_t>(c2_piece_cols),
+    });
+}
