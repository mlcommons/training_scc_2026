+// Warp max of a non-negative per-thread amax, then one atomicMax per warp into
+// amax (fp32 bits compare as integers for non-negative values)
+CUTLASS_DEVICE void reduce_amax(float* amax, float value) {
+    // Ignore NaNs like the fmax reduction (a scale multiply can produce one).
+    // Non-negative IEEE-754 bits have exactly the same max ordering.
+    value = __uint_as_float(__reduce_max_sync(0xffffffff, __float_as_uint(fmaxf(value, 0.0f))));
+    if (amax != nullptr and cute::elect_one_sync() and value > 0.0f)
+        atomicMax(reinterpret_cast<int*>(amax), __float_as_int(value));
+}
