+            if constexpr (N == 184) return MMA_64x184x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 192) return MMA_64x192x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 200) return MMA_64x200x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 208) return MMA_64x208x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 216) return MMA_64x216x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 224) return MMA_64x224x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 232) return MMA_64x232x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 240) return MMA_64x240x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 248) return MMA_64x248x32_F32E4M3E4M3_SS_TN();
+            if constexpr (N == 256) return MMA_64x256x32_F32E4M3E4M3_SS_TN();
+        }
+        static_assert(N == 8 or N == 16 or N == 24 or N == 32 or N == 40 or N == 48 or
+                      N == 56 or N == 64 or N == 72 or N == 80 or N == 88 or N == 96 or
+                      N == 104 or N == 112 or N == 120 or N == 128 or N == 136 or
+                      N == 144 or N == 152 or N == 160 or N == 168 or N == 176 or
+                      N == 184 or N == 192 or N == 200 or N == 208 or N == 216 or
+                      N == 224 or N == 232 or N == 240 or N == 248 or N == 256,
+                      "Unsupported WGMMA N (e5m2 only supports 8/16/32/64/96/128/192/256)");
+    }
+
+    static constexpr auto select_type() {
+        return mma::sm90::FP8MMA<N, decltype(select_mma())>();
+    }
+
+    using type = decltype(select_type());
+};
+
+template <typename ab_a_dtype_t, typename ab_b_dtype_t,
+          uint32_t SHAPE_M, uint32_t SHAPE_N, uint32_t SHAPE_K,
+          uint32_t kNumGroups,
+          uint32_t BLOCK_M, uint32_t BLOCK_N, uint32_t BLOCK_K,
+          uint32_t kSwizzleAMode, uint32_t kSwizzleBMode, uint32_t kSwizzleDMode,
+          uint32_t kNumStages,
+          uint32_t kNumTMAThreads, uint32_t kNumMathThreads,
+          uint32_t kNumTMAMulticast, bool kIsTMAMulticastOnA,
+          uint32_t kNumSMs, GemmType kGemmType,
+          typename cd_dtype_t, uint32_t kDStoreSplits = 1,
+          bool kWithC = false, bool kWithC2 = false, bool kWaitC = false, bool kAmaxBF16 = false>
+CUTLASS_GLOBAL __launch_bounds__(kNumTMAThreads + kNumMathThreads, 1) void
+sm90_fp8_gemm_per_tensor_impl(const float* scale_a, const float* scale_b, const float* scale_d,
+                              float* amax_d,
+                              int* grouped_layout,
+                              uint32_t shape_m, uint32_t shape_n, uint32_t shape_k,
+                              const __grid_constant__ cute::TmaDescriptor tensor_map_a,
+                              const __grid_constant__ cute::TmaDescriptor tensor_map_b,
+                              const __grid_constant__ cute::TmaDescriptor tensor_map_d,
+                              const __nv_bfloat16* __restrict__ c_ptr = nullptr, uint32_t ldc = 0,
+                              const __nv_bfloat16* __restrict__ c2_ptr = nullptr,
+                              const uint32_t* __restrict__ c2_flags = nullptr,
+                              uint32_t c2_piece_rows = 0, uint32_t c2_piece_cols = 0) {
+#if (defined(__CUDA_ARCH__) and (__CUDA_ARCH__ >= 900)) or defined(__CLION_IDE__)
+    // C/D type: BF16, or e4m3 with a per-tensor output scale (scale_d, the
+    // output's FORWARD scale; payload = value * scale_d)
+    DG_STATIC_ASSERT(cute::is_same_v<cd_dtype_t, cutlass::bfloat16_t> or
+                     cute::is_same_v<cd_dtype_t, cutlass::float_e4m3_t>, "Invalid C/D data dtype");
+    constexpr bool kFP8Out = not cute::is_same_v<cd_dtype_t, cutlass::bfloat16_t>;
+    DG_STATIC_ASSERT((cute::is_same_v<ab_a_dtype_t, cutlass::float_e4m3_t> or
+                      cute::is_same_v<ab_a_dtype_t, cutlass::float_e5m2_t>) and
+                     (cute::is_same_v<ab_b_dtype_t, cutlass::float_e4m3_t> or
+                      cute::is_same_v<ab_b_dtype_t, cutlass::float_e5m2_t>), "Invalid A/B data dtype");
+    DG_STATIC_ASSERT(kGemmType == GemmType::Normal, "Per-tensor kernel only supports normal GEMM");
+    // Addends (UB_TCCL_EPI=4): BF16 C, then C2, added to the staged BF16 tile in the store phase -- which runs in the
+    // shadow of the next tile's WGMMAs -- with the legacy kernel's rounding (bf16(scale * acc) + C, then + C2).
+    // kWaitC / kWithC2 with flags: the last addend is staged by the copy engine and guarded per piece.
+    DG_STATIC_ASSERT(not ((kWithC or kWithC2 or kWaitC) and not cute::is_same_v<cd_dtype_t, cutlass::bfloat16_t>),
+                     "Addends need the BF16 output");
+    DG_STATIC_ASSERT(kWithC or not kWithC2, "The second addend rides the C addend path");
+    DG_STATIC_ASSERT(not kWaitC or (kWithC and not kWithC2), "kWaitC: the flags guard a single C addend");
+    // kAmaxBF16: amax_d receives max |D| of the bf16-rounded BF16 output (one atomicMax per warp)
+    DG_STATIC_ASSERT(not kAmaxBF16 or cute::is_same_v<cd_dtype_t, cutlass::bfloat16_t>, "kAmaxBF16 needs the BF16 output");
+    DG_STATIC_ASSERT(not kAmaxBF16 or not kWithC, "kAmaxBF16 does not combine with the addends");
+
+    // Types
+    using WGMMA = typename PerTensorMMASelector<BLOCK_N, ab_a_dtype_t, ab_b_dtype_t>::type;
+    using Barrier = cutlass::arch::ClusterTransactionBarrier;
+
+    // Layout: two math warp-groups, each owning one 64-row half of a
+    // BLOCK_M = 128 tile (one m64nBLOCK_Nk32 WGMMA per k-step), sharing the
+    // B stage. Each warp-group stores its own half of the output.
+    DG_STATIC_ASSERT(BLOCK_M == 2 * WGMMA::M and kNumMathThreads == 256, "Requires BLOCK_M = 128 with two math warp-groups");
+    DG_STATIC_ASSERT(kNumTMAMulticast == 1, "Per-tensor kernel is cluster-1 only");
+    DG_STATIC_ASSERT(kSwizzleDMode == 128, "Output staging uses the 128B-swizzled layout");
+
+    // Output staging: per warp-group, kAtomsPerSplit swizzle atoms of
+    // [64 rows x 128 bytes]. The tile is stored in kStoreSplits column
+    // splits that reuse the staging buffer (BF16 only; an FP8 tile fits).
+    constexpr uint32_t kOutElemBytes = kFP8Out ? 1 : 2;
+    constexpr uint32_t kAtomCols = 128 / kOutElemBytes;
+    constexpr uint32_t kStoreSplits = kFP8Out ? 1 : kDStoreSplits;
+    constexpr uint32_t kSplitCols = BLOCK_N / kStoreSplits;
+    DG_STATIC_ASSERT(BLOCK_N % kStoreSplits == 0 and kSplitCols % kAtomCols == 0, "Invalid D store split");
+    constexpr uint32_t kAtomsPerSplit = kSplitCols / kAtomCols;
+    constexpr uint32_t kAtomBytes = WGMMA::M * 128;
+    constexpr uint32_t kWGStagingBytes = kAtomsPerSplit * kAtomBytes;
+    static constexpr uint32_t SMEM_D_SIZE = 2 * kWGStagingBytes;
+    static constexpr uint32_t SMEM_A_SIZE_PER_STAGE = BLOCK_M * BLOCK_K * sizeof(ab_a_dtype_t);
+    static constexpr uint32_t SMEM_B_SIZE_PER_STAGE = BLOCK_N * BLOCK_K * sizeof(ab_b_dtype_t);
+    DG_STATIC_ASSERT(SMEM_D_SIZE % 1024 == 0, "Staging must keep the A/B stages 1024B-aligned");
+
+    // Overwrite shape constants if the compiler gives
+    shape_m = SHAPE_M != 0 ? SHAPE_M : shape_m;
+    shape_n = SHAPE_N != 0 ? SHAPE_N : shape_n;
+    shape_k = SHAPE_K != 0 ? SHAPE_K : shape_k;
+
+    // Configs
+    const uint32_t num_total_k_blocks = math::ceil_div(shape_k, BLOCK_K);
+    const uint32_t warp_idx = __shfl_sync(0xffffffff, threadIdx.x / 32, 0);
+    const uint32_t lane_idx = ptx::get_lane_idx();
+
+    // Prefetch TMA descriptors at the very beginning
+    if (warp_idx == kNumMathThreads / 32 and cute::elect_one_sync()) {
+        cute::prefetch_tma_descriptor(&tensor_map_a);
+        cute::prefetch_tma_descriptor(&tensor_map_b);
+        cute::prefetch_tma_descriptor(&tensor_map_d);
+    }
+    __syncwarp();
+
+    // Align to 1024 bytes for swizzle-128B
+    extern __shared__ __align__(1024) uint8_t smem_buffer[];
+
+    // Data on shared memory
+    auto smem_d = smem_buffer;
+    auto smem_a = utils::PatternVisitor([&](const uint32_t& i) {
+        return reinterpret_cast<ab_a_dtype_t*>(smem_buffer + SMEM_D_SIZE + i * SMEM_A_SIZE_PER_STAGE);
+    });
+    auto smem_b = utils::PatternVisitor([&](const uint32_t& i) {
+        return reinterpret_cast<ab_b_dtype_t*>(smem_buffer + SMEM_D_SIZE + kNumStages * SMEM_A_SIZE_PER_STAGE + i * SMEM_B_SIZE_PER_STAGE);
+    });
+
+    // Fill barriers
+    auto barrier_start_ptr = reinterpret_cast<Barrier*>(smem_buffer + SMEM_D_SIZE + kNumStages * (SMEM_A_SIZE_PER_STAGE + SMEM_B_SIZE_PER_STAGE));
+    auto full_barriers     = utils::PatternVisitor([&](const uint32_t& i) { return barrier_start_ptr + i; });
+    auto empty_barriers    = utils::PatternVisitor([&](const uint32_t& i) { return barrier_start_ptr + kNumStages + i; });
+    // WG0 -> WG1 issue ordering: WG0 arrives once it has issued a stage's WGMMAs
+    auto issued_barriers   = utils::PatternVisitor([&](const uint32_t& i) { return barrier_start_ptr + 2 * kNumStages + i; });
+
+    // Initialize barriers
+    if (warp_idx == kNumMathThreads / 32 + 1 and cute::elect_one_sync()) {
+        #pragma unroll
+        for (uint32_t i = 0; i < kNumStages; ++ i) {
+            full_barriers[i]->init(1);
+            empty_barriers[i]->init(kNumMathThreads / 32);
+            issued_barriers[i]->init(4);
+        }
+        // Make initialized barrier visible in async proxy
+        cutlass::arch::fence_barrier_init();
+    }
+
+    // Synchronize all threads to make barrier visible in normal memory model
+    __syncthreads();
+
+    // Register reconfigurations
+    // Math warp-groups hold accumulators (128) + the packed pending tile (64):
+    // give them 240 (2 x 128 x 240 + 128 x 24 = 64512 <= 65536)
+    constexpr uint32_t kNumTMARegisters = 40;
+    constexpr uint32_t kNumMathRegisters = 232;
+
+    // PDL (launched with enable_pdl): the setup above touches no global
+    // memory; wait for the upstream grid before any global read (A/B TMA
+    // loads, scale dereferences).
+    cudaGridDependencySynchronize();
+
+    // Block scheduler
+    uint32_t m_block_idx, n_block_idx;
+    auto scheduler = sched::Scheduler<kGemmType, BLOCK_M, BLOCK_N, kNumGroups, kNumTMAMulticast, kIsTMAMulticastOnA, kNumSMs>(shape_m, shape_n, shape_k, nullptr);
+
+    // Pipeline and TMA phases
+    uint32_t stage_idx = 0, phase = 0;
+    auto advance_pipeline = [&](uint32_t& k_block_idx) {
+        ++ k_block_idx;
+        // Flip phases only if reach the next first stage
+        stage_idx = stage_idx == kNumStages - 1 ? 0 : stage_idx + 1;
+        phase ^= stage_idx == 0;
+    };
+
+    if (warp_idx >= kNumMathThreads / 32) {
+        // TMA warp-group for loading data
+        cutlass::arch::warpgroup_reg_dealloc<kNumTMARegisters>();
+
+        // NOTES: only one thread (or warp) will be used
+        if (warp_idx == kNumMathThreads / 32 + 2 and cute::elect_one_sync()) {
+            // Persistently schedule over blocks
+            while (scheduler.get_next_block(m_block_idx, n_block_idx)) {
+                for (uint32_t k_block_idx = 0; k_block_idx < num_total_k_blocks; advance_pipeline(k_block_idx)) {
+                    // Wait consumer release
+                    empty_barriers[stage_idx]->wait(phase ^ 1);
+
+                    // Issue TMA A and B
+                    auto& full_barrier = *full_barriers[stage_idx];
+                    const uint32_t k_idx = k_block_idx * BLOCK_K;
+                    tma::copy<BLOCK_K, BLOCK_M, kSwizzleAMode, ab_a_dtype_t>(&tensor_map_a, &full_barrier,
+                             smem_a[stage_idx], k_idx, m_block_idx * BLOCK_M, 1, 0);
+                    tma::copy<BLOCK_K, BLOCK_N, kSwizzleBMode, ab_b_dtype_t>(&tensor_map_b, &full_barrier,
+                             smem_b[stage_idx], k_idx, n_block_idx * BLOCK_N, 1, 0);
+                    full_barrier.arrive_and_expect_tx(SMEM_A_SIZE_PER_STAGE + SMEM_B_SIZE_PER_STAGE);
+                }
+            }
+        }
+    } else {
+        // Math warp-groups for WGMMA
+        cutlass::arch::warpgroup_reg_alloc<kNumMathRegisters>();
+
+        // NOTES: use `__shfl_sync` to encourage NVCC to use unified registers
+        const auto math_wg_idx = __shfl_sync(0xffffffff, threadIdx.x / 128, 0);
+        const auto warp_in_wg = warp_idx % 4;
+
+        auto a_desc = mma::sm90::make_smem_desc(smem_a[0] + math_wg_idx * WGMMA::M * BLOCK_K, 1);
+        auto b_desc = mma::sm90::make_smem_desc(smem_b[0], 1);
+        const uint32_t a_desc_lo = __shfl_sync(0xffffffff, a_desc.reg32_[0], 0);
+        const uint32_t b_desc_lo = __shfl_sync(0xffffffff, b_desc.reg32_[0], 0);
+
+        // One accumulator set (64 x BLOCK_N per warp-group), reused across all k-blocks
+        float accum[WGMMA::kNumAccum];
+
+        // Issue one k-block's WGMMA group (one full-width m64nBLOCK_Nk32 per k-step)
+        auto issue_k_block = [&](const uint32_t& s, const bool& first_k_block) {
+            const auto a_base_lo = a_desc_lo + s * (SMEM_A_SIZE_PER_STAGE / 16);
+            const auto b_base_lo = b_desc_lo + s * (SMEM_B_SIZE_PER_STAGE / 16);
+            #pragma unroll
+            for (uint32_t i = 0; i < WGMMA::kNumAccum; ++ i)
+                ptx::warpgroup_fence_operand(accum[i]);
+            ptx::warpgroup_arrive();
+            #pragma unroll
+            for (uint32_t k = 0; k < BLOCK_K / WGMMA::K; ++ k) {
+                a_desc.reg32_[0] = a_base_lo + (k * WGMMA::K) / 16;
+                b_desc.reg32_[0] = b_base_lo + (k * WGMMA::K) / 16;
+                // Scale-D zero only on the first k-step of a tile
+                WGMMA::wgmma(a_desc, b_desc, accum, not first_k_block or k > 0);
+            }
+            ptx::warpgroup_commit_batch();
+            #pragma unroll
+            for (uint32_t i = 0; i < WGMMA::kNumAccum; ++ i)
+                ptx::warpgroup_fence_operand(accum[i]);
+        };
+
+        // Wait for a stage's data, then issue it. WG1 issues each stage only
+        // after WG0 has: the tensor pipe then runs WG0's group before WG1's,
+        // so the two warp-groups' tile boundaries are ~half a k-block apart
+        // and each boundary (drain, convert, next tile's first issue) runs in
+        // the shadow of the other warp-group's queued group.
+        auto const ready_barrier_start = barrier_start_ptr + (math_wg_idx == 0 ? 0 : 2 * kNumStages);
+        auto wait_and_issue = [&](const bool& first_k_block) {
+            // WG0 acquires the TMA completion before releasing issued. WG1's
+            // acquire of issued therefore also observes the completed TMA;
+            // waiting on full again is redundant. Keep all four WG0 arrivals
+            // and both WGs' empty credits so a stage cannot be reused early.
+            ready_barrier_start[stage_idx].wait(phase);
+            issue_k_block(stage_idx, first_k_block);
+            if (math_wg_idx == 0 and lane_idx == 0)
+                issued_barriers[stage_idx]->arrive();
+        };
+
+        // Packed output fragments of the previous tile: converted right after
+        // its mainloop (freeing `accum` for the next tile), then written out
+        // DURING the next tile's mainloop, in the shadow of its WGMMAs.
+        // Per 8-column chunk i: BF16 holds {row r, row r + 8} bf16x2 words;
+        // FP8 holds one word {lo16: row r e4m3x2, hi16: row r + 8 e4m3x2}.
+        constexpr uint32_t kNumChunks = BLOCK_N / 8;
+        constexpr uint32_t kNumPacked = kFP8Out ? kNumChunks : kNumChunks * 2;
+        constexpr uint32_t kChunksPerSplit = kNumChunks / kStoreSplits;
+        uint32_t packed[kNumPacked];
+        bool has_pending = false;
+        uint32_t pending_m_idx = 0, pending_n_idx = 0;
+
+        // Empty barrier arrival for a given stage
+        auto empty_barrier_arrive_at = [&](const uint32_t& s) {
+            lane_idx == 0 ? empty_barriers[s]->arrive() : void();
+        };
+
+        // Per-tensor scales (dequant multipliers).
+        // FP8 output: scale_d is the output's FORWARD scale (payload = value * scale_d).
+        const float output_scale = scale_a[0] * scale_b[0];
+        const float output_scale_d = kFP8Out ? scale_d[0] : 1.0f;
+        // FP8 output: max |accumulator| of this thread (amax_d = max |value|)
+        float amax_thr = 0.0f;
+        __nv_bfloat162 amax_bf16 = __float2bfloat162_rn(0.0f);
+
+        // Store one column split of the pending tile: registers -> swizzled
+        // staging (this warp-group's half) -> TMA store
+        const bool is_store_leader = warp_in_wg == 0 and lane_idx == 0;
+        const uint32_t named_barrier_idx = 2 + math_wg_idx;
+        uint8_t* wg_staging = smem_d + math_wg_idx * kWGStagingBytes;
+        auto store_split = [&](const uint32_t& split_idx) {
+            // The previous TMA store from this staging buffer must have finished reading it
+            if (is_store_leader)
+                cute::tma_store_wait<0>();
+            if constexpr (kWithC2 or kWaitC) {
+                // Staged last addend: wait for this split's piece before the barrier releases the warp-group
+                if (c2_flags != nullptr and is_store_leader) {
+                    const uint32_t pieces_per_row = (shape_n + c2_piece_cols - 1) / c2_piece_cols;
+                    const uint32_t piece = (pending_m_idx * BLOCK_M + math_wg_idx * WGMMA::M) / c2_piece_rows * pieces_per_row +
+                                           (pending_n_idx * BLOCK_N + split_idx * kSplitCols) / c2_piece_cols;
+                    uint32_t ready = 0;
+                    do {
+                        asm volatile("ld.acquire.gpu.global.b32 %0, [%1];" : "=r"(ready) : "l"(c2_flags + piece) : "memory");
+                    } while (ready == 0);
+                }
+            }
+            cutlass::arch::NamedBarrier::sync(128, named_barrier_idx);
+
+            #pragma unroll
+            for (uint32_t c = 0; c < kChunksPerSplit; ++ c) {
+                const uint32_t i = split_idx * kChunksPerSplit + c;
+                const uint32_t col = c * 8;  // column (elements) within the split
+                if constexpr (kFP8Out) {
+                    // Pair lanes (L, L ^ 1) exchange one e4m3x2 half each so every
+                    // lane owns 4 consecutive columns of one row (32-bit stores).
+                    // Even lanes keep row r (cols c..c+3), odd lanes row r + 8.
+                    if (c % 2 == 1)
+                        continue;
+                    const uint32_t p0 = packed[i], p1 = packed[i + 1];
+                    const bool odd = lane_idx & 1;
+                    const uint32_t send = odd ? __byte_perm(p0, p1, 0x5410) : __byte_perm(p0, p1, 0x7632);
+                    const uint32_t recv = __shfl_xor_sync(0xffffffff, send, 1);
+                    const uint32_t w0 = odd ? __byte_perm(recv, p0, 0x7610) : __byte_perm(p0, recv, 0x5410);
+                    const uint32_t w1 = odd ? __byte_perm(recv, p1, 0x7632) : __byte_perm(p1, recv, 0x7610);
+                    const uint32_t row = warp_in_wg * 16 + lane_idx / 4 + (odd ? 8 : 0);
+                    #pragma unroll
+                    for (uint32_t j = 0; j < 2; ++ j) {
+                        const uint32_t col_byte = col + j * 8 + ((lane_idx % 4) / 2) * 4;
+                        const uint32_t atom = col_byte / 128, in_atom = col_byte % 128;
+                        const uint32_t piece = (in_atom / 16) ^ (row % 8);
+                        auto ptr = wg_staging + atom * kAtomBytes + row * 128 + piece * 16 + in_atom % 16;
+                        ptx::st_shared(reinterpret_cast<uint32_t*>(ptr), j == 0 ? w0 : w1);
+                    }
+                } else {
+                    // STSM x2: lanes 0-7 address rows r..r+7 (matrix 0), lanes 8-15 rows r+8..r+15
+                    const uint32_t row = warp_in_wg * 16 + lane_idx % 16;
+                    const uint32_t atom = col / kAtomCols;
+                    const uint32_t piece = ((col % kAtomCols) / 8) ^ (row % 8);
+                    auto ptr = wg_staging + atom * kAtomBytes + row * 128 + piece * 16;
+                    ptx::SM90_U32x2_STSM_N<uint32_t>::copy(packed[i * 2], packed[i * 2 + 1], ptr);
+                }
+            }
+            if constexpr (kWithC) {
+                // The split is staged: consecutive threads add consecutive 16-byte vectors of a row (coalesced global
+                // reads) into their swizzled staging location, as the legacy kernel's epilogue does
+                cutlass::arch::NamedBarrier::sync(128, named_barrier_idx);
+                constexpr uint32_t kVecsPerRow = kSplitCols / 8;
+                constexpr uint32_t kNumVecs = WGMMA::M * kVecsPerRow;
+                DG_STATIC_ASSERT(kNumVecs % 128 == 0, "Invalid addend split");
+                const uint32_t m_base = pending_m_idx * BLOCK_M + math_wg_idx * WGMMA::M;
+                const uint32_t n_base = pending_n_idx * BLOCK_N + split_idx * kSplitCols;
+                #pragma unroll 4
+                for (uint32_t v = threadIdx.x % 128; v < kNumVecs; v += 128) {
+                    const uint32_t r = v / kVecsPerRow, col = (v % kVecsPerRow) * 8;
+                    const uint32_t piece = ((col % kAtomCols) / 8) ^ (r % 8);
+                    auto staged = wg_staging + (col / kAtomCols) * kAtomBytes + r * 128 + piece * 16;
+                    const auto* c_vec = reinterpret_cast<const uint4*>(c_ptr + static_cast<size_t>(m_base + r) * ldc + n_base + col);
+                    const auto c = kWaitC ? __ldcg(c_vec) : __ldg(c_vec);
+                    uint4 d = *reinterpret_cast<uint4*>(staged);
+                    auto* dh = reinterpret_cast<__nv_bfloat162*>(&d);
+                    const auto* ch = reinterpret_cast<const __nv_bfloat162*>(&c);
+                    #pragma unroll
+                    for (int q = 0; q < 4; ++ q) dh[q] = __hadd2(dh[q], ch[q]);
+                    if constexpr (kWithC2) {
+                        const auto c2 = __ldcg(reinterpret_cast<const uint4*>(
+                            c2_ptr + static_cast<size_t>(m_base + r) * ldc + n_base + col));
+                        const auto* c2h = reinterpret_cast<const __nv_bfloat162*>(&c2);
+                        #pragma unroll
+                        for (int q = 0; q < 4; ++ q) dh[q] = __hadd2(dh[q], c2h[q]);
+                    }
+                    *reinterpret_cast<uint4*>(staged) = d;
+                }
+            }
+            cute::tma_store_fence();
+            cutlass::arch::NamedBarrier::sync(128, named_barrier_idx);
+
+            if (is_store_leader) {
+                const uint32_t m_idx = pending_m_idx * BLOCK_M + math_wg_idx * WGMMA::M;
+                #pragma unroll
+                for (uint32_t atom = 0; atom < kAtomsPerSplit; ++ atom) {
+                    const uint32_t n_idx = pending_n_idx * BLOCK_N + split_idx * kSplitCols + atom * kAtomCols;
+                    cute::SM90_TMA_STORE_2D::copy(&tensor_map_d, wg_staging + atom * kAtomBytes, n_idx, m_idx);
+                }
+                cute::tma_store_arrive();
+            }
+        };
+
+        // Stores of the pending tile are spread over the next tile's k-blocks 1, 3, ...
+        constexpr uint32_t kSplitStoreStride = 2;
+        auto split_store_k_block = [](const uint32_t& s) { return 1 + s * kSplitStoreStride; };
+
+        // Convert the accumulators into `packed` (frees them for the next tile)
+        auto convert_accum = [&]() {
+            #pragma unroll
+            for (uint32_t i = 0; i < kNumChunks; ++ i) {
+                if constexpr (kFP8Out) {
+                    // payload = value * scale_ab * scale_d (satfinite)
+                    const float s = output_scale * output_scale_d;
+                    amax_thr = fmaxf(amax_thr, fmaxf(fmaxf(fabsf(accum[i * 4 + 0]), fabsf(accum[i * 4 + 1])),
+                                                     fmaxf(fabsf(accum[i * 4 + 2]), fabsf(accum[i * 4 + 3]))));
+                    const auto lo = __nv_cvt_float2_to_fp8x2({accum[i * 4 + 0] * s, accum[i * 4 + 1] * s}, __NV_SATFINITE, __NV_E4M3);
+                    const auto hi = __nv_cvt_float2_to_fp8x2({accum[i * 4 + 2] * s, accum[i * 4 + 3] * s}, __NV_SATFINITE, __NV_E4M3);
+                    packed[i] = static_cast<uint32_t>(lo) | (static_cast<uint32_t>(hi) << 16);
+                } else {
+                    // Apply the per-tensor dequant scale in the epilogue (single multiply)
+                    const auto lo = __float22bfloat162_rn({accum[i * 4 + 0] * output_scale, accum[i * 4 + 1] * output_scale});
+                    const auto hi = __float22bfloat162_rn({accum[i * 4 + 2] * output_scale, accum[i * 4 + 3] * output_scale});
+                    if constexpr (kAmaxBF16)
+                        amax_bf16 = __hmax2(amax_bf16, __hmax2(__habs2(lo), __habs2(hi)));
+                    packed[i * 2 + 0] = *reinterpret_cast<const uint32_t*>(&lo);
+                    packed[i * 2 + 1] = *reinterpret_cast<const uint32_t*>(&hi);
+                }
+            }
+        };
+
+        // Persistently schedule over blocks. The next tile's indices are
+        // computed inside the current mainloop (k-block 2), off the
+        // tile-to-tile critical path. K-block 0 of every tile is issued by the
+        // previous iteration's boundary code (or the prologue below).
+        uint32_t next_m_block_idx = 0, next_n_block_idx = 0, unused_k_counter = 0;
+        bool has_tile = scheduler.get_next_block(m_block_idx, n_block_idx);
+        if (has_tile)
+            wait_and_issue(true);
+        while (has_tile) {
+            bool next_valid = false, fetched_next = false;
+            uint32_t prev_stage = stage_idx;
+            advance_pipeline(unused_k_counter);
+
+            #pragma unroll 2
+            for (uint32_t k_block_idx = 1; k_block_idx < num_total_k_blocks; ++ k_block_idx) {
+                wait_and_issue(false);
+
+                // Previous tile's output and the next tile's indices, in the
+                // shadow of the WGMMAs just issued
+                if (has_pending) {
+                    #pragma unroll
+                    for (uint32_t s = 0; s < kStoreSplits; ++ s)
+                        if (k_block_idx == split_store_k_block(s))
+                            store_split(s);
+                }
+                if (k_block_idx == 2)
+                    next_valid = scheduler.get_next_block(next_m_block_idx, next_n_block_idx), fetched_next = true;
+
+                // The previous k-block's group has completed: release its stage
+                ptx::warpgroup_wait<1>();
+                empty_barrier_arrive_at(prev_stage);
+                prev_stage = stage_idx;
+                advance_pipeline(unused_k_counter);
+            }
+
+            // Flush pending splits a short mainloop did not reach (`packed` is reused below)
+            if (has_pending) {
+                #pragma unroll
+                for (uint32_t s = 0; s < kStoreSplits; ++ s)
+                    if (split_store_k_block(s) >= num_total_k_blocks)
+                        store_split(s);
+            }
+            if (not fetched_next)
+                next_valid = scheduler.get_next_block(next_m_block_idx, next_n_block_idx);
+
+            // Tile boundary: drain, convert, issue the next tile's first k-block
+            ptx::warpgroup_wait<0>();
+            empty_barrier_arrive_at(prev_stage);
+            convert_accum();
+            has_pending = true;
+            pending_m_idx = m_block_idx, pending_n_idx = n_block_idx;
+            if (next_valid)
+                wait_and_issue(true);
+            has_tile = next_valid;
+            m_block_idx = next_m_block_idx, n_block_idx = next_n_block_idx;
+        }
+
+        // Last tile: nothing left to overlap with
+        if (has_pending) {
+            #pragma unroll
+            for (uint32_t s = 0; s < kStoreSplits; ++ s)
+                store_split(s);
+        }
+        if (is_store_leader)
+            cute::tma_store_wait<0>();
+        if constexpr (kFP8Out)
+            reduce_amax(amax_d, amax_thr * output_scale);
+        if constexpr (kAmaxBF16)
+            reduce_amax(amax_d, fmaxf(__bfloat162float(amax_bf16.x), __bfloat162float(amax_bf16.y)));
+    }
+#else
+    if (blockIdx.x == 0 and threadIdx.x == 0)
+        DG_DEVICE_ASSERT(false and "This kernel only support sm_90a");
+#endif
+}
+
+// 192 x BLOCK_N tile with three math warp-groups (64 rows each, sharing the
+// B stage), which loads fewer operand bytes per FLOP than a 128-row tile.
+// The CTA is the 384 math threads only (a 512-thread CTA would cap every
+// thread at 128 registers, below what a 128-accumulator WGMMA needs). TMA
+// refills are issued in-band: the warp that releases a stage last (smem
+// counter) refills it with the k-block kNumStages steps ahead. Each
+// warp-group converts and stores its own 64-row slice right after its
+// mainloop. Warp-groups whose rows lie entirely past M skip their WGMMAs and
+// stores.
+template <typename ab_a_dtype_t, typename ab_b_dtype_t,
+          uint32_t SHAPE_M, uint32_t SHAPE_N, uint32_t SHAPE_K,
+          uint32_t kNumGroups,
+          uint32_t BLOCK_M, uint32_t BLOCK_N, uint32_t BLOCK_K,
+          uint32_t kSwizzleAMode, uint32_t kSwizzleBMode, uint32_t kSwizzleDMode,
+          uint32_t kNumStages,
+          uint32_t kNumTMAThreads, uint32_t kNumMathThreads,
+          uint32_t kNumTMAMulticast, bool kIsTMAMulticastOnA,
+          uint32_t kNumSMs, GemmType kGemmType,
+          typename cd_dtype_t, uint32_t kDStoreSplits = 1>
+CUTLASS_GLOBAL __launch_bounds__(kNumMathThreads, 1) void
+sm90_fp8_gemm_per_tensor_3wg_impl(const float* scale_a, const float* scale_b, const float* scale_d,
+                                  float* amax_d,
+                                  int* grouped_layout,
+                                  uint32_t shape_m, uint32_t shape_n, uint32_t shape_k,
+                                  const __grid_constant__ cute::TmaDescriptor tensor_map_a,
+                                  const __grid_constant__ cute::TmaDescriptor tensor_map_b,
+                                  const __grid_constant__ cute::TmaDescriptor tensor_map_d) {
+#if (defined(__CUDA_ARCH__) and (__CUDA_ARCH__ >= 900)) or defined(__CLION_IDE__)
+    DG_STATIC_ASSERT(cute::is_same_v<cd_dtype_t, cutlass::bfloat16_t> or
+                     cute::is_same_v<cd_dtype_t, cutlass::float_e4m3_t>, "Invalid C/D data dtype");
+    constexpr bool kFP8Out = not cute::is_same_v<cd_dtype_t, cutlass::bfloat16_t>;
+    DG_STATIC_ASSERT(kGemmType == GemmType::Normal, "Per-tensor kernel only supports normal GEMM");
+
+    using WGMMA = typename PerTensorMMASelector<BLOCK_N, ab_a_dtype_t, ab_b_dtype_t>::type;
+    using Barrier = cutlass::arch::ClusterTransactionBarrier;
+    constexpr uint32_t kNumMathWGs = BLOCK_M / WGMMA::M;
+    constexpr uint32_t kNumMathWarps = kNumMathThreads / 32;
+    DG_STATIC_ASSERT(BLOCK_M % WGMMA::M == 0 and kNumMathThreads == kNumMathWGs * 128, "One math warp-group per 64 rows");
+    DG_STATIC_ASSERT(kNumTMAThreads == 0, "In-band TMA issue: no producer warp-group");
+    DG_STATIC_ASSERT(kNumTMAMulticast == 1, "Per-tensor kernel is cluster-1 only");
+    DG_STATIC_ASSERT(kSwizzleDMode == 128, "Output staging uses the 128B-swizzled layout");
+
+    // Output staging per warp-group: kAtomsPerSplit atoms of [64 rows x 128 bytes];
+    // BF16 tiles are stored in kDStoreSplits sequential column splits
+    constexpr uint32_t kOutElemBytes = kFP8Out ? 1 : 2;
+    constexpr uint32_t kAtomCols = 128 / kOutElemBytes;
+    constexpr uint32_t kStoreSplits = kFP8Out ? 1 : kDStoreSplits;
+    constexpr uint32_t kSplitCols = BLOCK_N / kStoreSplits;
+    DG_STATIC_ASSERT(BLOCK_N % kStoreSplits == 0 and kSplitCols % kAtomCols == 0, "Invalid D store split");
+    constexpr uint32_t kAtomsPerSplit = kSplitCols / kAtomCols;
+    constexpr uint32_t kAtomBytes = WGMMA::M * 128;
+    constexpr uint32_t kWGStagingBytes = kAtomsPerSplit * kAtomBytes;
+    static constexpr uint32_t SMEM_D_SIZE = kNumMathWGs * kWGStagingBytes;
+    static constexpr uint32_t SMEM_A_SIZE_PER_STAGE = BLOCK_M * BLOCK_K * sizeof(ab_a_dtype_t);
+    static constexpr uint32_t SMEM_B_SIZE_PER_STAGE = BLOCK_N * BLOCK_K * sizeof(ab_b_dtype_t);
+    DG_STATIC_ASSERT(SMEM_D_SIZE % 1024 == 0 and SMEM_A_SIZE_PER_STAGE % 1024 == 0, "Stages must stay 1024B-aligned");
+
+    shape_m = SHAPE_M != 0 ? SHAPE_M : shape_m;
+    shape_n = SHAPE_N != 0 ? SHAPE_N : shape_n;
+    shape_k = SHAPE_K != 0 ? SHAPE_K : shape_k;
+
+    const uint32_t num_total_k_blocks = math::ceil_div(shape_k, BLOCK_K);
+    const uint32_t warp_idx = __shfl_sync(0xffffffff, threadIdx.x / 32, 0);
+    const uint32_t lane_idx = ptx::get_lane_idx();
+
+    if (warp_idx == 0 and cute::elect_one_sync()) {
+        cute::prefetch_tma_descriptor(&tensor_map_a);
+        cute::prefetch_tma_descriptor(&tensor_map_b);
+        cute::prefetch_tma_descriptor(&tensor_map_d);
+    }
+    __syncwarp();
+
+    extern __shared__ __align__(1024) uint8_t smem_buffer[];
+    auto smem_d = smem_buffer;
+    auto smem_a = utils::PatternVisitor([&](const uint32_t& i) {
+        return reinterpret_cast<ab_a_dtype_t*>(smem_buffer + SMEM_D_SIZE + i * SMEM_A_SIZE_PER_STAGE);
+    });
+    auto smem_b = utils::PatternVisitor([&](const uint32_t& i) {
+        return reinterpret_cast<ab_b_dtype_t*>(smem_buffer + SMEM_D_SIZE + kNumStages * SMEM_A_SIZE_PER_STAGE + i * SMEM_B_SIZE_PER_STAGE);
+    });
+    auto barrier_start_ptr = reinterpret_cast<Barrier*>(smem_buffer + SMEM_D_SIZE + kNumStages * (SMEM_A_SIZE_PER_STAGE + SMEM_B_SIZE_PER_STAGE));
+    auto full_barriers = utils::PatternVisitor([&](const uint32_t& i) { return barrier_start_ptr + i; });
+    // Per-stage release counters (warps done reading the stage)
+    auto release_counters = reinterpret_cast<uint32_t*>(barrier_start_ptr + kNumStages);
+
+    if (warp_idx == 1 and cute::elect_one_sync()) {
+        #pragma unroll
+        for (uint32_t i = 0; i < kNumStages; ++ i) {
+            full_barriers[i]->init(1);
+            release_counters[i] = 0;
+        }
+        cutlass::arch::fence_barrier_init();
+    }
+    __syncthreads();
+
+    // PDL: no global reads above this point
+    cudaGridDependencySynchronize();
+
+    // Every warp runs the same deterministic tile sequence
+    auto scheduler = sched::Scheduler<kGemmType, BLOCK_M, BLOCK_N, kNumGroups, kNumTMAMulticast, kIsTMAMulticastOnA, kNumSMs>(shape_m, shape_n, shape_k, nullptr);
+    uint32_t m_block_idx = 0, n_block_idx = 0, next_m_block_idx = 0, next_n_block_idx = 0;
+    bool has_tile = scheduler.get_next_block(m_block_idx, n_block_idx);
+    bool next_valid = false;
+
+    auto issue_load = [&](const uint32_t& s, const uint32_t& m_blk, const uint32_t& n_blk, const uint32_t& k_blk) {
+        auto& full_barrier = *full_barriers[s];
+        // Rows past M are zero-filled by TMA (and still counted in the transaction bytes)
+        tma::copy<BLOCK_K, BLOCK_M, kSwizzleAMode, ab_a_dtype_t>(&tensor_map_a, &full_barrier,
+                 smem_a[s], k_blk * BLOCK_K, m_blk * BLOCK_M, 1, 0);
+        tma::copy<BLOCK_K, BLOCK_N, kSwizzleBMode, ab_b_dtype_t>(&tensor_map_b, &full_barrier,
+                 smem_b[s], k_blk * BLOCK_K, n_blk * BLOCK_N, 1, 0);
+        full_barrier.arrive_and_expect_tx(SMEM_A_SIZE_PER_STAGE + SMEM_B_SIZE_PER_STAGE);
+    };
+
+    // Prologue: fill the pipeline with the first tile's first kNumStages k-blocks
+    DG_STATIC_ASSERT(kNumStages >= 2, "Need at least two stages");
+    if (warp_idx == 0 and lane_idx == 0 and has_tile) {
+        #pragma unroll
+        for (uint32_t s = 0; s < kNumStages; ++ s)
+            if (s < num_total_k_blocks)
+                issue_load(s, m_block_idx, n_block_idx, s);
+    }
+
+    // Release the stage of k-block `k_blk` of the current tile; the last of the
+    // kNumMathWarps warps refills it with the k-block kNumStages steps ahead
+    // (in this tile, or in the next one).
+    auto release_stage = [&](const uint32_t& s, const uint32_t& k_blk) {
+        if (lane_idx == 0) {
+            if (atomicAdd(release_counters + s, 1) == kNumMathWarps - 1) {
+                release_counters[s] = 0;
+                const uint32_t target = k_blk + kNumStages;
+                if (target < num_total_k_blocks)
+                    issue_load(s, m_block_idx, n_block_idx, target);
+                else if (next_valid and target - num_total_k_blocks < num_total_k_blocks)
+                    issue_load(s, next_m_block_idx, next_n_block_idx, target - num_total_k_blocks);
+            }
+        }
+        __syncwarp();
+    };
+
+    const auto math_wg_idx = __shfl_sync(0xffffffff, threadIdx.x / 128, 0);
+    const auto warp_in_wg = warp_idx % 4;
+    auto a_desc = mma::sm90::make_smem_desc(smem_a[0] + math_wg_idx * WGMMA::M * BLOCK_K, 1);
+    auto b_desc = mma::sm90::make_smem_desc(smem_b[0], 1);
+    const uint32_t a_desc_lo = __shfl_sync(0xffffffff, a_desc.reg32_[0], 0);
+    const uint32_t b_desc_lo = __shfl_sync(0xffffffff, b_desc.reg32_[0], 0);
+
+    float accum[WGMMA::kNumAccum];
+    constexpr uint32_t kNumChunks = BLOCK_N / 8;
+    constexpr uint32_t kChunksPerSplit = kNumChunks / kStoreSplits;
+
+    const float output_scale = scale_a[0] * scale_b[0];
+    const float output_scale_d = kFP8Out ? scale_d[0] : 1.0f;
+    // FP8 output: max |accumulator| of this thread (amax_d = max |value|)
+    float amax_thr = 0.0f;
+
+    const bool is_store_leader = warp_in_wg == 0 and lane_idx == 0;
+    const uint32_t named_barrier_idx = 2 + math_wg_idx;
+    uint8_t* wg_staging = smem_d + math_wg_idx * kWGStagingBytes;
+
+    uint32_t stage_idx = 0, phase = 0;
+    while (has_tile) {
+        // Warp-groups entirely past M only keep the stage protocol going
+        const bool wg_valid = m_block_idx * BLOCK_M + math_wg_idx * WGMMA::M < shape_m;
+        // The next tile's indices are needed before the first cross-tile refill
+        // (k-block num_total_k_blocks - kNumStages); fetched at k-block 0.
+        next_valid = scheduler.get_next_block(next_m_block_idx, next_n_block_idx);
+
+        uint32_t prev_stage = 0;
+        #pragma unroll 2
+        for (uint32_t k_block_idx = 0; k_block_idx < num_total_k_blocks; ++ k_block_idx) {
+            const auto a_desc_base_lo = a_desc_lo + stage_idx * (SMEM_A_SIZE_PER_STAGE / 16);
+            const auto b_desc_base_lo = b_desc_lo + stage_idx * (SMEM_B_SIZE_PER_STAGE / 16);
+
+            full_barriers[stage_idx]->wait(phase);
+            if (wg_valid) {
+                #pragma unroll
+                for (uint32_t i = 0; i < WGMMA::kNumAccum; ++ i)
+                    ptx::warpgroup_fence_operand(accum[i]);
+                ptx::warpgroup_arrive();
+                #pragma unroll
+                for (uint32_t k = 0; k < BLOCK_K / WGMMA::K; ++ k) {
+                    a_desc.reg32_[0] = a_desc_base_lo + (k * WGMMA::K) / 16;
+                    b_desc.reg32_[0] = b_desc_base_lo + (k * WGMMA::K) / 16;
+                    WGMMA::wgmma(a_desc, b_desc, accum, k_block_idx > 0 or k > 0);
+                }
+                ptx::warpgroup_commit_batch();
+                #pragma unroll
+                for (uint32_t i = 0; i < WGMMA::kNumAccum; ++ i)
+                    ptx::warpgroup_fence_operand(accum[i]);
+                if (k_block_idx >= 1)
+                    ptx::warpgroup_wait<1>();
+            }
+            // The previous k-block's group has completed: release (and maybe refill) its stage
+            if (k_block_idx >= 1)
+                release_stage(prev_stage, k_block_idx - 1);
+            prev_stage = stage_idx;
+            stage_idx = stage_idx == kNumStages - 1 ? 0 : stage_idx + 1;
+            phase ^= stage_idx == 0;
+        }
+        ptx::warpgroup_wait<0>();
+        release_stage(prev_stage, num_total_k_blocks - 1);
+
+        if (wg_valid) {
+            // Epilogue: registers -> swizzled staging (this warp-group's 64 rows) -> TMA store
+            const uint32_t m_idx = m_block_idx * BLOCK_M + math_wg_idx * WGMMA::M;
+            #pragma unroll
+            for (uint32_t split_idx = 0; split_idx < kStoreSplits; ++ split_idx) {
+                // The previous TMA store from this staging buffer must have finished reading it
+                if (is_store_leader)
+                    cute::tma_store_wait<0>();
+                cutlass::arch::NamedBarrier::sync(128, named_barrier_idx);
+
+                #pragma unroll
+                for (uint32_t c = 0; c < kChunksPerSplit; ++ c) {
+                    const uint32_t i = split_idx * kChunksPerSplit + c;
+                    const uint32_t col = c * 8;
+                    if constexpr (kFP8Out) {
+                        // Pair lanes (L, L ^ 1) exchange one e4m3x2 half each: every lane
+                        // then owns 4 consecutive columns of one row (32-bit stores).
+                        if (c % 2 == 1)
+                            continue;
+                        const float s = output_scale * output_scale_d;
+                        uint32_t p[2];
+                        #pragma unroll
+                        for (uint32_t j = 0; j < 2; ++ j) {
+                            amax_thr = fmaxf(amax_thr, fmaxf(fmaxf(fabsf(accum[(i + j) * 4 + 0]), fabsf(accum[(i + j) * 4 + 1])),
+                                                             fmaxf(fabsf(accum[(i + j) * 4 + 2]), fabsf(accum[(i + j) * 4 + 3]))));
+                            const auto lo = __nv_cvt_float2_to_fp8x2({accum[(i + j) * 4 + 0] * s, accum[(i + j) * 4 + 1] * s}, __NV_SATFINITE, __NV_E4M3);
+                            const auto hi = __nv_cvt_float2_to_fp8x2({accum[(i + j) * 4 + 2] * s, accum[(i + j) * 4 + 3] * s}, __NV_SATFINITE, __NV_E4M3);
+                            p[j] = static_cast<uint32_t>(lo) | (static_cast<uint32_t>(hi) << 16);
+                        }
+                        const bool odd = lane_idx & 1;
+                        const uint32_t send = odd ? __byte_perm(p[0], p[1], 0x5410) : __byte_perm(p[0], p[1], 0x7632);
+                        const uint32_t recv = __shfl_xor_sync(0xffffffff, send, 1);
+                        const uint32_t w0 = odd ? __byte_perm(recv, p[0], 0x7610) : __byte_perm(p[0], recv, 0x5410);
+                        const uint32_t w1 = odd ? __byte_perm(recv, p[1], 0x7632) : __byte_perm(p[1], recv, 0x7610);
+                        const uint32_t row = warp_in_wg * 16 + lane_idx / 4 + (odd ? 8 : 0);
+                        #pragma unroll
+                        for (uint32_t j = 0; j < 2; ++ j) {
+                            const uint32_t col_byte = col + j * 8 + ((lane_idx % 4) / 2) * 4;
+                            const uint32_t atom = col_byte / 128, in_atom = col_byte % 128;
+                            const uint32_t piece = (in_atom / 16) ^ (row % 8);
+                            auto ptr = wg_staging + atom * kAtomBytes + row * 128 + piece * 16 + in_atom % 16;
+                            ptx::st_shared(reinterpret_cast<uint32_t*>(ptr), j == 0 ? w0 : w1);
+                        }
+                    } else {
+                        const auto lo = __float22bfloat162_rn({accum[i * 4 + 0] * output_scale, accum[i * 4 + 1] * output_scale});
+                        const auto hi = __float22bfloat162_rn({accum[i * 4 + 2] * output_scale, accum[i * 4 + 3] * output_scale});
+                        const uint32_t row = warp_in_wg * 16 + lane_idx % 16;
+                        const uint32_t atom = col / kAtomCols;
+                        const uint32_t piece = ((col % kAtomCols) / 8) ^ (row % 8);
+                        auto ptr = wg_staging + atom * kAtomBytes + row * 128 + piece * 16;
+                        ptx::SM90_U32x2_STSM_N<nv_bfloat162>::copy(lo, hi, ptr);
+                    }
+                }
+                cute::tma_store_fence();
+                cutlass::arch::NamedBarrier::sync(128, named_barrier_idx);
+
+                if (is_store_leader) {
+                    #pragma unroll
+                    for (uint32_t atom = 0; atom < kAtomsPerSplit; ++ atom) {
+                        const uint32_t n_idx = n_block_idx * BLOCK_N + split_idx * kSplitCols + atom * kAtomCols;
+                        cute::SM90_TMA_STORE_2D::copy(&tensor_map_d, wg_staging + atom * kAtomBytes, n_idx, m_idx);
+                    }
+                    cute::tma_store_arrive();
+                }
+            }
+        }
+        has_tile = next_valid;
+        m_block_idx = next_m_block_idx, n_block_idx = next_n_block_idx;
+    }
+    if (is_store_leader)
+        cute::tma_store_wait<0>();
+    if constexpr (kFP8Out)
+        reduce_amax(amax_d, amax_thr * output_scale);
+#else
+    if (blockIdx.x == 0 and threadIdx.x == 0)
+        DG_DEVICE_ASSERT(false and "This kernel only support sm_90a");
+#endif
+}
+
+};  // namespace deep_gemm
+
+#pragma clang diagnostic pop
diff --git a/deep_gemm/include/deep_gemm/impls/sm90_fp8_gemm_per_tensor_legacy.cuh b/deep_gemm/include/deep_gemm/impls/sm90_fp8_gemm_per_tensor_legacy.cuh
new file mode 100644
index 0000000..38a17ef
--- /dev/null
+++ b/deep_gemm/include/deep_gemm/impls/sm90_fp8_gemm_per_tensor_legacy.cuh
@@ -0,0 +1,418 @@
+// Copyright (c) 2026, Billy Cao
+// Per-tensor-scaled FP8 GEMM, BF16 output: 128 x BLOCK_N tile, producer
+// warp-group + two math warp-groups that store the tile together after its
+// mainloop (named-barrier synchronized epilogue, swizzled staging -> TMA).
+#pragma once
+
+#include <deep_gemm/impls/sm90_fp8_gemm_per_tensor.cuh>
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunknown-attributes"
+
+namespace deep_gemm {
+
+template <typename ab_a_dtype_t, typename ab_b_dtype_t,
+          uint32_t SHAPE_M, uint32_t SHAPE_N, uint32_t SHAPE_K,
+          uint32_t kNumGroups,
+          uint32_t BLOCK_M, uint32_t BLOCK_N, uint32_t BLOCK_K,
+          uint32_t kSwizzleAMode, uint32_t kSwizzleBMode, uint32_t kSwizzleDMode,
+          uint32_t kNumStages,
+          uint32_t kNumTMAThreads, uint32_t kNumMathThreads,
+          uint32_t kNumTMAMulticast, bool kIsTMAMulticastOnA,
+          uint32_t kNumSMs, GemmType kGemmType,
+          typename cd_dtype_t, uint32_t kDStoreSplits = 1, bool kWithC = false,
+          bool kWithC2 = false,
+          bool kWaitC = false>
+CUTLASS_GLOBAL __launch_bounds__(kNumTMAThreads + kNumMathThreads, 1) void
+sm90_fp8_gemm_per_tensor_legacy_impl(const float* scale_a, const float* scale_b, const float* scale_d,
+                                     float* amax_d,
+                              int* grouped_layout,
+                              uint32_t shape_m, uint32_t shape_n, uint32_t shape_k,
+                              const __grid_constant__ cute::TmaDescriptor tensor_map_a,
+                              const __grid_constant__ cute::TmaDescriptor tensor_map_b,
+                              const __grid_constant__ cute::TmaDescriptor tensor_map_d,
+                              const __nv_bfloat16* __restrict__ c_ptr, uint32_t ldc,
+                              const __nv_bfloat16* __restrict__ c2_ptr = nullptr,
+                              const uint32_t* __restrict__ c2_flags = nullptr,
+                              uint32_t c2_piece_rows = 0, uint32_t c2_piece_cols = 0) {
+#if (defined(__CUDA_ARCH__) and (__CUDA_ARCH__ >= 900)) or defined(__CLION_IDE__)
+    DG_STATIC_ASSERT(cute::is_same_v<cd_dtype_t, cutlass::bfloat16_t>, "BF16 output only");
+    DG_STATIC_ASSERT(kNumTMAMulticast == 1, "Cluster-1 only");
+    DG_STATIC_ASSERT(kWithC or not kWithC2, "The second addend rides the C addend path");
+    DG_STATIC_ASSERT(not kWaitC or (kWithC and not kWithC2), "kWaitC: the flags guard a single C addend");
+    DG_STATIC_ASSERT((cute::is_same_v<ab_a_dtype_t, cutlass::float_e4m3_t> or
+                      cute::is_same_v<ab_a_dtype_t, cutlass::float_e5m2_t>) and
+                     (cute::is_same_v<ab_b_dtype_t, cutlass::float_e4m3_t> or
+                      cute::is_same_v<ab_b_dtype_t, cutlass::float_e5m2_t>), "Invalid A/B data dtype");
+    DG_STATIC_ASSERT(kGemmType == GemmType::Normal, "Per-tensor kernel only supports normal GEMM");
+
+    // Types
+    using WGMMA = typename PerTensorMMASelector<BLOCK_N, ab_a_dtype_t, ab_b_dtype_t>::type;
+    using Barrier = cutlass::arch::ClusterTransactionBarrier;
+    DG_STATIC_ASSERT(BLOCK_M % WGMMA::M == 0 or BLOCK_M < WGMMA::M, "Invalid block size");
+
+    // PDL (launched with enable_pdl): wait for the upstream grid before any
+    // global read (A/B TMA loads, scale_a/scale_b dereferences).
+    asm volatile("griddepcontrol.wait;" ::: "memory");
+
+    // Overwrite shape constants if the compiler gives
+    shape_m = SHAPE_M != 0 ? SHAPE_M : shape_m;
+    shape_n = SHAPE_N != 0 ? SHAPE_N : shape_n;
+    shape_k = SHAPE_K != 0 ? SHAPE_K : shape_k;
+
+    // Shared memory. The D staging buffer holds BLOCK_N / kDStoreSplits
+    // columns at a time (the epilogue stores the tile in kDStoreSplits
+    // sequential column splits).
+    static constexpr uint32_t BLOCK_N_PER_SPLIT = BLOCK_N / kDStoreSplits;
+    static constexpr uint32_t SMEM_D_SIZE = math::constexpr_align(BLOCK_M * BLOCK_N_PER_SPLIT * static_cast<uint32_t>(sizeof(__nv_bfloat16)), 1024u);
+    static constexpr uint32_t SMEM_A_SIZE_PER_STAGE = BLOCK_M * BLOCK_K * sizeof(ab_a_dtype_t);
+    static constexpr uint32_t SMEM_B_SIZE_PER_STAGE = BLOCK_N * BLOCK_K * sizeof(ab_b_dtype_t);
+
+    // NOTES: Make sure we have enough shared memory for WGMMA padding
+    static constexpr uint32_t WGMMA_A_SIZE_PER_STAGE = WGMMA::M * BLOCK_K * sizeof(ab_a_dtype_t);
+    DG_STATIC_ASSERT(WGMMA_A_SIZE_PER_STAGE <= SMEM_A_SIZE_PER_STAGE + SMEM_B_SIZE_PER_STAGE * kNumStages, "Memory Out of bound for WGMMA");
+
+    // Configs
+    const uint32_t num_total_k_blocks = math::ceil_div(shape_k, BLOCK_K);
+    const uint32_t warp_idx = __shfl_sync(0xffffffff, threadIdx.x / 32, 0);
+    const uint32_t lane_idx = ptx::get_lane_idx();
+
+    // Prefetch TMA descriptors at the very beginning
+    if (warp_idx == kNumMathThreads / 32 and cute::elect_one_sync()) {
+        cute::prefetch_tma_descriptor(&tensor_map_a);
+        cute::prefetch_tma_descriptor(&tensor_map_b);
+        cute::prefetch_tma_descriptor(&tensor_map_d);
+    }
+    __syncwarp();
+
+    // Align to 1024 bytes for swizzle-128B
+    extern __shared__ __align__(1024) uint8_t smem_buffer[];
+    DG_STATIC_ASSERT(SMEM_D_SIZE % 1024 == 0, "Shared memory of A/B must be aligned to 1024 bytes");
+
+    // Data on shared memory
+    auto smem_d = reinterpret_cast<__nv_bfloat16*>(smem_buffer);
+    auto smem_a = utils::PatternVisitor([&](const uint32_t& i) {
+        return reinterpret_cast<ab_a_dtype_t*>(smem_buffer + SMEM_D_SIZE + i * SMEM_A_SIZE_PER_STAGE);
+    });
+    auto smem_b = utils::PatternVisitor([&](const uint32_t& i) {
+        return reinterpret_cast<ab_b_dtype_t*>(smem_buffer + SMEM_D_SIZE + kNumStages * SMEM_A_SIZE_PER_STAGE + i * SMEM_B_SIZE_PER_STAGE);
+    });
+
+    // Fill barriers
+    auto barrier_start_ptr = reinterpret_cast<Barrier*>(smem_buffer + SMEM_D_SIZE + kNumStages * (SMEM_A_SIZE_PER_STAGE + SMEM_B_SIZE_PER_STAGE));
+    auto full_barriers     = utils::PatternVisitor([&](const uint32_t& i) { return barrier_start_ptr + i; });
+    auto empty_barriers    = utils::PatternVisitor([&](const uint32_t& i) { return barrier_start_ptr + kNumStages + i; });
+
+    // Initialize barriers
+    if (warp_idx == kNumMathThreads / 32 + 1 and cute::elect_one_sync()) {
+        #pragma unroll
+        for (uint32_t i = 0; i < kNumStages; ++ i) {
+            full_barriers[i]->init(1);
+            empty_barriers[i]->init(kNumMathThreads / 32);
+        }
+        // Make initialized barrier visible in async proxy
+        cutlass::arch::fence_barrier_init();
+    }
+
+    // Synchronize all threads to make barrier visible in normal memory model
+    __syncthreads();
+
+    // Register reconfigurations
+    constexpr uint32_t kNumTMARegisters = 40;
+    constexpr uint32_t kNumMathRegisters = kNumMathThreads == 128 ? 248 : 232;
+
+    // Wait for primary kernel completion
+    cudaGridDependencySynchronize();
+
+    // Block scheduler
+    uint32_t m_block_idx, n_block_idx;
+    auto scheduler = sched::Scheduler<kGemmType, BLOCK_M, BLOCK_N, kNumGroups, kNumTMAMulticast, kIsTMAMulticastOnA, kNumSMs>(shape_m, shape_n, shape_k, grouped_layout);
+
+    // Pipeline and TMA phases
+    uint32_t stage_idx = 0, phase = 0;
+    auto advance_pipeline = [&](uint32_t& k_block_idx) {
+        ++ k_block_idx;
+        // Flip phases only if reach the next first stage
+        stage_idx = stage_idx == kNumStages - 1 ? 0 : stage_idx + 1;
+        phase ^= stage_idx == 0;
+    };
+
+    if (warp_idx >= kNumMathThreads / 32) {
+        // TMA warp-group for loading data
+        cutlass::arch::warpgroup_reg_dealloc<kNumTMARegisters>();
+
+        // NOTES: only one thread (or warp) will be used
+        if (warp_idx == kNumMathThreads / 32 + 2 and cute::elect_one_sync()) {
+            // Persistently schedule over blocks
+            while (scheduler.get_next_block(m_block_idx, n_block_idx)) {
+                for (uint32_t k_block_idx = 0; k_block_idx < num_total_k_blocks; advance_pipeline(k_block_idx)) {
+                    // Wait consumer release
+                    empty_barriers[stage_idx]->wait(phase ^ 1);
+
+                    // Issue TMA A
+                    auto& full_barrier = *full_barriers[stage_idx];
+                    const uint32_t k_idx = k_block_idx * BLOCK_K;
+                    tma::copy<BLOCK_K, BLOCK_M, kSwizzleAMode, ab_a_dtype_t>(&tensor_map_a, &full_barrier,
+                             smem_a[stage_idx], k_idx, scheduler.get_global_idx<false>(shape_m, BLOCK_M, m_block_idx),
+                             1, 0);
+
+                    // Issue TMA B
+                    tma::copy<BLOCK_K, BLOCK_N, kSwizzleBMode, ab_b_dtype_t>(&tensor_map_b, &full_barrier,
+                             smem_b[stage_idx], k_idx, scheduler.get_global_idx<true>(shape_n, BLOCK_N, n_block_idx, m_block_idx),
+                             1, 0);
+                    full_barrier.arrive_and_expect_tx(SMEM_A_SIZE_PER_STAGE + SMEM_B_SIZE_PER_STAGE);
+                }
+            }
+        }
+    } else {
+        // Math warp-groups for WGMMA
+        cutlass::arch::warpgroup_reg_alloc<kNumMathRegisters>();
+
+        // NOTES: use `__shfl_sync` to encourage NVCC to use unified registers
+        const auto math_wg_idx = __shfl_sync(0xffffffff, threadIdx.x / 128, 0);
+        const auto r_0 = warp_idx * 16 + lane_idx / 4, r_1 = r_0 + 8;
+
+        auto a_desc = mma::sm90::make_smem_desc(smem_a[0] + math_wg_idx * WGMMA::M * BLOCK_K, 1);
+        auto b_desc = mma::sm90::make_smem_desc(smem_b[0], 1);
+        const uint32_t a_desc_lo = __shfl_sync(0xffffffff, a_desc.reg32_[0], 0);
+        const uint32_t b_desc_lo = __shfl_sync(0xffffffff, b_desc.reg32_[0], 0);
+
+        // Accumulation for WGMMA (a single accumulator set, reused across all k-blocks)
+        constexpr uint32_t WAVE_BLOCK_M = BLOCK_M <= WGMMA::M ? BLOCK_M : WGMMA::M * 2;
+        DG_STATIC_ASSERT(BLOCK_M % WAVE_BLOCK_M == 0, "Invalid block sizes");
+        float accum[WGMMA::kNumAccum * (BLOCK_M / WAVE_BLOCK_M)] = {0};
+
+        // Pick threads whose WGMMA results are to be stored in shared memory
+        DG_STATIC_ASSERT(BLOCK_M >= 64 or kNumMathThreads == 128, "Only one math warp group for `BLOCK_M < 64`");
+        constexpr uint32_t kNumWGMMAStoreThreads = WAVE_BLOCK_M * (128 / WGMMA::M);
+        const bool do_wgmma_store = BLOCK_M >= WGMMA::M or warp_idx < kNumWGMMAStoreThreads / 32;
+
+        // Empty barrier arrival for a given stage
+        auto empty_barrier_arrive_at = [&](const uint32_t& s) {
+            lane_idx == 0 ? empty_barriers[s]->arrive() : void();
+        };
+
+        // Per-tensor scales (dequant multipliers)
+        const float output_scale = scale_a[0] * scale_b[0];
+
+        // Persistently schedule over blocks
+        while (scheduler.get_next_block(m_block_idx, n_block_idx)) {
+            // Skip useless computations (always valid for normal GEMM)
+            if (scheduler.is_computation_valid(m_block_idx, math_wg_idx * WGMMA::M)) {
+                #pragma unroll 4
+                for (uint32_t k_block_idx = 0; k_block_idx < num_total_k_blocks; advance_pipeline(k_block_idx)) {
+                    const auto a_desc_base_lo = a_desc_lo + stage_idx * (SMEM_A_SIZE_PER_STAGE / 16);
+                    const auto b_desc_base_lo = b_desc_lo + stage_idx * (SMEM_B_SIZE_PER_STAGE / 16);
+                    const uint32_t prev_stage = stage_idx == 0 ? kNumStages - 1 : stage_idx - 1;
+
+                    // Wait TMA arrivals
+                    full_barriers[stage_idx]->wait(phase);
+
+                    // Commit WGMMA instructions: ONE group per k-block, covering all M waves.
+                    // The accumulator persists across k-blocks (scale_d = One except the very first).
+                    #pragma unroll
+                    for (uint32_t i = 0; i < WGMMA::kNumAccum * (BLOCK_M / WAVE_BLOCK_M); ++ i)
+                        ptx::warpgroup_fence_operand(accum[i]);
+                    ptx::warpgroup_arrive();
+                    #pragma unroll
+                    for (uint32_t local_idx = 0; local_idx < BLOCK_M / WAVE_BLOCK_M; ++ local_idx) {
+                        auto m_offset = local_idx * WAVE_BLOCK_M;
+                        auto shifted_accum = accum + WGMMA::kNumAccum * local_idx;
+                        #pragma unroll
+                        for (uint32_t k = 0; k < BLOCK_K / WGMMA::K; ++ k) {
+                            a_desc.reg32_[0] = a_desc_base_lo + (m_offset * BLOCK_K + k * WGMMA::K) / 16;
+                            b_desc.reg32_[0] = b_desc_base_lo + k * WGMMA::K / 16;
+                            // Scale-D zero only on the very first WGMMA writing each
+                            // accumulator slot (tile boundary); every other WGMMA
+                            // accumulates onto the previous k-blocks' partial sums.
+                            WGMMA::wgmma(a_desc, b_desc, shifted_accum, k_block_idx > 0 or k > 0);
+                        }
+                    }
+                    ptx::warpgroup_commit_batch();
+                    #pragma unroll
+                    for (uint32_t i = 0; i < WGMMA::kNumAccum * (BLOCK_M / WAVE_BLOCK_M); ++ i)
+                        ptx::warpgroup_fence_operand(accum[i]);
+
+                    // Pipeline the stage release: the previous k-block's WGMMA group has
+                    // completed, so its smem stage can be handed back to the TMA warp.
+                    if (k_block_idx >= 1)
+                        ptx::warpgroup_wait<1>(), empty_barrier_arrive_at(prev_stage);
+                }
+                // Drain the last WGMMA group and release its stage
+                ptx::warpgroup_wait<0>();
+                empty_barrier_arrive_at(stage_idx == 0 ? kNumStages - 1 : stage_idx - 1);
+            } else {
+                #pragma unroll 4
+                for (uint32_t k_block_idx = 0; k_block_idx < num_total_k_blocks; advance_pipeline(k_block_idx)) {
+                    full_barriers[stage_idx]->wait(phase);
+                    empty_barrier_arrive_at(stage_idx);
+                }
+            }
+
+            // TMA checks
+            constexpr uint32_t kNumElemBytes = sizeof(nv_bfloat16);
+            constexpr uint32_t TMA_D_BLOCK_N = kSwizzleDMode == 0 ? BLOCK_N_PER_SPLIT : (kSwizzleDMode / kNumElemBytes);
+            constexpr uint32_t WGMMA_M_PER_WARP = WGMMA::M / 4;
+            constexpr uint32_t TMA_D_ATOMS_PER_SPLIT = BLOCK_N_PER_SPLIT / TMA_D_BLOCK_N;
+            constexpr uint32_t ACCUM_CHUNKS_PER_SPLIT = (WGMMA::kNumAccum / 4) / kDStoreSplits;
+            DG_STATIC_ASSERT(BLOCK_M % 8 == 0, "Invalid swizzling atom");
+            DG_STATIC_ASSERT(BLOCK_N % TMA_D_BLOCK_N == 0 and BLOCK_N / TMA_D_BLOCK_N <= 32,
+                            "Unaligned TMA store or too many TMA store instructions");
+            DG_STATIC_ASSERT(TMA_D_BLOCK_N % 8 == 0, "Invalid TMA block N");
+            DG_STATIC_ASSERT(BLOCK_N % kDStoreSplits == 0 and (WGMMA::kNumAccum / 4) % kDStoreSplits == 0,
+                            "Invalid D store split");
+            DG_STATIC_ASSERT(kNumWGMMAStoreThreads >= TMA_D_ATOMS_PER_SPLIT, "Too many TMA blocks");
+
+            // Skip WGMMA store for the unfilled parts
+            if (not do_wgmma_store)
+                continue;
+
+            constexpr bool kWithGroupOffsetD = false;
+            const auto m_idx = scheduler.get_global_idx<kWithGroupOffsetD>(shape_m, BLOCK_M, m_block_idx);
+
+            // Wait last TMA store to be finished
+            if (threadIdx.x < TMA_D_ATOMS_PER_SPLIT)
+                cute::tma_store_wait<0>();
+            cutlass::arch::NamedBarrier::sync(kNumWGMMAStoreThreads, 1);
+
+            // Write back to shared memory using STSM and issue TMA stores,
+            // in kDStoreSplits sequential halves (each half reuses the same
+            // reduced-size D staging buffer, freeing smem for A/B stages).
+            DG_STATIC_ASSERT(WGMMA::kNumAccum % 4 == 0, "Invalid STSM x2 vectorization");
+            #pragma unroll
+            for (uint32_t split_idx = 0; split_idx < kDStoreSplits; ++ split_idx) {
+                if (split_idx >= 1) {
+                    // The previous split's TMA store must complete before its
+                    // smem half is overwritten by this split
+                    if (threadIdx.x < TMA_D_ATOMS_PER_SPLIT)
+                        cute::tma_store_wait<0>();
+                    cutlass::arch::NamedBarrier::sync(kNumWGMMAStoreThreads, 1);
+                }
+                #pragma unroll
+                for (uint32_t local_idx = 0; local_idx < BLOCK_M / WAVE_BLOCK_M; ++ local_idx) {
+                    auto m_offset = local_idx * WAVE_BLOCK_M;
+                    auto shifted_accum = accum + WGMMA::kNumAccum * local_idx;
+                    #pragma unroll
+                    for (auto i = 0; i < ACCUM_CHUNKS_PER_SPLIT; ++ i) {
+                        const auto global_i = split_idx * ACCUM_CHUNKS_PER_SPLIT + i;
+                        // Swizzle or padding into the correct address
+                        uint8_t* smem_ptr = nullptr;
+                        if constexpr (kSwizzleDMode > 0) {
+                            // Calculate the swizzling atom offset and in-atom offset
+                            constexpr uint32_t kNumBankGroupBytes = 16;
+                            auto atom_offset = i / (TMA_D_BLOCK_N / 8), in_atom_offset = i % (TMA_D_BLOCK_N / 8);
+
+                            // Calculate the index of the bank group to be written in the atom
+                            auto bank_group_index = in_atom_offset + lane_idx * (kSwizzleDMode / kNumBankGroupBytes);
+
+                            // Reshape the atom in another view and swizzle
+                            constexpr bool kHasShortcut = (kSwizzleDMode / kNumBankGroupBytes) == 8;
+                            auto row = kHasShortcut ? (in_atom_offset / 8 + lane_idx) : (bank_group_index / 8);
+                            auto col = kHasShortcut ? (in_atom_offset) : (bank_group_index % 8);
+                            col ^= row % (kSwizzleDMode / 16);
+
+                            // Add back into the base pointer
+                            smem_ptr = reinterpret_cast<uint8_t*>(smem_d) +                // Base pointer
+                                warp_idx * (WGMMA_M_PER_WARP * kSwizzleDMode) +            // Warp offset
+                                m_offset * kSwizzleDMode +                                 // Wave offset
+                                atom_offset * BLOCK_M * kSwizzleDMode +                    // Swizzle atom offset (constants)
+                                row * (kNumBankGroupBytes * 8) + col * kNumBankGroupBytes; // In-atom offset
+                        } else {
+                            // No swizzling, just padding
+                            smem_ptr = reinterpret_cast<uint8_t*>(smem_d + (m_offset + warp_idx * WGMMA_M_PER_WARP + lane_idx) * BLOCK_N_PER_SPLIT + i * 8);
+                        }
+
+                        // NOTES: only 16 lanes' addresses are used
+                        // Apply the per-tensor dequant scale in the epilogue (single multiply)
+                        ptx::SM90_U32x2_STSM_N<nv_bfloat162>::copy(
+                            __float22bfloat162_rn({shifted_accum[global_i * 4 + 0] * output_scale, shifted_accum[global_i * 4 + 1] * output_scale}),
+                            __float22bfloat162_rn({shifted_accum[global_i * 4 + 2] * output_scale, shifted_accum[global_i * 4 + 3] * output_scale}),
+                            smem_ptr
+                        );
+                    }
+                }
+                if constexpr (kWithC) {
+                    // D = bf16(scale * acc) + C as a BF16 add (the value a separate
+                    // element-wise join after the GEMM gives). The staged split is
+                    // complete in shared memory; consecutive threads add consecutive
+                    // 16-byte C vectors of a row (coalesced global reads) into their
+                    // staged location.
+                    if constexpr (kWithC2 or kWaitC) {
+                        // Staged addend (UB_TCCL_EPI=2; C2, or C itself with kWaitC): a local copy the copy engine fills
+                        // piece by piece (c2_piece_rows x c2_piece_cols, row-major piece order), each piece followed by a
+                        // non-zero flag. One thread waits for this split's piece; the barrier below releases the rest.
+                        if (c2_flags != nullptr and threadIdx.x == 0) {
+                            const uint32_t pieces_per_row = (shape_n + c2_piece_cols - 1) / c2_piece_cols;
+                            const uint32_t piece = m_idx / c2_piece_rows * pieces_per_row +
+                                (n_block_idx * BLOCK_N + split_idx * BLOCK_N_PER_SPLIT) / c2_piece_cols;
+                            uint32_t ready = 0;
+                            do {
+                                asm volatile("ld.acquire.gpu.global.b32 %0, [%1];" : "=r"(ready) : "l"(c2_flags + piece) : "memory");
+                            } while (ready == 0);
+                        }
+                    }
+                    cutlass::arch::NamedBarrier::sync(kNumWGMMAStoreThreads, 1);
+                    constexpr uint32_t kVecsPerRow = BLOCK_N_PER_SPLIT / 8;
+                    constexpr uint32_t kNumVecs = BLOCK_M * kVecsPerRow;
+                    DG_STATIC_ASSERT(kNumVecs % kNumWGMMAStoreThreads == 0, "Invalid addend split");
+                    const uint32_t n_base = n_block_idx * BLOCK_N + split_idx * BLOCK_N_PER_SPLIT;
+                    #pragma unroll 4
+                    for (uint32_t v = threadIdx.x; v < kNumVecs; v += kNumWGMMAStoreThreads) {
+                        const uint32_t r = v / kVecsPerRow, j = v % kVecsPerRow;
+                        const auto* c_vec = reinterpret_cast<const uint4*>(
+                            c_ptr + static_cast<size_t>(m_idx + r) * ldc + n_base + j * 8);
+                        // kWaitC: C is written by the copy engine during this kernel, so read it through L2
+                        const auto c = kWaitC ? __ldcg(c_vec) : __ldg(c_vec);
+                        uint8_t* staged;
+                        if constexpr (kSwizzleDMode > 0) {
+                            // 128B atoms of TMA_D_BLOCK_N columns x BLOCK_M rows; the
+                            // 16-byte chunk index is XOR-swizzled with the row
+                            constexpr uint32_t kChunksPerAtom = kSwizzleDMode / 16;
+                            const uint32_t atom = j / kChunksPerAtom, chunk = j % kChunksPerAtom;
+                            staged = reinterpret_cast<uint8_t*>(smem_d) + atom * BLOCK_M * kSwizzleDMode +
+                                     r * kSwizzleDMode + ((chunk ^ (r % kChunksPerAtom)) * 16);
+                        } else {
+                            staged = reinterpret_cast<uint8_t*>(smem_d + r * BLOCK_N_PER_SPLIT + j * 8);
+                        }
+                        uint4 d = *reinterpret_cast<uint4*>(staged);
+                        auto* dh = reinterpret_cast<__nv_bfloat162*>(&d);
+                        const auto* ch = reinterpret_cast<const __nv_bfloat162*>(&c);
+                        #pragma unroll
+                        for (int q = 0; q < 4; ++ q) dh[q] = __hadd2(dh[q], ch[q]);
+                        if constexpr (kWithC2) {
+                            // Second addend (UB_TCCL, the peer's partial of this shard read through its IPC
+                            // mapping): a second BF16 add after the first, i.e. the rounding sequence of
+                            // "fold C, then add the peer's partial" that the ring's local reduce gives.
+                            const auto c2 = __ldcg(reinterpret_cast<const uint4*>(
+                                c2_ptr + static_cast<size_t>(m_idx + r) * ldc + n_base + j * 8));
+                            const auto* c2h = reinterpret_cast<const __nv_bfloat162*>(&c2);
+                            #pragma unroll
+                            for (int q = 0; q < 4; ++ q) dh[q] = __hadd2(dh[q], c2h[q]);
+                        }
+                        *reinterpret_cast<uint4*>(staged) = d;
+                    }
+                }
+                cute::tma_store_fence();
+                cutlass::arch::NamedBarrier::sync(kNumWGMMAStoreThreads, 1);
+
+                // Use TMA store to write this split back to global memory
+                if (threadIdx.x < TMA_D_ATOMS_PER_SPLIT) {
+                    auto in_block_n_offset = threadIdx.x * TMA_D_BLOCK_N;
+                    auto smem_ptr = smem_d + in_block_n_offset * BLOCK_M;
+                    auto n_idx = n_block_idx * BLOCK_N + split_idx * BLOCK_N_PER_SPLIT + in_block_n_offset;
+                    cute::SM90_TMA_STORE_2D::copy(&tensor_map_d, smem_ptr, n_idx, m_idx);
+                    cute::tma_store_arrive();
+                }
+                __syncwarp();
+            }
+        }
+    }
+#else
+    if (blockIdx.x == 0 and threadIdx.x == 0)
+        DG_DEVICE_ASSERT(false and "This kernel only support sm_90a");
+#endif
+}
