diff --git a/hopper/fp8_bwd_transpose.py b/hopper/fp8_bwd_transpose.py
new file mode 100644
index 0000000..1ed433e
--- /dev/null
+++ b/hopper/fp8_bwd_transpose.py
@@ -0,0 +1,42 @@
+# Copyright (c) 2026, Billy Cao.
+
+# [b, s, h, d] -> [b, h, d, s] copies of the fp8 backward operands. permute_tokens: position
+# 4t + 2j + p of each 16-token block holds token 8j + 2t + p, the dV/dK gemms' register operand order.
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _transpose_kernel(x_ptr, y_ptr, S, H, stride_xb, stride_xs, stride_xh,
+                      BLOCK_S: tl.constexpr, D: tl.constexpr, PERMUTE: tl.constexpr):
+    pid_s = tl.program_id(0)
+    pid_bh = tl.program_id(1)
+    b = pid_bh // H
+    h = pid_bh % H
+    k = pid_s * BLOCK_S + tl.arange(0, BLOCK_S)
+    if PERMUTE:
+        r = k % 16
+        tok = (k - r) + 8 * ((r // 2) % 2) + 2 * (r // 4) + (r % 2)
+    else:
+        tok = k
+    d = tl.arange(0, D)
+    x_off = (b.to(tl.int64) * stride_xb + h.to(tl.int64) * stride_xh
+             + tok.to(tl.int64)[:, None] * stride_xs + d[None, :])
+    x = tl.load(x_ptr + x_off, mask=(tok < S)[:, None])
+    y_off = ((pid_bh.to(tl.int64) * D + d[:, None]) * S + k[None, :])
+    tl.store(y_ptr + y_off, tl.trans(x), mask=(k < S)[None, :])
+
+
+def transpose_bshd_to_bhds(x: torch.Tensor, permute_tokens: bool) -> torch.Tensor:
+    b, s, h, d = x.shape
+    assert x.stride(-1) == 1 and d in (64, 128, 256)
+    if permute_tokens:
+        assert s % 16 == 0, "token permutation requires seqlen % 16 == 0"
+    y = torch.empty((b, h, d, s), device=x.device, dtype=x.dtype)
+    xu, yu = x.view(torch.uint8), y.view(torch.uint8)
+    block_s = 64
+    grid = (triton.cdiv(s, block_s), b * h)
+    _transpose_kernel[grid](xu, yu, s, h, x.stride(0), x.stride(1), x.stride(2),
+                            BLOCK_S=block_s, D=d, PERMUTE=permute_tokens, num_warps=4)
+    return y
