+// FP8 dS staging: explicit st.shared (the uint8 pointer chain otherwise compiles to generic stores).
+CUTLASS_DEVICE void fp8_sts_u16(void* p, uint16_t v) {
+    uint32_t a = uint32_t(__cvta_generic_to_shared(p));
+    asm volatile("st.shared.u16 [%0], %1;\n" :: "r"(a), "h"(v));
+}
+
+// Distributed shared memory helpers for the 2-CTA dS exchange.
+CUTLASS_DEVICE uint32_t dsmem_map(void const* p, uint32_t cta_rank) {
+    uint32_t r;
+    asm volatile("mapa.shared::cluster.u32 %0, %1, %2;\n"
+                 : "=r"(r) : "r"(static_cast<uint32_t>(__cvta_generic_to_shared(p))), "r"(cta_rank));
+    return r;
+}
+// Bulk copy into the partner's smem, completing on the partner's mbarrier.
+CUTLASS_DEVICE void dsmem_bulk_copy(uint32_t dst_cluster, void const* src, uint32_t bytes, uint32_t mbar_cluster) {
+    asm volatile("cp.async.bulk.shared::cluster.shared::cta.mbarrier::complete_tx::bytes [%0], [%1], %2, [%3];\n"
+                 :: "r"(dst_cluster), "r"(static_cast<uint32_t>(__cvta_generic_to_shared(src))), "r"(bytes), "r"(mbar_cluster)
