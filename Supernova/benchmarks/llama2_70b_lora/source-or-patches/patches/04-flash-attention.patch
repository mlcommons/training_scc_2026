+// The persistent forward scheduler's semaphore: one block per device, zeroed once outside graph capture;
+// the last tile fetch of each launch stores 0 back (tile_scheduler.hpp). nullptr -> per-call semaphore.
+// A 1-element fp32 device tensor's pointer (nullptr when absent).
+static float* scalar_f32_ptr(std::optional<Tensor> const& t, char const* name) {
+    if (!t.has_value()) { return nullptr; }
+    STD_TORCH_CHECK(t.value().scalar_type() == torch::headeronly::ScalarType::Float && t.value().numel() == 1
+                    && t.value().is_cuda(), name, " must be a 1-element CUDA fp32 tensor");
+    return static_cast<float*>(t.value().data_ptr());
+}
+
+static int* persistent_tile_semaphore(int n_ints) {
+    constexpr int kInts = 1024;
+    if (n_ints > kInts) { return nullptr; }
+    static std::mutex mu;
+    static int* blocks[64] = {};
+    int device_index;
+    CHECK_CUDA(cudaGetDevice(&device_index));
+    if (device_index < 0 || device_index >= 64) { return nullptr; }
+    std::lock_guard<std::mutex> lock(mu);
+    if (blocks[device_index] == nullptr) {
+        void* stream_ptr = nullptr;
+        TORCH_ERROR_CODE_CHECK(aoti_torch_get_current_cuda_stream(device_index, &stream_ptr));
+        cudaStreamCaptureStatus status;
+        CHECK_CUDA(cudaStreamIsCapturing(static_cast<cudaStream_t>(stream_ptr), &status));
+        if (status != cudaStreamCaptureStatusNone) { return nullptr; }
+        int* p = nullptr;
+        CHECK_CUDA(cudaMalloc(&p, kInts * sizeof(int)));
+        CHECK_CUDA(cudaMemset(p, 0, kInts * sizeof(int)));
+        CHECK_CUDA(cudaDeviceSynchronize());
+        blocks[device_index] = p;
+    }
+    return blocks[device_index];
+}
