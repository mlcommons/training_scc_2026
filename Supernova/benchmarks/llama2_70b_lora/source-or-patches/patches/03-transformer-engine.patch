+def _contig_wide(x: torch.Tensor) -> torch.Tensor:
+    """Contiguous copy of a byte-typed tensor through its widest integer view.
+
+    ``TensorIterator`` copies a uint8 tensor one byte per element. The same bytes
+    moved through int16/int32/int64 views give the same result with fewer
+    element-wise operations.
+    """
+    if x.is_contiguous():
+        return x
+    es = x.element_size()
+    wide = {1: torch.uint8, 2: torch.int16, 4: torch.int32, 8: torch.int64}
+    if es not in wide:
+        return x.contiguous()
+    xi = x.view(wide[es])
+    for w in (16, 8, 4, 2):
+        if w <= es or w not in wide:
+            continue
+        if (
+            x.stride(-1) == 1
+            and (x.shape[-1] * es) % w == 0
+            and (x.data_ptr() % w) == 0
+            and all((st * es) % w == 0 for st, s in zip(x.stride()[:-1], x.shape[:-1]) if s > 1)
+        ):
+            try:
+                return xi.view(wide[w]).contiguous().view(wide[es]).view(x.dtype)
+            except RuntimeError:
+                break
+    return x.contiguous()
+
