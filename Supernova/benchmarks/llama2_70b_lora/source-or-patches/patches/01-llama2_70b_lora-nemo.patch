index 0000000..bc01c92
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/cp_shards.py
@@ -0,0 +1,617 @@
+"""Uneven context parallel shards: a faster GPU of a CP group holds more tokens inside the decoder.
+
+Megatron slices every batch into 2 * cp equal chunks and rank r holds chunks r and 2cp-1-r. The embedding,
+the output layer and the loss keep that even layout. Inside the decoder this module gives rank r two chunks of
+c_r tokens each (sum over r of 2 * c_r = S), sized so that the ranks of the group finish together:
+
+  TransformerBlock.forward entry   hidden states and the rotary table move to the uneven layout (one all-to-all
+                                   over the CP group, autograd aware)
+  TransformerBlock.forward exit    the output moves back to the even layout
+
+Chunk c of the global sequence (c < cp: owner c; c >= cp: owner 2cp-1-c) has c_owner tokens, so every rank
+still holds two contiguous chunks in global order, and the CP exchange (cp_a2a_ce) assembles the full sequence
+from per-peer sizes. Attention runs on the full sequence with the heads split evenly, so its cost per rank is
+unchanged; the linear, MLP and elementwise work moves with the tokens.
+
+CP_SHARD_WEIGHTS=auto: calibrate() sets the split during warmup, before the training CUDA graph capture. Each
+iteration sets a split, recaptures the full-iteration graph and replays it; every consumer gate of the CP exchange
+adds its spin time to a per-peer device counter (cp_a2a_ce.gate_wait), so a rank's lateness is the time its peers
+waited for it. Tokens move from late ranks to early ones; the measured split with the smallest lateness spread is
+kept and cached per host, GPU set, power limits, vboost levels and GPU counts. A run that finds its cache entry
+uses it and runs no calibration step.
+CP_SHARD_WEIGHTS=w0,w1,...: fixed speed weights, one per physical GPU of the node (index = CUDA device ordinal
+before CUDA_VISIBLE_DEVICES remapping); tokens follow the weights. Unset, off or all-equal weights: equal shards,
+nothing patched.
+CP_SHARD_MAX: the largest shard as a multiple of the even shard. With transient FP8 transposes (FP8_TRANSIENT_TRANSPOSE=1)
+calibrate() fits a peak memory model per rank (base + bytes per token * tokens + resident fc2 layers * layer bytes)
+from the measured peak of every iteration, caps each rank's tokens by it and gives every rank as many resident
+fc2 transposes as fit beside its tokens (fewer on a rank with more tokens); the per-rank residency is cached with
+the split. Without the model, or when CP_SHARD_MAX is set, the cap is CP_SHARD_MAX (default 1.03125).
+CP_SHARD_CACHE_DIR: the calibration cache (default $MLPERF_ROOT/cp_shard_cache). CP_SHARD_RECALIBRATE=1 ignores it.
+"""
+
+import os
+import sys
+
+import torch
+
+_WEIGHTS = None       # list of weights, or "auto"
+_GRAN = 64            # chunk granularity in tokens: every shard a multiple of 128
+_CAL_ITERS = 5        # calibration iterations
+_CAL_REPS = 3         # timed graph replays per iteration
+_CAL_DAMP = 0.5       # fraction of the estimated token move applied per iteration
+_FIXED_FRAC = 0.18    # share of the step that does not move with the tokens (attention, split by heads)
+_forced = {}          # group ranks -> (S, chunk sizes): the calibrated table
+_seen_S = None
+_tables = {}          # (S, group ranks) -> chunk sizes c[0..cp-1]
+_maps = {}            # (S, chunk sizes, me, device) -> reshard index tensors
+active = None         # (S, c tuple) of the latest decoder call; its backward uses it too. Read by cp_a2a_ce, lora_rng
+
+
+def _phys_gpu(local_rank):
+    cvd = os.getenv("CUDA_VISIBLE_DEVICES")
+    if cvd:
+        return int(cvd.split(",")[local_rank])
+    return local_rank
+
+
+def chunks(S, cp_group):
+    """Chunk size c_r per CP rank for global sequence length S."""
+    ranks = tuple(torch.distributed.get_process_group_ranks(cp_group))
+    key = (S, ranks)
+    c = _tables.get(key)
+    if c is not None:
+        return c
+    global _seen_S
+    _seen_S = S
+    cp = len(ranks)
+    if _WEIGHTS == "auto":
+        f = _forced.get(ranks)
+        if f is not None and f[0] == S:
+            return f[1]
+        return (S // (2 * cp),) * cp
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError(f"cp_shards: first decoder call of sequence length {S} during graph capture; the shard "
+                           "table must be built eagerly (warmup) before capture")
+    mine = torch.tensor([_WEIGHTS[_phys_gpu(int(os.environ["LOCAL_RANK"]))]], dtype=torch.float64,
+                        device=torch.cuda.current_device())
+    allw = [torch.empty_like(mine) for _ in range(cp)]
+    torch.distributed.all_gather(allw, mine, group=cp_group)
+    w = [float(x.item()) for x in allw]
+    c = _round([S * x / sum(w) for x in w], S)
+    _tables[key] = c
+    if torch.distributed.get_rank() == ranks[0]:
+        print(f"cp_shards: CP group {list(ranks)} weights {w} -> tokens per rank {[2 * x for x in c]}",
+              flush=True)
+    return c
+
+
+def _round(tokens, S, caps=None):
+    """Chunk sizes (multiples of the granularity, sum S / 2) closest to the per-rank token targets. caps: the
+    largest token count of each rank (the memory model of calibrate()); without it, CP_SHARD_MAX times the even
+    shard. An explicit CP_SHARD_MAX also bounds the caps."""
+    cp = len(tokens)
+    if S % (2 * _GRAN * cp):
+        raise RuntimeError(f"cp_shards: S {S} is not a multiple of 2 * cp * gran ({2 * cp * _GRAN})")
+    units = S // 2 // _GRAN
+    ideal = [max(1.0, t / 2 / _GRAN) for t in tokens]
+    scale = units / sum(ideal)
+    ideal = [v * scale for v in ideal]
+    # memory: no rank above its cap; the excess goes to the ranks below theirs
+    ratio = os.getenv("CP_SHARD_MAX")
+    cap = [units / cp * float(ratio or "1.03125")] * cp
+    if caps is not None:
+        cap = [c / 2 / _GRAN for c in caps]
+        if ratio:
+            cap = [min(c, units / cp * float(ratio)) for c in cap]
+    for _ in range(cp):
+        over = sum(max(0.0, ideal[r] - cap[r]) for r in range(cp))
+        if over <= 1e-9:
+            break
+        under = [r for r in range(cp) if ideal[r] < cap[r]]
+        room = sum(cap[r] - ideal[r] for r in under)
+        ideal = [min(ideal[r], cap[r]) for r in range(cp)]
+        for r in under:
+            ideal[r] += over * (cap[r] - ideal[r]) / room if room > 0 else 0.0
+    base = [max(1, int(v)) for v in ideal]
+    rem = units - sum(base)
+    order = sorted(range(cp), key=lambda r: ideal[r] - int(ideal[r]), reverse=True)
+    i = 0
+    while rem != 0:
+        r = order[i % cp]
+        step = 1 if rem > 0 else -1
+        if base[r] + step >= 1:
+            base[r] += step
+            rem -= step
+        i += 1
+    return tuple(b * _GRAN for b in base)
+
+
+def auto():
+    return _WEIGHTS == "auto"
+
+
+def _gpu_state(gpu):
+    """(power limit W, vboost level) of physical GPU gpu, from nvidia-smi; -1 where unreadable."""
+    import re
+    import subprocess
+
+    def run(args):
+        try:
+            return subprocess.run(["nvidia-smi", *args], capture_output=True, text=True, timeout=30).stdout
+        except (OSError, subprocess.SubprocessError):
+            return ""
+
+    try:
+        pl = float(run(["--query-gpu=power.limit", "-i", str(gpu), "--format=csv,noheader,nounits"]).strip())
+    except ValueError:
+        pl = -1.0
+    m = re.search(r"vboost\s+\d+\s+(\d+)", run(["boost-slider", "-l", "-i", str(gpu)]))
+    return pl, float(m.group(1)) if m else -1.0
+
+
+def _rng_save():
+    import random
+
+    import numpy as np
+    from megatron.core.tensor_parallel.random import get_cuda_rng_tracker
+
+    return (random.getstate(), np.random.get_state(), torch.get_rng_state(), torch.cuda.get_rng_state_all(),
+            get_cuda_rng_tracker().get_states())
+
+
+def _rng_restore(st):
+    import random
+
+    import numpy as np
+    from megatron.core.tensor_parallel.random import get_cuda_rng_tracker
+
+    random.setstate(st[0])
+    np.random.set_state(st[1])
+    torch.set_rng_state(st[2])
+    torch.cuda.set_rng_state_all(st[3])
+    get_cuda_rng_tracker().set_states(st[4])
+
+
+def _cache_path(S, cp, group):
+    """Per-CP-group cache file, keyed on everything that changes the GPUs' relative speed: host, the group's
+    physical GPUs in CP rank order with each one's power limit and vboost level, the job's GPU count and GPUs
+    per node, S, cp, granularity, the memory cap and the load-time resident MLP transposes."""
+    import hashlib
+    import socket
+
+    import fp8_checkpoint
+
+    gpu = _phys_gpu(int(os.environ["LOCAL_RANK"]))
+    pl, vb = _gpu_state(gpu)
+    mine = torch.tensor([gpu, pl, vb], dtype=torch.float64, device=torch.cuda.current_device())
+    allg = [torch.empty_like(mine) for _ in range(cp)]
+    torch.distributed.all_gather(allg, mine, group=group)
+    per_gpu = [(int(x[0].item()), x[1].item(), int(x[2].item())) for x in allg]
+    key = {"host": socket.gethostname(), "gpus": per_gpu, "world": torch.distributed.get_world_size(),
+           "per_node": int(os.getenv("LOCAL_WORLD_SIZE", "0")), "S": S, "cp": cp, "gran": _GRAN,
+           "max": os.getenv("CP_SHARD_MAX", "1.03125"), "margin": _MEM_MARGIN,
+           "resident_adaptive": _residency_adaptive(),
+           "resident_base": sorted(fp8_checkpoint._resident_mlp_layers().items())}
+    h = hashlib.sha1(repr(sorted(key.items())).encode()).hexdigest()[:16]
+    d = os.getenv("CP_SHARD_CACHE_DIR") or os.path.join(os.getenv("MLPERF_ROOT", "."), "cp_shard_cache")
+    gpus = "-".join(str(g[0]) for g in per_gpu)
+    return os.path.join(d, f"{key['host']}_gpus{gpus}_{h}.json"), key
+
+
+def _cache_read(path, S, cp):
+    import json
+
+    try:
+        with open(path) as f:
+            d = json.load(f)
+        c = tuple(int(x) for x in d["chunks"])
+        res = d.get("resident_fc2")
+        res = None if res is None else [int(x) for x in res]
+    except (OSError, ValueError, KeyError, TypeError):
+        return None
+    if len(c) != cp or 2 * sum(c) != S or any(x % _GRAN for x in c) or (res is not None and len(res) != cp):
+        return None
+    return c, res
+
+
+def _cache_write(path, c, info):
+    import json
+
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    tmp = f"{path}.tmp{os.getpid()}"
+    with open(tmp, "w") as f:
+        json.dump({"chunks": list(c), "tokens": [2 * x for x in c], **info}, f)
+    os.replace(tmp, path)
+
+
+_MEM_MARGIN = int(3.0 * 2**30)     # bytes kept free on every GPU (covers allocator fragmentation) when sizing tokens and resident transposes
+_ALPHA_DEFAULT = 24 << 20  # bytes of peak memory per token before two token counts were measured (conservative)
+_ALPHA_SAFETY = 1.2        # factor on the fitted bytes per token
+
+
+def _residency_adaptive():
+    """Per-rank fc2 transpose residency is adjustable: transient transposes are on and the weights are FP8."""
+    if os.environ.get("FP8_TRANSIENT_TRANSPOSE", "0") != "1":
+        return False
+    import fp8_checkpoint
+
+    return fp8_checkpoint.mlp_layer_bytes("fc2") > 0
+
+
+def _set_residency(n):
+    import fp8_checkpoint
+
+    fp8_checkpoint.set_resident_mlp("fc2", n)
+
+
+def _set_residency_fit(n, lead=False, ranks=None):
+    """_set_residency(n), one layer fewer per OOM: building a transpose allocates it while its source is resident."""
+    while True:
+        try:
+            _set_residency(n)
+            return n
+        except torch.cuda.OutOfMemoryError:
+            if n <= 0:
+                raise
+            torch.cuda.empty_cache()
+            if lead and ranks is not None:
+                print(f"cp_shards: CP group {list(ranks)} resident fc2 {n} did not fit, "
+                      f"retrying at {n - 1}", flush=True)
+            n -= 1
+
+
+def _mem_fit(points, L):
+    """(bytes per token, base bytes, fitted) of peak = base + alpha * tokens + resident layers * L over this rank's
+    measured points; alpha from a least-squares fit (times _ALPHA_SAFETY) once two token counts were measured."""
+    ys = [(s, p - n * L) for s, n, p in points]
+    xs = sorted({s for s, _ in ys})
+    alpha, fitted = float(_ALPHA_DEFAULT), False
+    if len(xs) > 1:
+        ms = sum(s for s, _ in ys) / len(ys)
+        my = sum(y for _, y in ys) / len(ys)
+        var = sum((s - ms) ** 2 for s, _ in ys)
+        if var > 0:
+            alpha = _ALPHA_SAFETY * max(float(8 << 20), sum((s - ms) * (y - my) for s, y in ys) / var)
+            fitted = True
+    base = max(y - alpha * s for s, y in ys)
+    return alpha, base, fitted
+
+
+def _lateness(run_step, reps, cp, group):
+    """Run reps steps; return (lateness ms per step of every CP rank, step ms). Lateness of rank p = the time the
+    other ranks' consumer gates spent waiting for p's publish, from the device gate timers (cp_a2a_ce.gate_wait)."""
+    import time
+
+    import cp_a2a_ce
+
+    torch.cuda.synchronize()
+    cp_a2a_ce.gate_wait.zero_()
+    t0 = time.perf_counter()
+    for _ in range(reps):
+        run_step()
+    torch.cuda.synchronize()
+    step_ms = (time.perf_counter() - t0) * 1e3 / reps
+    allw = [torch.empty_like(cp_a2a_ce.gate_wait) for _ in range(cp)]
+    torch.distributed.all_gather(allw, cp_a2a_ce.gate_wait, group=group)
+    late = [sum(float(allw[q][p].item()) for q in range(cp) if q != p) / reps / 1e6 for p in range(cp)]
+    return late, step_ms
+
+
+CALIBRATED_MARKER = "cp_shards: calibrated, split cached; relaunch on the cache"
+
+
+def calibrate(run_step, reset_graphs, run_eval, amax_history_len, S):
+    """Warmup, before the training graph capture: set the per-CP-group split (CP_SHARD_WEIGHTS=auto).
+
+    A cached split (same host, GPUs, power limits, vboost, GPU counts, S, cp, granularity, cap) is used as is and
+    nothing runs. Otherwise every iteration sets a split, resets the CUDA graphs (reset_graphs), runs one warmup
+    step, the capture step and timed steps through run_step (the training forward-backward, graphed or not), and
+    reads each rank's lateness from the gate timers. The next split moves tokens from late ranks to early ones:
+    the per-token cost is estimated from the step time, the move is damped and capped for memory; with cp 2 a
+    bisection on the sign of the lateness difference takes over once two measured splits bracket zero. The
+    measured split with the smallest lateness spread wins and is cached, and the process exits: the launcher runs
+    again on the cache (see the end of this function). Every rank runs the same number of steps (the steps have
+    collectives across CP groups). amax_history_len is unused (kept for the caller's signature)."""
+    global _tables
+    if not auto():
+        return
+    from megatron.core import parallel_state as ps
+
+    group = ps.get_context_parallel_group()
+    ranks = tuple(torch.distributed.get_process_group_ranks(group))
+    cp = len(ranks)
+    if cp < 2:
+        return
+    lead = torch.distributed.get_rank() == ranks[0]
+    path, key = _cache_path(S, cp, group)
+    cached = None if os.getenv("CP_SHARD_RECALIBRATE", "0") == "1" else _cache_read(path, S, cp)
+    have = torch.tensor([1.0 if cached is not None else 0.0], device=torch.cuda.current_device())
+    torch.distributed.all_reduce(have, op=torch.distributed.ReduceOp.MIN)
+    me = torch.distributed.get_rank(group)
+    adaptive = _residency_adaptive()
+    if have.item() > 0:
+        c, res = cached
+        _forced[ranks] = (S, c)
+        _tables = {}
+        if adaptive and res is not None:
+            _set_residency(res[me])
+        if lead:
+            print(f"cp_shards: CP group {list(ranks)} split {[2 * x for x in c]} resident fc2 {res} from {path}",
+                  flush=True)
+        torch.distributed.barrier()
+        return
+    iters, reps, damp = _CAL_ITERS, _CAL_REPS, _CAL_DAMP
+    fixed = _FIXED_FRAC
+    rng = _rng_save()
+    c = (S // (2 * cp),) * cp
+    caps = None
+    if adaptive:
+        import fp8_checkpoint
+
+        L = fp8_checkpoint.mlp_layer_bytes("fc2")
+        nl = fp8_checkpoint.mlp_layer_count("fc2")
+        n_res = fp8_checkpoint.resident_mlp_count("fc2")
+        reset_graphs()
+        free, total = torch.cuda.mem_get_info()
+        usable = total - ((total - free) - torch.cuda.memory_reserved()) - _MEM_MARGIN
+        # Iteration 0 measures the rank's real memory point, so it must not assume any residency: the
+        # load-time count (e.g. fc2:42) has no measured base behind it and OOMs before the model exists.
+        # Start fully transient; every later iteration sizes residency from the fitted model.
+        n_loaded = n_res
+        n_res = 0
+        if lead:
+            print(f"cp_shards: CP group {list(ranks)} first-step resident fc2 0 of {n_loaded} loaded (usable {usable / 2**30:.1f} GiB, {L / 2**20:.1f} MiB/layer)",
+                  flush=True)
+        points = []                                    # (tokens, resident layers, peak reserved bytes) of this rank
+    seen = {}                                          # split -> (n, summed lateness per rank)
+    hist = []                                          # cp 2: (rank 0 tokens, lateness of rank 1 - rank 0)
+    for it in range(iters):
+        _forced[ranks] = (S, c)
+        _tables = {}
+        reset_graphs()
+        if adaptive:
+            n_res = _set_residency_fit(n_res, lead=lead, ranks=ranks)
+            torch.cuda.reset_peak_memory_stats()
+        run_step()                                     # warmup step (new shapes)
+        run_step()                                     # capture step when graphed
+        late, step_ms = _lateness(run_step, reps, cp, group)
+        if adaptive:
+            run_eval()                                 # the evaluation graph shares the pool: part of the peak
+            points.append((2 * c[me], n_res, torch.cuda.max_memory_reserved()))
+            alpha, base, fitted = _mem_fit(points, L)
+            mine = torch.tensor([float((usable - base) / alpha)], dtype=torch.float64,
+                                device=torch.cuda.current_device())
+            allc = [torch.empty_like(mine) for _ in range(cp)]
+            torch.distributed.all_gather(allc, mine, group=group)
+            caps = [float(x.item()) for x in allc]
+        if _seen_S != S:
+            raise RuntimeError(f"cp_shards: calibration expected sequence length {S}, the decoder saw {_seen_S}")
+        n, acc = seen.get(c, (0, [0.0] * cp))
+        seen[c] = (n + 1, [acc[r] + late[r] for r in range(cp)])
+        s = [2 * x for x in c]
+        # moving one token off rank p shortens its step by about step * (1 - fixed) / s_p
+        g = [step_ms * (1.0 - fixed) / s[p] for p in range(cp)]
+        mean_late = sum(late) / cp
+        step = [s[p] - damp * (late[p] - mean_late) / g[p] for p in range(cp)]
+        if cp == 2:
+            hist.append((s[0], late[1] - late[0]))
+            # hi: the largest rank 0 share with rank 1 late (needs more on rank 0); lo: the smallest with rank 0 late
+            hi = max((h for h in hist if h[1] > 0), default=None, key=lambda h: h[0])
+            lo = min((h for h in hist if h[1] < 0), default=None, key=lambda h: h[0])
+            if lo is not None and hi is not None and lo[0] > hi[0]:
+                x = hi[0] + (lo[0] - hi[0]) * hi[1] / (hi[1] - lo[1])
+                step = [x, S - x]
+        c_new = _round(step, S, caps)
+        if adaptive:
+            n_fit = max(0, min(nl, int((usable - base - alpha * 2 * c_new[me]) // L)))
+            # until the bytes per token are measured, residency only goes down (a rank that gains tokens gives
+            # up transposes to stay under its measured peak)
+            n_res = n_fit if fitted else min(n_res, n_fit)
+        if lead:
+            print(f"cp_shards: calibration {it} CP group {list(ranks)} tokens {s} lateness ms/step "
+                  f"{[round(x, 1) for x in late]} step {step_ms:.0f} ms"
+                  + (f" token caps {[int(x) for x in caps]} alpha {alpha / 2**20:.1f} MiB/token"
+                     f"{'' if fitted else ' (default)'} resident fc2 next {n_res}" if caps else "")
+                  + f" -> next {[2 * x for x in c_new]}", flush=True)
+        c = c_new
+    mean = {k: [v / n for v in acc] for k, (n, acc) in seen.items()}
+    c = min(mean, key=lambda k: max(mean[k]) - min(mean[k]))
+    res = None
+    if adaptive:
+        alpha, base, fitted = _mem_fit(points, L)
+        # one layer below the fit: the transpose being built is allocated while its source is resident
+        n_fit = max(0, min(nl, int((usable - base - alpha * 2 * c[me]) // L) - 1))
+        n_res = n_fit if fitted else min(n_res, n_fit)
+        n_res = _set_residency_fit(n_res, lead=lead, ranks=ranks)
+        mine = torch.tensor([n_res], device=torch.cuda.current_device())
+        alln = [torch.empty_like(mine) for _ in range(cp)]
+        torch.distributed.all_gather(alln, mine, group=group)
+        res = [int(x.item()) for x in alln]
+    if lead:
+        print(f"cp_shards: CP group {list(ranks)} split {[2 * x for x in c]} resident fc2 {res} (lateness spread "
+              f"{round(max(mean[c]) - min(mean[c]), 1)} ms/step; measured "
+              f"{ {str([2 * x for x in k]): [round(v, 1) for v in m] for k, m in mean.items()} })", flush=True)
+        _cache_write(path, c, {"key": key, "resident_fc2": res,
+                               "lateness_ms": {str([2 * x for x in k]): [round(v, 1) for v in m]
+                                               for k, m in mean.items()}})
+    # Training never continues in the process that calibrated. The calibration steps leave transformer_engine
+    # state behind (FP8 scaling of weights, amax histories, one-time first-step transitions) that no restore
+    # reproduced: such runs diverged (step-1 grad norm 1e4-1e5 against 49) while a run on the same cached split
+    # converged. So write the cache, end every rank here, and the launcher starts the run again on the cache
+    # (h200-tuning/run_rcp*.sh: CALIBRATED_MARKER in the log).
+    torch.cuda.synchronize()
+    torch.distributed.barrier()
+    if torch.distributed.get_rank() == 0:
+        print(CALIBRATED_MARKER, flush=True)
+    torch.distributed.barrier()
+    sys.stdout.flush()
+    sys.stderr.flush()
+    os._exit(0)
+
+
+def offsets(c):
+    """Global start of each of the 2cp chunks for chunk sizes c."""
+    cp = len(c)
+    sizes = [c[k] if k < cp else c[2 * cp - 1 - k] for k in range(2 * cp)]
+    off, o = [], 0
+    for s in sizes:
+        off.append(o)
+        o += s
+    return off
+
+
+def _owned(r, c):
+    """Global token ids of rank r under chunk sizes c, in local order (ascending)."""
+    cp = len(c)
+    off = offsets(c)
+    a = list(range(off[r], off[r] + c[r]))
+    b = list(range(off[2 * cp - 1 - r], off[2 * cp - 1 - r] + c[r]))
+    return a + b
+
+
+def local_positions(S, c, r, device):
+    """Global sequence position of every local token of rank r (int64 [2 * c_r])."""
+    return torch.tensor(_owned(r, c), dtype=torch.int64, device=device)
+
+
+def _plan(S, c_src, c_dst, me, device):
+    key = (S, c_src, c_dst, me, str(device))
+    p = _maps.get(key)
+    if p is not None:
+        return p
+    cp = len(c_src)
+    src = [_owned(r, c_src) for r in range(cp)]
+    dst = [_owned(r, c_dst) for r in range(cp)]
+    dst_owner = {}
+    for r in range(cp):
+        for t in dst[r]:
+            dst_owner[t] = r
+    mine = src[me]
+    pos_in_mine = {t: i for i, t in enumerate(mine)}
+    send_idx, send_splits = [], []
+    for q in range(cp):
+        ts = [t for t in mine if dst_owner[t] == q]
+        send_idx += [pos_in_mine[t] for t in ts]
+        send_splits.append(len(ts))
+    recv_ids, recv_splits = [], []
+    dst_set = set(dst[me])
+    for q in range(cp):
+        ts = [t for t in src[q] if t in dst_set]
+        recv_ids += ts
+        recv_splits.append(len(ts))
+    pos_in_dst = {t: i for i, t in enumerate(dst[me])}
+    recv_pos = torch.tensor([pos_in_dst[t] for t in recv_ids], dtype=torch.int64, device=device)
+    send = torch.tensor(send_idx, dtype=torch.int64, device=device)
+    p = (send, send_splits, recv_pos, torch.argsort(recv_pos), recv_splits, torch.argsort(send))
+    _maps[key] = p
+    return p
+
+
+def _move(x, plan, cp_group):
+    send, ssp, _, perm, rsp, _ = plan
+    buf = x.index_select(0, send).contiguous()
+    out = torch.empty((sum(rsp),) + tuple(x.shape[1:]), dtype=x.dtype, device=x.device)
+    torch.distributed.all_to_all_single(out, buf, output_split_sizes=rsp, input_split_sizes=ssp, group=cp_group)
+    return out.index_select(0, perm)
+
+
+def _move_back(g, plan, cp_group):
+    send, ssp, recv_pos, _, rsp, inv_send = plan
+    gbuf = g.index_select(0, recv_pos).contiguous()
+    out = torch.empty((sum(ssp),) + tuple(g.shape[1:]), dtype=g.dtype, device=g.device)
+    torch.distributed.all_to_all_single(out, gbuf, output_split_sizes=ssp, input_split_sizes=rsp, group=cp_group)
+    return out.index_select(0, inv_send)
+
+
+class _Reshard(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, plan, cp_group):
+        ctx.plan, ctx.cp_group = plan, cp_group
+        return _move(x, plan, cp_group)
+
+    @staticmethod
+    def backward(ctx, g):
+        return _move_back(g.contiguous(), ctx.plan, ctx.cp_group), None, None
+
+
+def reshard(x, S, c_src, c_dst, cp_group):
+    """x [s_local, ...] in the layout of chunk sizes c_src -> the layout of c_dst (dim 0 is the sequence)."""
+    if c_src == c_dst:
+        return x
+    me = torch.distributed.get_rank(cp_group)
+    plan = _plan(S, c_src, c_dst, me, x.device)
+    if x.requires_grad:
+        return _Reshard.apply(x, plan, cp_group)
+    return _move(x, plan, cp_group)
+
+
+def _wrap_block(orig):
+    def forward(self, hidden_states, attention_mask, *args, **kwargs):
+        global active
+        from megatron.core import parallel_state as ps
+
+        cp = ps.get_context_parallel_world_size()
+        if cp < 2 or not torch.is_tensor(hidden_states):
+            return orig(self, hidden_states, attention_mask, *args, **kwargs)
+        if args:
+            raise RuntimeError("cp_shards: TransformerBlock.forward positional arguments past attention_mask")
+        for k in ("context", "packed_seq_params", "padding_mask", "attention_bias", "rotary_pos_cos",
+                  "rotary_pos_sin", "rotary_pos_cos_sin", "sequence_len_offset", "inference_context",
+                  "inference_params"):
+            if kwargs.get(k) is not None:
+                raise RuntimeError(f"cp_shards: TransformerBlock.forward with {k} is not supported")
+        if attention_mask is not None:
+            raise RuntimeError("cp_shards: an explicit attention mask is not supported (causal only)")
+        group = ps.get_context_parallel_group()
+        s_local = hidden_states.shape[0]
+        S = s_local * cp
+        even = tuple([S // (2 * cp)] * cp)
+        c = chunks(S, group)
+        if c == even:
+            active = None
+            return orig(self, hidden_states, attention_mask, **kwargs)
+        rope = kwargs.get("rotary_pos_emb")
+        if rope is not None:
+            if not torch.is_tensor(rope) or rope.shape[0] != s_local:
+                raise RuntimeError("cp_shards: rotary_pos_emb must be a per-token tensor of the local length")
+            kwargs["rotary_pos_emb"] = reshard(rope, S, even, c, group)
+        hs = reshard(hidden_states, S, even, c, group)
+        # stays set after the call: the backward of this microbatch (exchanges, dropout positions) runs later
+        # under the same table
+        active = (S, c)
+        out = orig(self, hs, attention_mask, **kwargs)
+        if not torch.is_tensor(out):
+            raise RuntimeError("cp_shards: TransformerBlock.forward returned a tuple")
+        return reshard(out, S, c, even, group)
+
+    forward._cp_shards = True
+    return forward
+
+
+def install():
+    """Patch TransformerBlock.forward for uneven shards. CP_SHARD_WEIGHTS unset, off or equal weights: equal shards."""
+    global _WEIGHTS
+    raw = os.getenv("CP_SHARD_WEIGHTS", "").strip()
+    if raw in ("", "off"):
+        return
+    if raw == "auto":
+        w = "auto"
+    else:
+        w = [float(x) for x in raw.split(",")]
+        if len(set(w)) == 1:
+            return
+    if os.getenv("NVTE_FAV3_FP8_FWD", "0") != "1" or os.getenv("NVTE_FAV3_FP8_BWD", "0") != "1":
+        raise RuntimeError("cp_shards: uneven shards need the FA3 FP8 attention path (NVTE_FAV3_FP8_FWD/BWD=1)")
+    if os.getenv("CP_A2A_COMM", "nccl") not in ("ce", "tma"):
+        raise RuntimeError("cp_shards: uneven shards need CP_A2A_COMM=ce or tma")
+    if int(os.getenv("NVTE_CP_A2A_HEAD_CHUNKS", "1")) > 1:
+        raise RuntimeError("cp_shards: uneven shards do not support NVTE_CP_A2A_HEAD_CHUNKS > 1")
+    _WEIGHTS = w
+    from megatron.core.transformer.transformer_block import TransformerBlock
+
+    if getattr(TransformerBlock.forward, "_cp_shards", False):
+        return
+    TransformerBlock.forward = _wrap_block(TransformerBlock.forward)
+    if int(os.environ.get("RANK", "0")) == 0:
+        print(f"cp_shards: installed (weights {w}, granularity {_GRAN})", flush=True)
