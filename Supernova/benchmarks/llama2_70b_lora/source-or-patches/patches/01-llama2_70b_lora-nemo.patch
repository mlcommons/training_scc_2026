+"""Bit-preserving V layout for Hopper FP8 attention forward."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _transpose_v_bits(src, dst, S: tl.constexpr, H: tl.constexpr,
+                      stride_b: tl.constexpr, stride_s: tl.constexpr,
+                      stride_h: tl.constexpr,
+                      BLOCK_S: tl.constexpr, BLOCK_D: tl.constexpr,
+                      PERMUTE: tl.constexpr = False):
+    s = tl.program_id(0) * BLOCK_S + tl.arange(0, BLOCK_S)
+    d = tl.program_id(1) * BLOCK_D + tl.arange(0, BLOCK_D)
+    bh = tl.program_id(2)
+    b, h = bh // H, bh % H
+    offset = b.to(tl.int64) * stride_b + h.to(tl.int64) * stride_h
+    # A WGMMA FP8 register at k=4*t+2*j+p receives P at 8*j+2*t+p
+    # after permute_Cregs_fp8. Put the matching V row at that same k.
+    tok = (s & ~15) + ((s & 2) << 2) + ((s & 12) >> 1) + (s & 1) if PERMUTE else s
+    x = tl.load(src + offset + tok.to(tl.int64)[:, None] * stride_s + d[None, :],
+                mask=(tok < S)[:, None], other=0)
+    # src/dst are uint8: no floating-point conversion, saturation or rounding.
+    out = (bh.to(tl.int64) * 128 + d[:, None]) * S + s[None, :]
+    tl.store(dst + out, tl.trans(x), mask=(s < S)[None, :])
+
+
+@triton.jit
+def _transpose_v_words(src, dst, S: tl.constexpr, H: tl.constexpr,
+                       stride_b: tl.constexpr, stride_s: tl.constexpr,
+                       stride_h: tl.constexpr, PERMUTE: tl.constexpr):
+    # Each logical element handles a 4x4 byte tile. Global traffic and shared
+    # relayout use uint32 instead of scalar uint8; PRMT preserves every bit.
+    s4 = tl.program_id(0) * 16 + tl.arange(0, 16)
+    d4 = tl.program_id(1) * 16 + tl.arange(0, 16)
+    bh = tl.program_id(2)
+    b, h = bh // H, bh % H
+    row = s4 * 4
+    r0 = (row & ~15) + ((row & 12) >> 1) if PERMUTE else row
+    r2 = r0 + 8 if PERMUTE else r0 + 2
+    base = b.to(tl.int64) * stride_b + h.to(tl.int64) * stride_h + d4[None, :]
+    x0 = tl.load(src + base + r0.to(tl.int64)[:, None] * stride_s, mask=(row < S)[:, None], other=0)
+    x1 = tl.load(src + base + (r0 + 1).to(tl.int64)[:, None] * stride_s, mask=(row < S)[:, None], other=0)
+    x2 = tl.load(src + base + r2.to(tl.int64)[:, None] * stride_s, mask=(row < S)[:, None], other=0)
+    x3 = tl.load(src + base + (r2 + 1).to(tl.int64)[:, None] * stride_s, mask=(row < S)[:, None], other=0)
+    y0, y1, y2, y3 = tl.inline_asm_elementwise(
+        """{ .reg .b32 a, b, c, d;
+            prmt.b32 a, $4, $5, 0x5140; prmt.b32 b, $4, $5, 0x7362;
+            prmt.b32 c, $6, $7, 0x5140; prmt.b32 d, $6, $7, 0x7362;
+            prmt.b32 $0, a, c, 0x5410; prmt.b32 $1, a, c, 0x7632;
+            prmt.b32 $2, b, d, 0x5410; prmt.b32 $3, b, d, 0x7632;
+        }""", constraints="=r,=r,=r,=r,r,r,r,r", args=[x0, x1, x2, x3],
+        dtype=(tl.uint32, tl.uint32, tl.uint32, tl.uint32), is_pure=True, pack=1)
+    # join's last dimension varies fastest: this order flattens to y0,y1,y2,y3.
+    # One relayout avoids the seven barriers of four separate transposed stores.
+    y = tl.reshape(tl.join(tl.join(y0, y2), tl.join(y1, y3)), (16, 64))
+    d = tl.program_id(1) * 64 + tl.arange(0, 64)
+    out = (bh.to(tl.int64) * 128 + d[:, None]) * (S // 4) + s4[None, :]
+    tl.store(dst + out, tl.trans(y), mask=(row < S)[None, :])
+
+
+def transpose_v(v, *, permute_tokens=False, packed=False):
+    """[b,s,h,128] e4m3 -> sequence-contiguous view with the same shape.
+
+    With permute_tokens=True, pass v_seq_permuted=True to the native fwd op.
+    The returned view's strides alone cannot describe the token permutation.
+    The allocation belongs to this forward call. Callers must save the
+    original V for backward, not this scratch tensor. No module-level cache:
+    a serial CUDA graph can reuse the scratch allocation across layers.
+    """
+    if v.ndim != 4 or v.shape[-1] != 128 or v.stride(-1) != 1:
+        raise ValueError("V must have shape [b,s,h,128] and contiguous head dimension")
+    if v.dtype != torch.float8_e4m3fn or v.shape[1] % 16:
+        raise ValueError("V must be e4m3 with sequence length divisible by 16")
+    b, s, h, d = v.shape
+    tmp = torch.empty((b, h, d, s), dtype=torch.uint8, device=v.device)
+    if packed:
+        if any(v.stride(i) % 4 for i in range(3)):
+            raise ValueError("Packed V transpose requires four-byte-aligned outer strides")
+        _transpose_v_words[(triton.cdiv(s, 64), 2, b * h)](
+            v.view(torch.uint8).view(torch.uint32), tmp.view(torch.uint32), s, h,
+            v.stride(0) // 4, v.stride(1) // 4, v.stride(2) // 4,
+            PERMUTE=permute_tokens, num_warps=4)
+    else:
+        _transpose_v_bits[(triton.cdiv(s, 64), 2, b * h)](
+            v.view(torch.uint8), tmp, s, h, v.stride(0), v.stride(1), v.stride(2),
+            BLOCK_S=64, BLOCK_D=64, PERMUTE=permute_tokens, num_warps=4)
+    return tmp.view(torch.float8_e4m3fn).permute(0, 3, 1, 2)
