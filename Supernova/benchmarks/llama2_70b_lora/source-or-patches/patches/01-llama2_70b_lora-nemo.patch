+        self.max_steps = cfg.trainer.max_steps
+        self.log_every_n_steps = int(os.getenv("TRAIN_LOSS_LOG_INTERVAL", str(cfg.trainer.log_every_n_steps)))
+        self.log_diagnostics = bool(os.getenv("TRAIN_LOSS_LOG_INTERVAL"))
+        self.t0 = 0
+        self._pending = None
+        self._prev_ev = None
+
+    @staticmethod
+    def _mark():
+        ev = torch.cuda.Event(enable_timing=True)
+        ev.record()
+        return ev
+
+    @staticmethod
+    def _to_host(v):
+        if torch.is_tensor(v):
+            buf = torch.empty(v.shape, dtype=torch.float32, pin_memory=True)
+            buf.copy_(v.detach().float(), non_blocking=True)
+            return buf
+        return v
+
+    @staticmethod
+    def _host_float(v):
+        if v is None:
+            return None
+        return float(v.reshape(-1)[0]) if torch.is_tensor(v) else float(v)
+
+    def _emit(self, rec):
+        rec["ev"].synchronize()
+        d = rec["prev_ev"].elapsed_time(rec["ev"]) / 1000.0 if rec["prev_ev"] is not None else rec["d"]
+        diagnostic = {}
+        if rec["diag"] is not None:
+            diagnostic = {
+                "learning_rate": self._host_float(rec["diag"]["lr"]),
+                "grad_norm": self._host_float(rec["diag"]["grad_norm"]),
+                "skipped_iter": rec["diag"]["skipped_iter"],
+            }
+        mllogger.event(
+            key="tracked_stats",
+            metadata={mllogger.constants.SAMPLES_COUNT: self.global_batch_size * rec["step"]},
+            value={
+                "train_step_time": d,
+                # only the last pipeline stage computes the loss
+                "reduced_train_loss": self._host_float(rec["loss"]),
+                **diagnostic,
+            },
+        )
+
+    def _flush(self):
+        if self._pending is not None:
+            rec, self._pending = self._pending, None
+            self._emit(rec)
 
