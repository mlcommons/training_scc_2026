+"""Load high-precision checkpoints into primary FP8 weights without scale-1 loss.
+
+Megatron must stage checkpoint shards in high precision before factory merges.
+Quantize the assembled local parameter once, using its own amax. Calibrating
+individual checkpoint pieces would corrupt earlier pieces sharing scale_inv.
+"""
+import logging
+import os
+import re
+
+import torch
+from transformer_engine.pytorch.tensor.float8_tensor import Float8Tensor, Float8Quantizer
+from transformer_engine_torch import DType
+
+logger = logging.getLogger(__name__)
+
+
+def install_cpu_checkpoint_staging():
+    """Stage FP8 destinations in host precision for DCP loading.
+
+    Host staging keeps the assembled-weights peak off the GPUs; the fully
+    parallel load exchanges pieces per-tensor through CUDA and restores the
+    original device afterwards (megatron.core.dist_checkpointing.exchange_utils)."""
+    import megatron.core.dist_checkpointing.serialization as serialization
+    from megatron.core.dist_checkpointing.dict_utils import nested_values
+    from megatron.core.fp8_utils import dequantize_fp8_tensor, is_float8tensor
+
+    def stage(sharded_state_dict):
+        with torch.no_grad():
+            for value in nested_values(sharded_state_dict):
+                if hasattr(value, "data") and is_float8tensor(value.data):
+                    # Preserve initialized values for any checkpoint-missing
+                    # fields. The streaming load stages one layer group at a
+                    # time and keeps it on the GPU; a whole-model load stages
+                    # on the host (the full bf16 shard does not fit the GPU).
+                    value.data = dequantize_fp8_tensor(value.data)
+                    if not _STREAMING:
+                        value.data = value.data.cpu()
+
+    serialization.force_all_tensors_to_non_fp8 = stage
+    _install_streaming_load()
+
+
+def _calibrate(param, source):
+    quantizer = param._get_quantizer()
+    if not isinstance(quantizer, Float8Quantizer):
+        return
+    # Amax is computed after all checkpoint pieces (including SwiGLU's
+    # gate/up halves) have been assembled into one local weight.
+    amax = source.detach().abs().amax().float()
+    fp8_max = 448.0 if quantizer.dtype == DType.kFloat8E4M3 else 57344.0
+    scale = torch.where(amax > 0, fp8_max / amax, torch.ones_like(amax))
+    quantizer.scale.copy_(scale.reshape_as(quantizer.scale))
+    quantizer.amax.copy_(amax.reshape_as(quantizer.amax))
+    # Rebuild the transpose from the newly loaded payload when dgrad
+    # first asks for it; don't retain the initialized weight's copy.
+    param.update_usage(rowwise_usage=True, columnwise_usage=False)
+    quantizer.set_usage(rowwise=True, columnwise=False)
+
+
+def _build_transpose(param):
+    # Build the transpose from the final payload after copying. This avoids
+    # both stale initialized bytes and a separate TE RTC transpose at the
+    # first backward call. FP8_TRANSIENT_TRANSPOSE=1 skips it for every weight
+    # except the resident attention qkv and proj weights: TE's dgrad builds the
+    # transpose and drops it after the GEMM
+    # (patches/03-transformer-engine/08-te-transient-transpose.patch), and
+    # keeps a transpose that is already valid.
+    if (os.environ.get("FP8_TRANSIENT_TRANSPOSE", "0") == "1"
+            and id(param) not in _WT_PERSIST_PARAMS):
+        return
+    param._transpose = param._data.movedim(-1, 0).contiguous()
+    param._transpose_invalid = False
+    param._get_quantizer().set_usage(rowwise=True, columnwise=True)
+
+
+def _calibrate_loaded_weights(module, state_dict, prefix, local_metadata, strict,
+                              missing_keys, unexpected_keys, error_msgs):
+    del local_metadata, strict, missing_keys, unexpected_keys, error_msgs
+    with torch.no_grad():
+        for name, param in module.named_parameters(recurse=False):
+            if not isinstance(param, Float8Tensor):
+                continue
+            source = state_dict.get(prefix + name)
+            if source is None:
+                continue
+            if source is _LOADED:
+                # Already calibrated and copied by the streaming load.
+                del state_dict[prefix + name]
+                continue
+            if isinstance(source, Float8Tensor):
+                raise RuntimeError(
+                    "FP8 checkpoint data was quantized before shard assembly; "
+                    "keep Megatron's force_all_tensors_to_non_fp8 load staging enabled")
+            _calibrate(param, source)
+
+
+def _finish_loaded_weights(module, incompatible_keys):
+    # Keys the streaming load already applied were removed from the state
+    # dict by the pre-hook; they are not missing.
+    if _LOADED_KEYS:
+        incompatible_keys.missing_keys[:] = [
+            k for k in incompatible_keys.missing_keys if k not in _LOADED_KEYS
+        ]
+    for param in module.parameters(recurse=False):
+        if isinstance(param, Float8Tensor) and id(param) not in _LOADED_PARAMS:
+            _build_transpose(param)
+
+
+def prepare_fp8_checkpoint_load(model):
+    """Release initial transposes and calibrate each fully assembled weight."""
+    count = 0
+    for module in model.modules():
+        params = [p for p in module.parameters(recurse=False)
+                  if isinstance(p, Float8Tensor)]
+        if not params:
+            continue
+        for param in params:
+            param.update_usage(rowwise_usage=True, columnwise_usage=False)
+            param._get_quantizer().set_usage(rowwise=True, columnwise=False)
+        module.register_load_state_dict_pre_hook(_calibrate_loaded_weights)
+        module.register_load_state_dict_post_hook(_finish_loaded_weights)
+        count += len(params)
+    for mname, module in model.named_modules():
+        for pname, param in module.named_parameters(recurse=False):
+            if isinstance(param, Float8Tensor):
+                _FP8_PARAMS[f"{mname}.{pname}" if mname else pname] = param
+    logger.info("FP8 checkpoint load: high-precision staging and calibrated scales for %d weights", count)
+    if os.environ.get("FP8_TRANSIENT_TRANSPOSE", "0") == "1":
+        _select_persistent_transposes()
+
+
+_WT_PERSIST_PARAMS = {}  # id(param) -> state-dict key of a weight whose transpose stays resident
+_WT_PERSIST_RE = re.compile(r"(?:^|\.)(?:linear_qkv|linear_proj)\.(?:.*\.)?weight$")
+# WT_RESIDENT_MLP="fc1:N1,fc2:N2" also keeps the fc1 / fc2 transpose of the first N layers resident.
+_WT_MLP_RE = re.compile(r"(?:^|\.)linear_(fc1|fc2)\.(?:.*\.)?weight$")
+
+
+def _resident_mlp_layers():
+    """Parse WT_RESIDENT_MLP ("fc1:N,fc2:M") into {"fc1": N, "fc2": M}."""
+    counts = {"fc1": 0, "fc2": 0}
+    for item in filter(None, (x.strip() for x in os.environ.get("WT_RESIDENT_MLP", "").split(","))):
+        name, _, n = item.partition(":")
+        if name not in counts or not n.isdigit():
+            raise ValueError(f"WT_RESIDENT_MLP: bad entry {item!r} (expected fc1:N or fc2:N)")
+        counts[name] = int(n)
+    return counts
+
+
+def _select_persistent_transposes():
+    """Keep the FP8 transpose of the attention qkv and output projection weights resident.
+
+    The base weights are frozen, so W^T is built once at load (_build_transpose)
+    and TE's dgrad finds it valid and keeps it. All other FP8 weights keep the
+    transient transpose. A persisted transpose that an in-place weight update
+    invalidates is rebuilt into the same buffer before its next dgrad, so CUDA
+    graphs that captured its address stay valid.
+    """
+    nbytes = 0
+    mlp_layers = _resident_mlp_layers()
+    attn_resident = os.environ.get("WT_RESIDENT_ATTN", "1") != "0"  # 0: qkv/proj transposes are transient too
+    for key, param in _FP8_PARAMS.items():
+        if _WT_PERSIST_RE.search(key):
+            if not attn_resident:
+                continue
+        else:
+            mlp, layer = _WT_MLP_RE.search(key), _LAYER_RE.search(key)
+            if not (mlp and layer and int(layer.group(1)) < mlp_layers[mlp.group(1)]):
+                continue
+        _WT_PERSIST_PARAMS[id(param)] = key
+        nbytes += param._data.numel() * param._data.element_size()
+    _install_persistent_transpose_dgrad()
+    logger.info("FP8 checkpoint load: resident transpose for %d weights (%.2f GiB)",
+                len(_WT_PERSIST_PARAMS), nbytes / 2**30)
+
+
+def mlp_layer_bytes(name="fc2"):
+    """Bytes of one layer's FP8 weight transpose of the named MLP linear (fc1 or fc2), 0 if none is loaded."""
+    for key, param in _FP8_PARAMS.items():
+        m = _WT_MLP_RE.search(key)
+        if m and m.group(1) == name and _LAYER_RE.search(key):
+            return param._data.numel() * param._data.element_size()
+    return 0
+
+
+def mlp_layer_count(name="fc2"):
+    """Number of transformer layers holding an FP8 weight of the named MLP linear."""
+    n = 0
+    for key in _FP8_PARAMS:
+        m, layer = _WT_MLP_RE.search(key), _LAYER_RE.search(key)
+        if m and layer and m.group(1) == name:
+            n = max(n, int(layer.group(1)) + 1)
+    return n
+
+
+def resident_mlp_count(name="fc2"):
+    """Number of leading layers whose named MLP weight transpose is resident."""
+    n = 0
+    for key, param in _FP8_PARAMS.items():
+        m, layer = _WT_MLP_RE.search(key), _LAYER_RE.search(key)
+        if m and layer and m.group(1) == name and id(param) in _WT_PERSIST_PARAMS:
+            n = max(n, int(layer.group(1)) + 1)
+    return n
+
+
+def set_resident_mlp(name, n):
+    """Make the named MLP weight transpose resident for layers < n and transient for the others, on this rank.
+    Valid between steps, before a CUDA graph capture (the resident buffers move). Needs FP8_TRANSIENT_TRANSPOSE=1:
+    without it every transpose is resident."""
+    if os.environ.get("FP8_TRANSIENT_TRANSPOSE", "0") != "1":
+        raise RuntimeError("set_resident_mlp needs FP8_TRANSIENT_TRANSPOSE=1")
+    with torch.no_grad():
+        for key, param in _FP8_PARAMS.items():
+            m, layer = _WT_MLP_RE.search(key), _LAYER_RE.search(key)
+            if not (m and layer and m.group(1) == name):
+                continue
+            want = int(layer.group(1)) < n
+            if want and id(param) not in _WT_PERSIST_PARAMS:
+                _WT_PERSIST_PARAMS[id(param)] = key
+                _build_transpose(param)
+            elif not want and id(param) in _WT_PERSIST_PARAMS:
+                del _WT_PERSIST_PARAMS[id(param)]
+                param.update_usage(rowwise_usage=True, columnwise_usage=False)
+                param._get_quantizer().set_usage(rowwise=True, columnwise=False)
+    _install_persistent_transpose_dgrad()
+
+
+def _install_persistent_transpose_dgrad():
+    from transformer_engine.pytorch.ops.basic.basic_linear import BasicLinear
+
+    orig = BasicLinear._functional_backward
+    if getattr(orig, "_wt_persist", False):
+        return
+
+    def _functional_backward(*args, **kwargs):
+        weight = kwargs.get("weight", args[2] if len(args) > 2 else None)
+        if weight is not None and id(weight) in _WT_PERSIST_PARAMS \
+                and weight._transpose is not None and weight._transpose_invalid:
+            weight._create_transpose()
+        return orig(*args, **kwargs)
+
+    _functional_backward._wt_persist = True
+    BasicLinear._functional_backward = staticmethod(_functional_backward)
+
+
+_FP8_PARAMS = {}       # model state-dict key -> primary FP8 parameter
+_LOADED = object()     # state-dict value: the streaming load already applied this key
+_LOADED_KEYS = set()
+_LOADED_PARAMS = set()
+_STREAMING = False
+_LAYER_RE = re.compile(r"(?:^|\.)layers\.(\d+)\.")
+
+
+def _install_streaming_load():
+    """Load the base checkpoint in groups of LOAD_GROUP_LAYERS transformer layers.
+
+    The whole-model load stages every FP8 weight's high-precision shard in host
+    memory at once, a per-rank peak multiplied by the ranks of a node. Per group, the
+    pieces are staged on the GPU, merged, calibrated, copied into the primary
+    FP8 weights and freed before the next group: the same arithmetic as the
+    whole-model path (amax of the assembled weight, the same quantize copy and
+    transpose), with a small, bounded staging peak. LOAD_STREAM=0 restores the
+    whole-model host-staged load. LOAD_THREADS (default: half the CPUs; 1
+    leaves torch's setting) sets the torch intra-op threads for either path.
+    """
+    import megatron.core.dist_checkpointing as dist_checkpointing
+
+    whole_load = dist_checkpointing.load
+
+    def load(*args, **kwargs):
+        # LOAD_THREADS (default: half the CPUs) gives the load's host-side
+        # tensor work that many intra-op threads; torchrun pins OMP_NUM_THREADS=1.
+        threads = int(os.environ.get("LOAD_THREADS", str(max(1, os.cpu_count() // 2))))
+        if threads == 1:
+            return _load(*args, **kwargs)
+        prev = torch.get_num_threads()
+        torch.set_num_threads(threads)
+        try:
+            return _load(*args, **kwargs)
+        finally:
+            torch.set_num_threads(prev)
+
+    def _load(sharded_state_dict, checkpoint_dir, *args, **kwargs):
+        global _STREAMING
+        model_sd = sharded_state_dict.get("model") if isinstance(sharded_state_dict, dict) else None
+        if (os.environ.get("LOAD_STREAM", "1") != "1" or not _FP8_PARAMS
+                or not isinstance(model_sd, dict)
+                or any(isinstance(v, dict) for v in model_sd.values())):
+            return whole_load(sharded_state_dict, checkpoint_dir, *args, **kwargs)
+        per = int(os.environ.get("LOAD_GROUP_LAYERS", "20"))
+        groups = {}
+        for key in model_sd:
+            m = _LAYER_RE.search(key)
+            groups.setdefault(-1 if m is None else int(m.group(1)) // per, []).append(key)
+        result, tails = {"model": {}}, None
+        # Each group requests only part of the stacked per-layer tensors, so
+        # Megatron's access-integrity check (every global shard requested
+        # exactly once) cannot run per group, and a per-group strictness check
+        # would report the other groups' keys as missing. The groups partition
+        # the model's key set; the TP layout itself is unchanged by streaming.
+        kwargs["validate_access_integrity"] = False
+        kwargs["strict"] = "assume_ok_unexpected"
+        _STREAMING = True
+        try:
+            for i, gid in enumerate(sorted(groups)):
+                sub = {"model": {k: model_sd[k] for k in groups[gid]}}
+                if i == 0:
+                    sub.update({k: v for k, v in sharded_state_dict.items() if k != "model"})
+                out = whole_load(sub, checkpoint_dir, *args, **kwargs)
+                if isinstance(out, tuple):
+                    out, rest = out[0], out[1:]
+                    tails = rest if tails is None else tuple(a | b for a, b in zip(tails, rest))
+                applied = 0
+                with torch.no_grad():
+                    for key, value in out["model"].items():
+                        param = _FP8_PARAMS.get(key)
+                        if param is None or not torch.is_tensor(value):
+                            continue
+                        _calibrate(param, value)
+                        param.copy_(value)
+                        _build_transpose(param)
+                        out["model"][key] = _LOADED
+                        _LOADED_KEYS.add(key)
+                        _LOADED_PARAMS.add(id(param))
+                        applied += 1
+                        # The caller's sharded state dict still references the
+                        # staged tensor; release it before the next group.
+                        staged = model_sd[key]
+                        if hasattr(staged, "data") and torch.is_tensor(staged.data):
+                            staged.data = staged.data.new_empty(0)
+                if gid >= 0 and applied == 0:
+                    raise RuntimeError(
+                        "FP8 streaming load: no FP8 weight of layer group "
+                        f"{gid} matched a model parameter (state-dict key mismatch)")
+                result["model"].update(out.pop("model"))
+                result.update(out)
+                del out, sub
+        finally:
+            _STREAMING = False
+        # The GPU staging blocks stay in the caching allocator; return them so
+        # the CUDA-graph capture's private pool can use that memory.
+        torch.cuda.empty_cache()
+        logger.info("FP8 checkpoint load: streamed %d layer groups", len(groups))
+        return result if tails is None else (result, *tails)
+
+    dist_checkpointing.load = load
+
+
+def install_tensor_properties_compat():
+    """This torch's TensorProperties declares fields (e.g. strides, default None)
+    that materialize on every deserialized instance; Megatron-Core's metadata
+    reader forwards properties.__dict__ into torch.empty, which rejects them.
+    Strip the no-op defaults before the reader runs (non-None strides still fail
+    loudly). Applied as a runtime patch so the vendored Megatron-Bridge checkpointing
+    code stays unmodified."""
+    from pathlib import Path
+
+    from megatron.core.dist_checkpointing.strategies.torch import (
+        TorchDistLoadShardedStrategy, _get_filesystem_reader)
+    from torch.distributed.checkpoint.metadata import TensorStorageMetadata
+
+    if getattr(TorchDistLoadShardedStrategy.load_tensors_metadata, "_tensor_properties_compat", False):
+        return
+    _orig = TorchDistLoadShardedStrategy.load_tensors_metadata
+
+    def _compat(self, checkpoint_dir: Path, metadata=None):
+        if metadata is None:
+            metadata = _get_filesystem_reader(checkpoint_dir).read_metadata()
+        for tp in metadata.state_dict_metadata.values():
+            if isinstance(tp, TensorStorageMetadata):
+                props = tp.properties.__dict__
+                if props.get("strides", None) is None:
+                    props.pop("strides", None)
+        return _orig(self, checkpoint_dir, metadata)
+
+    _compat._tensor_properties_compat = True
+    TorchDistLoadShardedStrategy.load_tensors_metadata = _compat
