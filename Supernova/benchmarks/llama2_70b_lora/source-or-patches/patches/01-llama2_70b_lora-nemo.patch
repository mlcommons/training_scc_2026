+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/fused_residual.py
@@ -0,0 +1,661 @@
+"""Residual adds fused with their neighbours: add + RMSNorm + E4M3 cast forward, add + E5M2 cast backward.
+
+Stock chain per residual site, per layer per microbatch (TP1, TEFusedLoRALinear / TEFusedMLP te.ops branches):
+
+  forward   Megatron bias-dropout-add (no bias, hidden dropout 0): s = residual + out (one elementwise kernel),
+            then the next te.ops RMSNorm (qkv of the next layer, or fc1 of this layer) reads s and writes the FP8
+            payload with the next op's delayed-scaling E4M3 quantizer plus rstd.
+  backward  s feeds both the norm and the next residual, so autograd sums the two gradients (one elementwise
+            kernel), and the linear that produced the branch output (proj, or fc2 of the previous layer) casts
+            that sum to E5M2 with its grad-output quantizer (one more kernel).
+
+This module:
+
+  forward   the bias-dropout-add returns s unwritten and records (residual, out). The next RMSNorm call on s
+            runs one Triton kernel that writes s = residual + out (BF16, the same rounding as the aten add), the
+            FP8 payload of the norm output with the quantizer's scale, the amax (atomic max into the quantizer's
+            amax slot), scale_inv and rstd in TE's layout. The norm's fp32 row reduction order differs from TE's
+            kernel; s and the cast of a given norm value are exact.
+  backward  a fork at the norm input returns two aliases of s. Its backward runs one Triton kernel that writes
+            g = g_norm + g_residual (BF16, bitwise the aten add) and the E5M2 payload of g with the consumer's
+            grad-output quantizer (amax, scale_inv). The payload is kept for the consumer's quantize call on g,
+            which returns it instead of casting again (bitwise the stock cast: same value, same scale).
+  backward, norm folded
+            the RMSNorm that reads the fork output defers its backward (it returns an unwritten dx and no weight
+            gradient: the norm weight is frozen) and the fork's kernel computes dx = rstd * (dy * w - y * mean(dy * w * y))
+            in fp32 per row, rounds it to BF16 as TE stores it, then writes g and the E5M2 payload as above. Not
+            bitwise: the fp32 row reduction order differs from TE's norm backward; everything after dx is exact.
+
+Routing: TransformerLayer's bias-dropout-add callables and the input / pre-MLP norm steps are wrapped. Eligible
+(training with gradients, or evaluation for the forward add, norm and cast; FP8 delayed scaling, BF16 contiguous [s, b, h], no bias, hidden dropout 0, no fp32
+residual, no activation offload or selective recompute of the norms, one pipeline stage, and not inside a recomputed
+layer: under full recompute with the block method only layer 0 and the checkpointed window run stock code) calls take the fused path; the
+last layer's MLP add (it feeds the final norm) and every other call run the stock code. The norm interception
+wraps te.ops' rmsnorm_fwd: a call whose input is not the pending s raises, a call on the pending s that the kernel
+does not cover (no delayed Float8Quantizer, preallocated output) writes s with a plain add kernel and runs
+the stock norm. When the quantizer also asks for columnwise data the FP8 transpose is made from the payload, as TE's
+norm does. Both writes of s bypass autograd, so the fork's views of s stay valid. The quantize interception wraps
+Float8Quantizer.quantize_impl and only returns a payload for the same tensor, quantizer scale/amax buffers and
+rowwise-only usage.
+"""
+import inspect
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+FWD_WARPS = 8
+BWD_BLOCK = 4096
+BWD_WARPS = 8
+
+_installed = False
+_te_installed = False
+_pending = None      # deferred add: (s, residual, out)
+_stash = {}          # backward payloads by consumer quantizer (id of its amax): (g, data, scale_inv, scale, amax, te dtype)
+_next_fork = None    # (output tensor, layer number, grad-output quantizer of that layer's fc2)
+AMAX_PREZERO = None  # device -> fp32 [1] amax slot the fused norm kernel zeroes for the next GEMM, or None
+# The RMSNorm backward of a norm fed by a residual fork runs inside the fork's backward kernel (False: TE's norm
+# backward and the add + cast kernel, the reference the unit tests compare with)
+NORM_BWD_FOLD = True
+_fork_ptr = None     # data_ptr of the newest fork output, until the norm that reads it runs
+_pending_bwd = None  # deferred norm backward: (dx placeholder, dy, x, rstd, w)
+
+
+@triton.jit
+def _add_norm_quant_kernel(r_ptr, o_ptr, w_ptr, s_ptr, q_ptr, rstd_ptr, scale_ptr, amax_ptr, sinv_ptr, zero_ptr, EPS,
+                           H: tl.constexpr, BLOCK: tl.constexpr, ROUND_BF16: tl.constexpr, ZERO: tl.constexpr):
+    """One row: s = bf16(r + o); rstd = 1 / sqrt(mean(s^2) + eps); y = s * rstd * w; payload = fp8(y * scale).
+    With ZERO, program 0 also stores 0 to zero_ptr (an amax slot the next GEMM epilogue max-accumulates into)."""
+    row = tl.program_id(0).to(tl.int64)
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+    base = row * H
+    r = tl.load(r_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    o = tl.load(o_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    s = (r + o).to(tl.bfloat16)
+    tl.store(s_ptr + base + offs, s, mask=mask)
+    sf = s.to(tl.float32)
+    ms = tl.sum(sf * sf, axis=0) / H
+    rstd = libdevice.div_rn(1.0, libdevice.sqrt_rn(ms + EPS))
+    tl.store(rstd_ptr + row, rstd)
+    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    y = (sf * rstd) * w
+    if ROUND_BF16:
+        y = y.to(tl.bfloat16).to(tl.float32)
+    tl.atomic_max(amax_ptr, tl.max(tl.abs(y), axis=0))
+    scale = tl.load(scale_ptr)
+    tl.store(q_ptr + base + offs, (y * scale).to(q_ptr.dtype.element_ty), mask=mask)
+    if row == 0:
+        tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+        if ZERO:
+            tl.store(zero_ptr, 0.0)
+
+
+@triton.jit
+def _add_quant_kernel(a_ptr, b_ptr, g_ptr, q_ptr, scale_ptr, amax_ptr, sinv_ptr, N, BLOCK: tl.constexpr):
+    """g = bf16(a + b); payload = fp8(g * scale); amax of |g| atomically max-accumulated."""
+    pid = tl.program_id(0).to(tl.int64)
+    offs = pid * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < N
+    a = tl.load(a_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    g = (a + b).to(tl.bfloat16)
+    tl.store(g_ptr + offs, g, mask=mask)
+    gf = g.to(tl.float32)
+    tl.atomic_max(amax_ptr, tl.max(tl.where(mask, tl.abs(gf), 0.0), axis=0))
+    scale = tl.load(scale_ptr)
+    tl.store(q_ptr + offs, (gf * scale).to(q_ptr.dtype.element_ty), mask=mask)
+    if pid == 0:
+        tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+
+
+@triton.jit
+def _add_kernel(a_ptr, b_ptr, c_ptr, N, BLOCK: tl.constexpr):
+    """c = bf16(a + b), the aten BF16 add."""
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < N
+    a = tl.load(a_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    tl.store(c_ptr + offs, (a + b).to(tl.bfloat16), mask=mask)
+
+
+def add_into(a, b, c):
+    """c = a + b written by a kernel autograd does not see: c's version counter is unchanged, so views of c
+    returned by the residual fork stay valid."""
+    n = a.numel()
+    _add_kernel[(triton.cdiv(n, BWD_BLOCK),)](a, b, c, n, BLOCK=BWD_BLOCK, num_warps=BWD_WARPS)
+
+
+_NON_TN = []
+
+
+def _non_tn_fp8_gemm():
+    if not _NON_TN:
+        from transformer_engine.pytorch.utils import is_non_tn_fp8_gemm_supported
+
+        _NON_TN.append(bool(is_non_tn_fp8_gemm_supported()))
+    return _NON_TN[0]
+
+
+_TORCH_FP8 = {}
+
+
+def _torch_fp8(te_dtype):
+    if not _TORCH_FP8:
+        import transformer_engine_torch as tex
+
+        _TORCH_FP8[int(tex.DType.kFloat8E4M3)] = torch.float8_e4m3fn
+        _TORCH_FP8[int(tex.DType.kFloat8E5M2)] = torch.float8_e5m2
+    return _TORCH_FP8[int(te_dtype)]
+
+
+def add_rmsnorm_quant(r, o, w, eps, quantizer, s=None, round_bf16=False, zero=None):
+    """r, o [..., H] BF16 contiguous, w [H] -> (s BF16, payload uint8 [T, H], rstd fp32 [T], scale_inv fp32 [1]).
+    Writes s into the given tensor when one is passed, and 0 into zero[0] when zero is given."""
+    H = w.numel()
+    T = r.numel() // H
+    if s is None:
+        s = torch.empty_like(r)
+    data = torch.empty(T, H, dtype=torch.uint8, device=r.device)
+    rstd = torch.empty(T, dtype=torch.float32, device=r.device)
+    sinv = torch.empty(1, dtype=torch.float32, device=r.device)
+    _add_norm_quant_kernel[(T,)](
+        r, o, w, s, data.view(_torch_fp8(quantizer.dtype)), rstd, quantizer.scale, quantizer.amax, sinv,
+        zero if zero is not None else sinv, float(eps),
+        H=H, BLOCK=triton.next_power_of_2(H), ROUND_BF16=round_bf16, ZERO=zero is not None,
+        num_warps=FWD_WARPS, enable_fp_fusion=False,
+    )
+    return s, data, rstd, sinv
+
+
+def add_quant(a, b, quantizer):
+    """a, b BF16 contiguous of one shape -> (g = a + b BF16, payload uint8 of g's shape, scale_inv fp32 [1])."""
+    g = torch.empty_like(a)
+    data = torch.empty(a.shape, dtype=torch.uint8, device=a.device)
+    sinv = torch.empty(1, dtype=torch.float32, device=a.device)
+    n = a.numel()
+    _add_quant_kernel[(triton.cdiv(n, BWD_BLOCK),)](
+        a, b, g, data.view(_torch_fp8(quantizer.dtype)), quantizer.scale, quantizer.amax, sinv, n,
+        BLOCK=BWD_BLOCK, num_warps=BWD_WARPS, enable_fp_fusion=False,
+    )
+    return g, data, sinv
+
+
+@triton.jit
+def _norm_bwd_add_quant_kernel(dy_ptr, x_ptr, rstd_ptr, w_ptr, r_ptr, g_ptr, q_ptr, scale_ptr, amax_ptr, sinv_ptr,
+                               H: tl.constexpr, BLOCK: tl.constexpr, QUANT: tl.constexpr):
+    """One row: the RMSNorm input gradient dx = rstd * (dy * w - y * mean(dy * w * y)), y = x * rstd, rounded to
+    BF16 as TE's norm backward stores it; g = bf16(dx + r); with QUANT the payload fp8(g * scale), the amax of |g|
+    atomically max-accumulated and scale_inv. No weight gradient (the norm weight is frozen)."""
+    row = tl.program_id(0).to(tl.int64)
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+    base = row * H
+    dy = tl.load(dy_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    x = tl.load(x_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    rs = tl.load(rstd_ptr + row)
+    y = x * rs
+    dz = dy * w
+    m = tl.sum(dz * y, axis=0) / H
+    dx = (rs * (dz - y * m)).to(tl.bfloat16).to(tl.float32)
+    r = tl.load(r_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    g = (dx + r).to(tl.bfloat16)
+    tl.store(g_ptr + base + offs, g, mask=mask)
+    if QUANT:
+        gf = g.to(tl.float32)
+        tl.atomic_max(amax_ptr, tl.max(tl.where(mask, tl.abs(gf), 0.0), axis=0))
+        scale = tl.load(scale_ptr)
+        tl.store(q_ptr + base + offs, (gf * scale).to(q_ptr.dtype.element_ty), mask=mask)
+        if row == 0:
+            tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+
+
+NBWD_WARPS = 8
+
+
+def norm_bwd_add_quant(dy, x, rstd, w, r, quantizer=None, g=None):
+    """dy, x, r BF16 [T, H] contiguous, rstd fp32 [T], w [H] -> g = bf16(RMSNorm dx + r) (into g when given), and with
+    a quantizer (payload uint8 [T, H], scale_inv fp32 [1]) else (None, None)."""
+    H = w.numel()
+    T = x.numel() // H
+    if g is None:
+        g = torch.empty_like(r)
+    if quantizer is not None:
+        data = torch.empty(T, H, dtype=torch.uint8, device=x.device)
+        sinv = torch.empty(1, dtype=torch.float32, device=x.device)
+        q8, scale, amax = data.view(_torch_fp8(quantizer.dtype)), quantizer.scale, quantizer.amax
+    else:
+        data = sinv = None
+        q8 = scale = amax = rstd
+    _norm_bwd_add_quant_kernel[(T,)](
+        dy, x, rstd, w, r, g, q8, scale, amax, sinv if sinv is not None else rstd,
+        H=H, BLOCK=triton.next_power_of_2(H), QUANT=quantizer is not None,
+        num_warps=NBWD_WARPS, enable_fp_fusion=False,
+    )
+    return g, data, sinv
+
+
+def _float8(data, sinv, quantizer, fake_dtype):
+    """The tensor type TE's own cast returns for this quantizer (storage when the quantizer is internal)."""
+    if quantizer.internal:
+        from transformer_engine.pytorch.tensor.storage.float8_tensor_storage import Float8TensorStorage
+
+        return Float8TensorStorage(data=data, fp8_scale_inv=sinv, fp8_dtype=quantizer.dtype, fake_dtype=fake_dtype,
+                                   data_transpose=None, quantizer=quantizer)
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Tensor
+
+    return Float8Tensor(shape=data.shape, dtype=fake_dtype, data=data, fp8_scale_inv=sinv,
+                        fp8_dtype=quantizer.dtype, requires_grad=False, data_transpose=None,
+                        quantizer=quantizer, device=data.device)
+
+
+def _delayed_quantizer(q, te_dtype):
+    """True for a delayed-scaling Float8Quantizer of te_dtype with rowwise usage and scalar fp32 CUDA scale/amax."""
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+
+    if type(q) is not Float8Quantizer or int(q.dtype) != int(te_dtype):
+        return False
+    if not q.rowwise_usage:
+        return False
+    s, a = q.scale, q.amax
+    return (isinstance(s, torch.Tensor) and isinstance(a, torch.Tensor) and s.numel() == 1 and a.numel() == 1
+            and s.dtype == torch.float32 and a.dtype == torch.float32 and s.is_cuda and a.is_cuda)
+
+
+def _materialize():
+    global _pending
+    p, _pending = _pending, None
+    if p is not None:
+        s, r, o = p
+        add_into(r, o, s)
+
+
+class _DeferredAdd(torch.autograd.Function):
+    """s = residual + out, written by the next RMSNorm call on s (fused, or a plain add kernel when not fused)."""
+
+    @staticmethod
+    def forward(ctx, residual, out):
+        global _pending
+        if _pending is not None:
+            raise RuntimeError("fused_residual: a deferred residual add was not consumed before the next one")
+        s = torch.empty_like(residual)
+        _pending = (s, residual, out)
+        return s
+
+    @staticmethod
+    def backward(ctx, g):
+        return g, g
+
+
+def deferred_add(residual, out):
+    return _DeferredAdd.apply(residual, out)
+
+
+class _ResidualFork(torch.autograd.Function):
+    """(x, x) forward; backward sums the two gradients and casts the sum with the consumer's quantizer. With
+    the norm fold, the norm that reads the first output defers its backward here, and one kernel computes the
+    norm's input gradient, the sum and the cast."""
+
+    @staticmethod
+    def forward(ctx, x, quantizer):
+        global _fork_ptr
+        ctx.quantizer = quantizer
+        if NORM_BWD_FOLD:
+            _fork_ptr = x.data_ptr()
+        return x.view_as(x), x.view_as(x)
+
+    @staticmethod
+    def backward(ctx, ga, gb):
+        global _pending_bwd
+        import transformer_engine_torch as tex
+
+        q = ctx.quantizer
+        p = _pending_bwd
+        if p is not None:
+            if ga is None or ga.data_ptr() != p[0].data_ptr() or ga.numel() != p[0].numel():
+                raise RuntimeError("fused_residual: a deferred RMSNorm backward did not reach its residual fork")
+            _pending_bwd = None
+            _, dy, x, rstd, w = p
+            r = torch.zeros_like(ga) if gb is None else gb.to(torch.bfloat16).contiguous()
+            if q is not None and not _delayed_quantizer_any_usage(q, tex.DType.kFloat8E5M2):
+                q = None
+            g, data, sinv = norm_bwd_add_quant(dy, x, rstd, w, r, q)
+            if q is not None:
+                stash_payload(g, data, sinv, q)
+            return g.view(ga.shape), None
+        return _stock_fork_backward(q, ga, gb), None
+
+
+def _stock_fork_backward(q, ga, gb):
+    import transformer_engine_torch as tex
+
+    if ga is None or gb is None:
+        return gb if ga is None else ga
+    if (q is None or ga.dtype != torch.bfloat16 or gb.dtype != torch.bfloat16 or ga.shape != gb.shape
+            or not ga.is_contiguous() or not gb.is_contiguous()
+            or not _delayed_quantizer_any_usage(q, tex.DType.kFloat8E5M2)):
+        return ga + gb
+    g, data, sinv = add_quant(ga, gb, q)
+    stash_payload(g, data, sinv, q)
+    return g
+
+
+def _delayed_quantizer_any_usage(q, te_dtype):
+    """Type, dtype and buffer check only: the consumer sets its usage just before its own cast."""
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+
+    if type(q) is not Float8Quantizer or int(q.dtype) != int(te_dtype):
+        return False
+    s, a = q.scale, q.amax
+    return (isinstance(s, torch.Tensor) and isinstance(a, torch.Tensor) and s.numel() == 1 and a.numel() == 1
+            and s.dtype == torch.float32 and a.dtype == torch.float32 and s.is_cuda and a.is_cuda)
+
+
+def residual_fork(x, quantizer):
+    return _ResidualFork.apply(x, quantizer)
+
+
+def _make_rmsnorm_fwd(stock, module_path=False):
+    """te.ops path (module_path False): the deferred add must be consumed by this norm, and the fused kernel zeroes
+    the fc1 amax slot of the te.ops fc1 GEMM. TE module path (LayerNormLinear / LayerNormMLP, the TP > 1 layers): a
+    norm on another tensor runs stock, and no amax slot is touched (that contract is the te.ops fc1's)."""
+    def rmsnorm_fwd(x, w, eps, out, quantizer, otype, sm_margin, zero_centered_gamma):
+        global _pending
+        p = _pending
+        if p is not None:
+            s = p[0]
+            if x.data_ptr() != s.data_ptr() or x.numel() != s.numel():
+                if module_path:
+                    return stock(x, w, eps, out, quantizer, otype, sm_margin, zero_centered_gamma)
+                raise RuntimeError("fused_residual: an RMSNorm ran on another tensor while a residual add was deferred")
+            import transformer_engine_torch as tex
+
+            H = w.numel()
+            if (out is None and not zero_centered_gamma and quantizer is not None
+                    and _delayed_quantizer(quantizer, tex.DType.kFloat8E4M3)
+                    and int(otype) == int(tex.DType.kBFloat16) and x.dtype == torch.bfloat16
+                    and w.dtype == torch.bfloat16 and w.is_contiguous() and x.is_contiguous()
+                    and x.dim() == 2 and x.shape[1] == H and H <= 16384
+                    and p[1].is_contiguous() and p[2].is_contiguous()):
+                _pending = None
+                zero = AMAX_PREZERO(x.device) if AMAX_PREZERO is not None and not module_path else None
+                _, data, rstd, sinv = add_rmsnorm_quant(p[1], p[2], w, eps, quantizer, s=s, zero=zero)
+                y = _float8(data, sinv, quantizer, torch.bfloat16)
+                if quantizer.columnwise_usage and not _non_tn_fp8_gemm():
+                    y._create_transpose()
+                return _mark_fork_norm(x, w, (y, None, rstd))
+            _materialize()
+        return _mark_fork_norm(x, w, stock(x, w, eps, out, quantizer, otype, sm_margin, zero_centered_gamma))
+
+    rmsnorm_fwd._fused_residual = True
+    return rmsnorm_fwd
+
+
+def _mark_fork_norm(x, w, result):
+    """With the norm fold on, tag the rstd of a norm whose input is the newest fork output and whose weight is
+    frozen: its backward is deferred to that fork. te.ops runs the norm under no_grad, so w is a view without
+    requires_grad; the check reads the parameter it views, and a weight that is not a view of a parameter (a
+    converted copy) is treated as trainable."""
+    global _fork_ptr
+    if NORM_BWD_FOLD and _fork_ptr is not None and x.data_ptr() == _fork_ptr:
+        _fork_ptr = None
+        p = w._base if w._base is not None else w
+        if isinstance(p, torch.nn.Parameter) and not p.requires_grad:
+            result[2]._fused_residual_fork = True
+    return result
+
+
+def _make_rmsnorm_bwd(stock):
+    def rmsnorm_bwd(dy, x, rstd, w, sm_margin, zero_centered_gamma):
+        global _pending_bwd
+        H = w.numel()
+        if (getattr(rstd, "_fused_residual_fork", False) and not zero_centered_gamma
+                and dy.dtype == torch.bfloat16 and x.dtype == torch.bfloat16 and w.dtype == torch.bfloat16
+                and rstd.dtype == torch.float32 and dy.is_contiguous() and x.is_contiguous() and w.is_contiguous()
+                and x.dim() == 2 and x.shape[1] == H and dy.shape == x.shape and rstd.numel() == x.shape[0]
+                and H <= 16384):
+            if _pending_bwd is not None:
+                raise RuntimeError("fused_residual: a deferred RMSNorm backward was not consumed before the next one")
+            dx = torch.empty_like(dy)
+            # detached aliases keep the storage: the caller clears x and rstd after this returns
+            _pending_bwd = (dx, dy.detach(), x.detach(), rstd.detach(), w.detach())
+            return dx, torch.empty_like(w)
+        return stock(dy, x, rstd, w, sm_margin, zero_centered_gamma)
+
+    rmsnorm_bwd._fused_residual = True
+    return rmsnorm_bwd
+
+
+def stash_payload(g, data, sinv, quantizer):
+    """Keep the E5M2 payload (data, sinv) of g, cast with quantizer, for the quantizer's next cast of g. One entry per
+    quantizer: a newer payload replaces an unconsumed one, and a cast of another tensor drops it."""
+    _stash[id(quantizer.amax)] = (g, data, sinv, quantizer.scale, quantizer.amax, quantizer.dtype)
+
+
+def _make_quantize_impl(stock):
+    def quantize_impl(self, tensor):
+        e = _stash.pop(id(self.amax), None) if _stash else None
+        if (e is not None and tensor.data_ptr() == e[0].data_ptr() and tensor.numel() == e[0].numel()
+                and self.scale is e[3] and self.amax is e[4] and int(self.dtype) == int(e[5])
+                and self.rowwise_usage and not self.columnwise_usage
+                and tensor.dtype == torch.bfloat16 and tensor.is_contiguous()):
+            return _float8(e[1].view(tensor.shape), e[2], self, tensor.dtype)
+        return stock(self, tensor)
+
+    quantize_impl._fused_residual = True
+    return quantize_impl
+
+
+def _make_post_rs_norm(stock):
+    """fused_post_rs_norm reads its input directly: write a deferred s first (plain add kernel)."""
+    def fused_rs_norm_quant_ub(s, *a, **kw):
+        p = _pending
+        if p is not None and s.data_ptr() == p[0].data_ptr():
+            _materialize()
+        return stock(s, *a, **kw)
+
+    fused_rs_norm_quant_ub._fused_residual = True
+    return fused_rs_norm_quant_ub
+
+
+def install_te_hooks():
+    """Wrap te.ops' rmsnorm_fwd, rmsnorm_bwd, the TE module path's (cpp_extensions) rmsnorm_fwd / rmsnorm_bwd that
+    LayerNormLinear and LayerNormMLP call at TP > 1, fused_post_rs_norm's entry and Float8Quantizer.quantize_impl
+    (idempotent)."""
+    global _te_installed
+    if _te_installed:
+        return
+    import transformer_engine.pytorch.cpp_extensions as te_cpp
+    import transformer_engine.pytorch.ops.basic.rmsnorm as ops_rmsnorm
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+
+    for name in ("rmsnorm_fwd", "rmsnorm_bwd"):
+        if not hasattr(te_cpp, name):
+            raise RuntimeError(f"fused_residual: transformer_engine cpp_extensions no longer binds {name}")
+    if not getattr(te_cpp.rmsnorm_fwd, "_fused_residual", False):
+        te_cpp.rmsnorm_fwd = _make_rmsnorm_fwd(te_cpp.rmsnorm_fwd, module_path=True)
+    if not getattr(te_cpp.rmsnorm_bwd, "_fused_residual", False):
+        te_cpp.rmsnorm_bwd = _make_rmsnorm_bwd(te_cpp.rmsnorm_bwd)
+    try:
+        import fused_post_rs_norm
+    except ImportError:
+        fused_post_rs_norm = None
+    if fused_post_rs_norm is not None and not getattr(fused_post_rs_norm.fused_rs_norm_quant_ub, "_fused_residual",
+                                                      False):
+        fused_post_rs_norm.fused_rs_norm_quant_ub = _make_post_rs_norm(fused_post_rs_norm.fused_rs_norm_quant_ub)
+
+    for name in ("rmsnorm_fwd", "rmsnorm_bwd"):
+        if not hasattr(ops_rmsnorm, name):
+            raise RuntimeError(f"fused_residual: te.ops RMSNorm no longer binds {name}")
+    sig = list(inspect.signature(Float8Quantizer.quantize_impl).parameters)
+    if sig != ["self", "tensor"]:
+        raise RuntimeError(f"fused_residual: Float8Quantizer.quantize_impl signature changed ({sig})")
+    if not getattr(ops_rmsnorm.rmsnorm_fwd, "_fused_residual", False):
+        ops_rmsnorm.rmsnorm_fwd = _make_rmsnorm_fwd(ops_rmsnorm.rmsnorm_fwd)
+    if not getattr(Float8Quantizer.quantize_impl, "_fused_residual", False):
+        Float8Quantizer.quantize_impl = _make_quantize_impl(Float8Quantizer.quantize_impl)
+    if not getattr(ops_rmsnorm.rmsnorm_bwd, "_fused_residual", False):
+        ops_rmsnorm.rmsnorm_bwd = _make_rmsnorm_bwd(ops_rmsnorm.rmsnorm_bwd)
+    _te_installed = True
+
+
+def _fp8_delayed():
+    from transformer_engine.pytorch.quantization import FP8GlobalStateManager
+
+    return FP8GlobalStateManager.is_fp8_enabled() and FP8GlobalStateManager.get_fp8_recipe().delayed()
+
+
+def _layer_eval_ok(layer):
+    return not layer.training and _layer_cfg_ok(layer)
+
+
+def _layer_ok(layer):
+    return layer.training and torch.is_grad_enabled() and _layer_cfg_ok(layer) and not _layer_recomputed(layer)
+
+
+def _layer_recomputed(layer):
+    """True when training runs this layer inside a checkpointed (recomputed) forward.
+
+    The fused path keeps its deferred add and backward payloads in module state between calls, so a layer whose
+    forward is re-run during the backward pass cannot use it. Under full recompute with the block method, only the
+    first recompute_num_layers layers are checkpointed (Megatron skips the leading layers whose input has no
+    gradient: with a frozen base that is layer 0, so the window starts at layer 1); the layers after it run once
+    and take the fused path; layer 0 and the window run stock code.
+    """
+    cfg = layer.config
+    gran = getattr(cfg, "recompute_granularity", None)
+    if gran is None:
+        return False
+    if gran == "full" and getattr(cfg, "recompute_method", None) == "block":
+        return layer.layer_number - 1 <= cfg.recompute_num_layers
+    return True
+
+
+def _layer_cfg_ok(layer):
+    cfg = layer.config
+    return (not cfg.fp32_residual_connection
+            and not getattr(layer, "recompute_input_layernorm", False)
+            and not getattr(layer, "recompute_pre_mlp_layernorm", False)
+            and not getattr(layer, "offload_attn_norm", False)
+            and not getattr(layer, "offload_mlp_norm", False)
+            and _fp8_delayed())
+
+
+def _is_last_layer(layer):
+    from megatron.core import parallel_state
+
+    return (parallel_state.get_pipeline_model_parallel_world_size() != 1
+            or layer.layer_number >= layer.config.num_layers)
+
+
+def _branch_grad_quantizer(seq):
+    """Grad-output quantizer of the last te.ops BasicLinear in a te.ops Sequential."""
+    from transformer_engine.pytorch.ops.basic.basic_linear import BasicLinear
+
+    ops = [m for m in seq.modules() if isinstance(m, BasicLinear)]
+    if not ops:
+        return None
+    try:
+        return ops[-1].get_quantizer("backward", 0)
+    except Exception:
+        return None
+
+
+def _proj_grad_quantizer(layer):
+    lp = getattr(layer.self_attention, "linear_proj", None)
+    br = getattr(lp, "_fused_branches", None)
+    if not br or not getattr(lp, "_adapter_enabled", False):
+        return None
+    return _branch_grad_quantizer(br[0])
+
+
+def _fc2_grad_quantizer(layer):
+    fi = getattr(layer.mlp, "_fused_impl", None)
+    if not fi:
+        return None
+    return _branch_grad_quantizer(fi[0])
+
+
+def _sbh(t):
+    return isinstance(t, torch.Tensor) and t.dtype == torch.bfloat16 and t.dim() == 3 and t.is_contiguous()
+
+
+def _wrap_bda(layer_ref, orig_bda, site):
+    def bda(training, fused):
+        f = orig_bda(training, fused)
+
+        def run(x_with_bias, residual, prob):
+            global _next_fork
+            layer = layer_ref()
+            x, bias = x_with_bias
+            last = _is_last_layer(layer)
+            if (bias is None and prob == 0 and _sbh(x) and _sbh(residual) and x.shape == residual.shape
+                    and ((training and _layer_ok(layer)) or (not training and _layer_eval_ok(layer)))
+                    and not (site == "mlp" and last)):
+                out = deferred_add(residual, x)
+            else:
+                out = f(x_with_bias, residual, prob)
+            if site == "mlp" and not last and _layer_ok(layer):
+                _next_fork = (out, layer.layer_number, _fc2_grad_quantizer(layer))
+            return out
+
+        return run
+
+    return bda
+
+
+def install():
+    """Wrap TransformerLayer's bias-dropout-add callables and its two norm-input steps (idempotent)."""
+    global _installed
+    if _installed:
+        return
+    import weakref
+
+    from megatron.core.transformer.identity_op import IdentityOp
+    from megatron.core.transformer.transformer_layer import TransformerLayer
+
+    install_te_hooks()
+    for name in ("_run_input_layernorm", "_pre_mlp_layernorm_and_residual"):
+        if not hasattr(TransformerLayer, name):
+            raise RuntimeError(f"fused_residual: TransformerLayer.{name} missing")
+
+    orig_init = TransformerLayer.__init__
+
+    def __init__(self, *a, **kw):
+        orig_init(self, *a, **kw)
+        ref = weakref.ref(self)
+        self.self_attn_bda = _wrap_bda(ref, self.self_attn_bda, "attn")
+        self.mlp_bda = _wrap_bda(ref, self.mlp_bda, "mlp")
+
+    orig_in = TransformerLayer._run_input_layernorm
+    orig_mlp = TransformerLayer._pre_mlp_layernorm_and_residual
+
+    def _run_input_layernorm(self, hidden_states, *a, **kw):
+        global _next_fork
+        nf, _next_fork = _next_fork, None
+        ln_out, residual, state = orig_in(self, hidden_states, *a, **kw)
+        if (nf is not None and isinstance(hidden_states, torch.Tensor)
+                and nf[0].data_ptr() == hidden_states.data_ptr() and nf[0].shape == hidden_states.shape
+                and nf[1] + 1 == self.layer_number
+                and nf[2] is not None and ln_out is hidden_states and residual is hidden_states
+                and isinstance(self.input_layernorm, IdentityOp) and not state
+                and _sbh(hidden_states) and _layer_ok(self)):
+            ln_out, residual = residual_fork(hidden_states, nf[2])
+        return ln_out, residual, state
+
+    def _pre_mlp_layernorm_and_residual(self, hidden_states, *a, **kw):
+        ln_out, residual, state = orig_mlp(self, hidden_states, *a, **kw)
+        if (ln_out is hidden_states and residual is hidden_states
+                and isinstance(self.pre_mlp_layernorm, IdentityOp) and not state
+                and _sbh(hidden_states) and _layer_ok(self)):
+            q = _proj_grad_quantizer(self)
+            if q is not None:
+                ln_out, residual = residual_fork(hidden_states, q)
+        return ln_out, residual, state
+
+    TransformerLayer.__init__ = __init__
+    TransformerLayer._run_input_layernorm = _run_input_layernorm
+    TransformerLayer._pre_mlp_layernorm_and_residual = _pre_mlp_layernorm_and_residual
+    _installed = True
