+# Copyright (c) 2026, Billy Cao.
+
+"""Fused RMSNorm + delayed-scaling fp8 quantize for the two post-residual
+norm sites (input_layernorm+qkv, post_attention_layernorm+fc1).
+
+Stock chain per site (TE LayerNormLinear with return_layernorm_output,
+UB all-gather overlap): rmsnorm_fwd (read s, write y bf16 + rsigma) ->
+quantizer(y) (read y, write fp8 payload, amax) ->
+fill_userbuffers_buffer_for_all_gather (read payload, copy into the AG
+userbuffer local chunk) = 6 HBM passes, 3+ kernels.
+
+This kernel: read s; write y (the bf16 norm output the LoRA path
+consumes), the fp8 payload into a fresh tensor (saved for the wgrad --
+the userbuffer is reused by later microbatches before the backward, so
+the saved copy must be standalone), the same payload bytes into the
+userbuffer's local chunk (the GEMM input -- skips the staging copy), and
+rstd in TE's rmsnorm layout ([T] fp32, 1/sqrt(mean(s^2)+eps)) = 4 HBM
+passes, 1 kernel.
+
+The residual add stays outside (aten, before the module): its backward
+aliases the gradient to both inputs for free. The backward stays stock:
+rmsnorm_bwd(dgrad, s, rstd, gamma) consumes exactly the state saved
+here, so _LayerNormLinear.backward is unchanged.
+
+The norm's fp32 row reduction order differs from TE's cuDNN kernel
+(<= 1 bf16 ULP on y). The quantize step (payload of the
+same y) and the amax accumulation are bitwise (the delayed-scaling
+contract: amax_history[0] is zero-filled at iteration boundaries and
+max-accumulated within).
+
+Gated by NVTE_FUSED_POST_RS_NORM (default off).
+"""
+
+import os
+
+import torch  # noqa: F401
+import triton
+import triton.language as tl
+
+_logged = False
+
+
+@triton.jit
+def _fused_rs_norm_quant_kernel(
+    s_ptr, gamma_ptr,
+    y_ptr, out8_ptr, ub8_ptr, rstd_ptr,
+    scale_ptr, amax_ptr,
+    T, EPS,
+    H: tl.constexpr, BLOCK: tl.constexpr, E4M3: tl.constexpr,
+    WRITE_UB: tl.constexpr,
+):
+    row = tl.program_id(0)
+    if row >= T:
+        return
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+
+    s = tl.load(s_ptr + row * H + offs, mask=mask, other=0.0).to(tl.float32)
+    ms = tl.sum(tl.where(mask, s * s, 0.0), axis=0) / H
+    rstd = 1.0 / tl.sqrt(ms + EPS)
+    tl.store(rstd_ptr + row, rstd)
+
+    gamma = tl.load(gamma_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    y = (s * rstd * gamma).to(tl.bfloat16)
+    tl.store(y_ptr + row * H + offs, y, mask=mask)
+
+    # delayed-scaling quantize of the norm output (float(y) * scale,
+    # saturating RNE e4m3/e5m2; amax of the unscaled values atomicMax'd --
+    # one pass: quantize and pack)
+    yf = y.to(tl.float32)
+    amax = tl.max(tl.where(mask, tl.abs(yf), 0.0), axis=0)
+    tl.atomic_max(amax_ptr, amax)
+    scaled = yf * tl.load(scale_ptr)
+    if E4M3:
+        payload = scaled.to(tl.float8e4nv)
+    else:
+        payload = scaled.to(tl.float8e5)
+    tl.store(out8_ptr + row * H + offs, payload, mask=mask)
+    if WRITE_UB:
+        tl.store(ub8_ptr + row * H + offs, payload, mask=mask)
+
+
+def fused_rs_norm_quant_ub(s, gamma, quantizer, ub_local=None, eps=1e-5,
+                           fp8_dtype_e4m3=True):
+    """Run the fused RMSNorm + quantize. Returns (y_bf16, out8_payload,
+    rstd). With ub_local (the AG userbuffer's local chunk, [T, H] fp8-
+    typed or uint8), the payload is also written straight into the
+    userbuffer, skipping the staging copy. The quantizer's amax is
+    max-accumulated (delayed scaling contract: zero-filled at iteration
+    boundaries by the framework, accumulated within)."""
+    T, H = s.shape
+    global _logged
+    if not _logged:
+        _logged = True
+        if int(os.environ.get("RANK", "0")) == 0:
+            print(
+                f"[fused_post_rs_norm] fused RMSNorm+quantize+ubuf-fill active "
+                f"(T={T}, H={H}, e4m3={fp8_dtype_e4m3}, ub={'yes' if ub_local is not None else 'no'})",
+                flush=True,
+            )
+    out_bf16 = torch.empty_like(s)
+    out8 = torch.empty(T, H, dtype=torch.uint8, device=s.device)
+    rstd = torch.empty(T, dtype=torch.float32, device=s.device)
+    # the payload stores need fp8-typed pointers (bit-preserving views)
+    fp8_dt = torch.float8_e4m3fn if fp8_dtype_e4m3 else torch.float8_e5m2
+    out8_view = out8.view(fp8_dt)
+    if ub_local is None:
+        ub_view, write_ub = out8_view, False
+    else:
+        ub_view = ub_local.view(fp8_dt) if ub_local.dtype != fp8_dt else ub_local
+        write_ub = True
+    _fused_rs_norm_quant_kernel[(T,)](
+        s, gamma,
+        out_bf16, out8_view, ub_view, rstd,
+        quantizer.scale, quantizer.amax,
+        T, eps,
+        H=H, BLOCK=triton.next_power_of_2(H), E4M3=fp8_dtype_e4m3,
+        WRITE_UB=write_ub,
+        num_warps=8,
+    )
+    return out_bf16, out8, rstd
