@@ -0,0 +1,183 @@
+"""Wide copies for the context parallel attention exchange.
+
+TE's context parallel all-to-all re-lays out its FP8 payload with
+``movedim(...).contiguous()``. Those copies move a byte typed tensor, so the
+TensorIterator copy kernel indexes one byte per element. This module moves the
+same bytes through a wider integer view of the same memory, and makes the
+FlashAttention 3 forward write its BF16 output in the layout the quantizer
+needs so that copy does not happen at all.
+
+Sites covered, per layer per microbatch, all inside TE's
+``AttnFuncWithCPAndQKVOA2A`` with ``cp_comm_type`` a2a:
+
+  fwd  q, k, v  before the exchange
+       O        written directly in sbhd order, so the quantizer has nothing to copy
+       out      after the exchange, on the cp stream
+  bwd  dout     before the exchange
+       dq, dk, dv  after the exchange, on the cp stream
+
+The bytes that move are the same as the stock path and the results are bitwise
+identical at every site. When a tensor cannot be viewed with a wider type the
+copy falls back to the stock ``contiguous()``.
+"""
+import inspect
+import os
+
+import torch
+
+_INT = {1: torch.uint8, 2: torch.int16, 4: torch.int32, 8: torch.int64}
+
+_installed = False
+_stock_a2a = None
+_stock_fwd = None
+
+
+
+def _contig_wide(x):
+    """x made contiguous by copying through the widest integer view of its bytes that the strides allow."""
+    if x.is_contiguous():
+        return x
+    es = x.element_size()
+    xi = x.view(_INT[es])   # same bytes, integer type (a dtype view of the same size works on any strides)
+    for w in (16, 8, 4, 2):
+        if w <= es or w not in _INT:
+            continue
+        if (x.stride(-1) == 1 and (x.shape[-1] * es) % w == 0 and (x.data_ptr() % w) == 0
+                and all((st * es) % w == 0 for st, s in zip(x.stride()[:-1], x.shape[:-1]) if s > 1)):
+            try:
+                return xi.view(_INT[w]).contiguous().view(_INT[es]).view(x.dtype)
+            except RuntimeError:
+                break
+    return x.contiguous()
+
+
+def _a2a(a2a_inputs, chunk_ids_for_a2a, seq_dim, cp_size, cp_group, cp_stream, before_attn,
+         qkv_format="bshd", cu_seqlens_q_padded=None, cu_seqlens_kv_padded=None, a2a_input_names=None):
+    """te_cp.flash_attn_a2a_communicate for bshd/sbhd/bhsd with its two layout copies routed through the wide
+    copy; thd goes to the stock function. Everything else is the stock body."""
+    from transformer_engine.pytorch.attention.dot_product_attention import context_parallel as te_cp
+
+    if qkv_format not in ("bshd", "sbhd", "bhsd"):
+        return _stock_a2a(a2a_inputs, chunk_ids_for_a2a, seq_dim, cp_size, cp_group, cp_stream, before_attn,
+                          qkv_format, cu_seqlens_q_padded, cu_seqlens_kv_padded, a2a_input_names)
+    a2a_inputs = [a2a_inputs] if not isinstance(a2a_inputs, list) else a2a_inputs
+    a2a_outputs, a2a_reqs = [None] * len(a2a_inputs), [None] * len(a2a_inputs)
+    _, _, head_dim = te_cp.get_bsh_dims(qkv_format)
+    if before_attn:
+        for i in range(len(a2a_inputs) + 2):
+            if 0 < i < len(a2a_inputs) + 1:
+                a2a_outputs[i - 1] = torch.empty_like(a2a_inputs[i - 1])
+                a2a_reqs[i - 1] = torch.distributed.all_to_all_single(
+                    a2a_outputs[i - 1], a2a_inputs[i - 1], group=cp_group, async_op=True
+                )
+            if i > 1:
+                with torch.cuda.stream(cp_stream):
+                    a2a_reqs[i - 2].wait()
+                    x = a2a_outputs[i - 2]
+                    x = te_cp.reorder_seq_chunks_for_a2a_before_attn(x, chunk_ids_for_a2a, seq_dim, cp_size)
+                    a2a_outputs[i - 2] = x.view(*x.shape[:seq_dim], -1, *x.shape[(seq_dim + 2):])
+            if i < len(a2a_inputs):
+                x = a2a_inputs[i]
+                x = x.view(*x.shape[:head_dim], cp_size, x.shape[head_dim] // cp_size, *x.shape[head_dim + 1:])
+                a2a_inputs[i] = _contig_wide(x.movedim(head_dim, 0))
+    else:
+        for i in range(len(a2a_inputs) + 2):
+            if 0 < i < len(a2a_inputs) + 1:
+                a2a_outputs[i - 1] = torch.empty_like(a2a_inputs[i - 1])
+                a2a_reqs[i - 1] = torch.distributed.all_to_all_single(
+                    a2a_outputs[i - 1], a2a_inputs[i - 1], group=cp_group, async_op=True
+                )
+            if i < len(a2a_inputs):
+                x = a2a_inputs[i]
+                x = x.view(*x.shape[:seq_dim], cp_size * 2, -1, *x.shape[(seq_dim + 1):])
+                a2a_inputs[i] = te_cp.reorder_seq_chunks_for_a2a_after_attn(x, chunk_ids_for_a2a, seq_dim, cp_size)
+            if i > 1:
+                with torch.cuda.stream(cp_stream):
+                    a2a_reqs[i - 2].wait()
+                    x = a2a_outputs[i - 2]
+                    tmp_list = list(qkv_format)
+                    tmp_list.insert(0, "2")
+                    tmp_list.insert(0, "c")
+                    tmp_format = "".join(tmp_list)
+                    head_dim_ = tmp_format.index("h") - 1
+                    tmp_list.insert(head_dim_, tmp_list.pop(0))
+                    x = x.movedim(0, head_dim_)
+                    tmp_format = "".join(tmp_list)
+                    seq_dim_ = tmp_format.index("s") - 1
+                    tmp_list.insert(seq_dim_, tmp_list.pop(0))
+                    x = x.movedim(0, seq_dim_)
+                    x = _contig_wide(x)
+                    a2a_outputs[i - 2] = x.view(-1, x.shape[-3] * x.shape[-2], x.shape[-1])
+    torch.cuda.current_stream().wait_stream(cp_stream)
+    return a2a_outputs[0] if len(a2a_inputs) == 1 else a2a_outputs
+
+
+def _fwd_o_direct(q_fp8, k_fp8, v_fp8, softmax_scale, qkv_layout, o_format, is_causal):
+    """fav3_attention_fwd's bf16-O branch for sbhd with O written in place in sbhd order (contiguous), so the
+    caller's O_quantizer(out_) quantizes it without a re-layout copy. Same kernel, same arguments as the stock
+    call; only the out tensor's strides differ."""
+    import fav3_fp8_bwd as m
+
+    src_format = qkv_layout.split("_")[0].replace("3", "").replace("2", "")
+    if src_format != "sbhd":
+        return _stock_fwd(q_fp8, k_fp8, v_fp8, softmax_scale, qkv_layout, o_format, is_causal)
+    for t in (q_fp8, k_fp8, v_fp8):
+        m._require(m._is_quantized(t) and m._fp8_dtype_is(t, m.tex.DType.kFloat8E4M3),
+                   "q/k/v must be e4m3-quantized tensors")
+    q8, k8, v8 = m._fp8_view(q_fp8), m._fp8_view(k_fp8), m._fp8_view(v_fp8)
+    qs, ks, vs = m._scale(q_fp8), m._scale(k_fp8), m._scale(v_fp8)
+    s_q, b = q_fp8.shape[:2]
+    s_k = k_fp8.shape[0]
+    hq, d = q_fp8.shape[-2], q_fp8.shape[-1]
+    hkv, d_v = v_fp8.shape[-2], v_fp8.shape[-1]
+    m._require(d == 128 and d_v == 128, f"head dim must be 128, got {d}/{d_v}")
+    m._require(hq % hkv == 0 and s_q == s_k and s_q % 16 == 0,
+               "GQA head ratio, seqlen_q == seqlen_kv and seqlen % 16 required")
+
+    def _desc(s):
+        return s.view(1, 1).expand(b, hkv)
+
+    # Column-major V removes the producer's repeated in-kernel transpose.
+    v_fwd = m._layout_view(v8, "sbhd")
+    from fp8_v_transpose import transpose_v
+    v_fwd = transpose_v(v_fwd, permute_tokens=True)
+    layout_kwargs = {"v_seq_permuted": True}
+    out = torch.empty(s_q, b, hq, d_v, device=q8.device, dtype=torch.bfloat16)
+    _, lse, _, _ = torch.ops.flash_attn_3.fwd(
+        m._layout_view(q8, "sbhd"), m._layout_view(k8, "sbhd"), v_fwd,
+        None, None, None, m._layout_view(out, "sbhd"),
+        q_descale=_desc(qs), k_descale=_desc(ks), v_descale=_desc(vs),
+        softmax_scale=softmax_scale, is_causal=is_causal, window_size_left=-1, window_size_right=-1,
+        attention_chunk=0, softcap=0.0, is_rotary_interleaved=True, scheduler_metadata=None,
+        num_splits=1, pack_gqa=False, sm_margin=0, **layout_kwargs,
+    )
+    rng = torch.zeros(2, dtype=torch.int64, device=out.device)
+    aux = [lse.contiguous().unsqueeze(-1), rng]
+    return out, aux
+
+
+def install():
+    """Install the wide copies and the direct FA3 output (idempotent)."""
+    global _installed, _stock_a2a, _stock_fwd
+    if _installed:
+        return
+    from transformer_engine.pytorch.attention.dot_product_attention import context_parallel as te_cp
+
+    src = inspect.getsource(te_cp.flash_attn_a2a_communicate)
+    for needle in ("a2a_inputs[i] = x.movedim(head_dim, 0).contiguous()", "x = x.contiguous()",
+                   "reorder_seq_chunks_for_a2a_before_attn(", "reorder_seq_chunks_for_a2a_after_attn("):
+        if needle not in src:
+            raise RuntimeError(f"cp_layout_copies: TE flash_attn_a2a_communicate changed ({needle!r} missing)")
+    _stock_a2a = te_cp.flash_attn_a2a_communicate
+    te_cp.flash_attn_a2a_communicate = _a2a
+    # The direct FA3 output changes the O layout of the FP8 forward only; with
+    # the FP8 forward off there is no bf16 O copy to remove and the stock
+    # forward stays.
+    if os.getenv("NVTE_FAV3_FP8_FWD", "0") == "1":
+        import fav3_fp8_bwd
+
+        _stock_fwd = fav3_fp8_bwd.fav3_attention_fwd
+        fav3_fp8_bwd.fav3_attention_fwd = _fwd_o_direct
+    _installed = True
+    if int(os.environ.get("RANK", "0")) == 0:
+        print("[cp_layout_copies] installed (wide a2a copies, direct FA3 O)", flush=True)
diff --git a/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/cp_shards.py b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/cp_shards.py
