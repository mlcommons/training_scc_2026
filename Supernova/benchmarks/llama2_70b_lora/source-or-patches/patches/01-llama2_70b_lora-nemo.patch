index 0000000..8b8d13f
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/lora_rng.py
@@ -0,0 +1,168 @@
+"""Layout-invariant randomness of the LoRA adapters: the A init and the 'pre' dropout masks.
+
+A seed gives the same adapter init and the same dropout masks under every TP x CP layout, so two
+layouts that see the same data follow the same random trajectory.
+
+Init (init_lora_a): each adapter's full A [dim, in] is drawn on a CPU generator keyed by the run seed
+and the adapter's base linear name, U(-1/sqrt(in), 1/sqrt(in)) (Bridge's kaiming on the full fan-in),
+and every rank keeps its own shard. Megatron's GPU init draws each shard from the rank's own tracker
+stream instead, so TP1 and TP2 start from different A matrices.
+
+Dropout (call_seed + positions): the keep bit of an element is a function of
+  (run seed, adapter name, call index, global sample, global token, global hidden index)
+only. call_seed() returns the per-call Philox key: a device counter per adapter, advanced by one
+on-device kernel per training forward (CUDA-graph safe; replays advance it), reset to zero when the
+training warmup ends (reset_counters), so call k of an adapter is the same logical microbatch in every
+layout. positions() maps each local row of the adapter input [s, b, k] to its global row id
+(dp_rank * b + b_idx) * S + t, with t the token's position in the full sequence: Megatron's
+per-sequence CP split (chunks cp_rank and 2*cp-1-cp_rank of 2*cp), then the contiguous sequence-
+parallel split at TP > 1 when the adapter input keeps the full hidden (qkv), or the hidden offset of
+the rank's shard when it is hidden-sharded (proj). The kernels key Philox on the global flat index
+row_id * H + k, so a token's mask does not depend on which rank holds it.
+"""
+
+import math
+import os
+import zlib
+
+import torch
+import triton
+import triton.language as tl
+
+_MAX_SLOTS = 4096
+_ctr = None
+_slots = {}
+_maps = {}
+
+
+def base_seed():
+    return int(os.environ.get("SEED", "1"))
+
+
+def _name_key(adapter):
+    name = adapter.base_linear_name
+    while name.startswith("module."):
+        name = name[len("module."):]
+    return zlib.crc32(name.encode())
+
+
+def _mix(*vals):
+    """splitmix64 over the values, kept in [0, 2**62)."""
+    x = 0
+    for v in vals:
+        x = (x + (v & 0xFFFFFFFFFFFFFFFF) + 0x9E3779B97F4A7C15) & 0xFFFFFFFFFFFFFFFF
+        x = ((x ^ (x >> 30)) * 0xBF58476D1CE4E5B9) & 0xFFFFFFFFFFFFFFFF
+        x = ((x ^ (x >> 27)) * 0x94D049BB133111EB) & 0xFFFFFFFFFFFFFFFF
+        x ^= x >> 31
+    return x & ((1 << 62) - 1)
+
+
+def _tp(adapter):
+    g = adapter.tp_group
+    if g is None or not torch.distributed.is_initialized():
+        return 1, 0
+    return torch.distributed.get_world_size(g), torch.distributed.get_rank(g)
+
+
+
+@torch.no_grad()
+def init_lora_a(adapter, tp=None):
+    """Overwrite adapter.linear_in.weight with this rank's shard of the seed-keyed full A.
+    tp: (size, rank) override for unit gates; default from the adapter's TP group."""
+    if getattr(adapter, "is_expert", False) or getattr(adapter, "replicate_adapter", False):
+        return
+    w = adapter.linear_in.weight
+    if w.is_meta:
+        raise RuntimeError("lora_rng.init_lora_a: adapter weight is on the meta device")
+    tp, tpr = tp if tp is not None else _tp(adapter)
+    r, c = w.shape
+    if adapter.input_is_parallel:
+        full = (r, c * tp)
+        part = (slice(None), slice(tpr * c, (tpr + 1) * c))
+    else:
+        full = (r * tp, c)
+        part = (slice(tpr * r, (tpr + 1) * r), slice(None))
+    if full[0] != adapter.dim:
+        raise RuntimeError(f"lora_rng.init_lora_a: unexpected A shard {tuple(w.shape)} for dim {adapter.dim} tp {tp}")
+    g = torch.Generator(device="cpu")
+    g.manual_seed(_mix(base_seed(), _name_key(adapter), 0xA))
+    bound = 1.0 / math.sqrt(full[1])
+    a = torch.empty(full, dtype=torch.float32).uniform_(-bound, bound, generator=g)
+    w.copy_(a[part].to(dtype=w.dtype, device=w.device))
+
+
+@triton.jit
+def _seed_kernel(ctr_ptr, out_ptr, slot, salt):
+    c = tl.load(ctr_ptr + slot)
+    tl.store(ctr_ptr + slot, c + 1)
+    tl.store(out_ptr, (salt + c * 2654435761) & 0x3FFFFFFFFFFFFFFF)
+
+
+def call_seed(adapter, device):
+    """[1] int64 Philox key for this adapter's next training call (advances its counter on device)."""
+    global _ctr
+    if _ctr is None:
+        _ctr = torch.zeros(_MAX_SLOTS, dtype=torch.int64, device=device)
+    key = _name_key(adapter)
+    ent = _slots.get(id(adapter))
+    if ent is None:
+        if len(_slots) >= _MAX_SLOTS:
+            raise RuntimeError("lora_rng: more adapters than counter slots")
+        ent = (len(_slots), _mix(base_seed(), key, 0xD))
+        _slots[id(adapter)] = ent
+    slot, salt = ent
+    out = torch.empty((1,), dtype=torch.int64, device=device)
+    _seed_kernel[(1,)](_ctr, out, slot, salt)
+    return out
+
+
+def reset_counters():
+    """Zero every adapter's call counter: the next training call of each adapter is call 0."""
+    if _ctr is not None:
+        _ctr.zero_()
+
+
+def positions(adapter, shape, device, ranks=None):
+    """(row ids [s*b] int64, global row width H, hidden offset) for an adapter input of shape [s, b, k].
+    ranks: (tp, tp_rank, cp, cp_rank, dp_rank) override for unit gates; default from the process groups."""
+    if len(shape) != 3:
+        raise RuntimeError(f"lora_rng.positions: adapter input must be [s, b, k], got {tuple(shape)}")
+    s, b, k = (int(v) for v in shape)
+    if ranks is None:
+        from megatron.core import parallel_state as ps
+
+        tp, tpr = _tp(adapter)
+        cp, cpr = ps.get_context_parallel_world_size(), ps.get_context_parallel_rank()
+        dpr = ps.get_data_parallel_rank()
+    else:
+        tp, tpr, cp, cpr, dpr = ranks
+    w = adapter.linear_in.weight
+    hfull = w.shape[1] * tp if adapter.input_is_parallel else w.shape[1]
+    if k == hfull:
+        koff, seq_split = 0, tp > 1
+    elif k * tp == hfull:
+        koff, seq_split = tpr * k, False
+    else:
+        raise RuntimeError(f"lora_rng.positions: hidden {k} fits neither the full {hfull} nor a 1/{tp} shard")
+    import cp_shards
+
+    uneven = cp_shards.active if (ranks is None and cp > 1) else None
+    key = (s, b, k, koff, seq_split, hfull, tp, tpr, cp, cpr, dpr, uneven, str(device))
+    m = _maps.get(key)
+    if m is None:
+        s_cp = s * tp if seq_split else s
+        sidx = torch.arange(s, device=device, dtype=torch.int64) + (tpr * s if seq_split else 0)
+        if uneven is not None:
+            S = uneven[0]
+            t = cp_shards.local_positions(S, uneven[1], cpr, device)[sidx]
+        else:
+            S = s_cp * cp
+            C = S // (2 * cp)
+            half = sidx // C
+            t = torch.where(half == 0, cpr, 2 * cp - 1 - cpr) * C + sidx % C
+        samples = dpr * b + torch.arange(b, device=device, dtype=torch.int64)
+        m = (samples[None, :] * S + t[:, None]).reshape(-1).contiguous()
+        if (dpr + 1) * b * S * hfull // 16 >= 2**32:
+            raise RuntimeError("lora_rng.positions: global element index exceeds the 32-bit Philox counter")
+        _maps[key] = m
+    return m, hfull, koff
diff --git a/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/placement_check.py b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/placement_check.py
new file mode 100644
index 0000000..f20810e
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/placement_check.py
@@ -0,0 +1,146 @@
+"""Fail-fast NVLink placement assertion for multi-island nodes (2-node plan).
+
+Each 8xH200 node is 2 NV6 islands. With mcore's default rank order
+(tp-cp-ep-dp-pp), a TP2/CP2 model group is 4 consecutive global ranks — one
+island — PROVIDED driver GPU numbering is island-contiguous (0-3 = island A,
+4-7 = island B; `nvidia-smi topo -m` shows the split) and nothing remaps
+CUDA_VISIBLE_DEVICES per rank. TP/CP comm must never straddle islands
+(NVLink exists only within); the DP group (LoRA grads, amax — a few MB/step)
+may span islands and nodes.
+
+This parses `nvidia-smi topo -m` once and asserts per rank that every
+TP-group and CP-group peer shares an NVLink connection, raising with a
+remediation message instead of silently routing per-layer comm over
+PCIe/SYS.
+"""
+
+import os
+import re
+import subprocess
+
+import torch
+import torch.distributed as dist
+
+_ANSI = re.compile(r"\x1b\[[0-9;]*m")
+_TOPO_CACHE = None
+
+
+def _topo_matrix():
+    """{(gpu_i, gpu_j): link_type} from `nvidia-smi topo -m` (cached)."""
+    global _TOPO_CACHE
+    if _TOPO_CACHE is not None:
+        return _TOPO_CACHE
+    out = subprocess.run(
+        ["nvidia-smi", "topo", "-m"], capture_output=True, text=True, timeout=60
+    )
+    if out.returncode != 0:
+        raise RuntimeError(
+            f"placement_check: nvidia-smi topo -m failed: {out.stderr.strip()}"
+        )
+    lines = [ _ANSI.sub("", ln).split() for ln in out.stdout.splitlines() ]
+    header = next((ln for ln in lines if ln and ln[0] == "GPU0"), None)
+    if header is None:
+        raise RuntimeError("placement_check: no GPU column header in topo output")
+    # GPU columns are the leading run of GPU<digit> tokens (the trailing
+    # "GPU NUMA ID" column's bare "GPU" token must not count)
+    n = 0
+    for tok in header:
+        if re.fullmatch(r"GPU\d+", tok):
+            n += 1
+        elif n:
+            break
+    topo = {}
+    for ln in lines:
+        if not ln or not re.fullmatch(r"GPU\d+", ln[0]):
+            continue
+        i = int(ln[0][3:])
+        # first n tokens after the row label are the GPU columns
+        if len(ln) < n + 1:
+            continue
+        for j in range(n):
+            topo[(i, j)] = ln[1 + j]
+    _TOPO_CACHE = (n, topo)
+    return _TOPO_CACHE
+
+
+def _physical_gpu_index():
+    """Physical GPU index of this rank's current device (CVD-translated).
+
+    CUDA_VISIBLE_DEVICES holds either numeric indices or GPU UUIDs; the uuid
+    form is what a scheduler hands out when it assigns cards by identity.
+    """
+    dev = torch.cuda.current_device()
+    cvd = os.environ.get("CUDA_VISIBLE_DEVICES", "")
+    if not cvd:
+        return dev
+    ids = cvd.split(",")
+    if dev >= len(ids):
+        raise RuntimeError(
+            f"placement_check: CUDA_VISIBLE_DEVICES={cvd!r} has fewer entries "
+            f"than current device {dev}"
+        )
+    entry = ids[dev].strip()
+    if entry.isdigit():
+        return int(entry)
+    uuid = entry.removeprefix("GPU-")
+    out = subprocess.run(
+        ["nvidia-smi", "--query-gpu=index,uuid", "--format=csv,noheader"],
+        capture_output=True, text=True, timeout=60,
+    )
+    if out.returncode != 0:
+        raise RuntimeError(
+            f"placement_check: nvidia-smi uuid query failed: {out.stderr.strip()}"
+        )
+    for line in out.stdout.splitlines():
+        idx, _, u = line.partition(",")
+        if u.strip().removeprefix("GPU-") == uuid:
+            return int(idx)
+    raise RuntimeError(
+        f"placement_check: CUDA_VISIBLE_DEVICES entry {entry!r} is not a GPU of this host"
+    )
+
+
+def _check_group(pg, group_name, phys_self, rank_self):
+    ranks = dist.get_process_group_ranks(pg)
+    if len(ranks) <= 1:
+        return
+    n, topo = _topo_matrix()
+    ids = [torch.zeros(1, dtype=torch.int64, device="cuda") for _ in ranks]
+    mine = torch.tensor([_physical_gpu_index()], dtype=torch.int64, device="cuda")
+    dist.all_gather(ids, mine, group=pg)
+    phys = {r: int(t.item()) for r, t in zip(ranks, ids)}
+    for r, p in phys.items():
+        if r == rank_self:
+            continue
+        link = topo.get((phys_self, p))
+        if link is None or not link.startswith("NV"):
+            raise RuntimeError(
+                f"placement_check: {group_name} group ranks {ranks} map to GPUs "
+                f"{phys} — ranks {rank_self} (GPU {phys_self}) and {r} (GPU {p}) "
+                f"are linked '{link}' (not NVLink). TP/CP groups must sit inside "
+                f"one NVLink island. Fix: ensure CUDA_VISIBLE_DEVICES is unset or "
+                f"maps consecutive local ranks onto one island "
+                f"(check `nvidia-smi topo -m`)."
+            )
+
+
+def assert_nvlink_model_groups():
+    """Raise unless this rank's TP and CP peers are all NVLink-connected."""
+    from megatron.core import parallel_state as ps
+
+    rank = dist.get_rank()
+    phys = _physical_gpu_index()
+    _check_group(ps.get_tensor_model_parallel_group(), "TP", phys, rank)
+    _check_group(ps.get_context_parallel_group(), "CP", phys, rank)
+    if rank == 0:
+        n, topo = _topo_matrix()
+        print(f"[placement_check] OK: TP/CP peers NVLink-connected "
+              f"(rank 0 on physical GPU {phys}, {n} GPUs visible)",
+              file=__import__("sys").stderr, flush=True)
+
+
+class PlacementCheckCallback:
+    """Bridge callback shim: assert placement once, after setup."""
+
+    def on_data_init_start(self, context):
+        assert_nvlink_model_groups()
diff --git a/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/qkv_eval_fused.py b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/qkv_eval_fused.py
new file mode 100644
index 0000000..a7e4cf1
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/qkv_eval_fused.py
@@ -0,0 +1,34 @@
+"""TP1 eval runs TEFusedLoRALinear's fused main branch, so eval uses training's numerics.
+
+At TP == 1 Bridge wraps linear_qkv / linear_proj in TEFusedLoRALinear, whose training forward is a te.ops
+main branch (RMSNorm -> Quantize -> MakeExtraOutput -> Linear) where the RMSNorm kernel writes FP8 directly
+with the Quantize op's quantizer: one rounding. With the adapter disabled (LORA_EVAL_MERGE merges the delta
+into the weight for eval), TEFusedLoRALinear would fall back to LoRALinear.forward, i.e. the LayerNormLinear
+module with return_layernorm_output=True, which writes the norm in bf16 and casts it afterwards: two roundings
+and its own delayed-scaling quantizer.
+
+Here, with the adapter disabled, the fused main branch runs and its extra output is dropped. It aliases the same FP8
+weight (so it reads the merged payload) and the same Quantize quantizer as training. This path is bitwise
+equal to the training path and lowers the eval memory peak. No effect where TEFusedLoRALinear is not built (TP > 1) or in training (adapter enabled).
+"""
+_installed = False
+
+
+def install():
+    global _installed
+    if _installed:
+        return
+    _installed = True
+    from megatron.bridge.peft.lora_layers import TEFusedLoRALinear
+
+    orig = TEFusedLoRALinear.forward
+
+    def forward(self, x):
+        if self._adapter_enabled:
+            return orig(self, x)
+        if self._fused_branches is None:
+            self._fused_branches = self._make_fused_branches()
+        out, _ = self._fused_branches[0](x)
+        return out, None
+
+    TEFusedLoRALinear.forward = forward
diff --git a/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/quantize_rowwise.py b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/quantize_rowwise.py
new file mode 100644
index 0000000..65672b8
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/quantize_rowwise.py
@@ -0,0 +1,47 @@
+"""Two forward cleanups on the TP1 recipe: no transposed copy of the qkv input, no memset before the fc1 GEMM.
+
+1. Megatron-Bridge's TEFusedLoRALinear builds the qkv main branch as te.ops RMSNorm -> Quantize(forward) ->
+   MakeExtraOutput -> Linear. The RMSNorm writes FP8 with the Quantize op's forward quantizer, whose usage nobody
+   sets, so it keeps the Float8Quantizer default of rowwise and columnwise. On Hopper, FP8 GEMMs take only the TN
+   layout, so the norm (TE's, and fused_residual's) also writes a transposed copy of the [tokens, hidden]
+   activation with a separate transpose kernel. Nothing reads that copy: the frozen qkv weight needs no wgrad, so
+   the Linear neither uses nor saves x^T, and the LoRA branch reads the rowwise payload. install() wraps te.ops
+   Quantize.pre_fuser_forward so the op's forward Float8Quantizer is rowwise-only. A consumer that does want the
+   columnwise data calls update_usage(columnwise_usage=True) on the tensor and TE builds it then (BasicLinear does
+   this for a weight gradient).
+
+2. The fc1 fprop GEMM epilogue max-accumulates its output amax into a fresh torch.zeros(1) (a memset node and a
+   gap before every fc1 GEMM). install() points fused_residual's norm kernel, which runs on the same stream before
+   the fc1 input exists, at a persistent slot in deepgemm_gemm that it zeroes; the fc1 GEMM takes that slot when it
+   is marked zeroed and allocates as before otherwise. The amax value is unchanged.
+"""
+import sys
+
+_installed = False
+
+
+def install():
+    """Wrap te.ops Quantize.pre_fuser_forward and connect the fc1 amax slot (idempotent)."""
+    global _installed
+    if _installed:
+        return
+    from transformer_engine.pytorch.ops.basic.quantize import Quantize
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+
+    import fused_residual
+
+    orig = Quantize.pre_fuser_forward
+
+    def pre_fuser_forward(self, *args, **kwargs):
+        orig(self, *args, **kwargs)
+        if not getattr(self, "_quantize_forward", False):
+            return
+        q = self.get_quantizer("forward", 0)
+        if type(q) is Float8Quantizer and q.columnwise_usage:
+            q.set_usage(rowwise=True, columnwise=False)
+
+    Quantize.pre_fuser_forward = pre_fuser_forward
+    dg = sys.modules.get("deepgemm_gemm")
+    if dg is not None and getattr(dg, "_FC1_AMAX", False):
+        fused_residual.AMAX_PREZERO = dg.fc1_amax_prezero
+    _installed = True
