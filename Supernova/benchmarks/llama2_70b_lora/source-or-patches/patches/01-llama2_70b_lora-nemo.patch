+"""FP8 attention output fed straight into linear_proj.
+
+The stock chain from the attention output to the output projection, per layer per microbatch, on the
+TP1 attention path with FP8 delayed scaling (with context parallelism the payload also crosses the
+a2a exchange):
+
+  attention forward                  O_quantizer(O): E4M3 payload of the attention output (kept)
+                                    [cp: the a2a moves the payload bytes]
+                                    out_fp8.dequantize(): BF16 O                       (removed here)
+  linear_proj (TEFusedLoRALinear)   BasicLinear input_quantizer(O): E4M3 payload again (removed here)
+                                    fprop GEMM, and the LoRA branch on the BF16 O
+
+With this module the attention call is made with fp8_output=True, so the attention returns the E4M3
+payload as a Float8Tensor (the a2a path hands back the received bytes without a kernel, the plain path
+quantizes O once), and the te.ops BasicLinear of linear_proj consumes it as is (a quantized input is
+not quantized again). The LoRA branch reads the same payload: the folded dropout + LoRA-A GEMM
+(lora_dropout_fold.py) dequantizes FP8 input in its prologue.
+
+Numerics: the projection GEMM reads q_O(O) instead of q_proj(dq(q_O(O))), one rounding fewer. Not
+bitwise. The O quantizer amax and scale_inv are produced as before.
+
+The proj input quantizer (linear_proj main branch BasicLinear, forward quantizer 0) does not quantize
+anything on this path, but eval reads it: eval is not routed and runs linear_proj on the BF16 attention
+output through that quantizer, with the scale its delayed-scaling history gives. So each routed call
+max-accumulates the attention's O amax into that quantizer's amax slot (amax_history[0]), one device
+op, no host sync, CUDA graph safe. The step-end amax reduction and scale update then treat it as in the
+unfolded path. The value is max|O| where the unfolded path records max|dq(q_O(O))|: q_O and dq are
+monotonic, so the two differ only by the E4M3 rounding of that one maximum (at most 2^-4 relative, or the
+saturation when O exceeds the O scale's range). Training does not read this quantizer, so training
+outputs and gradients are unchanged.
+
+Routing: Attention.forward_pre_attn_and_core_attn is wrapped (outside the fused RoPE wrapper). A call
+is eligible when the fused RoPE route is (self attention, training, the DotProductAttention core with
+or without context parallelism, FP8 delayed scaling and fp8_dpa, no head chunking; see
+fused_rope_fp8._qkv_quantizer), the attention's O quantizer is a per-tensor E4M3 Float8Quantizer, and
+linear_proj is a TEFusedLoRALinear with its adapter enabled and pre-dropout. For an eligible call the
+TE DotProductAttention.forward of that attention gets fp8_output=True. Every other call runs the
+original code.
+"""
+import inspect
+
+import torch
+
+_installed = False
+_target = None  # core attention module of the call being routed, None outside a routed call
+
+
+def _proj_ok(module):
+    from megatron.bridge.peft.lora_layers import TEFusedLoRALinear
+
+    lp = getattr(module, "linear_proj", None)
+    if type(lp) is not TEFusedLoRALinear or not lp._adapter_enabled:
+        return False
+    ad = getattr(lp, "adapter", None)
+    if ad is None or getattr(ad, "dropout_position", "pre") != "pre":
+        return False
+    w = lp.to_wrap
+    return getattr(w, "parallel_mode", "row") in ("row", None) and not getattr(w, "ub_overlap_rs", False)
+
+
+def _o_quantizer_ok(core_attention):
+    from transformer_engine.pytorch.attention.dot_product_attention import utils as dpa_utils
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+    import transformer_engine_torch as tex
+
+    fwd = (getattr(core_attention, "quantizers", None) or {}).get("scaling_fwd") or []
+    if len(fwd) <= dpa_utils.META_O:
+        return False
+    q = fwd[dpa_utils.META_O]
+    if type(q) is not Float8Quantizer or q.dtype != tex.DType.kFloat8E4M3:
+        return False
+    s, a = q.scale, q.amax
+    return (isinstance(s, torch.Tensor) and isinstance(a, torch.Tensor) and s.numel() == 1 and a.numel() == 1
+            and s.dtype == torch.float32 and a.dtype == torch.float32)
+
+
+def _proj_input_quantizer(linear_proj):
+    """Forward input quantizer of linear_proj's main-branch BasicLinear (a per-tensor Float8Quantizer), or None
+    before the fused branches and their recipe state exist."""
+    from transformer_engine.pytorch.ops.basic import BasicLinear
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+
+    branches = getattr(linear_proj, "_fused_branches", None)
+    if branches is None:
+        return None
+    for op in branches[0]._modules.values():
+        for basic in getattr(op, "basic_ops", (op,)):
+            if isinstance(basic, BasicLinear):
+                q = basic.get_quantizer("forward", 0) if basic._quantizers is not None else None
+                return q if type(q) is Float8Quantizer else None
+    return None
+
+
+@torch.no_grad()
+def _track_proj_input_amax(module):
+    """Max-accumulate the routed attention's O amax into linear_proj's input-quantizer amax slot."""
+    from transformer_engine.pytorch.attention.dot_product_attention import utils as dpa_utils
+
+    q = _proj_input_quantizer(module.linear_proj)
+    if q is None:
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("fused_quant_fold: graph capture of a routed attention before linear_proj has an "
+                               "FP8 input quantizer; its amax would never be tracked")
+        return
+    o_amax = module.core_attention.quantizers["scaling_fwd"][dpa_utils.META_O].amax
+    torch.maximum(q.amax, o_amax, out=q.amax)
+
+
+def _eligible(module, bound):
+    import fused_rope_fp8
+
+    if not (module.training and torch.is_grad_enabled()):
+        return False
+    if fused_rope_fp8._qkv_quantizer(module, bound) is None:
+        return False
+    return _o_quantizer_ok(module.core_attention) and _proj_ok(module)
+
+
+def _call_signature(fn):
+    """Signature of Megatron's forward_pre_attn_and_core_attn behind fn.
+
+    fn is the fused RoPE wrapper, whose own signature is (self, *args, **kwargs); binding against it would
+    hide every named argument (rotary_pos_emb, hidden_states, ...) from the eligibility check. The wrapper
+    keeps Megatron's signature in its closure as `sig`."""
+    code, cells = getattr(fn, "__code__", None), getattr(fn, "__closure__", None) or ()
+    if code is not None:
+        for name, cell in zip(code.co_freevars, cells):
+            if name == "sig" and isinstance(cell.cell_contents, inspect.Signature):
+                return cell.cell_contents
+    return inspect.signature(fn)
+
+
+def _dpa_kwargs(module, kwargs):
+    """kwargs of a TE DotProductAttention.forward call, with fp8_output=True for the routed attention."""
+    if module is _target:
+        kwargs["fp8_output"] = True
+    return kwargs
+
+
+def install():
+    """Wrap Attention.forward_pre_attn_and_core_attn and TE DotProductAttention.forward (idempotent).
+
+    Installs after fused_rope_fp8.install(), whose eligibility it reuses."""
+    global _installed
+    if _installed:
+        return
+    import fused_rope_fp8
+    from megatron.core.transformer import attention as mattn
+    from transformer_engine.pytorch.attention.dot_product_attention.dot_product_attention import (
+        DotProductAttention,
+    )
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Tensor
+
+    if not fused_rope_fp8._installed:
+        raise RuntimeError("fused_quant_fold: install fused_rope_fp8 first")
+    if "fp8_output" not in inspect.signature(DotProductAttention.forward).parameters:
+        raise RuntimeError("fused_quant_fold: TE DotProductAttention.forward has no fp8_output argument")
+
+    orig_dpa = DotProductAttention.forward
+
+    def dpa_forward(self, *args, **kwargs):
+        return orig_dpa(self, *args, **_dpa_kwargs(self, kwargs))
+
+    orig = mattn.Attention.forward_pre_attn_and_core_attn
+    sig = _call_signature(orig)
+    for p in ("hidden_states", "rotary_pos_emb", "packed_seq_params"):
+        if p not in sig.parameters:
+            raise RuntimeError(f"fused_quant_fold: forward_pre_attn_and_core_attn signature has no {p!r}: {sig}")
+
+    def forward_pre_attn_and_core_attn(self, *args, **kwargs):
+        global _target
+        if _target is not None or not _eligible(self, sig.bind(self, *args, **kwargs).arguments):
+            return orig(self, *args, **kwargs)
+        _target = self.core_attention
+        try:
+            out = orig(self, *args, **kwargs)
+        finally:
+            _target = None
+        if not isinstance(out, Float8Tensor):
+            raise RuntimeError(f"fused_quant_fold: routed attention returned {type(out).__name__}, not a Float8Tensor")
+        _track_proj_input_amax(self)
+        return out
+
+    DotProductAttention.forward = dpa_forward
+    mattn.Attention.forward_pre_attn_and_core_attn = forward_pre_attn_and_core_attn
+    _installed = True
