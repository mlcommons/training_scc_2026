index 0000000..248c9c0
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/lora_merge_fused.py
@@ -0,0 +1,80 @@
+import torch
+import triton
+import triton.language as tl
+
+BM = 32
+BN = 256
+WARPS = 4
+
+
+@triton.jit
+def _merge_kernel(payload_ptr, sinv_ptr, b_ptr, a_ptr, M, N, KD, scale, seed,
+                  K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr):
+    pm = tl.program_id(0)
+    pn = tl.program_id(1)
+    rows = pm * BM + tl.arange(0, BM)
+    cols = pn * BN + tl.arange(0, BN)
+    rmask = rows < M
+    cmask = cols < N
+    ks = tl.arange(0, K)
+    kmask = ks < KD
+    b = tl.load(b_ptr + rows[:, None] * KD + ks[None, :], mask=rmask[:, None] & kmask[None, :], other=0.0)
+    a = tl.load(a_ptr + ks[:, None] * N + cols[None, :], mask=kmask[:, None] & cmask[None, :], other=0.0)
+    lora = tl.dot(b, a).to(tl.bfloat16).to(tl.float32)
+    lora = (lora * scale).to(tl.bfloat16).to(tl.float32)
+    offs = rows[:, None].to(tl.int64) * N + cols[None, :]
+    mask = rmask[:, None] & cmask[None, :]
+    inv_scale = tl.math.div_rn(1.0, tl.load(sinv_ptr))
+    q = tl.load(payload_ptr + offs, mask=mask, other=0).to(tl.float8e4nv, bitcast=True)
+    y = q.to(tl.float32) + lora * inv_scale
+    bits = y.to(tl.int32, bitcast=True)
+    exponent = tl.where(y == 0.0, 0, ((bits >> 23) & 0xFF) - 126)
+    field = tl.maximum(exponent + 123, 118)
+    spacing = (field << 23).to(tl.float32, bitcast=True)
+    inv_spacing = ((254 - field) << 23).to(tl.float32, bitcast=True)
+    h = (offs.to(tl.int32) * (-1640531527) + seed).to(tl.uint32, bitcast=True)
+    h = h ^ (h >> 16)
+    h = (h.to(tl.int32, bitcast=True) * (-2048144789)).to(tl.uint32, bitcast=True)
+    h = h ^ (h >> 13)
+    h = (h.to(tl.int32, bitcast=True) * (-1028477387)).to(tl.uint32, bitcast=True)
+    h = h ^ (h >> 16)
+    noise = (h >> 8).to(tl.float32) * 5.9604644775390625e-08
+    rounded = tl.floor(y * inv_spacing + noise) * spacing
+    rounded = tl.minimum(tl.maximum(rounded, -448.0), 448.0)
+    tl.store(payload_ptr + offs, rounded.to(tl.float8e4nv).to(tl.uint8, bitcast=True), mask=mask)
+
+
+def factors(payload, linear_out, linear_in, dim, tp_group):
+    import torch.distributed as dist
+
+    tp = 1 if tp_group is None else dist.get_world_size(tp_group)
+    if tp == 1:
+        return linear_out, linear_in
+    if linear_in.shape[0] * tp == dim and linear_out.shape[1] == dim:
+        parts = [torch.empty_like(linear_in) for _ in range(tp)]
+        dist.all_gather(parts, linear_in, group=tp_group)
+        return linear_out, torch.cat(parts, dim=0)
+    if linear_out.shape[0] * tp == payload.shape[0]:
+        parts = [torch.empty_like(linear_out) for _ in range(tp)]
+        dist.all_gather(parts, linear_out, group=tp_group)
+        return torch.cat(parts, dim=0), linear_in
+    return linear_out, linear_in
+
+
+def supported(payload, scale_inv, linear_out, linear_in):
+    return (payload.dtype == torch.uint8 and payload.dim() == 2 and payload.is_contiguous()
+            and scale_inv.dtype == torch.float32 and scale_inv.numel() == 1
+            and linear_out.dtype == torch.bfloat16 and linear_in.dtype == torch.bfloat16
+            and linear_out.is_contiguous() and linear_in.is_contiguous()
+            and linear_out.shape[0] == payload.shape[0] and linear_in.shape[1] == payload.shape[1]
+            and linear_out.shape[1] == linear_in.shape[0] and 1 <= linear_out.shape[1] <= 256
+            and payload.numel() < 2 ** 31)
+
+
+def merge_into(payload, scale_inv, linear_out, linear_in, lora_scale, seed):
+    m, n = payload.shape
+    kd = linear_out.shape[1]
+    k = max(16, 1 << (kd - 1).bit_length())
+    grid = (triton.cdiv(m, BM), triton.cdiv(n, BN))
+    _merge_kernel[grid](payload, scale_inv, linear_out, linear_in, m, n, kd, float(lora_scale), int(seed),
+                        K=k, BM=BM, BN=BN, num_warps=WARPS)
diff --git a/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/lora_rng.py b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/lora_rng.py
