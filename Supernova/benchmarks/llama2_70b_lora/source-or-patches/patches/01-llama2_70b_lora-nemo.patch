 class DeltaTimingCallback(Callback):
+    """Per-step tracked_stats (train_step_time, loss, lr, grad norm) without a per-step host sync.
+
+    The loss and grad norm of step N are copied to pinned host memory without
+    blocking and logged at the end of step N+1, when they are complete, so the
+    host queues step N+1 while the GPU runs step N. train_step_time is the GPU
+    time between the end-of-step events of steps N-1 and N. The step before an
+    evaluation and the last step are flushed with a device sync, so eval_start
+    and run_stop follow the GPU.
+    """
+
     def __init__(self, cfg):
-        self.t0 = 0
