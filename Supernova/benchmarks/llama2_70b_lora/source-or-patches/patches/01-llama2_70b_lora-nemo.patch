+        combined_output = _A2AAdd.apply(linear_output, y, self.adapter.tp_group)
+        return combined_output if not self._base_returns_tuple else (combined_output, bias)
+    adapter_output = self.adapter_forward(self.adapter, ln, *args, **kwargs)
+    combined_output = torch.add(linear_output, adapter_output.reshape(linear_output.shape))
+    if not self._base_returns_tuple:
+        return combined_output
+    return combined_output, bias
+
+
+_logged = False
+_PLA = None
+_installed = False
+
+
+def install():
+    """Patch LoRALinear.forward and swap nn.Dropout for FusedDropout in newly built ParallelLinearAdapters (idempotent)."""
+    global _installed
+    if _installed:
+        return
+    from megatron.bridge.peft.lora_layers import LoRALinear
+    from megatron.bridge.peft.utils import ParallelLinearAdapter
