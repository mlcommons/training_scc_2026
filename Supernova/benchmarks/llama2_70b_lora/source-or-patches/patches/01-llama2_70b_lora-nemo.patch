+"""Select the TP collective transport in production training (TP_COMM_MODE).
+
+Modes
+-----
+    ub     (default) TE UserBuffers overlap. The ring writes into a registered
+           buffer DURING the GEMM, so the collective has no separate residency.
+           This is what ships.
+    nccl   Plain NCCL collectives, no overlap. The stock path, and the
+           reference every other mode is measured against.
+    symk   NCCL symmetric-memory kernels. Buffers are allocated from a
+           registered pool and NCCL runs its symmetric kernel instead of RING.
+           Requires NCCL_SYM_CTAS to be set explicitly: NCCL's own channel
+           count on registered buffers is below what the kernel needs.
+    tccl   T-CCL technique on our own primitive: the peer's partial is loaded
+           into smem by TMA and reduced into the local shard with
+           cp.reduce.async.bulk. Graph-safe by construction -- see tccl_mode.py.
+
+Why a switch and not a code change
+----------------------------------
+Megatron-Bridge's CLAUDE.md forbids editing 3rdparty/Megatron-LM, so the TP
+collective sites are intercepted from this module by replacing the module-level
+functions in megatron.core.tensor_parallel.mappings. That keeps the upstream
+tree pristine and makes the mode a single env var.
+
+The patch works because mappings.py's autograd Functions call the private
+helpers as bare module-level names (_gather_along_first_dim, ...), so replacing
+the attribute on the module is seen by every call site.
+
+What each mode intercepts
+-------------------------
+The five functions that carry TP traffic on this model:
+    _reduce                         all-reduce (row-parallel grad)
+    _gather_along_first_dim         all-gather  (sequence parallel)
+    _reduce_scatter_along_first_dim reduce-scatter (sequence parallel)
+    _gather_along_last_dim          all-gather  (column parallel output)
+    _reduce_scatter_along_last_dim  reduce-scatter (row parallel input)
+
+WHAT THIS DOES NOT REACH, and it matters when reading a result. With
+USE_TE_OPS=1 -- which production sets, and DEEPGEMM requires -- the transformer
+layers are TE's te.ops BasicLinear, and those call TE's own helpers in
+transformer_engine/pytorch/distributed.py (gather_along_first_dim,
+reduce_scatter_along_first_dim), not Megatron's mappings. Only the Megatron
+modules still on the classic path (embedding, output layer, and anything the
+fuser does not take) route through the patch above.
+
+So a run's "TP collective calls" count is a floor, not the whole TP traffic,
+and the report line must be read with that in mind. Every mode here has the
+same blind spot, so they are comparable with each other -- but none of them
+covers the TE-carried traffic, and a mode cannot be called production-ready for
+this stack until it does. The end-of-run report prints the count so the gap is
+visible rather than assumed.
+
+ub mode does NOT intercept: TE's modules carry the overlap internally, so the
+Python collectives never run. Intercepting would double-count.
+
+Install
+-------
+    import tp_comm_mode
+    tp_comm_mode.install()
+
+Called from train.py next to the other install() calls. No-op when
+TP_COMM_MODE is unset or "ub".
+"""
+
+import os
+
+import torch
+import torch.distributed as dist
+
+_INSTALLED = False
+_MODE = "ub"
+_REPORT = {"calls": 0, "pooled": 0, "fallbacks": 0}
+
+
+def mode():
+    return _MODE
+
+
+def _want_symm():
+    return _MODE == "symk"
+
+
+def _log(msg):
+    if int(os.environ.get("RANK", "0")) == 0:
+        print(f"[tp_comm_mode] {msg}", flush=True)
+
+
+def install():
+    """Intercept Megatron's TP collectives for the selected mode. Idempotent."""
+    global _INSTALLED, _MODE
+    if _INSTALLED:
+        return True
+    _MODE = os.environ.get("TP_COMM_MODE", "ub").strip().lower()
+
+    if _MODE in ("", "ub"):
+        _log("mode ub: TE UserBuffers overlap, no Python interception")
+        _INSTALLED = True
+        return True
+
+    if _MODE == "tccl":
+        # Implemented on our own primitive, not by linking ooverlap: that
+        # library carries a host-side epoch counter that a CUDA graph captures
+        # once and then replays stale, so it cannot be captured. tccl_mode.py
+        # maps the peer buffer over CUDA IPC and drives tma_rs_bf16, which is
+        # graph-safe.
+        import tccl_mode
+        tccl_mode._load_lib()  # fail now, not at the first collective
+        _log("mode tccl: our TMA reduce over an IPC-mapped peer (graph-safe)")
+
+    if _MODE not in ("nccl", "symk", "tccl"):
+        raise RuntimeError(
+            f"TP_COMM_MODE={_MODE!r} is not one of ub / nccl / symk / tccl")
+
+    try:
+        from megatron.core.tensor_parallel import mappings as M
+    except Exception as e:  # noqa: BLE001
+        raise RuntimeError(f"tp_comm_mode: cannot import mappings: {e}") from e
+
+    if _MODE == "symk":
+        # TP_COMM_MODE=symk IS the request for the symmetric pool: the pool is on exactly when UB_TRANSPORT is
+        # symk_nccl, so select it here. install() itself is deferred: see _ensure_symm().
+        os.environ["UB_TRANSPORT"] = "symk_nccl"
+
+    # nccl mode needs no patching: the stock functions already call
+    # torch.distributed directly. Installing the counters anyway keeps the
+    # report uniform across modes.
+    _patch(M)
+    # TE-carried TP traffic (USE_TE_OPS=1 modules), which the mappings patch above cannot reach: te_comm_takeover.py,
+    # always installed for symk and tccl (no separate switch).
+    import te_comm_takeover
+    te_comm_takeover.install(_MODE)
+    _INSTALLED = True
+    _log(f"mode {_MODE}: intercepted {len(_PATCHED)} TP collective sites")
+    if _MODE == "symk":
+        _log(f"NCCL_SYM_CTAS={os.environ.get('NCCL_SYM_CTAS', '<unset>')}")
+    return True
+
+
+_SYMM_READY = False
+
+
+def _ensure_symm():
+    """Create the symmetric pool at the first collective, not at install time.
+
+    symm_pool.install() registers on the TP process group, and train.py runs
+    install() long before Megatron's parallel_state exists. _candidate_groups()
+    swallows the resulting exception and returns an empty list, so an eager
+    install() finds no group, fails, and takes the run down at startup for a
+    reason that is not true by the time traffic flows.
+
+    The first collective is both the first moment the answer is correct and the
+    last moment before the pool has to exist, so it is where this belongs --
+    the same point symm_pool.pool_buffers already installs from.
+    """
+    global _SYMM_READY
+    if _SYMM_READY:
+        return
+    import symm_pool
+    if not symm_pool.install():
+        raise RuntimeError(
+            "TP_COMM_MODE=symk but symm_pool.install() failed at the first "
+            "collective; the collectives would silently run RING, which is "
+            "not a symmetric-kernel result. See the [symm_pool] line above.")
+    _SYMM_READY = True
+
+
+_PATCHED = []
+
+
+def _pooled(shape, dtype, device):
+    """Allocate from the symmetric pool when the mode wants it."""
+    if not _want_symm():
+        return torch.empty(shape, dtype=dtype, device=device)
+    _ensure_symm()
+    import symm_pool
+    with symm_pool.pool_buffers() as in_pool:
+        out = torch.empty(shape, dtype=dtype, device=device)
+    if not in_pool:
+        _REPORT["fallbacks"] += 1
+    return out
+
+
+def _patch(M):
+    """Replace the five TP collective entry points, keeping the originals."""
+    import functools
+
+    orig_reduce = M._reduce
+    orig_gaf = M._gather_along_first_dim
+    orig_rsaf = M._reduce_scatter_along_first_dim
+    orig_gal = M._gather_along_last_dim
+    orig_rsal = M._reduce_scatter_along_last_dim
+
+    def _reduce(input_, group):
+        if group is None or group.size() == 1:
+            return orig_reduce(input_, group)
+        _REPORT["calls"] += 1
+        if not _want_symm():
+            return orig_reduce(input_, group)
+        _ensure_symm()
+        import symm_pool
+        x = input_.contiguous()
+        # BOTH buffers must be inside the pool window, or NCCL falls back to
