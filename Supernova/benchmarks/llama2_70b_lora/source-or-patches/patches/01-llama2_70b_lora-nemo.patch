@@ -0,0 +1,553 @@
+"""Fused RoPE and FP8 quantize of q/k/v around the context parallel all-to-all attention.
+
+The stock chain from the qkv projection output to the FP8 all-to-all payload, per layer per microbatch:
+
+  forward   Megatron get_query_key_value_tensors: SplitAlongDim of mixed_qkv [s, b, ng, (np/ng + 2) * hn]
+            and the query reshape to [s, b, np, hn] (a strided copy, the views do not merge),
+            Megatron apply_rotary_pos_emb -> TE fused_rope_forward on q and on the strided k view,
+            TE FusedAttention context parallel path: v.contiguous() (copy),
+            TE AttnFuncWithCPAndQKVOA2A.forward: combine_and_quantize (cat of q|k|v, then the
+            delayed-scaling cast with the DotProductAttention QKV quantizer).
+  backward  AttnFuncWithCPAndQKVOA2A.backward: combine_and_dequantize (cat of dq|dk|dv, then the
+            dequantize with dq's scale_inv), TE fused_rope_backward on dk and dq, the reshape
+            backward (a view) and the SplitAlongDim backward (cat into dmixed_qkv).
+
+This module replaces both sides with one Triton kernel each, plus a small kernel that writes the cos
+and sin table of the call's freqs ([s, 256] fp32, the values TE's kernels compute per block):
+
+  forward   reads mixed_qkv once, applies RoPE in registers with TE's fp32 math (sin and cos of the
+            fp32 freqs through libdevice, the same products and the same fused multiply-add order),
+            rounds to BF16 where the stock chain materialises BF16, accumulates the amax of those
+            BF16 values into the quantizer's amax buffer, and writes the E4M3 payload of q, k and v
+            in the layout combine_and_quantize produces (one flat buffer, q then k then v) plus
+            scale_inv = 1 / scale. The three tensors reach TE as Float8Tensors, so the attention
+            function takes its quantized-input branch and quantizes nothing itself.
+  backward  receives the attention gradients as Float8Tensors (the quantized-input branch returns
+            them without dequantizing), dequantizes with dq's scale_inv and rounds to BF16 as the
+            stock dequantize does, applies the RoPE backward in registers and writes dmixed_qkv.
+
+The output bytes, the amax and dmixed_qkv are bitwise equal to the stock chain
+(h200-tuning/fused_rope_fp8/test_fused_rope_fp8.py).
+
+Routing: Attention.forward_pre_attn_and_core_attn is wrapped. For an eligible call (self attention,
+training with gradients enabled or evaluation without, no packed sequences, no inference context, BF16 activations, head
+dim 128 with power-of-two head counts, RoPE fusion on and not interleaved with fp32 contiguous freqs,
+the TE DotProductAttention core with or without context parallelism (its a2a path or the plain path),
+FP8 delayed scaling with fp8_dpa and an E4M3 QKV quantizer that already exists) the wrapper switches
+the call onto Megatron's single mixed_qkv RoPE branch (config.fused_single_qkv_rope for the duration
+of the call) and the patched apply_fused_qkv_rotary_pos_emb runs the fused kernels. With context
+parallelism the q/k/v payloads go into the exchange send slots, without they take plain buffers.
+Every other call runs the original code.
+"""
+import inspect
+import os
+import sys
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+_HD = 128  # head dim the kernels are written for
+# Tiling: query groups per program and warps per program, forward and backward.
+FWD_CFG = (8, 4)
+BWD_CFG = (8, 4)
+
+_installed = False
+_quantizer = None  # QKV quantizer of the attention call being routed, None outside a routed call
+# The CP group of the routed call when the forward writes q/k/v into the cp_a2a_ce send slots, else None
+_fold_group = None
+_module = None  # the Attention module of the routed call
+# The backward reads dq/dk/dv in the CP a2a receive layout (cp_a2a_ce receive-layout fold) when the exchange hands
+# them over that way; the forward of every routed call with the a2a fold group grants the exchange one fold.
+# The rope backward also writes the qkv grad-output E5M2 payload when _qkv_grad_quantizer finds one; the
+# fused_residual quantize hook consumes it instead of a separate cast.
+
+
+@triton.jit
+def _rope2(x, r, c, s):
+    """x * c + r * s with the multiply-add order nvcc gives TE's rope kernels: fma(x, c, r * s)."""
+    return tl.fma(x, c, r * s)
+
+
+@triton.jit
+def _sincos_kernel(f_ptr, cs_ptr, D: tl.constexpr):
+    """cs[s] = [cos(f[s, :D]), sin(f[s, :D])]: libdevice cosf and sinf, the values of TE's sincosf."""
+    s = tl.program_id(0).to(tl.int64)
+    d = tl.arange(0, D)
+    f = tl.load(f_ptr + s * D + d)
+    tl.store(cs_ptr + s * (2 * D) + d, libdevice.cos(f))
+    tl.store(cs_ptr + s * (2 * D) + D + d, libdevice.sin(f))
+
+
+@triton.jit
+def _store_rows_fp8(dst, lo, hi, scale):
+    H: tl.constexpr = lo.shape[1]
+    full = tl.reshape(tl.permute(tl.join(lo, hi), (0, 2, 1)), (lo.shape[0], 2 * H))
+    col = tl.arange(0, 2 * H)[None, :]
+    tl.store(dst + col, (full * scale).to(dst.dtype.element_ty))
+
+
+@triton.jit
+def _fwd_kernel(x_ptr, xs_s, xs_b, xs_g, csq_ptr, csk_ptr, q_ptr, k_ptr, v_ptr,
+                scale_ptr, amax_ptr, sinv_ptr, B, NT,
+                G: tl.constexpr, GB: tl.constexpr, HPG: tl.constexpr, D: tl.constexpr, CP: tl.constexpr):
+    """One token (s, b) and GB query groups per program: their q heads, k and v."""
+    pid = tl.program_id(0)
+    t = pid // (G // GB)
+    g0 = (pid % (G // GB)) * GB
+    s = t // B
+    b = t % B
+    H: tl.constexpr = D // 2
+    d = tl.arange(0, H)
+    base = x_ptr + s.to(tl.int64) * xs_s + b.to(tl.int64) * xs_b
+    scale = tl.load(scale_ptr)
+    t64 = t.to(tl.int64)
+
+    # q: rows r = g * HPG + h, the head order of the [s, b, np, hn] reshape
+    cs = csq_ptr + s.to(tl.int64) * (2 * D)
+    cl = tl.load(cs + d)[None, :]
+    ch = tl.load(cs + H + d)[None, :]
+    sl = tl.load(cs + D + d)[None, :]
+    sh = tl.load(cs + D + H + d)[None, :]
+    r = tl.arange(0, GB * HPG)
+    src = base + ((g0 + r // HPG) * xs_g + (r % HPG) * D)[:, None] + d[None, :]
+    lo = tl.load(src).to(tl.float32)
+    hi = tl.load(src + H).to(tl.float32)
+    olo = _rope2(lo, -hi, cl, sl).to(tl.bfloat16).to(tl.float32)
+    ohi = _rope2(hi, lo, ch, sh).to(tl.bfloat16).to(tl.float32)
+    amax = tl.maximum(tl.max(tl.abs(olo)), tl.max(tl.abs(ohi)))
+    # q: [s, b, np, hn] order with CP == 1; with CP > 1 the a2a send layout [cp, s, b, np / cp, hn]
+    hq = g0 * HPG + r
+    HC: tl.constexpr = G * HPG // CP
+    _store_rows_fp8(q_ptr + ((hq // HC).to(tl.int64) * NT * HC + t64 * HC + hq % HC)[:, None] * D, olo, ohi, scale)
+
+    # k: one head per group, after the group's q heads
+    cs = csk_ptr + s.to(tl.int64) * (2 * D)
+    cl = tl.load(cs + d)[None, :]
+    ch = tl.load(cs + H + d)[None, :]
+    sl = tl.load(cs + D + d)[None, :]
+    sh = tl.load(cs + D + H + d)[None, :]
+    g = g0 + tl.arange(0, GB)
+    src = base + (g * xs_g + HPG * D)[:, None] + d[None, :]
+    lo = tl.load(src).to(tl.float32)
+    hi = tl.load(src + H).to(tl.float32)
+    olo = _rope2(lo, -hi, cl, sl).to(tl.bfloat16).to(tl.float32)
+    ohi = _rope2(hi, lo, ch, sh).to(tl.bfloat16).to(tl.float32)
+    amax = tl.maximum(amax, tl.maximum(tl.max(tl.abs(olo)), tl.max(tl.abs(ohi))))
+    GC: tl.constexpr = G // CP
+    kv_row = ((g // GC).to(tl.int64) * NT * GC + t64 * GC + g % GC)[:, None]
+    _store_rows_fp8(k_ptr + kv_row * D, olo, ohi, scale)
+
+    # v: copied, no rotation
+    dv = tl.arange(0, D)
+    vv = tl.load(base + (g * xs_g + (HPG + 1) * D)[:, None] + dv[None, :]).to(tl.float32)
+    amax = tl.maximum(amax, tl.max(tl.abs(vv)))
+    tl.store(v_ptr + kv_row * D + dv[None, :], (vv * scale).to(v_ptr.dtype.element_ty))
+
+    tl.atomic_max(amax_ptr, amax)
+    if pid == 0:
+        tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+
+
+@triton.jit
+def _store_rows(dx_ptr, q8_ptr, off, lo, hi, scale, Q8: tl.constexpr):
+    """Store the row halves lo | hi (fp32 [R, H]) rounded to BF16 at dx_ptr + off (off: [R, 1] row starts), with Q8
+    also their E5M2 payload (bf16 value * scale, the TE cast) at q8_ptr + off. The halves are joined into full
+    [R, 2H] rows first, so each row is one contiguous store. Returns max |bf16 value| of the elementwise max of the
+    halves (only used with Q8)."""
+    H: tl.constexpr = lo.shape[1]
+    lb = lo.to(tl.bfloat16)
+    hb = hi.to(tl.bfloat16)
+    full = tl.reshape(tl.permute(tl.join(lb, hb), (0, 2, 1)), (lo.shape[0], 2 * H))
+    col = tl.arange(0, 2 * H)[None, :]
+    tl.store(dx_ptr + off + col, full)
+    if Q8:
+        tl.store(q8_ptr + off + col, (full.to(tl.float32) * scale).to(q8_ptr.dtype.element_ty))
+    return tl.max(tl.maximum(tl.abs(lb.to(tl.float32)), tl.abs(hb.to(tl.float32))))
+
+
+@triton.jit
+def _bwd_kernel(dq_ptr, dk_ptr, dv_ptr, sinv_ptr, csq_ptr, csk_ptr, dx_ptr, B,
+                q8_ptr, dscale_ptr, damax_ptr, dsinv_ptr, NT,
+                G: tl.constexpr, GB: tl.constexpr, HPG: tl.constexpr, D: tl.constexpr, Q8: tl.constexpr,
+                CP: tl.constexpr):
+    """One token and GB query groups per program: dequantize dq/dk/dv, RoPE backward of dq and dk,
+    write the groups' dmixed_qkv rows [GB, (HPG + 2) * D]. With Q8 also write the E5M2 payload of
+    dmixed_qkv with the qkv grad-output quantizer's scale, max-accumulate its amax (one atomic per program)
+    and write scale_inv.
+    dq/dk/dv are token-major [NT, heads, D] with CP == 1; with CP > 1 they are the CP a2a receive layout
+    [CP, NT, heads / CP, D] (head h at peer h // (heads / CP), local head h % (heads / CP)), read in place."""
+    pid = tl.program_id(0)
+    t = pid // (G // GB)
+    g0 = (pid % (G // GB)) * GB
+    s = t // B
+    H: tl.constexpr = D // 2
+    W: tl.constexpr = (HPG + 2) * D
+    d = tl.arange(0, H)
+    si = tl.load(sinv_ptr)
+    t64 = t.to(tl.int64)
+    dscale = 1.0
+    if Q8:
+        dscale = tl.load(dscale_ptr)
+
+    cs = csq_ptr + s.to(tl.int64) * (2 * D)
+    cl = tl.load(cs + d)[None, :]
+    ch = tl.load(cs + H + d)[None, :]
+    sl = tl.load(cs + D + d)[None, :]
+    sh = tl.load(cs + D + H + d)[None, :]
+    r = tl.arange(0, GB * HPG)
+    if CP == 1:
+        src = dq_ptr + (t64 * (G * HPG) + g0 * HPG + r)[:, None] * D + d[None, :]
+    else:
+        HC: tl.constexpr = G * HPG // CP
+        hq = g0 * HPG + r
+        src = dq_ptr + ((hq // HC).to(tl.int64) * NT * HC + t64 * HC + hq % HC)[:, None] * D + d[None, :]
+    lo = (tl.load(src).to(tl.float32) * si).to(tl.bfloat16).to(tl.float32)
+    hi = (tl.load(src + H).to(tl.float32) * si).to(tl.bfloat16).to(tl.float32)
+    olo = _rope2(lo, hi, cl, sh)
+    ohi = _rope2(hi, lo, ch, -sl)
+    row = (t64 * G + g0 + r // HPG)[:, None] * W + ((r % HPG) * D)[:, None]
+    amax = _store_rows(dx_ptr, q8_ptr, row, olo, ohi, dscale, Q8)
+
+    cs = csk_ptr + s.to(tl.int64) * (2 * D)
+    cl = tl.load(cs + d)[None, :]
+    ch = tl.load(cs + H + d)[None, :]
+    sl = tl.load(cs + D + d)[None, :]
+    sh = tl.load(cs + D + H + d)[None, :]
+    g = g0 + tl.arange(0, GB)
+    if CP == 1:
+        kv_row = (t64 * G + g)[:, None]
+    else:
+        GC: tl.constexpr = G // CP
+        kv_row = ((g // GC).to(tl.int64) * NT * GC + t64 * GC + g % GC)[:, None]
+    src = dk_ptr + kv_row * D + d[None, :]
+    lo = (tl.load(src).to(tl.float32) * si).to(tl.bfloat16).to(tl.float32)
+    hi = (tl.load(src + H).to(tl.float32) * si).to(tl.bfloat16).to(tl.float32)
+    olo = _rope2(lo, hi, cl, sh)
+    ohi = _rope2(hi, lo, ch, -sl)
+    row = (t64 * G + g)[:, None] * W + HPG * D
+    amax = tl.maximum(amax, _store_rows(dx_ptr, q8_ptr, row, olo, ohi, dscale, Q8))
+
+    src = dv_ptr + kv_row * D + d[None, :]
+    vlo = tl.load(src).to(tl.float32) * si
+    vhi = tl.load(src + H).to(tl.float32) * si
+    row = (t64 * G + g)[:, None] * W + (HPG + 1) * D
+    amax = tl.maximum(amax, _store_rows(dx_ptr, q8_ptr, row, vlo, vhi, dscale, Q8))
+    if Q8:
+        tl.atomic_max(damax_ptr, amax)
+        if pid == 0:
+            tl.store(dsinv_ptr, libdevice.div_rn(1.0, dscale))
+
+
+_SINCOS_CACHE = {}
+_SINCOS_CACHE_MAX = 8
+
+
+def _table(f, S):
+    key = (f.data_ptr(), tuple(f.shape), tuple(f.stride()), S)
+    hit = _SINCOS_CACHE.get(key)
+    if hit is not None and hit[0]._version == hit[2]:
+        return hit[1]
+    cs = torch.empty(S, 2 * _HD, dtype=torch.float32, device=f.device)
+    _sincos_kernel[(S,)](f, cs, D=_HD, num_warps=1)
+    if torch.cuda.is_current_stream_capturing():
+        return cs
+    if len(_SINCOS_CACHE) >= _SINCOS_CACHE_MAX:
+        _SINCOS_CACHE.pop(next(iter(_SINCOS_CACHE)))
+    _SINCOS_CACHE[key] = (f, cs, f._version)
+    return cs
+
+
+def _sincos(fq, fk, S):
+    """cos/sin tables [S, 2 * 128] of the first S rows of fq and fk (one table when they are the same rows)."""
+    csq = _table(fq, S)
+    if fk.data_ptr() == fq.data_ptr():
+        return csq, csq
+    return csq, _table(fk, S)
+
+
+_TORCH_FP8 = {}
+
+
+def _torch_fp8(te_dtype):
+    if not _TORCH_FP8:
+        import transformer_engine_torch as tex
+
+        _TORCH_FP8[int(tex.DType.kFloat8E4M3)] = torch.float8_e4m3fn
+        _TORCH_FP8[int(tex.DType.kFloat8E5M2)] = torch.float8_e5m2
+    return _TORCH_FP8[int(te_dtype)]
+
+
+def rope_quant_fwd(mixed, fq, fk, quantizer, cp_group=None):
+    """mixed [s, b, ng, (hpg + 2) * 128] BF16 -> uint8 payloads q [s, b, ng * hpg, 128], k and v
+    [s, b, ng, 128] (views of one flat buffer, q then k then v) and scale_inv [1]. Accumulates the
+    amax of the BF16 rotated values into quantizer.amax.
+    With cp_group, q, k and v are written into their cp_a2a_ce send slots in the a2a
+    send layout [cp, s, b, h / cp, 128] and returned as those slots viewed as [s, b, h, 128]."""
+    S, B, G, W = mixed.shape
+    hpg = W // _HD - 2
+    n_q, n_kv = S * B * G * hpg * _HD, S * B * G * _HD
+    cp = 1
+    if cp_group is not None:
+        import cp_a2a_ce
+
+        cp = cp_group.size()
+        q, k, v = (cp_a2a_ce.acquire_pre(n, mixed.device, cp_group).view(S, B, h, _HD)
+                   for n, h in ((n_q, G * hpg), (n_kv, G), (n_kv, G)))
+    else:
+        buf = torch.empty(n_q + 2 * n_kv, dtype=torch.uint8, device=mixed.device)
+        q = buf[:n_q].view(S, B, G * hpg, _HD)
+        k = buf[n_q:n_q + n_kv].view(S, B, G, _HD)
+        v = buf[n_q + n_kv:].view(S, B, G, _HD)
+    sinv = torch.empty(1, dtype=torch.float32, device=mixed.device)
+    fp8 = _torch_fp8(quantizer.dtype)
+    gb, warps = FWD_CFG
+    gb = min(gb, G)
+    csq, csk = _sincos(fq, fk, S)
+    _fwd_kernel[(S * B * (G // gb),)](
+        mixed, mixed.stride(0), mixed.stride(1), mixed.stride(2), csq, csk,
+        q.view(fp8), k.view(fp8), v.view(fp8), quantizer.scale, quantizer.amax, sinv, B, S * B,
+        G=G, GB=gb, HPG=hpg, D=_HD, CP=cp,
+        num_warps=warps, enable_fp_fusion=False,
+    )
+    return q, k, v, sinv
+
+
+def rope_dequant_bwd(dq, dk, dv, scale_inv, fp8_dtype, fq, fk, shape, dy_quantizer=None):
+    """uint8 gradient payloads dq [s, b, ng * hpg, 128], dk, dv [s, b, ng, 128] of TE dtype fp8_dtype,
+    all dequantized with scale_inv -> dmixed_qkv of shape [s, b, ng, (hpg + 2) * 128] BF16.
+    With dy_quantizer (a delayed-scaling Float8Quantizer) returns (dmixed_qkv, payload uint8 of the same
+    shape, scale_inv fp32 [1]): the payload is the quantizer's cast of dmixed_qkv and its amax is
+    max-accumulated into dy_quantizer.amax, as the quantizer's own cast does.
+    dq, dk and dv may be the cp_a2a_ce receive-layout placeholders of the post exchange (ce transport): their
+    bytes are then in the receive layout [cp, s, b, heads / cp, 128] and the kernel reads that layout in place."""
+    S, B, G, W = shape
+    hpg = W // _HD - 2
+    cp = 1
+    a2a = sys.modules.get("cp_a2a_ce")  # placeholders exist only once the exchange module is loaded
+    if a2a is not None:
+        cp = a2a.recv_layout(dq, dk, dv) or 1
+        if cp > 1 and (G % cp or (G * hpg) % cp):
+            raise RuntimeError("fused_rope_fp8: receive-layout dq/dk/dv with heads not divisible by cp")
+    fp8 = _torch_fp8(fp8_dtype)
+    dx = torch.empty(S, B, G, W, dtype=torch.bfloat16, device=dq.device)
+    if dy_quantizer is not None:
+        data = torch.empty(S, B, G, W, dtype=torch.uint8, device=dq.device)
+        dsinv = torch.empty(1, dtype=torch.float32, device=dq.device)
+        q8, dscale, damax = data.view(_torch_fp8(dy_quantizer.dtype)), dy_quantizer.scale, dy_quantizer.amax
+    else:
+        q8 = dscale = damax = dsinv = dx
+    gb, warps = BWD_CFG
+    gb = min(gb, G)
+    csq, csk = _sincos(fq, fk, S)
+    _bwd_kernel[(S * B * (G // gb),)](
+        dq.contiguous().view(fp8), dk.contiguous().view(fp8), dv.contiguous().view(fp8),
+        scale_inv, csq, csk, dx, B, q8, dscale, damax, dsinv, S * B,
+        G=G, GB=gb, HPG=hpg, D=_HD, Q8=dy_quantizer is not None, CP=cp,
+        num_warps=warps, enable_fp_fusion=False,
+    )
+    if dy_quantizer is not None:
+        return dx, data, dsinv
+    return dx
+
+
+def _float8(data, scale_inv, quantizer, dtype):
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Tensor
+
+    return Float8Tensor(shape=data.shape, dtype=dtype, data=data, fp8_scale_inv=scale_inv,
+                        fp8_dtype=quantizer.dtype, requires_grad=False, data_transpose=None,
+                        quantizer=quantizer, device=data.device)
+
+
+class _RopeQKVFP8(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, mixed, fq, fk, quantizer, cp_group, dy_quantizer=None):
+        q, k, v, sinv = rope_quant_fwd(mixed, fq, fk, quantizer, cp_group)
+        if cp_group is not None:
+            import cp_a2a_ce
+
+            cp_a2a_ce.grant_recv_fold()
+        ctx.save_for_backward(fq, fk)
+        ctx.shape = tuple(mixed.shape)
+        ctx.dy_quantizer = dy_quantizer
+        return tuple(_float8(x, sinv, quantizer, mixed.dtype) for x in (q, k, v))
+
+    @staticmethod
+    def backward(ctx, gq, gk, gv):
+        from transformer_engine.pytorch.tensor.storage.float8_tensor_storage import Float8TensorStorage
+
+        fq, fk = ctx.saved_tensors
+        if not all(isinstance(x, Float8TensorStorage) for x in (gq, gk, gv)):
+            raise RuntimeError("fused_rope_fp8: the attention backward returned non-FP8 q/k/v gradients")
+        # dk and dv dequantize with dq's scale_inv and dtype, as combine_and_dequantize does
+        args = (gq._data, gk._data, gv._data, gq._scale_inv, gq._fp8_dtype, fq, fk, ctx.shape)
+        dq8 = ctx.dy_quantizer
+        if dq8 is None:
+            return rope_dequant_bwd(*args), None, None, None, None, None
+        import fused_residual
+
+        dx, data, dsinv = rope_dequant_bwd(*args, dy_quantizer=dq8)
+        fused_residual.stash_payload(dx, data, dsinv, dq8)
+        return dx, None, None, None, None, None
+
+
+def _qkv_grad_quantizer(module):
+    """The qkv grad-output quantizer the rope backward casts dmixed_qkv with, or None:
+    a delayed-scaling E5M2 Float8Quantizer of the main-branch BasicLinear of a TEFusedLoRALinear linear_qkv."""
+    import fused_residual
+    import transformer_engine_torch as tex
+    from megatron.bridge.peft.lora_layers import TEFusedLoRALinear
+
+    lq = getattr(module, "linear_qkv", None)
+    if type(lq) is not TEFusedLoRALinear or not lq._adapter_enabled or not lq._fused_branches:
+        return None
+    q = fused_residual._branch_grad_quantizer(lq._fused_branches[0])
+    if q is None or not fused_residual._delayed_quantizer_any_usage(q, tex.DType.kFloat8E5M2):
+        return None
+    return q
+
+
+def _make_apply(stock_apply):
+    def apply_fused_qkv_rotary_pos_emb(mixed_qkv, q_freqs, k_freqs, qkv_split_arg_list, *args, **kwargs):
+        if _quantizer is None:
+            return stock_apply(mixed_qkv, q_freqs, k_freqs, qkv_split_arg_list, *args, **kwargs)
+        dyq = _qkv_grad_quantizer(_module)
+        return _RopeQKVFP8.apply(mixed_qkv, q_freqs, k_freqs, _quantizer, _fold_group, dyq)
+
+    return apply_fused_qkv_rotary_pos_emb
+
+
+def _qkv_quantizer(module, args):
+    """The DotProductAttention QKV quantizer when this attention call is eligible, else None."""
+    from megatron.core.transformer import attention as mattn
+    from megatron.core.transformer.identity_op import IdentityOp
+    from transformer_engine.pytorch.attention.dot_product_attention import utils as dpa_utils
+    from transformer_engine.pytorch.attention.dot_product_attention.dot_product_attention import (
+        DotProductAttention,
+    )
+    from transformer_engine.pytorch.quantization import FP8GlobalStateManager
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+    import transformer_engine_torch as tex
+
+    if module.training != torch.is_grad_enabled() or module.attention_type != "self":
+        return None
+    for name in ("key_value_states", "inference_context", "inference_params", "packed_seq_params",
+                 "rotary_pos_cos", "rotary_pos_sin", "rotary_pos_cos_sin", "attention_bias",
+                 "packed_sequence_cp_metadata"):
+        if args.get(name) is not None:
+            return None
+    rpe = args.get("rotary_pos_emb")
+    if rpe is None or (isinstance(rpe, tuple) and (len(rpe) != 2 or rpe[0] is None or rpe[1] is None)):
+        return None
+    hs = args.get("hidden_states")
+    if not isinstance(hs, torch.Tensor) or hs.dtype != torch.bfloat16 or hs.dim() != 3:
+        return None
+    for f in rpe if isinstance(rpe, tuple) else (rpe,):
+        if (not isinstance(f, torch.Tensor) or f.dim() != 4 or f.dtype != torch.float32 or not f.is_contiguous()
+                or f.shape[0] < hs.shape[0] or f.shape[1] != 1 or f.shape[2] != 1 or f.shape[3] != _HD):
+            return None
+    nq, ng = module.num_attention_heads_per_partition, module.num_query_groups_per_partition
+    if (module.hidden_size_per_attention_head != _HD or nq % ng or nq & (nq - 1) or ng & (ng - 1)
+            or module.config.num_query_groups < module.world_size):
+        return None
+    cfg = module.config
+    if (cfg.fused_single_qkv_rope or cfg.test_mode or cfg.flash_decode or not cfg.apply_rope_fusion
+            or cfg.rotary_interleaved or cfg.multi_latent_attention or cfg.no_rope_freq
+            or getattr(cfg, "mrope_section", None) is not None or cfg.attention_output_gate
+            or not mattn.HAVE_FUSED_QKV_ROPE):
+        return None
+    if getattr(module, "_yarn_concentration_factor", 1.0) != 1.0:
+        return None
+    for ln in (getattr(module, "q_layernorm", None), getattr(module, "k_layernorm", None)):
+        if ln is not None and not isinstance(ln, IdentityOp):
+            return None
+    ca = module.core_attention
+    if not isinstance(ca, DotProductAttention) or ca.qkv_format != "sbhd":
+        return None
+    if isinstance(ca.cp_group, torch.distributed.ProcessGroup) and ca.cp_group.size() >= 2:
+        if ca.cp_comm_type != "a2a":
+            return None
+    elif ca.cp_group is not None:
+        return None
+    if os.getenv("NVTE_CP_A2A_HEAD_CHUNKS", "1") != "1" or os.getenv("NVTE_DPA_FP8_RECIPE", ""):
+        return None
+    if not FP8GlobalStateManager.is_fp8_enabled():
+        return None
+    recipe = FP8GlobalStateManager.get_fp8_recipe()
+    if not (recipe.delayed() and recipe.fp8_dpa):
+        return None
+    fwd = getattr(ca, "quantizers", {}).get("scaling_fwd") or []
+    if len(fwd) <= dpa_utils.META_QKV:
+        return None
+    q = fwd[dpa_utils.META_QKV]
+    if type(q) is not Float8Quantizer or q.dtype != tex.DType.kFloat8E4M3:
+        return None
+    s, a = q.scale, q.amax
+    if not (isinstance(s, torch.Tensor) and isinstance(a, torch.Tensor) and s.numel() == 1 and a.numel() == 1
+            and s.dtype == torch.float32 and a.dtype == torch.float32 and s.is_cuda and a.is_cuda):
+        return None
+    return q
+
+
+def _a2a_fold_group(module):
+    """The CP group when q/k/v can be written straight into the cp_a2a_ce send slots (the
+    ce/tma carrier installed, heads divisible by cp), else None. Without a CP group (no
+    context parallelism) the payloads take their plain buffers and None is returned."""
+    grp = module.core_attention.cp_group
+    if not isinstance(grp, torch.distributed.ProcessGroup) or grp.size() < 2:
+        return None
+    import cp_a2a_ce
+    from transformer_engine.pytorch.attention.dot_product_attention import context_parallel as te_cp
+
+    if te_cp.flash_attn_a2a_communicate is not cp_a2a_ce._a2a:
+        return None
+    cp = grp.size()
+    nq, ng = module.num_attention_heads_per_partition, module.num_query_groups_per_partition
+    if nq % cp or ng % cp:
+        return None
+    return grp
+
+
+def install():
+    """Wrap Attention.forward_pre_attn_and_core_attn and Megatron's mixed_qkv RoPE entry (idempotent)."""
+    global _installed
+    if _installed:
+        return
+    from megatron.core.transformer import attention as mattn
+
+    if not mattn.HAVE_FUSED_QKV_ROPE:
+        raise RuntimeError("fused_rope_fp8: Megatron has no apply_fused_qkv_rotary_pos_emb entry (TE too old)")
+    src = inspect.getsource(mattn.Attention.forward_pre_attn_and_core_attn)
+    for needle in ("self.config.fused_single_qkv_rope", "apply_fused_qkv_rotary_pos_emb(",
+                   "mixed_qkv, q_pos_emb, k_pos_emb, qkv_split_arg_list"):
+        if needle not in src:
+            raise RuntimeError(f"fused_rope_fp8: Megatron forward_pre_attn_and_core_attn changed ({needle!r} missing)")
+    orig = mattn.Attention.forward_pre_attn_and_core_attn
+    sig = inspect.signature(orig)
+
+    def forward_pre_attn_and_core_attn(self, *args, **kwargs):
+        global _quantizer, _fold_group, _module
+        bound = sig.bind(self, *args, **kwargs).arguments
+        q = _qkv_quantizer(self, bound)
+        if q is None:
+            return orig(self, *args, **kwargs)
+        cfg = self.config
+        cfg.fused_single_qkv_rope = True
+        _quantizer = q
+        _fold_group = _a2a_fold_group(self)
+        _module = self
+        try:
+            return orig(self, *args, **kwargs)
+        finally:
+            cfg.fused_single_qkv_rope = False
+            _quantizer = None
+            _fold_group = None
+            _module = None
+
+    mattn.apply_fused_qkv_rotary_pos_emb = _make_apply(mattn.apply_fused_qkv_rotary_pos_emb)
+    mattn.Attention.forward_pre_attn_and_core_attn = forward_pre_attn_and_core_attn
+    import fused_residual
+
+    fused_residual.install_te_hooks()  # the quantize hook that consumes the rope backward payload
+    _installed = True
