+"""Fused elementwise chain of the LoRA adapter (plain-torch segments only; TE GEMMs untouched).
+
+What the stock Bridge path does per adapted linear (qkv, proj), per layer, per microbatch:
+  fwd:  y = nn.Dropout(x)               (torch fused_dropout: writes y AND a mask tensor)
+        ...A / B GEMMs...
+        combined = linear_output.clone(); combined.add_(adapter_output)   (clone R+W, add R+R+W)
+  bwd:  masked_scale(dy, mask)           (reads the saved mask)
+
+Fusions implemented here (plain-torch segments only; TE GEMMs are untouched):
+  1. LoRALinear.forward: `out = linear_output + adapter_output` (one out-of-place pass) instead of
+     clone() + add_() -> avoids one full read+write of the output per adapted linear. The autograd
+     graph is equivalent (AddBackward passes the gradient to both inputs; CloneBackward is identity).
+  2. Adapter dropout ('pre', training, p>0): Triton dropout that saves only an 8-byte key for backward and
+     REGENERATES the mask there (no mask write in fwd, no mask read in bwd). The mask is the layout-invariant
+     one of lora_rng: Philox4x32-10 keyed per adapter call (lora_rng.call_seed, on device, CUDA-graph safe),
+     one call per 16 consecutive GLOBAL elements (global row id * H + global hidden index,
+     lora_rng.positions), drop when the element's byte is below floor(p * 256), keep scaled by 1/(1-p) --
+     the same bits the TP1 fold path (lora_dropout_fold) draws for the same token, so a seed gives the same
+     masks under every TP x CP layout. The adapter's A init is layout-invariant the same way
+     (lora_rng.init_lora_a). An adapter-less FusedDropout falls back to dropout_regen (default CUDA
+     generator, local flat index).
+  3. Proj adapter with LORA_A2A: the hidden->sequence all-to-all runs on ONE contiguous buffer, the
+     cat(dim=-1) is folded into the residual add in a Triton kernel, and the backward is a single
+     permute with no cat (bitwise identical to the stock path).
+"""
+import os
+import weakref
+
+import torch
+import torch.nn as nn
+import triton
+import triton.language as tl
+
+import lora_rng
+from lora_dropout_fold import _chunk_base, _drop_threshold, _keep_mask_cb
+
+_BLOCK = 512   # elements per philox lane per program (one program covers 4*_BLOCK elements)
+_ROUNDS = 7    # Philox4x32-7 (passes BigCrush per Salmon et al.)
+
+
+@triton.jit
+def _dropout_scale_kernel(x_ptr, y_ptr, seed_ptr, n, p, c, BLOCK: tl.constexpr, EVEN: tl.constexpr,
+                          ROUNDS: tl.constexpr):
+    """y = x * c * (u >= p), u ~ U[0,1) from philox4x32(seed, counter); 4 lanes of BLOCK contiguous elements."""
+    pid = tl.program_id(0)
+    seed = tl.load(seed_ptr)
+    j = tl.arange(0, BLOCK)
+    r0, r1, r2, r3 = tl.rand4x(seed, pid * BLOCK + j, ROUNDS)
+    base = pid * (4 * BLOCK) + j
+    for q in tl.static_range(4):
+        o = base + q * BLOCK
+        r = r0 if q == 0 else (r1 if q == 1 else (r2 if q == 2 else r3))
+        if EVEN:
+            x = tl.load(x_ptr + o)
+            tl.store(y_ptr + o, tl.where(r >= p, x.to(tl.float32) * c, 0.0).to(y_ptr.dtype.element_ty))
+        else:
+            m = o < n
+            x = tl.load(x_ptr + o, mask=m, other=0.0)
+            tl.store(y_ptr + o, tl.where(r >= p, x.to(tl.float32) * c, 0.0).to(y_ptr.dtype.element_ty), mask=m)
+
+
+def _launch(x, seed, p):
+    assert x.is_contiguous() and x.numel() < 2**31 - 8 * _BLOCK
+    y = torch.empty_like(x)
+    n = x.numel()
+    grid = (triton.cdiv(n, 4 * _BLOCK),)
+    _dropout_scale_kernel[grid](x, y, seed, n, p, 1.0 / (1.0 - p), BLOCK=_BLOCK, EVEN=(n % (4 * _BLOCK) == 0),
+                                ROUNDS=_ROUNDS, num_warps=4)
+    return y
+
+
+class _DropoutRegen(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, seed, p):
+        ctx.save_for_backward(seed)
+        ctx.p = p
+        return _launch(x.contiguous(), seed, p)
+
+    @staticmethod
+    def backward(ctx, g):
+        (seed,) = ctx.saved_tensors
+        return _launch(g.contiguous(), seed, ctx.p), None, None
+
+
+def dropout_regen(x: torch.Tensor, p: float) -> torch.Tensor:
+    """Dropout with on-device seed drawn from the default CUDA generator (graph-safe)."""
+    seed = torch.randint(0, 2**62, (1,), dtype=torch.int64, device=x.device)
+    return _DropoutRegen.apply(x, seed, p)
+
+
+# ---- layout-invariant dropout (lora_rng): the mask of lora_dropout_fold, keyed on global positions --------
+_PBM = 32
+_PBK = 128
+
+
+@triton.jit
+def _pos_dropout_kernel(x_ptr, y_ptr, seed_ptr, grow_ptr, M, K, KG, KOFF, thr, scale,
+                        BM: tl.constexpr, BK: tl.constexpr, ROUNDS: tl.constexpr):
+    """y = keep * x * scale; keep from one Philox4x32 call per 16 consecutive GLOBAL elements (_keep_mask)."""
+    rows = tl.program_id(0) * BM + tl.arange(0, BM)
+    k0 = tl.program_id(1) * BK
+    cols = k0 + tl.arange(0, BK)
+    rm = rows < M
+    seed = tl.load(seed_ptr)
+    cb = _chunk_base(tl.load(grow_ptr + rows, mask=rm, other=0), KG, KOFF)
+    keep = _keep_mask_cb(seed, cb, k0, thr, BM, BK, ROUNDS)
+    off = rows.to(tl.int64)[:, None] * K + cols[None, :]
+    x = tl.load(x_ptr + off, mask=rm[:, None], other=0.0).to(tl.float32)
+    tl.store(y_ptr + off, tl.where(keep, x * scale, 0.0).to(y_ptr.dtype.element_ty), mask=rm[:, None])
+
+
+def _pos_launch(x, seed, pos, p):
+    grow, KG, KOFF = pos
+    K = x.shape[-1]
+    x2 = x.contiguous().view(-1, K)
+    M = x2.shape[0]
+    assert K % _PBK == 0 and grow.numel() == M
+    thr, scale = _drop_threshold(p)
+    y = torch.empty_like(x2)
+    _pos_dropout_kernel[(triton.cdiv(M, _PBM), K // _PBK)](x2, y, seed, grow, M, K, KG, KOFF, thr, scale,
+                                                           BM=_PBM, BK=_PBK, ROUNDS=10, num_warps=4)
+    return y.view(x.shape)
+
+
+class _PosDropout(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, seed, pos, p):
+        ctx.save_for_backward(seed)
+        ctx.pos, ctx.p = pos, p
+        return _pos_launch(x, seed, pos, p)
+
+    @staticmethod
+    def backward(ctx, g):
+        (seed,) = ctx.saved_tensors
+        return _pos_launch(g, seed, ctx.pos, ctx.p), None, None, None
+
+
+class FusedDropout(nn.Module):
+    """Drop-in for nn.Dropout(p) (same `.p`, train/eval semantics). With its adapter known, the mask is the
+    layout-invariant one of lora_rng (same bits as the TP1 fold path for the same token); else dropout_regen."""
+
+    def __init__(self, p: float, adapter=None):
+        super().__init__()
+        self.p = p
+        # weakref: a Module attribute would register the adapter as a child of its own submodule
+        self._adapter = weakref.ref(adapter) if adapter is not None else None
+
+    def forward(self, x):
+        if not self.training or self.p == 0.0:
+            return x
+        adapter = self._adapter() if self._adapter is not None else None
+        if adapter is None:
+            return dropout_regen(x, self.p)
+        seed = lora_rng.call_seed(adapter, x.device)
+        pos = lora_rng.positions(adapter, x.shape, x.device)
+        return _PosDropout.apply(x, seed, pos, self.p)
+
+    def extra_repr(self):
+        return f"p={self.p} (lorafuse)"
+
+
+# ---- proj adapter (LORA_A2A): hidden->sequence all-to-all fused with the residual add ----------------
+# stock: chunk(dim0)+contiguous -> all_to_all (list) -> torch.cat(dim=-1) [fwd]; chunk(dim=-1)+2x contiguous ->
+# all_to_all -> torch.cat(dim=0) [bwd]; then clone+add_. Here the exchange runs on ONE contiguous
+# [ws, S/ws, H/ws] buffer (all_to_all_single), the cat(dim=-1) is folded into the add
+# (out[s, j*Hh+h] = base[s, j*Hh+h] + recv[j, s, h]) and bwd needs one permute copy and no cat.
+@triton.jit
+def _perm_add_kernel(base_ptr, recv_ptr, out_ptr, S2, H, Hh, S2Hh, BLOCK: tl.constexpr):
+    """out[s, c] = base[s, c] + recv[c // Hh, s, c % Hh]"""
+    s = tl.program_id(0)
+    cb = tl.program_id(1)
+    c = cb * BLOCK + tl.arange(0, BLOCK)
+    j = (cb * BLOCK) // Hh
+    h = c - j * Hh
+    r = tl.load(recv_ptr + j * S2Hh + s * Hh + h)
+    b = tl.load(base_ptr + s * H + c)
+    tl.store(out_ptr + s * H + c, (b.to(tl.float32) + r.to(tl.float32)).to(out_ptr.dtype.element_ty))
+
+
+@triton.jit
+def _perm_kernel(g_ptr, send_ptr, S2, H, Hh, S2Hh, BLOCK: tl.constexpr):
+    """send[j, s, h] = g[s, j*Hh + h]"""
+    s = tl.program_id(0)
+    cb = tl.program_id(1)
+    c = cb * BLOCK + tl.arange(0, BLOCK)
+    j = (cb * BLOCK) // Hh
+    h = c - j * Hh
+    tl.store(send_ptr + j * S2Hh + s * Hh + h, tl.load(g_ptr + s * H + c))
+
+
+_PB = 1024
+
+
+class _A2AAdd(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, base, y, group):
+        import torch.distributed as dist
+        ws = dist.get_world_size(group)
+        ctx.group, ctx.ws, ctx.gshape = group, ws, base.shape
+        ctx.yshape = y.shape
+        Hh = y.shape[-1]
+        y = y.reshape(-1, Hh).contiguous()
+        shape = base.shape
+        base = base.reshape(-1, shape[-1]).contiguous()
+        S, S2, H = y.shape[0], base.shape[0], shape[-1]
+        assert S == S2 * ws and H == Hh * ws
+        recv = torch.empty_like(y)
+        dist.all_to_all_single(recv, y, group=group)
+        if Hh % _PB == 0:
+            out = torch.empty_like(base)
+            _perm_add_kernel[(S2, H // _PB)](base, recv, out, S2, H, Hh, S2 * Hh, BLOCK=_PB)
+        else:
+            out = base + recv.view(ws, S2, Hh).permute(1, 0, 2).reshape(S2, H)
+        return out.view(shape)
+
+    @staticmethod
+    def backward(ctx, g):
+        import torch.distributed as dist
+        ws, group = ctx.ws, ctx.group
+        gshape = ctx.gshape
+        g = g.contiguous()
+        g2 = g.view(-1, gshape[-1])
+        S2, H = g2.shape
+        Hh = H // ws
+        if Hh % _PB == 0:
+            send = torch.empty((ws * S2, Hh), dtype=g.dtype, device=g.device)
+            _perm_kernel[(S2, H // _PB)](g2, send, S2, H, Hh, S2 * Hh, BLOCK=_PB)
+        else:
+            send = g2.view(S2, ws, Hh).permute(1, 0, 2).reshape(ws * S2, Hh)
+        recv = torch.empty_like(send)
+        dist.all_to_all_single(recv, send, group=group)
+        return g, recv.view(ctx.yshape), None
+
+
+def _a2a_eligible(ad):
+    return (ad.input_is_parallel and ad.use_a2a and not ad.disable_sequence_parallel_comm and not ad.is_expert
+            and not ad.replicate_adapter and not ad.config.cpu_offloading
+            and getattr(ad, "dropout_position", "pre") == "pre")
+
+
+def _adapter_forward_pre_a2a(ad, x):
+    """ParallelLinearAdapter.forward for the row-parallel (proj) a2a case, stopping before all2all_hp2sp."""
+    x = ad.dropout(x)
+    x, _ = ad.linear_in(x)
+    x = ad.activation(x)
+    x = x * (ad.alpha / ad.dim)
+    x, _ = ad.linear_out(x)
+    return x
+
+
+def _lora_forward(self, x, *args, **kwargs):
+    """LoRALinear.forward with `out = base + adapter` (no clone + add_)."""
+    global _logged
+    if not _logged and int(os.environ.get("RANK", "0")) == 0:
+        _logged = True
+        print(f"[lora_fused] fused LoRALinear.forward and Triton dropout active; first module {type(self.to_wrap).__name__}",
+              flush=True)
+    linear_output, bias, layernorm_output = self.base_linear_forward(x, *args, **kwargs)
+    if not self._adapter_enabled:
+        return linear_output if not self._base_returns_tuple else (linear_output, bias)
+    ln = layernorm_output.contiguous()
