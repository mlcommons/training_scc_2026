+"""E5M2 quantize of the attention output gradient straight into the CP a2a send layout.
+
+On the TP1 context parallel a2a path with FP8 delayed scaling, AttnFuncWithCPAndQKVOA2A.backward receives the
+BF16 gradient of the attention output, quantizes it with its dO quantizer (a TE cast to E5M2, amax into the
+quantizer) and hands the payload to the pre-exchange, which packs it into its send slot with a strided copy
+(the 16384-grid direct_copy on the main stream, [s, b, h, d] -> [cp, s, b, h/cp, d]).
+
+This module wraps that backward. For an eligible call it claims the dout send slot (cp_a2a_ce.acquire_pre, the
+next call on the payload's ring, as the exchange would) and one Triton kernel quantizes dout into it in the packed
+order, with TE's delayed-scaling cast: payload = e5m2(fp32(x) * scale), max |fp32(x)| atomically into the
+quantizer's amax, scale_inv = 1 / scale. The backward then receives a Float8Tensor (its quantized-input branch:
+no cast) whose payload is the slot viewed as dout's shape; only the exchange reads it, and it skips its pack.
+
+Eligible: the cp_a2a_ce carrier installed, cp >= 2, no head chunking, FP8 delayed scaling on the fused attention
+backend, o_format sbhd, a contiguous BF16 dout of rank 4 (or 3, [s, b, h * d]) whose head count divides by cp, and
+a rowwise-only per-tensor E5M2 Float8Quantizer as the dO quantizer. Every other call runs the stock backward.
+"""
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+_installed = False
+
+
+@triton.jit
+def _quant_pack_kernel(x_ptr, y_ptr, scale_ptr, amax_ptr, sinv_ptr, NT,
+                       H: tl.constexpr, D: tl.constexpr, CP: tl.constexpr):
+    """One token t = (s, b) per program: its H * D values -> the send layout [cp, s * b, H / cp, D]."""
+    t = tl.program_id(0).to(tl.int64)
+    i = tl.arange(0, H * D)
+    x = tl.load(x_ptr + t * (H * D) + i).to(tl.float32)
+    scale = tl.load(scale_ptr)
+    h = i // D
+    HC: tl.constexpr = H // CP
+    dst = ((h // HC).to(tl.int64) * NT * HC + t * HC + h % HC) * D + i % D
+    tl.store(y_ptr + dst, (x * scale).to(y_ptr.dtype.element_ty))
+    tl.atomic_max(amax_ptr, tl.max(tl.abs(x)))
+    if tl.program_id(0) == 0:
+        tl.store(sinv_ptr, libdevice.div_rn(1.0, scale))
+
+
+def quant_pack(dout, quantizer, cp_group, heads, head_dim):
+    """dout BF16 (contiguous, S * B tokens of heads * head_dim) -> Float8Tensor of dout's shape whose uint8
+    payload is a cp_a2a_ce send slot holding the E5M2 values in the packed [cp, s, b, h/cp, d] order."""
+    import cp_a2a_ce
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Tensor
+
+    cp = cp_group.size()
+    n = dout.numel()
+    slot = cp_a2a_ce.acquire_pre(n, dout.device, cp_group)
+    sinv = torch.empty(1, dtype=torch.float32, device=dout.device)
+    nt = n // (heads * head_dim)
+    _quant_pack_kernel[(nt,)](dout, slot.view(torch.float8_e5m2), quantizer.scale, quantizer.amax, sinv, nt,
+                              H=heads, D=head_dim, CP=cp, num_warps=8)
+    return Float8Tensor(shape=dout.shape, dtype=dout.dtype, data=slot.view(dout.shape), fp8_scale_inv=sinv,
+                        fp8_dtype=quantizer.dtype, requires_grad=False, data_transpose=None, quantizer=quantizer,
+                        device=dout.device)
+
+
+def _eligible(ctx, dout):
+    """(cp_group, heads, head_dim) when this backward call can take the packed quantize, else None."""
+    import cp_a2a_ce
+    import transformer_engine_torch as tex
+    from transformer_engine.pytorch.attention.dot_product_attention import context_parallel as te_cp
+    from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer
+    from transformer_engine.pytorch.tensor.storage.float8_tensor_storage import Float8TensorStorage
+
+    if te_cp.flash_attn_a2a_communicate is not cp_a2a_ce._a2a:
+        return None
+    if getattr(ctx, "head_chunks", 1) > 1 or not getattr(ctx, "fp8", False) or not ctx.use_fused_attention:
+        return None
+    if not ctx.fp8_recipe.delayed() or getattr(ctx, "o_format", None) != "sbhd":
+        return None
+    if not isinstance(dout, torch.Tensor) or isinstance(dout, Float8TensorStorage):
+        return None
+    if dout.dtype != torch.bfloat16 or not dout.is_cuda or not dout.is_contiguous() or dout.dim() not in (3, 4):
+        return None
+    grp = ctx.cp_group
+    if not isinstance(grp, torch.distributed.ProcessGroup) or grp.size() < 2:
+        return None
+    shape = tuple(getattr(ctx, "orig_o_shape", ()))
+    if len(shape) != 4 or dout.numel() != shape[0] * shape[1] * shape[2] * shape[3]:
+        return None
+    heads, head_dim = shape[2], shape[3]
+    cp = grp.size()
+    if heads % cp or (heads * head_dim) & (heads * head_dim - 1):
+        return None
+    qz = ctx.dO_quantizer
+    if (type(qz) is not Float8Quantizer or qz.dtype != tex.DType.kFloat8E5M2 or not qz.rowwise_usage
+            or qz.columnwise_usage):
+        return None
+    s, a = qz.scale, qz.amax
+    if not (isinstance(s, torch.Tensor) and isinstance(a, torch.Tensor) and s.numel() == 1 and a.numel() == 1
+            and s.dtype == torch.float32 and a.dtype == torch.float32 and s.is_cuda and a.is_cuda):
+        return None
+    return grp, heads, head_dim
+
+
+def install():
+    """Wrap AttnFuncWithCPAndQKVOA2A.backward (idempotent)."""
+    global _installed
+    if _installed:
+        return
+    from transformer_engine.pytorch.attention.dot_product_attention import context_parallel as te_cp
+
+    fn = te_cp.AttnFuncWithCPAndQKVOA2A
+    stock = fn.backward
+
+    def backward(ctx, dout, *args):
+        el = _eligible(ctx, dout)
+        if el is not None:
+            grp, heads, head_dim = el
+            dout = quant_pack(dout, ctx.dO_quantizer, grp, heads, head_dim)
+        return stock(ctx, dout, *args)
+
+    fn.backward = staticmethod(backward)
+    _installed = True
