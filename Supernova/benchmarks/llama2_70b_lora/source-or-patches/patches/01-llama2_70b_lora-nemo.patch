@@ -0,0 +1,263 @@
+# Copyright (c) 2026, Billy Cao.
+
+"""NCCL symmetric-memory pool for the training collectives (UB_TRANSPORT=symk_nccl).
+
+What this does
+--------------
+Registers a CUDA memory pool with NCCL and allocates collective buffers from
+it, so NCCL can run its symmetric kernels (`ReduceScatter_LD`,
+`AllReduce_RSxLD_AGxST`, ...) instead of the SM-resident RING kernels.
+
+What this cannot do
+-------------------
+The TP reduce-scatters (`proj_fprop`, `fc2_fprop`, `qkv_dgrad`) do NOT go
+through torch.distributed. They are TE UserBuffers C++ kernels with their own
+communicator, and a symmetric pool cannot reach them. That path is
+`te-ub-symk.patch`, selected by UB_TRANSPORT=symk_nccl.
+
+So this covers the LoRA adapter AG/RS, the CP token all-reduces, and the CP
+a2a IPC-handle all-gather.
+
+Why a pool at all
+-----------------
+NCCL runs a symmetric kernel only when BOTH the send and receive buffers are
+inside a registered symmetric window. A plain `torch.empty` is not, so it
+silently falls back to RING. The pool is how the buffers reach a window
+without touching each call site's allocation.
+
+API notes
+---------
+- `register_mem_pool` is a method on the concrete NCCL ProcessGroup, not on
+  `torch.distributed` and not on the abstract `ProcessGroup`. It is reached
+  through the group object at runtime.
+- The pool allocator must be `ProcessGroupNCCL.mem_allocator`.
+  `_symmetric_memory.get_mempool_allocator` produces segments NCCL refuses
+  ("Window address must be suitably aligned").
+- `_symmetric_memory.enable_symm_mem_for_group(name)` is a DIFFERENT feature
+  (the symm_mem tensor API, used by `all_to_all_nd`). It is not needed for
+  NCCL's symmetric *kernels* and is not called here.
+
+Failure modes guarded against
+-----------------------------
+- `NCCL_SYM_CTAS=16` sets the CTA count of the symmetric kernels on registered
+  buffers (NCCL's own pick is lower). It is an env var, so no NCCL rebuild is
+  needed.
+- Forcing `NCCL_SYM_KERNEL` disables every non-symmetric algorithm on that
+  communicator and breaks unregistered collectives. Do not set it.
+- A collective whose buffers are outside the pool falls back to RING
+  silently. `stats()` counts pool vs non-pool calls so a silent fallback
+  reads as a number rather than as "in-band".
+"""
+
+import os
+
+import torch
+import torch.distributed as dist
+
+_pool = None
+_installed = False
+_enabled = False
+_groups_registered = 0
+_in_pool = 0
+_out_of_pool = 0
+
+
+def enabled():
+    return _enabled
+
+
+def available():
+    """True if this torch build exposes the pieces we need."""
+    try:
+        from torch.distributed import ProcessGroupNCCL
+    except ImportError:
+        return False
+    return (
+        hasattr(torch.cuda, "MemPool")
+        and hasattr(torch.cuda, "use_mem_pool")
+        and hasattr(ProcessGroupNCCL, "register_mem_pool")
+        and hasattr(ProcessGroupNCCL, "mem_allocator")
+    )
+
+
+def stats():
+    """Calls that landed in the symmetric pool vs fell back to plain buffers.
+
+    A high `out_of_pool` count means the pool is not covering
+    the traffic, and any speedup measured is not the symmetric kernels'."""
+    return {"in_pool": _in_pool, "out_of_pool": _out_of_pool,
+            "groups": _groups_registered}
+
+
+class pool_buffers:
+    """Allocate the enclosed tensors from the registered symmetric pool.
+
+        with symm_pool.pool_buffers() as in_pool:
+            out = torch.empty(...)
+            dist.all_gather_into_tensor(out, x, group=g)
+            symm_pool.note(in_pool)
+
+    `in_pool` is False when the feature is off or the pool could not be
+    created, so a call site degrades to plain buffers rather than failing.
+    """
+
+    def __init__(self):
+        self._ctx = None
+
+    def __enter__(self):
+        if not _installed and os.environ.get("UB_TRANSPORT", "nccl") == "symk_nccl" \
+                and dist.is_initialized() and not torch.cuda.is_current_stream_capturing():
+            # First collective call site installs the pool: every rank reaches the same
+            # first LoRA collective, after parallel_state is up and before the
+            # full-iteration graph capture. Without this nothing ever calls install()
+            # from the training path and the pool is a silent no-op.
+            install()
+        if not _enabled or _pool is None:
+            return False
+        try:
+            self._ctx = torch.cuda.use_mem_pool(_pool)
+            self._ctx.__enter__()
+            return True
+        except Exception:  # noqa: BLE001 - never fail a training step here
+            self._ctx = None
+            return False
+
+    def __exit__(self, *exc):
+        if self._ctx is not None:
+            try:
+                self._ctx.__exit__(*exc)
+            except Exception:  # noqa: BLE001
+                pass
+        return False
+
+
+def note(in_pool):
+    """Count a collective as pool-backed or not, for the end-of-run report."""
+    global _in_pool, _out_of_pool
+    if in_pool:
+        _in_pool += 1
+    else:
+        _out_of_pool += 1
+
+
+def _candidate_groups():
+    """The NCCL groups the pool is registered on: the TP group, plus the
+    DP group when it is intra-node.
+
+    The pooled call sites (lora_local.py) are TP collectives, and with symm=True every pool segment created
+    later is registered on every registered communicator, one collective each. WORLD and DP span nodes, where
+    the symmetric kernels do not apply (intra-node only), so registering them buys nothing and adds a
+    cross-node collective to every segment creation — except a single-node DP group (TP1 x CP4 x DP2 on
+    one host), where the distributed optimizer's f32 gradient all-reduce is exactly the traffic the
+    symmetric kernels cover.
+    """
+    out = []
+    try:
+        from megatron.core import parallel_state as ps
+
+        g = ps.get_tensor_model_parallel_group()
+        if g is not None:
+            out.append(g)
+        if os.environ.get("SYMM_POOL_DP", "0") == "1":
+            dp = ps.get_data_parallel_group()
+            if dp is not None and dist.get_world_size(dp) == dist.get_world_size():
+                out.append(dp)  # single-node DP group == the whole world on this host
+    except Exception:  # noqa: BLE001
+        pass
+    return out
+
+
+def install():
+    """Create and register the symmetric pool. Idempotent.
+
+    Call once after init_process_group and before the first collective. Safe
+    unless UB_TRANSPORT is symk_nccl: returns False without touching anything.
+    """
+    global _pool, _installed, _enabled, _groups_registered
+
+    if _installed:
+        return _enabled
+    _installed = True
+
+    if os.environ.get("UB_TRANSPORT", "nccl") != "symk_nccl":
+        return False
+
+    if not available():
+        print("[symm_pool] OFF: this torch build has no "
+              "ProcessGroupNCCL.register_mem_pool / mem_allocator", flush=True)
+        return False
+
+    from torch.distributed import ProcessGroupNCCL
+
+    try:
+        # mem_allocator is an INSTANCE property. Read on the class it is the
+        # property descriptor itself, which torch.cuda.MemPool rejects with
+        # "incompatible constructor arguments ... Invoked with: <property
+        # object>". Take it from a backend instance; the class
+        # attribute stays only as a fallback for a torch build that exposes it
+        # as a plain attribute.
+        alloc = None
+        for g in _candidate_groups():
+            try:
+                alloc = g._get_backend(torch.device("cuda", torch.cuda.current_device())).mem_allocator
+                break
+            except Exception:  # noqa: BLE001
+                continue
+        _pool = torch.cuda.MemPool(alloc if alloc is not None else ProcessGroupNCCL.mem_allocator)
+    except Exception as e:  # noqa: BLE001
+        print(f"[symm_pool] OFF: pool creation failed: {e}", flush=True)
+        _pool = None
+        return False
+
+    seen = set()
+    for g in _candidate_groups():
+        if id(g) in seen:
+            continue
+        seen.add(id(g))
+        register = getattr(g, "register_mem_pool", None)
+        if register is None:
+            # A c10d ProcessGroup wrapper: the method lives on its NCCL backend.
+            # Without this fallback every group is skipped and the pool is torn down.
+            try:
+                be = g._get_backend(torch.device("cuda", torch.cuda.current_device()))
+                register = getattr(be, "register_mem_pool", None)
+            except Exception:  # noqa: BLE001
+                register = None
+        if register is None:
+            continue
+        try:
+            register(_pool, symm=True)
+            _groups_registered += 1
+        except Exception as e:  # noqa: BLE001
+            print(f"[symm_pool] group skipped: {e}", flush=True)
+
+    if _groups_registered == 0:
+        print("[symm_pool] OFF: no NCCL group accepted the pool", flush=True)
+        _pool = None
+        return False
+
+    _enabled = True
+    ctas = os.environ.get("NCCL_SYM_CTAS")
+    msg = f"[symm_pool] ON: {_groups_registered} groups registered"
+    if ctas:
+        msg += f", NCCL_SYM_CTAS={ctas}"
+    else:
+        msg += " -- WARNING: NCCL_SYM_CTAS unset; set NCCL_SYM_CTAS=16."
+    print(msg, flush=True)
+    # Without this the pool-vs-fallback counters are never printed and a run
+    # where the pool carried nothing reads exactly like a run where it carried
+    # everything.
+    import atexit
+    atexit.register(report)
+    return True
+
+
+def report():
+    """End-of-run line: did the pool actually carry the traffic."""
+    if not _enabled:
+        return
+    print(f"[symm_pool] calls in pool {_in_pool}, outside {_out_of_pool}, "
+          f"groups {_groups_registered}", flush=True)
+    if _out_of_pool > _in_pool:
+        print("[symm_pool] WARNING: most collectives did NOT use the pool; "
+              "the symmetric kernels were mostly idle", flush=True)
