+"""CP all-to-all transport for the context parallel attention exchange, any cp_size >= 2: a bulk copy over
+IPC-mapped peer slots on all eight exchanges (q, k, v, out, dout, dq, dk, dv). One flag, one implementation,
+installed at every cp: CP_A2A_COMM=nccl, the default when the variable is unset, leaves the stock
+(cp_layout_copies) exchange, and any other value raises.
+
+The copy is a TMA kernel (tma_copy_blocks, do_reduce=0) or a copy engine copy, by CP_A2A_COMM. The TMA
+library is built from h200-tuning/tma_reduce/tma_reduce.cu by
+h200-tuning/tma_reduce/build_lib.sh (nvcc sm_90a); TMA_REDUCE_LIB overrides the path.
+
+
+Where it sits
+-------------
+With NVTE_CP_A2A_HEAD_CHUNKS unset, TE's AttnFuncWithCPAndQKVOA2A takes the stock path:
+flash_attn_a2a_communicate (as patched by cp_layout_copies) with one torch.distributed.all_to_all_single per
+tensor -- q, k, v before attention, out after it; dout before the backward attention, dq, dk, dv after it. All
+eight move fp8 bytes. This module replaces flash_attn_a2a_communicate for sbhd with the same body and the NCCL
+all-to-all swapped for TMA pulls. HEAD_CHUNKS >= 2 routes q/k/v through the fused pre-exchange, which never
+reaches this function, so with it set this module covers the other five sites and q/k/v stay on NCCL.
+
+Post exchanges
+--------------
+The post path needs no staging copy: the producer's sequence-order payload is copied into its slot once
+(replacing the stock reorder kernel, same bytes) and each consumer pulls its two sequence chunks straight
+out of it.
+
+Mechanism (a ring per payload byte count, cp_size - 1 peers)
+------------------------------------------------------------
+Each rank owns two send slots (depth 2) and one counter block [tick, publish, done[0..cp-1]], raw cudaMalloc
+blocks exported over IPC and mapped into every peer once, eagerly, before any graph capture. done[p] counts this
+rank's completed pulls FROM peer p, so the (src, dst) pair p -> me has its own counter, and peer p's producer
+reads it. Call k on a ring (k = the device-side tick, read at run time so graph replays gate on live counter
+values, never on host-baked thresholds):
+  producer (main stream):  tick += 1; wait every peer q: q.done[me] >= tick - 2   (slot reuse)
+                           pack into send slot (the stock layout copy, retargeted)
+                           publish += 1                                         (release, sys)
+                           own rows: local copy slot -> out
+  consumer (one side stream per peer p, forked after the publish):
+                           wait p.publish >= done[p] + 1   (acquire, sys; done[p] is this side
+                                                            stream's own FIFO counter, so + 1 is
+                                                            exactly this pull's index)
+                           pull of p's slot rows for this rank -> out
+                           done[p] += 1                             (release, sys)
+                           join event -> the cp stream wait()s on it, as on the NCCL work
+The producer of call k needs only its consumers' call k - 2, and a consumer only the producers' call k, so the
+dependency graph is acyclic and the cross-rank lead is bounded at two calls. Counters are monotonic and never
+reset.
+
+Slot rotation is host-chosen and baked into the captured graph; it stays consistent across replays because every
+ring sees an EVEN number of calls per captured region. Rings are keyed by byte count: at the training shapes the
+16 MiB ring carries q, out, dout, dq (4 per layer per microbatch) and the 2 MiB ring k, v, dk, dv (4), the eval
+shapes get their own rings with 2 per layer per microbatch each. A configuration that makes a per-region ring
+count odd breaks the rotation; the a2a bench replays a captured graph across many
+replays with fresh data and checks every output byte against stock.
+
+Spins and SMs
+-------------
+Two spin kernels, each ONE program: the producer gate (main stream) and the consumer gate (one per side stream,
+so at most cp_size - 1 resident: 3 at cp 4, 7 at cp 8). A spin holds one SM; at most cp of 132 are held (8 at cp 8), so every kernel a peer's
+progress needs (its pack, its arrive, a GEMM) still has SMs to run on. The TMA pull is SM work (CTAs x one SM
+each, see _TMA_CTAS_GPU for the per-GPU budget) but never spins -- it only waits on its own TMA mbarriers -- so it cannot starve a
+producer. No persistent grid spins anywhere.
+
+Numerics: only bytes move. The pack and the layout copies are the stock ones (same views, same wide integer
+copies) retargeted into the slot, quantisation and amax are untouched (they happen before this function), and
+every exchanged byte is a bitwise copy.
+
+Transport: CP_A2A_COMM=tma pulls each peer's slot with tma_copy_blocks, which needs TMA_REDUCE_LIB or
+h200-tuning/tma_reduce/build/libtma_reduce.so of this checkout (built by
+h200-tuning/tma_reduce/build_lib.sh). CP_A2A_COMM=ce copies the same bytes with the copy engines on the
+same side streams and needs no library.
+"""
+import ctypes
+import ctypes.util
+import os
+import socket
+
+import torch
+import triton
+import triton.language as tl
+
+import cp_layout_copies as _clc
+
+_ipc_lazy_peer_access = 0x01  # cudaIpcMemLazyEnablePeerAccess
+
+
+def _load_cudart():
+    for name in ("libcudart.so.13", "libcudart.so.12", "libcudart.so"):
+        try:
+            return ctypes.CDLL(name)
+        except OSError:
+            continue
+    found = ctypes.util.find_library("cudart")
+    if found is None:
+        raise RuntimeError("libcudart not found")
+    return ctypes.CDLL(found)
+
+
+class _IpcMemHandle(ctypes.Structure):
+    _fields_ = [("reserved", ctypes.c_byte * 64)]
+
+
+_CUDART = None
+
+
+def _cudart():
+    global _CUDART
+    if _CUDART is None:
+        rt = _load_cudart()
+        rt.cudaIpcGetMemHandle.restype = ctypes.c_int
+        rt.cudaIpcGetMemHandle.argtypes = [ctypes.POINTER(_IpcMemHandle), ctypes.c_void_p]
+        rt.cudaIpcOpenMemHandle.restype = ctypes.c_int
+        rt.cudaIpcOpenMemHandle.argtypes = [
+            ctypes.POINTER(ctypes.c_void_p), _IpcMemHandle, ctypes.c_uint]
+        rt.cudaMalloc.restype = ctypes.c_int
+        rt.cudaMalloc.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_size_t]
+        rt.cudaMemcpy2DAsync.restype = ctypes.c_int
+        rt.cudaMemcpy2DAsync.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t,
+                                         ctypes.c_size_t, ctypes.c_size_t, ctypes.c_int, ctypes.c_void_p]
+        _CUDART = rt
+    return _CUDART
+
+
+def _check(rc, what):
+    if rc != 0:
+        raise RuntimeError(f"{what} failed with cudaError {rc}")
+
+
+def _ipc_malloc(nbytes, device):
+    """One dedicated cudaMalloc block: cudaIpcOpenMemHandle maps the peer's
+    view at the exported pointer's allocation base, so every IPC-exchanged
+    block must sit at an allocation base. Blocks live for the process."""
+    with torch.cuda.device(device):
+        ptr = ctypes.c_void_p()
+        _check(_cudart().cudaMalloc(ctypes.byref(ptr), ctypes.c_size_t(nbytes)), "cudaMalloc")
+        return ptr.value
+
+
+def _export_ipc_handle(dev_ptr, device):
+    handle = _IpcMemHandle()
+    _check(_cudart().cudaIpcGetMemHandle(ctypes.byref(handle), ctypes.c_void_p(dev_ptr)),
+           "cudaIpcGetMemHandle")
+    return torch.tensor(list(handle.reserved), dtype=torch.uint8, device=device)
+
+
+def _open_ipc_handle(handle):
+    assert handle.dtype == torch.uint8 and handle.numel() == 64
+    raw = _IpcMemHandle()
+    raw.reserved[:] = handle.cpu().tolist()
+    ptr = ctypes.c_void_p()
+    _check(_cudart().cudaIpcOpenMemHandle(ctypes.byref(ptr), raw, _ipc_lazy_peer_access),
+           "cudaIpcOpenMemHandle")
+    return ptr.value
+
+
+# DLPack ABI (v0 capsule): zero-ownership torch tensors over the raw blocks.
+class _DLDevice(ctypes.Structure):
+    _fields_ = [("device_type", ctypes.c_int32), ("device_id", ctypes.c_int32)]
+
+
+class _DLDataType(ctypes.Structure):
+    _fields_ = [("code", ctypes.c_uint8), ("bits", ctypes.c_uint8), ("lanes", ctypes.c_uint16)]
+
+
+class _DLTensor(ctypes.Structure):
+    _fields_ = [
+        ("data", ctypes.c_void_p),
+        ("device", _DLDevice),
+        ("ndim", ctypes.c_int32),
+        ("dtype", _DLDataType),
+        ("shape", ctypes.POINTER(ctypes.c_int64)),
+        ("strides", ctypes.POINTER(ctypes.c_int64)),
+        ("byte_offset", ctypes.c_uint64),
+    ]
+
+
+class _DLManagedTensor(ctypes.Structure):
+    _fields_ = [
+        ("dl_tensor", _DLTensor),
+        ("manager_ctx", ctypes.c_void_p),
+        ("deleter", ctypes.c_void_p),  # NULL: the block is never freed by design
+    ]
+
+
+_DL_CPU, _DL_CUDA = 1, 2
+_DL_UINT8 = (1, 8)  # kDLUInt, 8 bits
+_DL_KEEPALIVE = []  # structs and shape arrays must outlive every tensor
+
+
+def _tensor_from_dev_ptr(ptr, nbytes, device):
+    """Zero-ownership uint8 [nbytes] torch tensor over raw device memory."""
+    _PyCapsule_New = ctypes.pythonapi.PyCapsule_New
+    _PyCapsule_New.restype = ctypes.py_object
+    _PyCapsule_New.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_void_p]
+    dev = torch.device(device)
+    managed = _DLManagedTensor()
+    managed.dl_tensor.data = ctypes.c_void_p(ptr)
+    managed.dl_tensor.device = _DLDevice(_DL_CUDA, dev.index if dev.index is not None
+                                         else torch.cuda.current_device())
+    managed.dl_tensor.ndim = 1
+    managed.dl_tensor.dtype = _DLDataType(_DL_UINT8[0], _DL_UINT8[1], 1)
+    shape = (ctypes.c_int64 * 1)(nbytes)
+    managed.dl_tensor.shape = ctypes.cast(shape, ctypes.POINTER(ctypes.c_int64))
+    managed.dl_tensor.strides = None  # NULL strides: compact row-major
+    managed.dl_tensor.byte_offset = 0
+    managed.deleter = None
+    _DL_KEEPALIVE.append((managed, shape))
+    capsule = _PyCapsule_New(
+        ctypes.cast(ctypes.byref(managed), ctypes.c_void_p), b"dltensor", None
+    )
+    return torch.from_dlpack(capsule)
+
+
+@triton.jit
+def _now():
+    return tl.inline_asm_elementwise("mov.u64 $0, %globaltimer;", "=l", [], dtype=tl.int64, is_pure=False, pack=1)
+
+
+@triton.jit
+def _gate_kernel(ctr_ptr, expect_base_ptr, wait_ptr, ADD: tl.constexpr, TIMED: tl.constexpr):
+    # spin until *ctr_ptr >= *expect_base_ptr + ADD. The expectation base is
+    # a counter this rank's own streams update in FIFO order - the main
+    # stream's tick for producer gates (each gate sits right after its own
+    # tick), the side stream's done for consumer gates (each gate sits right
+    # after the previous pull's arrive) - so the base is exactly the gate's
+    # own call index plus the skew allowance. Reading it from device memory
+    # at run time is what makes graph replays gate on current counter
+    # values, never host-baked thresholds.
+    # TIMED: the spin time in ns is added to *wait_ptr (cp_shards reads it to balance the CP ranks).
+    e = tl.load(expect_base_ptr) + ADD
+    if TIMED:
+        t0 = _now()
+    v = tl.atomic_add(ctr_ptr, 0, sem="acquire", scope="sys")
+    while v < e:
+        v = tl.atomic_add(ctr_ptr, 0, sem="acquire", scope="sys")
+    if TIMED:
+        tl.atomic_add(wait_ptr, _now() - t0, sem="relaxed", scope="gpu")
+
+
+@triton.jit
+def _arrive_kernel(ctr_ptr):
+    tl.atomic_add(ctr_ptr, 1, sem="release", scope="sys")
+
+
+@triton.jit
+def _tick_gate_kernel(tick_ptr, c0, c1, c2, NP: tl.constexpr):
+    # tick += 1, then spin until every peer's pull counter for this rank reached tick - 2
+    # (the slot's previous tenant, two calls back, has been read by all consumers).
+    # Covers the first three peers in one launch, which is the whole gate through cp 4. Peers 4..cp-1
+    # (cp >= 5) each get one _gate_kernel(peer.done[me], tick, ADD=-2) right after it on the same stream: the
+    # same condition (done >= tick - 2), read from the tick this launch just wrote.
+    t = tl.atomic_add(tick_ptr, 1, sem="relaxed", scope="gpu") + 1
+    e = t - 2
+    v = tl.atomic_add(c0, 0, sem="acquire", scope="sys")
+    while v < e:
+        v = tl.atomic_add(c0, 0, sem="acquire", scope="sys")
+    if NP > 1:
+        v = tl.atomic_add(c1, 0, sem="acquire", scope="sys")
+        while v < e:
+            v = tl.atomic_add(c1, 0, sem="acquire", scope="sys")
+    if NP > 2:
+        v = tl.atomic_add(c2, 0, sem="acquire", scope="sys")
+        while v < e:
+            v = tl.atomic_add(c2, 0, sem="acquire", scope="sys")
+
+
+class _RingN:
+    """Per-byte-count IPC send slots + [tick, publish, done[cp]] counters, mapped into every peer."""
+
+    def __init__(self, nbytes, device, cp_group):
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                "cp_a2a_ce: new payload size appeared during graph capture; its ring must be "
+                "created eagerly (warmup) before capture")
+        cp = torch.distributed.get_world_size(cp_group)
+        me = torch.distributed.get_rank(cp_group)
+        if cp < 2:
+            raise RuntimeError(f"cp_a2a_ce: cp_size {cp}: the ring needs at least one peer")
+        # Capability check, not a size limit: the slots are CUDA IPC mappings, which only exist between GPUs of
+        # one host. A CP group that spans hosts cannot be served by this primitive at all.
+        hosts = [None] * cp
+        torch.distributed.all_gather_object(hosts, socket.gethostname(), group=cp_group)
+        if len(set(hosts)) != 1:
+            raise RuntimeError(
+                f"cp_a2a_ce: the CP group spans hosts {sorted(set(hosts))}; the TMA transport pulls over CUDA IPC, "
+                "which is intra-node only. Set CP_A2A_COMM=nccl for this layout (stock NCCL exchange).")
+        self.cp, self.me, self.nbytes = cp, me, nbytes
+        self.peers = [p for p in range(cp) if p != me]
+        self.host_k = 0
+        self.send = [_tensor_from_dev_ptr(_ipc_malloc(nbytes, device), nbytes, device)
+                     for _ in range(2)]
+        nctr = 2 + cp
+        blk = _ipc_malloc(max(64, 8 * nctr), device)
+        ctr = _tensor_from_dev_ptr(blk, 8 * nctr, device).view(torch.int64)
+        ctr.zero_()
+        self.tick = ctr[0:1]
+        self.publish = ctr[1:2]
+        self.done = [ctr[2 + p:3 + p] for p in range(cp)]
+        msg = torch.cat([_export_ipc_handle(self.send[0].data_ptr(), device),
+                         _export_ipc_handle(self.send[1].data_ptr(), device),
+                         _export_ipc_handle(blk, device)])
+        gathered = [torch.empty_like(msg) for _ in range(cp)]
+        torch.distributed.all_gather(gathered, msg, group=cp_group)
+        self.peer_send, self.peer_publish, self.peer_done_me = {}, {}, {}
+        for p in self.peers:
+            pm = gathered[p]
+            self.peer_send[p] = [_tensor_from_dev_ptr(_open_ipc_handle(pm[0:64]), nbytes, device),
+                                 _tensor_from_dev_ptr(_open_ipc_handle(pm[64:128]), nbytes, device)]
+            pc = _tensor_from_dev_ptr(_open_ipc_handle(pm[128:192]), 8 * nctr, device).view(torch.int64)
+            self.peer_publish[p] = pc[1:2]
+            self.peer_done_me[p] = pc[2 + me:3 + me]
+        global gate_wait
+        if gate_wait is None:
+            gate_wait = torch.zeros(cp, dtype=torch.int64, device=device)
+        torch.cuda.synchronize(device)
+        torch.distributed.barrier(group=cp_group)
+
+
+class _Work:
+    """The all-to-all handle: wait() joins every pull's side stream into the caller's stream."""
+
+    __slots__ = ("joins",)
+
+    def __init__(self, joins):
+        self.joins = joins
+
+    def wait(self):
+        cur = torch.cuda.current_stream()
+        for ev in self.joins:
+            cur.wait_event(ev)
+
+
+_rings = {}
+_side = []
+# gate_wait[p]: ns this rank's consumer gates spent waiting for peer p's publish (int64, accumulated on device)
+gate_wait = None
+
+
+def _ring_for(key, nbytes, device, cp_group):
+    """The ring of payload class key (the payload size under even shards, the same on every rank), with
+    nbytes slots (the largest payload of that class over the CP ranks)."""
+    ring = _rings.get(key)
+    if ring is None or ring.nbytes < nbytes:
+        # nbytes is the same on every rank, so every rank replaces a too small ring at the same call (collective)
+        ring = _RingN(nbytes, device, cp_group)
+        _rings[key] = ring
+    return ring
+
+
+def _layout(cp_size, S):
+    """(chunk sizes c[0..cp-1], chunk offsets off[0..2cp-1], even shard S/cp, largest shard) of the decoder call
+    in flight: cp_shards' uneven table when active, else S / 2cp per chunk."""
+    import cp_shards
+
+    a = cp_shards.active
+    if a is None:
+        c = (S // (2 * cp_size),) * cp_size
+    else:
+        if a[0] != S:
+            raise RuntimeError(f"cp_a2a_ce: exchange of sequence length {S} inside a decoder call of {a[0]}")
+        c = a[1]
+    off, o = [], 0
+    for k in range(2 * cp_size):
+        off.append(o)
+        o += c[k] if k < cp_size else c[2 * cp_size - 1 - k]
+    return c, off, S // cp_size, 2 * max(c)
+
+
+def _seq_len(cp_size, s_local, me):
+    """Global sequence length for a pre exchange whose local shard has s_local tokens."""
+    import cp_shards
+
+    a = cp_shards.active
+    if a is None:
+        return s_local * cp_size
+    if 2 * a[1][me] != s_local:
+        raise RuntimeError(f"cp_a2a_ce: local shard {s_local} does not match the uneven table {a[1]} (rank {me})")
+    return a[0]
+
+
+def _side_streams(n, device):
+    while len(_side) < n:
+        _side.append(torch.cuda.Stream(device=device))
+    return _side[:n]
+
+
+def _acquire(key, nbytes, device, cp_group):
+    """Main stream: claim the next slot of the ring of payload class key (tick + slot-reuse gate).
+    Returns (ring, slot index, slot uint8 tensor)."""
+    ring = _ring_for(key, nbytes, device, cp_group)
+    slot = ring.host_k & 1
+    ring.host_k += 1
+    peers = ring.peers
+    c = [ring.peer_done_me[p] for p in peers] + [ring.tick] * max(0, 3 - len(peers))
+    _tick_gate_kernel[(1,)](ring.tick, c[0], c[1], c[2], NP=min(3, len(peers)))
+    for ctr in c[3:len(peers)]:   # cp >= 5: the remaining peers, same done >= tick - 2 condition
+        _gate_kernel[(1,)](ctr, ring.tick, ctr, ADD=-2, TIMED=False)
+    return ring, slot, ring.send[slot]
+
+
+# Pre-exchange inputs whose producer wrote them straight into their send slot in the packed
+# [cp, s, b, h/cp, d] order (the fused rope forward, fused_rope_fp8): slot data_ptr -> (ring, slot index).
+# The tensor the producer hands on is that slot viewed as [s, b, h, d]; only this module reads it,
+# and _pre_ce skips its pack.
+_prepacked = {}
+
+
+def acquire_pre(nbytes, device, cp_group):
+    """Main stream, producer side: claim the send slot for the next pre-exchange of an nbytes payload, in
+    exchange call order. Returns the uint8 slot; the producer writes the payload into it in the packed order
+    and passes the slot (viewed as [s, b, h, d]) to the exchange."""
+    cp = torch.distributed.get_world_size(cp_group)
+    me = torch.distributed.get_rank(cp_group)
+    import cp_shards
+
+    if cp_shards.active is None:
+        key = alloc = nbytes
+    else:
+        S, c = cp_shards.active
+        s_me, s_even = 2 * c[me], S // cp
+        if nbytes % s_me:
+            raise RuntimeError(f"cp_a2a_ce: pre payload {nbytes} B is not a multiple of the local shard {s_me}")
+        key, alloc = nbytes // s_me * s_even, nbytes // s_me * 2 * max(c)
+    ring, slot, send = _acquire(key, alloc, device, cp_group)
+    _prepacked[send.data_ptr()] = (ring, slot)
+    return send[:nbytes]
+
+
+
+def _publish_and_pull(ring, slot, plan, land2d=False):
+    """After the pack wrote ring.send[slot]: publish, copy the own rows locally, and pull every
+    peer's rows on its side stream. plan(p, src_u8) -> list of (dst_view, src_view) for the
+    payload rows that come from rank p (src_u8 = p's slot, or this rank's own for p == me).
+    land2d (ce only): every dst is a strided view of uniform rows in the final layout; each peer pair lands with
+    one cudaMemcpy2DAsync, the own rows with the wide integer strided copy."""
+    _arrive_kernel[(1,)](ring.publish)
+    me = ring.me
+    cur = torch.cuda.current_stream()
+    for dst, src in plan(me, ring.send[slot]):
+        if dst.is_contiguous() or land2d:
+            _wide_into(dst, src)
+        else:
+            # byte view: a strided destination (direct post layout) takes the elementwise copy, still bitwise
+            dst.view(torch.uint8).copy_(src.view(torch.uint8), non_blocking=True)
+    ev = torch.cuda.Event()
+    ev.record(cur)
+    joins = []
+    for s, p in zip(_side_streams(len(ring.peers), ring.send[0].device), ring.peers):
+        s.wait_event(ev)
+        with torch.cuda.stream(s):
+            _gate_kernel[(1,)](ring.peer_publish[p], ring.done[p], gate_wait[p:p + 1], ADD=1, TIMED=True)
+            if land2d:
+                for dst, src in plan(p, ring.peer_send[p][slot]):
+                    _memcpy2d(dst, src, s)
+            else:
+                _pull_pairs(plan(p, ring.peer_send[p][slot]), s, _ctas_per_peer(len(ring.peers)))
+            _arrive_kernel[(1,)](ring.done[p])
+            e = torch.cuda.Event()
+            e.record(s)
+            joins.append(e)
+    return _Work(joins)
+
+
+_TMA = None
+# CP_A2A_COMM=tma pulls each peer's slot with tma_copy_blocks; ce copies it with the copy engines on the
+# same side streams. Both move the same bytes.
+_XPORT = "nccl"
+_TMA_GEO = 64 | (2 << 8) | (1 << 16) | (8 << 24)
+_TMA_CTAS_GPU = 12
+
+
+def _ctas_per_peer(npeers):
+    return max(1, -(-_TMA_CTAS_GPU // npeers))
+
+
+_TMA_ROW = 2048
+# Post pulls write the final [2, s/2cp, b, cp, h/cp, d] layout directly when its row (h/cp*d bytes) is at least
+# this; below it (dk/dv: 256 B rows) the pull lands contiguous and the stock receive-side copy runs.
+_DIRECT_MIN_ROW = 2048
+
+
+def _rows(t):
+    """Describe tensor view t as (row_bytes, nrows, row_stride_bytes): nrows rows of one contiguous run each,
+    at a uniform stride. None if t has no such description (or is not 16-byte aligned)."""
+    es = t.element_size()
+    dims = [(n, st) for n, st in zip(t.shape, t.stride()) if n != 1]
+    inner = es
+    while dims and dims[-1][1] * es == inner:
+        inner *= dims.pop()[0]
+    nrows, stride = 1, inner
+    if dims:
+        n0, s0 = dims.pop()
+        nrows, stride = n0, s0 * es
+        while dims:
+            n1, s1 = dims.pop()
+            if s1 * es != stride * nrows:
+                return None
+            nrows *= n1
+    if (t.data_ptr() | inner | stride) % 16:
+        return None
+    return inner, nrows, stride
+
+
+def _desc(dst, src, row):
+    """(row_bytes, nrows, src_stride, dst_stride) for one (dst, src) pair, or None. A side that is one
+    contiguous run is re-described in rows of the other side's row (or `row` when both are contiguous)."""
+    a, b = _rows(src), _rows(dst)
+    if a is None or b is None:
+        return None
+    n = a[0] * a[1]
+    if b[0] * b[1] != n:
+        return None
+    if a[1] == 1 and b[1] == 1:
+        if n % row:
+            return None                              # copy_ fallback
+        return row, n // row, row, row
+    row = a[0] if b[1] == 1 else b[0]
+    out = []
+    for rb, nr, st in (a, b):
+        if nr == 1:
+            if rb % row:
+                return None
+            out.append(row)
+        elif rb == row:
+            out.append(st)
+        else:
+            return None
+    return row, n // row, out[0], out[1]
+
+
+def _pull_pairs(pairs, stream, ctas):
+    """One peer's pulls on its side stream, over the transport CP_A2A_COMM selects."""
+    if _XPORT == "ce":
+        for dst, src in pairs:
+            if dst.is_contiguous():
+                _wide_into(dst, src)
+            else:
+                dst.view(torch.uint8).copy_(src.view(torch.uint8), non_blocking=True)
+        return
+    descs = [_desc(d, s, _TMA_ROW) for d, s in pairs]
+    if (len(pairs) == 2 and descs[0] is not None and descs[0] == descs[1]):
+        (d0, s0), (d1, s1) = pairs
+        rb, nr, ss, ds = descs[0]
+        sb, db = s1.data_ptr() - s0.data_ptr(), d1.data_ptr() - d0.data_ptr()
+        if sb % 16 == 0 and db % 16 == 0:
+            _tma_launch(s0.data_ptr(), d0.data_ptr(), rb, 2 * nr, ss, ds, nr, sb, db, stream, ctas)
+            return
+    for (dst, src), dsc in zip(pairs, descs):
+        if dsc is None:
+            dst.copy_(src, non_blocking=True)
+            continue
+        rb, nr, ss, ds = dsc
+        _tma_launch(src.data_ptr(), dst.data_ptr(), rb, nr, ss, ds, nr, 0, 0, stream, ctas)
+
+
+def _tma_launch(src, dst, row, nrows, ss, ds, rpb, sb, db, stream, ctas):
+    rc = _TMA.tma_copy_blocks(src, dst, row, nrows, ss, ds, rpb, sb, db, ctas,
+                              stream.cuda_stream, 0, _TMA_GEO)
+    if rc != 0:
+        raise RuntimeError(f"cp_a2a_ce: tma_copy_blocks failed rc={rc}")
+
+
+_D2D = 3  # cudaMemcpyDeviceToDevice
+
+
+def _memcpy2d(dst, src, stream):
+    """dst (a strided view of uniform rows, each row contiguous) <- src (contiguous, the same bytes in row order)
+    with one cudaMemcpy2DAsync on stream: a copy engine copy, captured as one memcpy node under graph capture."""
+    r = _rows(dst)
+    if r is None or not src.is_contiguous() or r[0] * r[1] != src.numel() * src.element_size():
+        raise RuntimeError("cp_a2a_ce: 2D landing needs uniform destination rows and a contiguous source of the "
+                           "same bytes")
+    row, nrows, dpitch = r
+    _check(_cudart().cudaMemcpy2DAsync(dst.data_ptr(), dpitch, src.data_ptr(), row, row, nrows, _D2D,
+                                       stream.cuda_stream), "cudaMemcpy2DAsync")
+
+
+
+def _wide_into(dst, src):
+    """dst (contiguous, same shape/dtype as src) <- src through the widest integer view of the bytes that
+    cp_layout_copies._contig_wide would use; bitwise the same bytes as src.contiguous()."""
+    es = src.element_size()
+    si = src.view(_clc._INT[es])
+    di = dst.view(_clc._INT[es])
+    for w in (16, 8, 4, 2):
+        if w <= es or w not in _clc._INT:
+            continue
+        if (src.stride(-1) == 1 and (src.shape[-1] * es) % w == 0 and (src.data_ptr() % w) == 0
+                and all((st * es) % w == 0 for st, s in zip(src.stride()[:-1], src.shape[:-1]) if s > 1)):
+            try:
+                di.view(_clc._INT[w]).copy_(si.view(_clc._INT[w]))
+                return
+            except RuntimeError:
+                break
+    dst.copy_(src)
+
+
+_stock_a2a = None
+
+
+# Receive-layout fold of the dq/dk/dv post exchange (ce transport). The only consumer of those three tensors is the
+# fused rope backward (fused_rope_fp8.rope_dequant_bwd), which reads the receive layout [cp, s_local, b, h/cp, d]
+# directly (the a2a send layout of the forward, mirrored). The exchange then skips the receive-side layout copy and
+# returns recv itself viewed in the stock output shape [s_local*b, h, d] -- a placeholder whose bytes are NOT in the
+# stock order -- and records its data_ptr here; the consumer takes the entry and indexes the receive layout.
+# Credits: the fused rope forward grants one per routed attention call (grant_recv_fold), each folded exchange
+# spends one, so an exchange whose gradients the fused rope backward will not consume never folds; an exchange
+# whose pulls already wrote the final layout, and the tma transport, keep the stock receive side. A placeholder
+# that is still recorded when the next folded exchange starts was read by someone else: that raises.
+# CUDA graphs: the record is host state, consumed while the region is captured; recv comes from the graph's pool,
+# so the captured consumer reads the same static buffer on every replay.
+# Forward `out` post exchange on the ce transport: each peer's two sequence chunks land straight in the final
+# [2, s/2cp, b, cp, h/cp, d] layout with one cudaMemcpy2DAsync per chunk (row h/cp*d bytes, source pitch = row,
+# destination pitch cp*row), the own chunks by the wide integer strided copy, so the receive-side layout copy on the
+# cp stream disappears. Only the single-tensor `out` exchange (before_attn False) with a row of at least
+# _DIRECT_MIN_ROW takes it; shorter rows keep the pull + receive-side copy, and the other seven exchanges, and the
+# dq/dk/dv receive-layout fold, are unchanged. CUDA graphs: the destination comes from the graph's pool and the peer
+# slots are fixed IPC mappings, so every 2D memcpy node has static addresses.
+_recv_fold = {}      # placeholder data_ptr -> (recv [cp, 2, s/2cp, b, h/cp, d], cp)
+_fold_credit = 0
+
+
+def grant_recv_fold():
+    """Fused rope forward (routed call with the a2a fold group): its q/k/v gradients come back through
+    rope_dequant_bwd, so the next dq/dk/dv post exchange may hand them over in the receive layout (ce only)."""
+    global _fold_credit
+    if _XPORT == "ce":
+        _fold_credit += 1
+
+
+def _recv_placeholder(recv, cp_size):
+    """recv [cp, 2, s/2cp, b, h/cp, d] (contiguous) viewed as the stock post-exchange output [s/cp * b, h, d]
+    (bytes in the receive order), recorded for take_recv."""
+    if not recv.is_contiguous():
+        raise RuntimeError("cp_a2a_ce: receive-layout fold needs a contiguous recv buffer")
+    ph = recv.view(-1, recv.shape[-2] * cp_size, recv.shape[-1])
+    _recv_fold[ph.data_ptr()] = (recv, cp_size)
+    return ph
+
+
+
+def recv_layout(*xs):
+    """Consumer side: for the dq/dk/dv payloads xs (placeholders or ordinary tensors) return None when none of
+    them is a folded placeholder, else the cp size of their receive layout [cp, s_local, b, h/cp, d] (all of
+    them must be folded, with one cp). Takes the records."""
+    hits = [_recv_fold.pop(x.data_ptr(), None) for x in xs]
+    if all(h is None for h in hits):
+        if _recv_fold:
+            raise RuntimeError("cp_a2a_ce: receive-layout fold: the consumer got tensors that are not the folded "
+                               "placeholders while placeholders are outstanding")
+        return None
+    if any(h is None for h in hits) or len({h[1] for h in hits}) != 1:
+        raise RuntimeError("cp_a2a_ce: receive-layout fold: mixed folded/unfolded payloads")
+    for x, (recv, _) in zip(xs, hits):
+        if x.numel() * x.element_size() != recv.numel() * recv.element_size():
+            raise RuntimeError("cp_a2a_ce: receive-layout fold: payload size does not match its recv buffer")
+    return hits[0][1]
+
+
+
+def _pre_ce(x, seq_dim, cp_size, cp_group, head_dim):
+    """Before-attention exchange of one sbhd/bshd tensor x [.., s_local, .., h, d] (this rank's two
+    load-balanced sequence chunks, all heads) over the ring. Returns (out, work): out is the
+    stock function's final result before its last view, [.., 2cp, s_local/2, .., h/cp, d] with the
+    sequence halves already in global order (the stock reorder is folded into where each pull lands)."""
+    me = torch.distributed.get_rank(cp_group)
+    if seq_dim != 0:
+        raise RuntimeError("cp_a2a_ce: pre-exchange chunk copies need seq_dim 0 (sbhd)")
+    xv = x.view(*x.shape[:head_dim], cp_size, x.shape[head_dim] // cp_size, *x.shape[head_dim + 1:])
+    packed_view = xv.movedim(head_dim, 0)            # [cp, (stock a2a input layout)]
+    S = _seq_len(cp_size, x.shape[0], me)
+    c, off, s_even, s_max = _layout(cp_size, S)
+    nbytes = x.numel() * x.element_size()
+    per_tok = nbytes // x.shape[0]
+    pre = _prepacked.pop(x.data_ptr(), None)
+    if pre is not None:
+        # the producer already wrote x into this slot in the packed order (acquire_pre)
+        ring, slot = pre
+        send = ring.send[slot]
+        if ring.nbytes < nbytes:
+            raise RuntimeError("cp_a2a_ce: pre-packed input does not fit its slot")
+        slot_t = send[:nbytes].view(x.dtype).view(packed_view.shape)
+    else:
+        ring, slot, send = _acquire(per_tok * s_even, per_tok * s_max, x.device, cp_group)
+        slot_t = send[:nbytes].view(x.dtype).view(packed_view.shape)
+        _wide_into(slot_t, packed_view)              # the stock pack, retargeted into the slot
+    # stock: a2a out [cp(src), <block>] -> movedim(0, seq_dim) -> view(.., 2cp, s_local/2, ..) ->
+    # index_select(seq_dim, ids) with ids[r] = 2r, ids[r + cp] = 2cp - 2r - 1. So global chunk c gets
+    # src c's first half for c < cp and src 2cp-1-c's second half for c >= cp.
+    blk = packed_view.shape[1:]                      # one source's block, x layout with h/cp heads
+    out = torch.empty((S,) + tuple(blk[1:]), dtype=x.dtype, device=x.device)
+    nch = 2 * cp_size
+
+    def plan(p, src_u8):
+        # rank p's block destined for this rank holds p's 2 c_p tokens; its halves land in global chunks p and
+        # 2cp-1-p, at their offsets in the full sequence
+        cp_ = c[p]
+        shape = (cp_size, 2 * cp_) + tuple(blk[1:])
+        src = src_u8[:per_tok * 2 * cp_].view(x.dtype).view(shape)[me]
+        return [(out.narrow(0, off[p], cp_), src.narrow(0, 0, cp_)),
+                (out.narrow(0, off[nch - 1 - p], cp_), src.narrow(0, cp_, cp_))]
+
+    work = _publish_and_pull(ring, slot, plan)
+    return out, work
+
+
+def _post_ce(x, seq_dim, cp_size, cp_group, land2d=False):
+    """After-attention exchange of one tensor x [s, .., h/cp, d] in sequence order. Returns (recv, work, final)
+    with recv the stock a2a output [cp(src), 2, s/(2cp), .., h/cp, d]: src p's global chunks me and
+    2cp-1-me. The stock reorder before the send (index_select over 2cp chunks) is replaced by one
+    sequence-order copy into the slot; each consumer pulls its two chunks out of it.
+
+    final is None (the caller does the stock receive-side layout copy recv.movedim(0, 3) -> contiguous),
+    or, with xport tma (or land2d on ce) and a row of at least _DIRECT_MIN_ROW, that contiguous
+    [2, s/2cp, .., cp, h/cp, d] buffer itself: recv is then its movedim(3, 0) view and every pull writes its rows
+    (h/cp*d bytes each, stride cp*h/cp*d) straight into the final layout, so the receive-side copy disappears.
+    On ce the peer chunks land through one cudaMemcpy2DAsync each (_publish_and_pull land2d)."""
+    me = torch.distributed.get_rank(cp_group)
+    if seq_dim != 0:
+        raise RuntimeError("cp_a2a_ce: post-exchange chunk copies need seq_dim 0 (sbhd)")
+    nbytes = x.numel() * x.element_size()
+    S = x.shape[0]
+    c, off, s_even, s_max = _layout(cp_size, S)
+    per_tok = nbytes // S
+    ring, slot, send = _acquire(nbytes, per_tok * s_max * cp_size, x.device, cp_group)
+    nch = 2 * cp_size
+    cm = c[me]
+    slot_t = send[:nbytes].view(x.dtype).view(x.shape)
+    own = (off[me], off[nch - 1 - me])
+    _wide_into(slot_t, x)
+    final = None
+    land2d = land2d and _XPORT == "ce"
+    if (_XPORT == "tma" or land2d) and x.dim() == 4:
+        fshape = [2, cm, x.shape[1], cp_size, *x.shape[2:]]   # [2, c_me, b, cp, h/cp, d]
+        cand = torch.empty(fshape, dtype=x.dtype, device=x.device)
+        rv = cand.movedim(3, 0)
+        r = _rows(rv[0, 0])
+        if r is not None and r[0] >= _DIRECT_MIN_ROW:
+            final, recv = cand, rv
+    land2d = land2d and final is not None
+    if final is None:
+        recv = torch.empty(cp_size, 2, cm, *x.shape[1:], dtype=x.dtype, device=x.device)
+
+    def plan(p, src_u8):
+        src = src_u8[:nbytes].view(x.dtype).view(x.shape)
+        return [(recv[p, 0], src.narrow(0, own[0], cm)), (recv[p, 1], src.narrow(0, own[1], cm))]
+
+    work = _publish_and_pull(ring, slot, plan, land2d)
+    return recv, work, final
+
+
+def _a2a(a2a_inputs, chunk_ids_for_a2a, seq_dim, cp_size, cp_group, cp_stream, before_attn,
+         qkv_format="bshd", cu_seqlens_q_padded=None, cu_seqlens_kv_padded=None, a2a_input_names=None):
+    """flash_attn_a2a_communicate with the TMA transport on every exchange (sbhd, any cp >= 2); a non-sbhd layout
+    goes to the stock (cp_layout_copies) function. There is no per-site selector: every exchange that reaches this
+    function takes the transport, whatever its name (all eight or CP_A2A_COMM=nccl)."""
+    names = a2a_input_names or []
+    if qkv_format != "sbhd" or seq_dim != 0 or cp_size < 2:
+        return _stock_a2a(a2a_inputs, chunk_ids_for_a2a, seq_dim, cp_size, cp_group, cp_stream, before_attn,
+                          qkv_format, cu_seqlens_q_padded, cu_seqlens_kv_padded, a2a_input_names)
+    xs = a2a_inputs if isinstance(a2a_inputs, list) else [a2a_inputs]
+    global _fold_credit
+    fold = (_XPORT == "ce" and not before_attn and names == ["dq", "dk", "dv"] and _fold_credit > 0
+            and all(x.dim() == 4 and x.element_size() == 1 for x in xs))
+    if fold:
+        _fold_credit -= 1
+    out2d = _XPORT == "ce" and not before_attn and names == ["out"] and len(xs) == 1
+    res = _a2a_ce(a2a_inputs, chunk_ids_for_a2a, seq_dim, cp_size, cp_group, cp_stream, before_attn, qkv_format,
+                  fold, out2d)
+    return res
+
+
+def _a2a_ce(a2a_inputs, chunk_ids_for_a2a, seq_dim, cp_size, cp_group, cp_stream, before_attn, qkv_format,
+            fold=False, out2d=False):
+    """fold (post exchange of dq/dk/dv only): return receive-layout placeholders (_recv_placeholder) instead of
+    the receive-side layout copy, when no output was pulled straight into the final layout.
+    out2d (post exchange of out only, ce): the pulls land in the final layout by 2D copies (_post_ce land2d)."""
+    from transformer_engine.pytorch.attention.dot_product_attention import context_parallel as te_cp
+
+    a2a_inputs = [a2a_inputs] if not isinstance(a2a_inputs, list) else a2a_inputs
+    n = len(a2a_inputs)
+    outs = [None] * n
+    _, _, head_dim = te_cp.get_bsh_dims(qkv_format)
+    if before_attn:
+        # the stock loop pipelines pack(i) / a2a(i-1) / reorder(i-2); here pack and publish are one
+        # call per tensor on the main stream and the pulls run on the side streams.
+        pend = [_pre_ce(x, seq_dim, cp_size, cp_group, head_dim) for x in a2a_inputs]
+        with torch.cuda.stream(cp_stream):
+            for i, (out, work) in enumerate(pend):
+                work.wait()
+                outs[i] = out
+    else:
+        pend = [_post_ce(x, seq_dim, cp_size, cp_group, land2d=out2d) for x in a2a_inputs]
+        fold = fold and all(final is None for _, _, final in pend)
+        if fold:
+            if _recv_fold:
+                raise RuntimeError("cp_a2a_ce: receive-layout fold: the previous dq/dk/dv placeholders were never "
+                                   "taken by the fused rope backward")
+        with torch.cuda.stream(cp_stream):
+            for i, (recv, work, final) in enumerate(pend):
+                work.wait()
+                if fold:
+                    outs[i] = _recv_placeholder(recv, cp_size)
+                    continue
+                if final is not None:
+                    xx = final                          # the pulls already wrote the final layout
+                else:
+                    # the stock receive-side layout copy, unchanged (cp_layout_copies' wide copy)
+                    xx = recv.movedim(0, 3)             # [2, s/2cp, b, cp, h/cp, d] for sbhd
+                    xx = _clc._contig_wide(xx)
+                outs[i] = xx.view(-1, xx.shape[-3] * xx.shape[-2], xx.shape[-1])
+    torch.cuda.current_stream().wait_stream(cp_stream)
+    return outs[0] if n == 1 else outs
+
+
+def _default_lib():
+    # h200-tuning/tma_reduce/build of this checkout (work-nemo/../h200-tuning/...), built by h200-tuning/tma_reduce/build_lib.sh
+    here = os.path.dirname(os.path.abspath(__file__))
+    return os.path.join(os.path.dirname(here), "h200-tuning", "tma_reduce", "build", "libtma_reduce.so")
+
+
+def install():
+    """Patch flash_attn_a2a_communicate to the IPC ring transport. CP_A2A_COMM selects the carrier:
+    tma, ce, or nccl for the stock exchange, which is also the default when the variable is unset.
+    Must run after cp_layout_copies.install(): this module's stock fallback is the function installed
+    there."""
+    global _stock_a2a, _TMA, _XPORT
+    _XPORT = os.getenv("CP_A2A_COMM", "nccl")
+    if _XPORT not in ("tma", "ce", "nccl"):
+        raise RuntimeError(f"cp_a2a_ce: CP_A2A_COMM={_XPORT!r} (tma | ce | nccl)")
+    if _XPORT == "nccl":
+        return
+    from transformer_engine.pytorch.attention.dot_product_attention import context_parallel as te_cp
+
+    if te_cp.flash_attn_a2a_communicate is _a2a:
+        return
+    if te_cp.flash_attn_a2a_communicate is not _clc._a2a:
+        raise RuntimeError("cp_a2a_ce: install after cp_layout_copies (flash_attn_a2a_communicate is not its _a2a)")
+    if _XPORT == "ce":
+        _stock_a2a = te_cp.flash_attn_a2a_communicate
+        te_cp.flash_attn_a2a_communicate = _a2a
+        if te_cp.flash_attn_a2a_communicate is not _a2a:
+            raise RuntimeError("cp_a2a_ce: the flash_attn_a2a_communicate patch did not take")
+        if int(os.environ.get("RANK", "0")) == 0:
+            print("cp_a2a_ce: installed (CP a2a, copy engine pulls)", flush=True)
+        return
+    lib = os.getenv("TMA_REDUCE_LIB") or _default_lib()
+    if not os.path.exists(lib):
+        raise RuntimeError(f"cp_a2a_ce: tma library {lib!r} missing; build it with h200-tuning/tma_reduce/build_lib.sh, "
+                           "point TMA_REDUCE_LIB at one, or set CP_A2A_COMM=ce for the copy engine pulls")
+    _TMA = ctypes.CDLL(lib)
+    u64 = ctypes.c_ulonglong
+    if not hasattr(_TMA, "tma_copy_blocks"):
+        raise RuntimeError(f"cp_a2a_ce: {lib} predates tma_copy_blocks; rebuild tma_reduce.cu")
+    i64, ci = ctypes.c_longlong, ctypes.c_int
+    _TMA.tma_copy_blocks.restype = ci
+    _TMA.tma_copy_blocks.argtypes = [ctypes.c_void_p, ctypes.c_void_p, u64, ci, u64, u64, ci, i64, i64, ci,
+                                     ctypes.c_void_p, ci, ci]
+    tb, la, sm = ci(), ci(), ci()
+    if _TMA.tma_rs_geom_info(_TMA_GEO, ctypes.byref(tb), ctypes.byref(la), ctypes.byref(sm)) != 0:
+        raise RuntimeError(f"cp_a2a_ce: {lib} does not build geo {_TMA_GEO:#x}; rebuild tma_reduce.cu")
+    _stock_a2a = te_cp.flash_attn_a2a_communicate
+    te_cp.flash_attn_a2a_communicate = _a2a
+    if te_cp.flash_attn_a2a_communicate is not _a2a:
+        raise RuntimeError("cp_a2a_ce: the flash_attn_a2a_communicate patch did not take")
+    if int(os.environ.get("RANK", "0")) == 0:
+        print(f"cp_a2a_ce: installed (CP a2a, tma geo {_TMA_GEO:#x} {_TMA_CTAS_GPU} CTAs/GPU, lib {lib})",
+              flush=True)
