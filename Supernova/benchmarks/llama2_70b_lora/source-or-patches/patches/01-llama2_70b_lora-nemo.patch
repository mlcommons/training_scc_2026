+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/deepgemm_gemm.py
@@ -0,0 +1,369 @@
+"""Env-gated custom-kernel reroute for TransformerEngine fp8 GEMMs (DEEPGEMM=1).
+
+Routes suitable TE ``general_gemm`` calls (transformer_engine/pytorch/
+cpp_extensions/gemm.py — the single dispatch for fwd/dgrad/wgrad fp8 GEMMs; only fprop is routed)
+through our custom per-tensor-scaled SM90 kernel
+(deep_gemm ``fp8_gemm_nt_per_tensor``: raw fp8 wgmma, fp32 accumulation over
+all K, ONE epilogue multiply by ``scale_a * scale_b`` read from the live
+``_scale_inv`` device tensors; no scaling-factor buffers at all).
+
+Kernel source (DeepGEMM derivative in this repository's deepgemm/ tree):
+  deep_gemm/include/deep_gemm/impls/sm90_fp8_gemm_per_tensor.cuh
+  csrc/jit_kernels/impls/sm90_fp8_gemm_per_tensor.hpp
+
+Routing rules (everything else falls through to the original general_gemm):
+  - fprop: layout "TN", grad False -> a = B._data [M,K] K-major e4m3,
+    b = A._data [N,K] K-major e4m3.
+  - dgrad (layout "NN", grad True) and wgrad (layout "NT") are never routed.
+  - Operand dtypes accepted: e4m3 x e4m3.
+  - ub/ub_type/extra_output/bulk_overlap (GEMM+RS/AG fused) and pre_rs_add
+    (the pre-RS LoRA delta join, which rides that overlap inside TE's C++),
+    bias, gelu, gelu_in, accumulate, beta, alpha!=1, out,
+    quantization_params all force fallthrough.
+
+Per-shape configs: only a handful of production shapes exist (Llama-2-70B
+LoRA, TP2 CP2, hidden 8192, ffn 28672). ``_CONFIGS`` maps (n, k) -> "auto" or
+"block_m,block_n,cluster_m,cluster_n[,stages]". Unknown shapes fall back to
+the wave/power-model router ``_auto_config``. M-specific overrides use the
+(n, k, m) key when they differ (``_CONFIGS_M``, checked first).
+
+Capture discipline (full-iteration CUDA graphs): the wrapper only reads
+host-side metadata (types/shapes/strides) — no .item()/.cpu()/data-dependent
+branching. Scales are the LIVE ``_scale_inv`` device tensors passed straight
+through to the kernel (it dereferences them at launch, so graph replay
+re-reads the current values).
+DeepGEMM JIT-compiles per (dtype-pair, N, K, config) on first call — every
+routed shape must be seen during eager warmup BEFORE graph capture.
+
+Install: ``import deepgemm_gemm; deepgemm_gemm.install()`` AFTER
+transformer_engine is importable, BEFORE model construction. Patches the
+defining module, the ``cpp_extensions`` package attribute, and every
+already-imported TE module holding the symbol.
+"""
+
+import os
+import sys
+
+_ENABLED = os.getenv("DEEPGEMM", "0") == "1"
+
+_pt_gemm = None
+_HAS_BF16_AMAX = False
+try:
+    import deep_gemm as _deep_gemm
+
+    _pt_gemm = _deep_gemm._C.fp8_gemm_nt_per_tensor
+    _HAS_BF16_AMAX = bool(getattr(_deep_gemm._C, "per_tensor_bf16_amax", False))
+except Exception as _e:  # pragma: no cover - deep_gemm missing/broken
+    print(f"[deepgemm_gemm] deep_gemm per-tensor kernel unavailable ({_e}); "
+          f"install() is a no-op", file=sys.stderr, flush=True)
+
+_orig_general_gemm = None
+_installed = False
+
+# With SWIGLU_FUSION on, the TP1 fc1 fprop (the shapes below) also emits the amax of its bf16-rounded output from the GEMM
+# epilogue. swiglu_fusion consumes it in one pass over the output instead of two; the GEMM output bytes are unchanged.
+_FC1_AMAX = os.getenv("SWIGLU_FUSION", "1") == "1" and _HAS_BF16_AMAX  # an older deep_gemm build would ignore amax_d silently
+_FC1_AMAX_SHAPES = {(57344, 8192)}
+fc1_amax_pending = None  # (output data_ptr, output numel, amax tensor) of the latest fc1 fprop
+# A persistent fc1 amax slot that an earlier kernel on the stream zeroes (fused_residual's norm kernel, which runs
+# before the fc1 input exists), replacing the per-call torch.zeros memset. fc1_amax_prezero hands the slot to that
+# kernel and marks it zeroed; the next fc1 fprop takes it and clears the mark, so the slot is never reused before
+# it is zeroed again.
+_fc1_amax_slot = None
+_fc1_amax_zeroed = False
+
+
+def fc1_amax_prezero(device):
+    """The amax slot for the caller's kernel to zero, or None when the fc1 amax epilogue is off."""
+    global _fc1_amax_slot, _fc1_amax_zeroed
+    if not _FC1_AMAX:
+        return None
+    if _fc1_amax_slot is None or _fc1_amax_slot.device != device:
+        _fc1_amax_slot = torch.zeros(1, dtype=torch.float32, device=device)
+    _fc1_amax_zeroed = True
+    return _fc1_amax_slot
+
+
+# (n, k) -> per-tensor GEMM config; "auto" lets DeepGEMM pick the kernel
+# variant by M and output dtype. Unlisted shapes fall back to the
+# wave/power-model router (_auto_config).
+_CONFIGS = {
+    # forward (n=fout, k=fin); TP2/CP2 shapes first, then TP4/CP1
+    (5120, 8192): "auto",    # qkv fwd
+    (8192, 4096): "128,256,1,1,4,2",   # oproj fwd
+    (28672, 8192): "auto",   # fc1 fwd
+    (8192, 14336): "auto",   # fc2 fwd
+    (2560, 8192): "192,256,1,1,3",     # qkv fwd (chunk m=2048; M=8192 in _CONFIGS_M)
+    (8192, 2048): "128,256,1,1,4,2",   # oproj fwd
+    (14336, 8192): "auto",   # fc1 fwd
+    (8192, 7168): "auto",    # fc2 fwd
+    # TP1 x CP4 shapes (unsharded: qkv 10240 = 8192 + 2 x 1024 GQA, ffn 28672 x 2 gate/up). Keyed on (n, k), not
+    # (n, k, m): M is MBS x seq / CP (training M 4096, eval VAL_MBS 4 -> M 8192) and moves with every recipe change,
+    # so an M key falls through silently. All four use the overlapped-epilogue 128 x 256 tile, 4 stages, 2 store splits.
+    # No collision: TP2 / TP4 shard n or k (5120 / 2560 qkv, 4096 / 2048 proj k, 28672 / 14336 fc1, 14336 / 7168 fc2 k).
+    (10240, 8192): "128,256,1,1,4,2",   # qkv fwd TP1
+    (8192, 8192): "128,256,1,1,4,2",    # proj fwd TP1
+    (57344, 8192): "128,256,1,1,4,2",   # fc1 fwd TP1
+    (8192, 28672): "128,256,1,1,4,2",   # fc2 fwd TP1
+}
+# M-specific overrides keyed (n, k, m); falls back to _CONFIGS
+_CONFIGS_M = {
+    (2560, 8192, 8192): "128,256,1,1,4,2",  # qkv fwd full shape
+}
+
+
+# ---------------------------------------------------------------------------
+# Algorithmic fallback for shapes not in the per-shape tables: a fitted
+# wave/power wall model,
+#   wall ~ a * waves * cpt * (1 - x * idle_frac)
+#     cpt = 0.0662 * bm * bn * k / 8192   (0.0643 for bm=192)   [cycles/tile]
+#     waves = ceil(m_tiles * n_tiles / 132)  (persistent 132-block grid)
+#     idle_frac = 1 - m_tiles*n_tiles / (waves*132)
+#     x ~= 0 below ~20% idle (no clock recovery at the power cap), 0.55 in
+#         the 20-40% idle regime (power-cap clock recovery). The model is
+#         only trusted at bn=256 (cpt is not bn-linear below that), so the
+#         candidate set is bn=256 only.
+# The model discriminates bm (128 vs 192) only; the within-bm variant keeps
+# the default split: legacy 3-stage below M=6144, 4-stage ds=2 above.
+# ---------------------------------------------------------------------------
+_NUM_SMS = 132  # H200 persistent grid of the per-tensor kernel
+_CPT = {128: 0.0662, 192: 0.0643}  # cycles per (bm*bn*k/8192)
+
+
+# ---------------------------------------------------------------------------
+# Persistent-grid size of the per-tensor kernel (DEEPGEMM_NUM_SMS).
+#
+# The kernel launches one block per SM over 128 x 256 tiles, so a tile count
+# that does not divide the grid leaves the last wave partly idle: at 132 SMs
+# qkv (1280 tiles) ends on 92 of 132 blocks, proj (1024) on 100, fc1 (7168) on
+# 40. At 128 every one of those counts divides exactly (10, 8, 56 waves).
+# fc2 is excluded: its 1024 tiles run over a 28672-deep K, where the smaller
+# grid costs more than the tail saves, so it keeps the full count.
+# Unset keeps the full device count on every shape.
+# ---------------------------------------------------------------------------
+_SM_LIMIT = int(os.getenv("DEEPGEMM_NUM_SMS", "0"))
+_SM_LIMIT_SKIP = {(8192, 28672), (8192, 14336)}  # fc2 fwd, TP1 and TP2
+_FULL_SMS = None
+_GRID_SMS = None
+
+
+def _set_grid(n, k):
+    """Set the persistent grid for this shape. Host-side only, so it is safe
+    inside a CUDA graph capture: the grid is baked into the captured launch.
+
+    The full count comes from the device, not from get_num_sms(), which returns
+    the value this function last set."""
+    global _FULL_SMS, _GRID_SMS
+    if _deep_gemm is None:
+        return
+    if _FULL_SMS is None:
+        _FULL_SMS = torch.cuda.get_device_properties(torch.cuda.current_device()).multi_processor_count
+    want = _FULL_SMS if (_SM_LIMIT == 0 or (n, k) in _SM_LIMIT_SKIP) else _SM_LIMIT
+    if _GRID_SMS != want:
+        _deep_gemm.set_num_sms(want)
+        _GRID_SMS = want
+
+
+def _auto_config(m, n, k):
+    """Wave/power-model config for an unlisted fprop shape (bf16 out)."""
+    best_cfg, best_score = None, None
+    grid = _SM_LIMIT or _NUM_SMS   # the wave count follows the launched grid
+    for bm in (128, 192):
+        m_tiles = -(-m // bm)
+        n_tiles = -(-n // 256)
+        tiles = m_tiles * n_tiles
+        waves = -(-tiles // grid)
+        idle = 1.0 - tiles / (waves * grid)
+        x = 0.55 if idle >= 0.20 else 0.0
+        score = waves * _CPT[bm] * bm * 256 * k / 8192 * (1.0 - x * idle)
+        if best_score is None or score < best_score:
+            best_score, best_cfg = score, bm
+    if best_cfg == 128:
+        return "legacy:128,256,1,1,3" if m < 6144 else "128,256,1,1,4,2"
+    return "192,256,1,1,3"
+
+
+def _pick_config(m, n, k):
+    """Config for an fprop shape: _CONFIGS_M (n, k, m), then _CONFIGS (n, k), then _auto_config."""
+    cfg = _CONFIGS_M.get((n, k, m))
+    if cfg is None:
+        cfg = _CONFIGS.get((n, k))
+    return cfg if cfg is not None else _auto_config(m, n, k)
+
+
+def _f8_view(t, dtype):
+    """TE stores raw fp8 bits as uint8; DeepGEMM wants
+    typed fp8 tensors. Zero-cost view (t is gated contiguous)."""
+    if t.dtype == torch.uint8:
+        return t.view(dtype)
+    return t
+
+
+def _try_deepgemm(A, B, out_dtype, quantization_params, gelu, gelu_in, alpha,
+                  beta, accumulate, layout, out, bias, grad, ub, ub_type,
+                  extra_output, bulk_overlap, pre_rs_add):
+    """Return a general_gemm-style 4-tuple, or None to fall through."""
+    from transformer_engine.pytorch.constants import DType as _TEDType
+
+    # --- caller-argument gates (all host-side metadata) --------------------
+    # pre_rs_add (the pre-RS LoRA delta join input) rides the ub GEMM+RS
+    # overlap: the join happens inside TE's C++ split_overlap_rs, and this
+    # kernel path has no userbuffer, so a call carrying it can never be
+    # served here — it must reach TE's general_gemm.
+    if (ub is not None or ub_type is not None or extra_output is not None
+            or bulk_overlap or pre_rs_add is not None):
+        return None
+    if (bias is not None or gelu or gelu_in is not None or accumulate
+            or beta is not None or out is not None):
+        return None
+    if alpha not in (None, 1.0):
+        return None
+    if quantization_params is not None:
+        return None
+    if out_dtype is not torch.bfloat16:
+        return None
+
+    if layout == "TN" and not grad:
+        kind = "fwd"
+    else:
+        return None
+
+    # --- operand gates ------------------------------------------------------
+    # fwd: a = B._data (activations [M,K] K-major), b = A._data (rowwise
+    # weight [N,K] K-major).
+    a_data = getattr(B, "_data", None)
+    b_data = getattr(A, "_data", None)
+    if a_data is None or b_data is None:
+        return None
+
+    e4m3 = int(_TEDType.kFloat8E4M3)
+    a_dt, b_dt = getattr(B, "_fp8_dtype", None), getattr(A, "_fp8_dtype", None)
+    # fwd: e4m3 x e4m3
+    if not (a_dt == e4m3 and b_dt == e4m3):
+        return None
+
+    a_scale = getattr(B, "_scale_inv", None)
+    b_scale = getattr(A, "_scale_inv", None)
+    if (not isinstance(a_scale, torch.Tensor) or not isinstance(b_scale, torch.Tensor)
+            or a_scale.numel() != 1 or b_scale.numel() != 1
+            or a_scale.dtype is not torch.float32 or b_scale.dtype is not torch.float32
+            or not a_scale.is_cuda or not b_scale.is_cuda):
+        return None
+
+    # --- shape/layout normalization ----------------------------------------
+    # B (a-operand): [M, K] or [s, b, K], K-major contiguous.
+    if a_data.dim() not in (2, 3) or not a_data.is_contiguous():
+        return None
+    a_shape3 = a_data.shape
+    a2 = a_data.reshape(-1, a_data.shape[-1]) if a_data.dim() == 3 else a_data
+    m, k = a2.shape
+
+    # A (b-operand): [N, K] K-major contiguous (the rowwise weight).
+    if b_data.dim() != 2 or not b_data.is_contiguous():
+        return None
+    n = b_data.shape[0]
+    if b_data.shape[1] != k:
+        return None
+
+    if k % 128 != 0 or n % 128 != 0:
+        return None
+    if m == 0 or n == 0 or k == 0:
+        return None
+
+    # --- kernel call ---------------------------------------------------------
+    torch_dtype_a = torch.float8_e4m3fn
+    d = torch.empty((m, n), dtype=torch.bfloat16, device=a2.device)
+    cfg = _pick_config(m, n, k)
+    _set_grid(n, k)
+    if _FC1_AMAX and (n, k) in _FC1_AMAX_SHAPES and cfg.startswith("128,"):
+        global fc1_amax_pending, _fc1_amax_zeroed
+        if _fc1_amax_zeroed and _fc1_amax_slot is not None and _fc1_amax_slot.device == a2.device:
+            amax, _fc1_amax_zeroed = _fc1_amax_slot, False
+        else:
+            amax = torch.zeros(1, dtype=torch.float32, device=a2.device)
+        _pt_gemm(_f8_view(a2, torch_dtype_a), a_scale,
+                 _f8_view(b_data, torch.float8_e4m3fn), b_scale,
+                 d, "nk", cfg, amax_d=amax)
+        fc1_amax_pending = (d.data_ptr(), d.numel(), amax)
+    else:
+        _pt_gemm(_f8_view(a2, torch_dtype_a), a_scale,
+                 _f8_view(b_data, torch.float8_e4m3fn), b_scale,
+                 d, "nk", cfg)
+    if a_data.dim() == 3:
+        d = d.view(*a_shape3[:-1], n)
+    return d, None, None, None
+
+
+def _deepgemm_general_gemm(A, B, out_dtype=None, quantization_params=None,
+                           gelu=False, gelu_in=None, alpha=1.0, beta=None,
+                           accumulate=False, layout="TN", out=None, bias=None,
+                           use_split_accumulator=False, grad=False, ub=None,
+                           ub_type=None, extra_output=None, bulk_overlap=False,
+                           pre_rs_add=None):
+    if _ENABLED and _pt_gemm is not None:
+        try:
+            res = _try_deepgemm(A, B, out_dtype, quantization_params, gelu,
+                                gelu_in, alpha, beta, accumulate, layout, out,
+                                bias, grad, ub, ub_type, extra_output,
+                                bulk_overlap, pre_rs_add)
+            if res is not None:
+                return res
+        except Exception as _e:  # never break training; fall through
+            import sys
+            print(f"[deepgemm_gemm] routed GEMM fell back: {type(_e).__name__}: {_e}",
+                  file=sys.stderr, flush=True)
+    return _orig_general_gemm(
+        A, B,
+        out_dtype=out_dtype,
+        quantization_params=quantization_params,
+        gelu=gelu,
+        gelu_in=gelu_in,
+        alpha=alpha,
+        beta=beta,
+        accumulate=accumulate,
+        layout=layout,
+        out=out,
+        bias=bias,
+        use_split_accumulator=use_split_accumulator,
+        grad=grad,
+        ub=ub,
+        ub_type=ub_type,
+        extra_output=extra_output,
+        bulk_overlap=bulk_overlap,
+        pre_rs_add=pre_rs_add,
+    )
+
+
+def install():
+    """Patch the general_gemm symbol everywhere TE holds it. Idempotent."""
+    global _orig_general_gemm, _installed
+    if _installed or _pt_gemm is None:
+        return
+    import transformer_engine.pytorch  # noqa: F401 (registers transformer_engine_torch)
+    import transformer_engine.pytorch.cpp_extensions.gemm as gemm_mod
+    import transformer_engine.pytorch.cpp_extensions as pkg_mod
+
+    if getattr(gemm_mod.general_gemm, "__name__", "") == "_deepgemm_general_gemm":
+        _installed = True
+        return
+    _orig_general_gemm = gemm_mod.general_gemm
+
+    # 1) defining module; 2) package attribute (lazy `from ..cpp_extensions
+    #    import general_gemm` — basic_linear.py, the USE_TE_OPS=1 path);
+    # 3) every already-imported TE module holding the original symbol.
+    gemm_mod.general_gemm = _deepgemm_general_gemm
+    if hasattr(pkg_mod, "general_gemm"):
+        pkg_mod.general_gemm = _deepgemm_general_gemm
+    n = 0
+    for name, mod in list(sys.modules.items()):
+        if not name.startswith("transformer_engine") or mod is None:
+            continue
+        if getattr(mod, "general_gemm", None) is _orig_general_gemm:
+            mod.general_gemm = _deepgemm_general_gemm
+            n += 1
+    _installed = True
+    print(f"[deepgemm_gemm] installed (custom per-tensor kernel; patched gemm "
+          f"module + package attr + {n} loaded TE modules)", file=sys.stderr, flush=True)
+
+
+import torch  # noqa: E402 (kept last: heavy import, module is inert without install())
diff --git a/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/fav3_fp8_bwd.py b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/fav3_fp8_bwd.py
