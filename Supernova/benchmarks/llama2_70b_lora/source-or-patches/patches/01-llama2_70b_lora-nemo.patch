+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/fav3_fp8_bwd.py
@@ -0,0 +1,385 @@
+# Copyright (c) 2026, Billy Cao.
+
+"""Route the TE fp8 attention backward to the flash_attn_3 fp8 kernel.
+
+Enabled with NVTE_FAV3_FP8_BWD=1 through hooks in
+transformer_engine/pytorch/attention/dot_product_attention/{backends,
+context_parallel}.py (FusedAttnFunc and the CP a2a path). The forward
+stays on the cuDNN path; the backward consumes the saved e4m3 q/k/v/out
+with their per-tensor scale_inv factors and the cuDNN softmax LSE.
+Returns e5m2-quantized dq/dk/dv written by the kernel's postprocess on both
+paths (the CP a2a tail exchanges them; without context parallelism TE
+consumes the payloads directly).
+"""
+
+import os
+
+import torch
+import transformer_engine_torch as tex
+from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer, Float8Tensor
+import triton
+import triton.language as tl
+from triton.language.extra import cuda as tlc
+
+from flash_attn_interface import flash_attn_bwd_fp8, _flash_attn_forward
+
+_E4M3 = torch.float8_e4m3fn
+_E5M2 = torch.float8_e5m2
+_E4M3_MAX = 448.0
+_E5M2_MAX = 57344.0
+
+# PDL chaining: the prep kernel waits on its predecessor before the first load and releases its dependents once
+# its stores are issued, so PDL-launched neighbours can overlap its tail.
+_PDL = True
+
+
+@triton.jit
+def _do_prep_kernel(x_ptr, do8_ptr, dot_ptr, S, H, stride_b, stride_s, stride_h,
+                    q_ptr, qt_ptr, q_stride_b, q_stride_s, q_stride_h,
+                    k_ptr, kt_ptr, HK, k_stride_b, k_stride_s, k_stride_h,
+                    s5_ptr, dp_scale_ptr, k_scale_ptr, scal_ptr, ds_mult, softmax_scale,
+                    HAS_DP: tl.constexpr, PDL: tl.constexpr, BLOCK_S: tl.constexpr, D: tl.constexpr):
+    """dO e5m2 payload x -> e4m3 y = clamp(x / 128, +-448), stored twice: in the
+    payload's own [b, s, h, d] layout (do8) and transposed + token-permuted as
+    [b, h, d, s] (do_t, the fp8_bwd_transpose_qdo order: within every 16-token
+    block position 4*t + 2*j + p holds token 8*j + 2*t + p). Program (0, 0) also
+    writes the backward's scalars to scal_ptr: ds_scale (dP scale * ds_mult, or
+    ds_mult without a dP quantizer), do_scale = s5 * 128 and
+    dq_scale = softmax_scale * k_scale / ds_scale. The same programs write the
+    backward's transposed Q (q_t, token-permuted like do_t) and K (k_t, token
+    order kept; the programs of heads h < HK)."""
+    if PDL:
+        tlc.gdc_wait()
+    pid_s = tl.program_id(0)
+    pid_bh = tl.program_id(1)
+    if pid_s == 0 and pid_bh == 0:
+        if HAS_DP:
+            ds = tl.load(dp_scale_ptr) * ds_mult
+        else:
+            ds = ds_mult
+        tl.store(scal_ptr, ds)
+        tl.store(scal_ptr + 1, tl.load(s5_ptr) * 128.0)
+        tl.store(scal_ptr + 2, tl.math.div_rn(softmax_scale * tl.load(k_scale_ptr), ds))
+    b = pid_bh // H
+    h = pid_bh % H
+    k = pid_s * BLOCK_S + tl.arange(0, BLOCK_S)
+    r = k % 16
+    tok = (k - r) + 8 * ((r // 2) % 2) + 2 * (r // 4) + (r % 2)
+    d = tl.arange(0, D)
+    off = (b.to(tl.int64) * stride_b + h.to(tl.int64) * stride_h
+           + tok.to(tl.int64)[:, None] * stride_s + d[None, :])
+    m = (tok < S)[:, None]
+    x = tl.load(x_ptr + off, mask=m).to(tl.float32) * 0.0078125
+    y = tl.minimum(tl.maximum(x, -448.0), 448.0).to(do8_ptr.dtype.element_ty)
+    tl.store(do8_ptr + off, y, mask=m)
+    t_off = (pid_bh.to(tl.int64) * D + d[:, None]) * S + k[None, :]
+    tl.store(dot_ptr + t_off, tl.trans(y), mask=(k < S)[None, :])
+    q_off = (b.to(tl.int64) * q_stride_b + h.to(tl.int64) * q_stride_h
+             + tok.to(tl.int64)[:, None] * q_stride_s + d[None, :])
+    tl.store(qt_ptr + t_off, tl.trans(tl.load(q_ptr + q_off, mask=m)), mask=(k < S)[None, :])
+    if h < HK:
+        k_off = (b.to(tl.int64) * k_stride_b + h.to(tl.int64) * k_stride_h
+                 + k.to(tl.int64)[:, None] * k_stride_s + d[None, :])
+        kt_off = ((b * HK + h).to(tl.int64) * D + d[:, None]) * S + k[None, :]
+        tl.store(kt_ptr + kt_off, tl.trans(tl.load(k_ptr + k_off, mask=(k < S)[:, None])),
+                 mask=(k < S)[None, :])
+    if PDL:
+        tlc.gdc_launch_dependents()
+
+
+def _prep_do_e5m2(src, src_format, s5, ks, ds_source, softmax_scale, q8, k8):
+    """One launch: e4m3 dO (src layout), its transposed token-permuted copy in the
+    kernel layout [b, h, d, s], the transposed Q / K (q_t token-permuted, k_t
+    not), and the (ds_scale, do_scale, dq_scale) device scalars."""
+    t = src.permute(1, 0, 2, 3) if src_format == "sbhd" else src  # [b, s, h, d] view
+    b, S, H, D = t.shape
+    tq, tk = _layout_view(q8, src_format), _layout_view(k8, src_format)
+    HK = tk.shape[2]
+    _require(tq.shape == t.shape and tk.shape[:2] == (b, S) and tq.stride(3) == 1 and tk.stride(3) == 1
+             and H % HK == 0, "q/k must match dO's batch/seqlen and be d-contiguous")
+    q_t = torch.empty((b, H, D, S), device=src.device, dtype=_E4M3)
+    k_t = torch.empty((b, HK, D, S), device=src.device, dtype=_E4M3)
+    _require(S % 16 == 0 and t.stride(3) == 1, "dO must be d-contiguous with seqlen % 16 == 0")
+    do8 = torch.empty_like(src, dtype=_E4M3)
+    do8_t = do8.permute(1, 0, 2, 3) if src_format == "sbhd" else do8
+    do_t = torch.empty((b, H, D, S), device=src.device, dtype=_E4M3)
+    scal = torch.empty(3, device=src.device, dtype=torch.float32)
+    dp_scale, ds_mult = ds_source
+    block_s = 64
+    _do_prep_kernel[(triton.cdiv(S, block_s), b * H)](
+        t, do8_t, do_t, S, H, t.stride(0), t.stride(1), t.stride(2),
+        tq, q_t, tq.stride(0), tq.stride(1), tq.stride(2),
+        tk, k_t, HK, tk.stride(0), tk.stride(1), tk.stride(2),
+        s5, dp_scale if dp_scale is not None else s5, ks, scal, ds_mult, softmax_scale,
+        HAS_DP=dp_scale is not None, PDL=_PDL, BLOCK_S=block_s, D=D,
+        num_warps=4, launch_pdl=_PDL)
+    return do8, do_t, q_t, k_t, scal[0:1], scal[1:2], scal[2:3]
+
+
+def _fp8_outputs(ctx, quantize_output, q8, k8, v8, hq, hkv, src_format):
+    """e5m2 gradient outputs written directly by the kernel's postprocess, for a
+    delayed-scaling rowwise e5m2 dQKV quantizer and GQA (dK/dV go through the
+    postprocess only with GQA): (dq8, dk8, dv8, scale, amax, scale_inv) in the
+    kernel layout [b, s, h, d], or None (bf16 outputs, quantized by the caller).
+    The kernel casts the bf16-rounded values exactly as the quantizer does.
+    dq8 is a kernel-layout view of a buffer in the caller's layout (sbhd stays
+    sbhd), so the postprocess writes dQ in place and the return needs no copy;
+    dk8/dv8 inherit the caller's layout from K/V."""
+    qz = getattr(ctx, "dQKV_quantizer", None)
+    if not (quantize_output and hq != hkv and type(qz) is Float8Quantizer
+            and qz.dtype == tex.DType.kFloat8E5M2 and qz.rowwise_usage and not qz.columnwise_usage):
+        return None
+    outs = [_layout_view(torch.empty(q8.shape, device=q8.device, dtype=_E5M2), src_format)]
+    outs += [torch.empty_like(_layout_view(x, src_format), dtype=_E5M2) for x in (k8, v8)]
+    scale_inv = torch.empty(1, device=q8.device, dtype=torch.float32)
+    return (*outs, qz.scale.view(1), qz.amax.view(1), scale_inv)
+
+
+def _ds_scale_source(ctx):
+    """dS quantization scale source and amax buffer from the attention's
+    delayed-scaling dP quantizer: ds_scale = dP scale mapped to the e5m2
+    format the kernel quantizes dS to (dS8 = dS * ds_scale; real max|dS| is
+    atomically recorded into the quantizer's amax slot, so TE's history
+    update keeps qz.scale tracking dS). The scale comes from the tensor's
+    own amax history, per the TE delayed-scaling convention: a step whose
+    max|dS| exceeds the history amax saturates at the e5m2 max like every
+    other fp8 operand in the model."""
+    qz = getattr(ctx, "dP_quantizer", None)
+    scale = getattr(qz, "scale", None)
+    amax = getattr(qz, "amax", None)
+    _require(
+        isinstance(scale, torch.Tensor) and isinstance(amax, torch.Tensor)
+        and scale.numel() == 1 and amax.numel() == 1
+        and scale.dtype == torch.float32 and amax.dtype == torch.float32,
+        "expected the delayed-scaling dP quantizer (per-tensor fp32 scale/amax)",
+    )
+    fmax = _E5M2_MAX if int(getattr(qz, "dtype", -1)) == int(tex.DType.kFloat8E5M2) else _E4M3_MAX
+    return (scale.view(1), _E5M2_MAX / fmax), amax.view(1)
+
+
+def _require(cond, msg):
+    if not cond:
+        raise RuntimeError(f"NVTE_FAV3_FP8_BWD: {msg}")
+
+
+def _is_quantized(t):
+    return hasattr(t, "_data") and hasattr(t, "_scale_inv")
+
+
+def _fp8_dtype_is(t, want):
+    """Whether t's payload dtype equals want. A tensor without the attribute, or
+    with it unset, is not that dtype; the comparison goes through int() because
+    this TE's DType raises rather than returning False when one side is None."""
+    got = getattr(t, "_fp8_dtype", None)
+    return got is not None and int(got) == int(want)
+
+
+def _fp8_view(t):
+    """e4m3 view of a TE quantized tensor's uint8 payload, in the tensor's shape."""
+    _require(
+        _fp8_dtype_is(t, tex.DType.kFloat8E4M3),
+        f"expected an e4m3 payload, got {getattr(t, '_fp8_dtype', '<absent>')} "
+        f"on {type(t).__name__} (has _data={hasattr(t, '_data')}, "
+        f"has _scale_inv={hasattr(t, '_scale_inv')}, dtype={t.dtype})",
+    )
+    data = t._data.view(_E4M3)
+    return data.view(t.shape) if data.dim() != t.dim() else data
+
+
+def _scale(t):
+    s = t._scale_inv
+    _require(
+        s.numel() == 1 and s.dtype == torch.float32 and s.is_cuda,
+        f"expected a per-tensor fp32 device scale_inv, got shape {tuple(s.shape)}",
+    )
+    return s
+
+
+def _layout_view(t, src_format):
+    """TE layout [s,b,h,d] (sbhd) -> kernel layout [b,s,h,d]; bshd passes through."""
+    if src_format == "sbhd":
+        return t.permute(1, 0, 2, 3)
+    return t
+
+
+def _te_view(t, src_format):
+    """Kernel layout [b,s,h,d] -> TE layout [s,b,h,d] (sbhd); bshd passes through."""
+    if src_format == "sbhd":
+        return t.permute(1, 0, 2, 3)
+    return t
+
+
+def fav3_attention_bwd(ctx, q_fp8, k_fp8, v_fp8, out_, d_out, d_out_fp8, aux_ctx_tensors,
+                       quantize_output=False):
+    """Run the flash_attn_3 fp8 backward for the TE delayed-scaling attention.
+
+    q_fp8/k_fp8/v_fp8/out_: saved e4m3 quantized tensors (forward payloads).
+    d_out: incoming gradient (bf16 or quantized tensor, or None).
+    d_out_fp8: d_out quantized by the TE dO quantizer.
+    aux_ctx_tensors: forward auxiliary tensors; [0] is the softmax LSE.
+    quantize_output: return e5m2-quantized dq/dk/dv (written by the kernel's postprocess)
+    instead of bf16.
+    """
+    _require(ctx.fp8_recipe.delayed(), "only per-tensor delayed scaling is supported")
+    _require(ctx.attn_bias_type == "no_bias", "attention bias is not supported")
+    _require(ctx.dropout_p == 0.0, "dropout is not supported")
+    _require(ctx.softmax_type == "vanilla", "only vanilla softmax is supported")
+    is_causal = "causal" in ctx.attn_mask_type
+    # TE encodes top-left causal as window (-1, 0)
+    _require(
+        tuple(ctx.window_size) in ((-1, -1), (-1, 0)),
+        f"sliding window {tuple(ctx.window_size)} is not supported",
+    )
+    _require(
+        not is_causal or getattr(ctx, "bottom_right_diagonal", None) in (None, False),
+        "bottom-right-diagonal causal is not supported",
+    )
+
+    src_format = ctx.qkv_layout.split("_")[0].replace("3", "").replace("2", "")
+    _require(
+        src_format in ("sbhd", "bshd"),
+        f"qkv layout {ctx.qkv_layout} is not supported (sbhd/bshd only)",
+    )
+
+    if src_format == "sbhd":
+        s_q, b = q_fp8.shape[:2]
+        s_k = k_fp8.shape[0]
+    else:
+        b, s_q = q_fp8.shape[:2]
+        s_k = k_fp8.shape[1]
+    hq, d = q_fp8.shape[-2], q_fp8.shape[-1]
+    hkv, d_v = v_fp8.shape[-2], v_fp8.shape[-1]
+    _require(d == 128 and d_v == 128, f"head dim must be 128, got {d}/{d_v}")
+    _require(hq % hkv == 0, f"query heads ({hq}) must be a multiple of kv heads ({hkv})")
+    _require(s_k == s_q, "seqlen_q must equal seqlen_kv")
+    _require(s_q % 16 == 0, f"seqlen must be a multiple of 16, got {s_q}")
+
+    q8 = _fp8_view(q_fp8)
+    k8 = _fp8_view(k_fp8)
+    v8 = _fp8_view(v_fp8)
+    qs, ks, vs = _scale(q_fp8), _scale(k_fp8), _scale(v_fp8)
+
+    # e4m3 O goes to the kernel as is (dequantized in its preprocess); else bf16 O
+    o_descale = None
+    if _is_quantized(out_) and _fp8_dtype_is(out_, tex.DType.kFloat8E4M3):
+        out_k, o_descale = _fp8_view(out_), _scale(out_)
+    else:
+        out_k = out_.dequantize() if _is_quantized(out_) else out_
+
+    lse = aux_ctx_tensors[0]
+    _require(lse.numel() == b * hq * s_q and lse.dtype == torch.float32,
+             f"unexpected LSE {tuple(lse.shape)} {lse.dtype}")
+    if lse.shape != (b, hq, s_q):
+        lse = lse.reshape(b, hq, s_q)
+
+    softmax_scale = getattr(ctx, "softmax_scale", None) or getattr(ctx, "attn_scale", None)
+    ds_source, ds_amax = _ds_scale_source(ctx)
+    do_dtype = getattr(d_out_fp8, "_fp8_dtype", None) or ctx.dO_quantizer.dtype
+    if do_dtype == tex.DType.kFloat8E5M2:
+        # e4m3 = e5m2 / 128 exactly (same amax coverage, one exponent shift);
+        # real = do8 * (s5 * 128) == payload * s5 for any s5
+        do8, do_t, q_t, k_t, ds_scale, do_scale, dq_scale = _prep_do_e5m2(
+            d_out_fp8._data.view(_E5M2).view(d_out_fp8.shape), src_format, _scale(d_out_fp8), ks,
+            ds_source, softmax_scale, q8, k8)
+    elif do_dtype == tex.DType.kFloat8E4M3:
+        do_data = d_out_fp8._data.view(_E4M3)
+        do8 = do_data.view(d_out_fp8.shape) if do_data.dim() != d_out_fp8.dim() else do_data
+        do_scale = _scale(d_out_fp8)
+        dp_scale, ds_mult = ds_source
+        ds_scale = dp_scale * ds_mult if dp_scale is not None else ds_mult
+        do_t = q_t = k_t = dq_scale = None
+    else:
+        _require(False, f"unexpected dO payload dtype {do_dtype}")
+
+    fp8_out = _fp8_outputs(ctx, quantize_output, q8, k8, v8, hq, hkv, src_format)
+    # the kernel takes one set of dQ strides for the bf16 and the e5m2 dQ: the
+    # (unwritten) bf16 dQ gets the e5m2 dQ's caller layout
+    dq_buf = None if fp8_out is None else _layout_view(
+        torch.empty(q8.shape, device=q8.device, dtype=torch.bfloat16), src_format)
+    dq, dk, dv = flash_attn_bwd_fp8(
+        _layout_view(do8, src_format),
+        _layout_view(q8, src_format),
+        _layout_view(k8, src_format),
+        _layout_view(v8, src_format),
+        _layout_view(out_k, src_format),
+        lse,
+        q_scale=qs,
+        k_scale=ks,
+        v_scale=vs,
+        do_scale=do_scale,
+        ds_scale=ds_scale,
+        dq=dq_buf,
+        ds_amax=ds_amax,
+        softmax_scale=softmax_scale,
+        is_causal=is_causal,
+        q_t=q_t,
+        k_t=k_t,
+        do_t=do_t,
+        dq_scale=dq_scale,
+        fp8_out=fp8_out,
+        o_descale=o_descale,
+    )
+    if fp8_out is not None:
+        qz, scale_inv = ctx.dQKV_quantizer, fp8_out[5]
+        return tuple(
+            Float8Tensor(shape=x.shape, dtype=torch.bfloat16, data=x.view(torch.uint8),
+                         fp8_scale_inv=scale_inv, fp8_dtype=qz.dtype, requires_grad=False,
+                         data_transpose=None, quantizer=qz)
+            for x in (_te_view(t, src_format).contiguous() for t in fp8_out[:3]))
+    dq, dk, dv = (_te_view(dq, src_format), _te_view(dk, src_format), _te_view(dv, src_format))
+    if quantize_output:
+        dq, dk, dv = [ctx.dQKV_quantizer(x.contiguous()) for x in (dq, dk, dv)]
+    return dq, dk, dv
+
+
+def fav3_attention_fwd(q_fp8, k_fp8, v_fp8, softmax_scale, qkv_layout, o_format, is_causal):
+    """Run the flash_attn_3 fp8 forward for the TE delayed-scaling attention.
+
+    q_fp8/k_fp8/v_fp8: e4m3 quantized tensors, the payloads TE's fp8 DPA forward
+    branch produces. Returns (out, [lse, None]): lse fp32 (b, h, s) in natural
+    log -- the format the fp8 backward (cuDNN or the fav3 one) consumes. The None
+    rng slot matches the fp8
+    aux_ctx_tensors unpacking (dropout is not supported).
+    """
+    for t in (q_fp8, k_fp8, v_fp8):
+        _require(_is_quantized(t) and _fp8_dtype_is(t, tex.DType.kFloat8E4M3),
+                 "q/k/v must be e4m3-quantized tensors")
+    src_format = qkv_layout.split("_")[0].replace("3", "").replace("2", "")
+    _require(src_format in ("sbhd", "bshd"),
+             f"qkv layout {qkv_layout} is not supported (sbhd/bshd only)")
+    q8, k8, v8 = _fp8_view(q_fp8), _fp8_view(k_fp8), _fp8_view(v_fp8)
+    qs, ks, vs = _scale(q_fp8), _scale(k_fp8), _scale(v_fp8)
+    if src_format == "sbhd":
+        s_q, b = q_fp8.shape[:2]
+        s_k = k_fp8.shape[0]
+    else:
+        b, s_q = q_fp8.shape[:2]
+        s_k = k_fp8.shape[1]
+    hq, d = q_fp8.shape[-2], q_fp8.shape[-1]
+    hkv, d_v = v_fp8.shape[-2], v_fp8.shape[-1]
+    _require(d == 128 and d_v == 128, f"head dim must be 128, got {d}/{d_v}")
+    _require(hq % hkv == 0 and s_q == s_k and s_q % 16 == 0,
+             "GQA head ratio, seqlen_q == seqlen_kv and seqlen % 16 required")
+    # Column-major V removes the producer's repeated in-kernel transpose.
+    v_fwd = _layout_view(v8, src_format)
+    from fp8_v_transpose import transpose_v
+    v_fwd = transpose_v(v_fwd, permute_tokens=True)
+    # per-tensor scales broadcast to the (b, h_k) descale shape the kernel takes
+    def _desc(s):
+        return s.view(1, 1).expand(b, hkv)
+    # out is bf16; each caller path quantizes it exactly once for its backward save.
+    out, lse, _, _ = _flash_attn_forward(
+        _layout_view(q8, src_format),
+        _layout_view(k8, src_format),
+        v_fwd,
+        q_descale=_desc(qs), k_descale=_desc(ks), v_descale=_desc(vs),
+        softmax_scale=softmax_scale, causal=is_causal,
+        pack_gqa=False if v_fwd.stride(-1) != 1 else None,
+        v_seq_permuted=True,
+    )
+    out_q = _te_view(out, src_format)
+    # aux mirrors the cuDNN forward's format (stats (b, h, s, 1) fp32 + a (2,)
+    # int64 rng slot) so the cuDNN backward stays usable as the fallback; the
+    # fav3 backward reads aux[0] and reshapes either way.
+    rng = torch.zeros(2, dtype=torch.int64, device=out_q.device)
+    return out_q, [lse.contiguous().unsqueeze(-1), rng]
