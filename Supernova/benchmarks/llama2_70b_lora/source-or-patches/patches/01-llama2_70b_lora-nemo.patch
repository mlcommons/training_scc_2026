@@ -0,0 +1,219 @@
+"""Cached-FP8 SwiGLU fusion for the TE ops path (on by default; SWIGLU_FUSION=0 disables).
+
+Replaces ``transformer_engine.pytorch.ops.basic.swiglu.SwiGLU.op_forward`` and
+``op_backward`` for the production configuration (plain, non-interleaved SwiGLU
+with ``cache_quantized_input`` -- MCore's ``activation_func_fp8_input_store``,
+FP8_ACT=1):
+
+  - forward: one kernel computes the SwiGLU output (quantized by the next op's
+    delayed-scaling E4M3 quantizer) and the input amax, then quantizes the saved
+    input with the original current-scaling rule (epsilon 0, no power-of-two
+    rounding). The cache pass waits for the complete input amax. When the input is
+    the output of the TP1 fc1 DeepGEMM fprop (deepgemm_gemm), that GEMM's epilogue
+    has already produced the input amax, and one kernel does both passes in a
+    single read of the input (bitwise identical outputs).
+  - backward: consumes the saved E4M3 input directly, rounding each dequantized
+    value to BF16 in registers -- the original dequantize-to-BF16 boundary --
+    before TE's SiLU/derivative math, and writes E5M2 gradients with amax and
+    inverse-scale updates. No materialized BF16 temporary.
+
+GEMM accumulation is untouched. Unsupported types/layouts, CPU offload and
+non-BF16 autocast fall through to the original TE operation.
+
+Kernel source: swiglu_fusion/swiglu.cu, built by h200-tuning/setup/setup_sc26.sh into
+swiglu_fusion/build/libswiglu_fusion.so.
+"""
+import ctypes
+import os
+from pathlib import Path
+
+import torch
+import transformer_engine.pytorch
+import transformer_engine_torch as tex
+import deepgemm_gemm
+from transformer_engine.pytorch.tensor.float8_tensor import Float8Quantizer, Float8CurrentScalingQuantizer
+from transformer_engine.pytorch.tensor.storage.float8_tensor_storage import Float8TensorStorage
+
+BLOCKS = 1056  # fixed grid selected on H200
+FWD_KNOWN_BLOCKS = 2112  # one-pass forward (two vectors per thread per step)
+
+_library = None
+_installed = False
+
+
+def _lib():
+    global _library
+    if _library is None:
+        path = os.environ.get("SWIGLU_FUSION_LIB") or str(
+            Path(__file__).resolve().parents[1] / "swiglu_fusion" / "build" / "libswiglu_fusion.so"
+        )
+        _library = ctypes.CDLL(path)
+        _library.launch_swiglu_cached_fp8.argtypes = [ctypes.c_void_p] * 7 + [ctypes.c_int] * 3 + [ctypes.c_void_p]
+        _library.launch_swiglu_cached_fp8.restype = ctypes.c_int
+        _library.launch_swiglu_fwd_cache.argtypes = [ctypes.c_void_p] * 8 + [ctypes.c_int] * 3 + [ctypes.c_void_p]
+        _library.launch_swiglu_fwd_cache.restype = ctypes.c_int
+        _library.launch_swiglu_fwd_cache_known_amax.argtypes = [ctypes.c_void_p] * 8 + [ctypes.c_int] * 3 + [ctypes.c_void_p]
+        _library.launch_swiglu_fwd_cache_known_amax.restype = ctypes.c_int
+        _library.launch_swiglu_fwd_eval.argtypes = [ctypes.c_void_p] * 5 + [ctypes.c_int] * 3 + [ctypes.c_void_p]
+        _library.launch_swiglu_fwd_eval.restype = ctypes.c_int
+    return _library
+
+
+def launch(x, dy, quantizer, blocks=BLOCKS):
+    """Backward: E4M3 saved input x and BF16 dy -> E5M2 dx (quantizer: grad-output E5M2)."""
+    assert isinstance(x, Float8TensorStorage) and x._fp8_dtype == tex.DType.kFloat8E4M3
+    assert type(quantizer) is Float8Quantizer and quantizer.dtype == tex.DType.kFloat8E5M2
+    assert quantizer.rowwise_usage and not quantizer.columnwise_usage
+    assert dy.dtype == torch.bfloat16 and dy.is_contiguous() and x._data.is_contiguous()
+    assert x._data.device == dy.device == quantizer.scale.device == quantizer.amax.device
+    assert x._scale_inv.dtype == quantizer.scale.dtype == quantizer.amax.dtype == torch.float32
+    assert x._scale_inv.numel() == quantizer.scale.numel() == quantizer.amax.numel() == 1
+    assert tuple(x.size()) == (*dy.shape[:-1], dy.shape[-1] * 2)
+    assert dy.shape[-1] % 16 == 0
+    data = torch.empty_like(x._data)
+    inv = torch.empty_like(quantizer.scale)
+    with torch.cuda.device(dy.device):
+        rc = _lib().launch_swiglu_cached_fp8(
+            x._data.data_ptr(), x._scale_inv.data_ptr(), dy.data_ptr(), data.data_ptr(),
+            quantizer.scale.data_ptr(), quantizer.amax.data_ptr(), inv.data_ptr(),
+            dy.numel() // dy.shape[-1], dy.shape[-1], blocks,
+            torch.cuda.current_stream().cuda_stream)
+    if rc:
+        raise RuntimeError(f"SwiGLU backward launch failed: CUDA error {rc}")
+    return Float8TensorStorage(data=data, fp8_scale_inv=inv, fp8_dtype=quantizer.dtype,
+                               fake_dtype=dy.dtype, quantizer=quantizer)
+
+
+def forward(x, quantizer, blocks=BLOCKS):
+    """Forward: BF16 x -> (E4M3 output via quantizer, current-scaled E4M3 cached input)."""
+    assert type(x) is torch.Tensor and x.dtype == torch.bfloat16 and x.is_contiguous()
+    assert type(quantizer) is Float8Quantizer and quantizer.dtype == tex.DType.kFloat8E4M3
+    assert quantizer.rowwise_usage and not quantizer.columnwise_usage
+    assert x.device == quantizer.scale.device == quantizer.amax.device
+    assert quantizer.scale.dtype == quantizer.amax.dtype == torch.float32
+    assert quantizer.scale.numel() == quantizer.amax.numel() == 1
+    assert x.shape[-1] % 32 == 0
+    shape = (*x.shape[:-1], x.shape[-1] // 2)
+    y = torch.empty(shape, dtype=torch.uint8, device=x.device)
+    cached = torch.empty_like(x, dtype=torch.uint8)
+    y_inv = torch.empty_like(quantizer.scale)
+    x_amax = torch.zeros_like(quantizer.amax)
+    x_inv = torch.empty_like(quantizer.scale)
+    with torch.cuda.device(x.device):
+        rc = _lib().launch_swiglu_fwd_cache(
+            x.data_ptr(), y.data_ptr(), cached.data_ptr(), quantizer.scale.data_ptr(),
+            quantizer.amax.data_ptr(), y_inv.data_ptr(), x_amax.data_ptr(), x_inv.data_ptr(),
+            x.numel() // x.shape[-1], shape[-1], blocks, torch.cuda.current_stream().cuda_stream)
+    if rc:
+        raise RuntimeError(f"SwiGLU forward launch failed: CUDA error {rc}")
+    qx = Float8CurrentScalingQuantizer(tex.DType.kFloat8E4M3, x.device, rowwise=True, columnwise=False)
+    out = Float8TensorStorage(data=y, fp8_scale_inv=y_inv, fp8_dtype=quantizer.dtype,
+                              fake_dtype=x.dtype, quantizer=quantizer)
+    saved = Float8TensorStorage(data=cached, fp8_scale_inv=x_inv, fp8_dtype=tex.DType.kFloat8E4M3,
+                                fake_dtype=x.dtype, quantizer=qx)
+    return out, saved
+
+
+def forward_known_amax(x, quantizer, x_amax, blocks=FWD_KNOWN_BLOCKS):
+    """Forward with the input amax already produced by the fc1 GEMM epilogue: one pass over x."""
+    assert type(x) is torch.Tensor and x.dtype == torch.bfloat16 and x.is_contiguous()
+    assert type(quantizer) is Float8Quantizer and quantizer.dtype == tex.DType.kFloat8E4M3
+    assert quantizer.rowwise_usage and not quantizer.columnwise_usage
+    assert x.device == quantizer.scale.device == quantizer.amax.device == x_amax.device
+    assert quantizer.scale.dtype == quantizer.amax.dtype == x_amax.dtype == torch.float32
+    assert quantizer.scale.numel() == quantizer.amax.numel() == x_amax.numel() == 1
+    assert x.shape[-1] % 32 == 0
+    shape = (*x.shape[:-1], x.shape[-1] // 2)
+    y = torch.empty(shape, dtype=torch.uint8, device=x.device)
+    cached = torch.empty_like(x, dtype=torch.uint8)
+    y_inv = torch.empty_like(quantizer.scale)
+    x_inv = torch.empty_like(quantizer.scale)
+    with torch.cuda.device(x.device):
+        rc = _lib().launch_swiglu_fwd_cache_known_amax(
+            x.data_ptr(), y.data_ptr(), cached.data_ptr(), quantizer.scale.data_ptr(), x_amax.data_ptr(),
+            quantizer.amax.data_ptr(), y_inv.data_ptr(), x_inv.data_ptr(),
+            x.numel() // x.shape[-1], shape[-1], blocks, torch.cuda.current_stream().cuda_stream)
+    if rc:
+        raise RuntimeError(f"SwiGLU forward launch failed: CUDA error {rc}")
+    qx = Float8CurrentScalingQuantizer(tex.DType.kFloat8E4M3, x.device, rowwise=True, columnwise=False)
+    out = Float8TensorStorage(data=y, fp8_scale_inv=y_inv, fp8_dtype=quantizer.dtype,
+                              fake_dtype=x.dtype, quantizer=quantizer)
+    saved = Float8TensorStorage(data=cached, fp8_scale_inv=x_inv, fp8_dtype=tex.DType.kFloat8E4M3,
+                                fake_dtype=x.dtype, quantizer=qx)
+    return out, saved
+
+
+def forward_eval(x, quantizer, blocks=FWD_KNOWN_BLOCKS):
+    assert type(x) is torch.Tensor and x.dtype == torch.bfloat16 and x.is_contiguous()
+    assert type(quantizer) is Float8Quantizer and quantizer.dtype == tex.DType.kFloat8E4M3
+    assert x.device == quantizer.scale.device == quantizer.amax.device
+    assert x.shape[-1] % 32 == 0
+    shape = (*x.shape[:-1], x.shape[-1] // 2)
+    y = torch.empty(shape, dtype=torch.uint8, device=x.device)
+    y_inv = torch.empty_like(quantizer.scale)
+    with torch.cuda.device(x.device):
+        rc = _lib().launch_swiglu_fwd_eval(
+            x.data_ptr(), y.data_ptr(), quantizer.scale.data_ptr(), quantizer.amax.data_ptr(), y_inv.data_ptr(),
+            x.numel() // x.shape[-1], shape[-1], blocks, torch.cuda.current_stream().cuda_stream)
+    if rc:
+        raise RuntimeError(f"SwiGLU eval forward launch failed: CUDA error {rc}")
+    return Float8TensorStorage(data=y, fp8_scale_inv=y_inv, fp8_dtype=quantizer.dtype,
+                               fake_dtype=x.dtype, quantizer=quantizer)
+
+
+def install():
+    global _installed
+    if os.environ.get("SWIGLU_FUSION", "1") != "1" or _installed:
+        return
+    from transformer_engine.pytorch.ops.basic.swiglu import SwiGLU
+    from transformer_engine.pytorch.cpu_offload import is_cpu_offload_enabled
+
+    _lib()  # fail at startup, not at the first layer, if the library is missing
+    original_backward = SwiGLU.op_backward
+    original_forward = SwiGLU.op_forward
+
+    def fused_forward(self, ctx, input_, prev_op_grad_output_quantizer, next_op_input_quantizer):
+        q = next_op_input_quantizer
+        pending, deepgemm_gemm.fc1_amax_pending = deepgemm_gemm.fc1_amax_pending, None
+        # The stock fused path.
+        if (type(self) is SwiGLU and self.glu_interleave_size is None
+                and self.cache_quantized_input and ctx.requires_grad and not is_cpu_offload_enabled()
+                and type(input_) is torch.Tensor and input_.dtype == torch.bfloat16
+                and input_.is_contiguous() and input_.shape[-1] % 32 == 0
+                and (not torch.is_autocast_enabled() or torch.get_autocast_dtype("cuda") == torch.bfloat16)
+                and type(q) is Float8Quantizer and q.dtype == tex.DType.kFloat8E4M3
+                and q.rowwise_usage and not q.columnwise_usage):
+            if pending is not None and pending[0] == input_.data_ptr() and pending[1] == input_.numel():
+                out, saved = forward_known_amax(input_, q, pending[2])
+            else:
+                out, saved = forward(input_, q)
+            ctx.save_for_backward(saved)
+            ctx.dtype = input_.dtype
+            ctx.prev_op_grad_output_quantizer = prev_op_grad_output_quantizer
+            return out
+        if (type(self) is SwiGLU and self.glu_interleave_size is None and not ctx.requires_grad
+                and type(input_) is torch.Tensor and input_.dtype == torch.bfloat16
+                and input_.is_contiguous() and input_.shape[-1] % 32 == 0
+                and (not torch.is_autocast_enabled() or torch.get_autocast_dtype("cuda") == torch.bfloat16)
+                and type(q) is Float8Quantizer and q.dtype == tex.DType.kFloat8E4M3
+                and q.rowwise_usage and not q.columnwise_usage):
+            return forward_eval(input_, q)
+        return original_forward(self, ctx, input_, prev_op_grad_output_quantizer, next_op_input_quantizer)
+
+    def fused_backward(self, ctx, grad_output):
+        x, = ctx.saved_tensors
+        q = ctx.prev_op_grad_output_quantizer
+        if (type(self) is SwiGLU and self.glu_interleave_size is None
+                and isinstance(x, Float8TensorStorage) and x._fp8_dtype == tex.DType.kFloat8E4M3
+                and ctx.dtype == torch.bfloat16 and type(grad_output) is torch.Tensor
+                and grad_output.dtype == torch.bfloat16 and grad_output.is_contiguous()
+                and type(q) is Float8Quantizer and q.dtype == tex.DType.kFloat8E5M2
+                and q.rowwise_usage and not q.columnwise_usage
+                and x._data.is_contiguous() and grad_output.shape[-1] % 16 == 0):
+            return launch(x, grad_output, q), ()
+        return original_backward(self, ctx, grad_output)
+
+    SwiGLU.op_backward = fused_backward
+    SwiGLU.op_forward = fused_forward
+    _installed = True
+    print("[swiglu_fusion] installed (cached-FP8 SwiGLU forward + backward)", flush=True)
