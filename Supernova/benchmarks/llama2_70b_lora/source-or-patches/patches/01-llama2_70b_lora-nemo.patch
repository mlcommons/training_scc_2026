index 0000000..9361d95
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/tccl_mode.py
@@ -0,0 +1,369 @@
+"""T-CCL-style TMA reduce-scatter and all-gather for production training (TP_COMM_MODE=tccl), any group size.
+
+What this is, and what it is not
+--------------------------------
+It is the T-CCL *technique* -- peer data loaded into smem by TMA and written to the local buffer with
+cp.async.bulk (all-gather) or reduced into it with cp.reduce.async.bulk (reduce-scatter) -- implemented on our own
+primitive (h200-tuning/tma_reduce/tma_reduce.cu, entry tma_rs_bf16 = tma_copy_blocks with the default geometry and a
+do_reduce flag), not by linking ooverlap.
+
+Why not the library:
+  - It carries a HOST-SIDE epoch counter in its ready signal (ooverlap_comm_private.cu:767), which increments once
+    at capture and then replays stale forever. Production runs full-iteration CUDA graphs, so the library cannot be
+    captured.
+  - It owns its own IPC registry and signal buffers alongside our CP a2a transport -- two gate protocols in one
+    process.
+  - Its group API is single-process-multi-GPU. Training is one process per rank, so the buffers have to be
+    exchanged over CUDA IPC anyway.
+
+Our primitive is graph-safe by construction: no cudaMalloc, no device sync, no static host state, only
+cudaFuncSetAttribute plus a launch per call. The handshake counters live in device memory and are advanced by
+kernels, so every graph replay gates on live values.
+
+Layout (group of n ranks, this rank r)
+--------------------------------------
+One raw cudaMalloc block per rank, exported over CUDA IPC and mapped into every other rank of the group once, at the
+first collective (never inside a capture):
+    [ ctl: done (i64), ready (i64) | pad to 256 B ][ staging: capacity bytes ]
+cudaMalloc, not a torch tensor: cudaIpcOpenMemHandle maps the peer's view at the ALLOCATION base, so the exported
+pointer must be one (cp_a2a_ce's _ipc_malloc, shared).
+
+Reduce-scatter (dim 0, bf16 SUM; x is this rank's [N, cols] partial, shard = N / n rows)
+  stage   my staging slot j holds MY partial of rank (r + 1 + j) % n's shard, j = 0 .. n-2 -- i.e. x rotated to
+          start at shard r + 1, minus my own shard: at most two contiguous copies, (n-1)/n of the payload.
+  reduce  out = x[my shard]; then for k = 1 .. n-1, peer q = (r + k) % n: out += q's slot (r - q - 1) % n by one
+          TMA reduce each, all on the caller's stream. Serial on one stream on purpose: the adds then happen in a
+          fixed order and the result is deterministic (concurrent TMA reduces into one buffer would race the
+          bf16 rounding order).
+  At n = 2: one slot, the peer's partial of my shard, one reduce.
+
+All-gather (byte copy, any dtype; output is the n inputs concatenated, all_gather_into_tensor semantics)
+  stage   my input -> my staging (one copy of the shard).
+  pull    out[r] = input (local copy); for every peer q: TMA copy (do_reduce=0) of q's staging -> out[q].
+  The direction is PULL rather than push: a push would write my shard into each
+  peer's staging and need a second copy on the receiver (its output is a fresh allocation, not IPC-mapped); pulling
+  straight into my own output saves that copy. Same slots, same handshake, the reduce off.
+
+Handshake, per collective (both ops; everything stream-ordered, counters monotonic, never reset)
+  [done]   done += 1 (release, sys); wait every peer's done >= mine (acquire, sys). "I finished reading your
+           staging for the previous call" -- what stops me overwriting a buffer a peer still reads. The previous
+           call's TMA kernels end with cp.async.bulk.wait_group 0, so kernel completion means reads complete.
+  stage
+  [ready]  ready += 1; wait every peer's ready >= mine. "My staging for this call is written."
+  reduce / pull
+  Every rank publishes before it waits, so the protocol cannot deadlock; ranks stay within one call of each other,
+  which is the rendezvous a TP collective is anyway. One staging buffer per rank is therefore enough. The gates are
+  cp_a2a_ce's one-program spin kernels: 2 x (n-1) tiny launches per collective, one SM each while spinning.
+  Correctness requires every rank to take the same branch on every call (tccl or fallback); every refusal below
+  depends only on shapes, dtypes and the group, which all ranks share, and is decided before any kernel is
+  enqueued.
+
+Capability checks (not hardware policy)
+  - sm_90a: the primitive is compiled for it (tma_rs_arch_ok);
+  - one host: the staging is CUDA IPC, intra-node only, so a group whose ranks span hosts is refused at setup.
+
+Enable
+------
+    TP_COMM_MODE=tccl TCCL_CTAS=8            (TCCL_CTAS: CTAs per TMA launch, a launch parameter)
+
+Requires libtma_reduce.so; TMA_REDUCE_LIB overrides the path.
+"""
+
+import ctypes
+import os
+import socket
+
+import torch
+import torch.distributed as dist
+
+_LIB = None
+_STATE = {}         # id(group) -> _Peers
+_CFG = {"shard_bytes": 0}   # per-rank shard in bytes, set by configure()
+_REPORT = {"calls": 0, "skipped": 0, "bytes": 0, "ag_calls": 0, "ag_bytes": 0}
+_CTL_BYTES = 256
+
+
+def _log(msg):
+    if int(os.environ.get("RANK", "0")) == 0:
+        print(f"[tccl_mode] {msg}", flush=True)
+
+
+def _load_lib():
+    global _LIB
+    if _LIB is not None:
+        return _LIB
+    here = os.path.dirname(os.path.abspath(__file__))
+    path = os.environ.get(
+        "TMA_REDUCE_LIB",
+        os.path.join(here, "..", "h200-tuning", "tma_reduce", "build", "libtma_reduce.so"),
+    )
+    if not os.path.exists(path):
+        raise RuntimeError(
+            f"tccl_mode: {path} not found. Build it with "
+            f"h200-tuning/tma_reduce/build.sh (nvcc -arch=sm_90a), or set TMA_REDUCE_LIB.")
+    lib = ctypes.CDLL(path)
+    vp, u64, ci = ctypes.c_void_p, ctypes.c_ulonglong, ctypes.c_int
+    lib.tma_rs_bf16.argtypes = [vp, vp, u64, ci, u64, u64, ci, vp, ci]
+    lib.tma_rs_bf16.restype = ci
+    lib.tma_rs_arch_ok.argtypes = [ci, ctypes.POINTER(ci), ctypes.POINTER(ci)]
+    lib.tma_rs_arch_ok.restype = ci
+    _LIB = lib
+    return lib
+
+
+def configure(rows, cols):
+    """Record the per-rank bf16 shard shape (rows x cols). Called from train.py before the first step.
+
+    Separate from setup() because the process group does not exist yet where train.py configures this: `main()`
+    builds the config, and `finetune()` only initialises parallel_state much later. setup() therefore runs lazily
+    at the first collective, when both the group and this shape are available.
+    """
+    _CFG["shard_bytes"] = int(rows) * int(cols) * 2
+
+
+class _Peers:
+    """One group's IPC state: my block (ctl + staging) and every peer's, mapped."""
+
+    def __init__(self, group, shard_bytes):
+        import cp_a2a_ce as ce  # the IPC block helpers and the spin/arrive kernels, shared with the CP transport
+
+        lib = _load_lib()
+        dev = torch.cuda.current_device()
+        maj, mnr = ctypes.c_int(), ctypes.c_int()
+        if lib.tma_rs_arch_ok(dev, ctypes.byref(maj), ctypes.byref(mnr)) != 0:
+            raise RuntimeError(
+                f"tccl_mode: GPU {dev} is sm_{maj.value}{mnr.value}; libtma_reduce.so is sm_90a only. Nothing "
+                f"will be measured or trained this way.")
+        n, me = group.size(), group.rank()
+        hosts = [None] * n
+        dist.all_gather_object(hosts, socket.gethostname(), group=group)
+        if len(set(hosts)) != 1:
+            raise RuntimeError(
+                f"tccl_mode: the group spans hosts {sorted(set(hosts))}; the TMA primitive reads peers over CUDA "
+                f"IPC, which is intra-node only.")
+        # Staging capacity: n-1 RS slots of the largest shard (an AG needs one shard). 16-byte multiple.
+        cap = ((max(1, n - 1) * shard_bytes) + 255) & ~255
+        total = _CTL_BYTES + cap
+        base = ce._ipc_malloc(total, dev)
+        blk = ce._tensor_from_dev_ptr(base, total, f"cuda:{dev}")
+        blk[:_CTL_BYTES].zero_()
+        ctl = blk[:_CTL_BYTES].view(torch.int64)
+        self.n, self.me, self.cap = n, me, cap
+        self.done, self.ready = ctl[0:1], ctl[1:2]
+        self.stage = blk[_CTL_BYTES:]                 # uint8 [cap]
+        self.stage_ptr = base + _CTL_BYTES
+        h = ce._export_ipc_handle(base, f"cuda:{dev}")
+        gathered = [torch.empty_like(h) for _ in range(n)]
+        dist.all_gather(gathered, h, group=group)
+        self.peer_stage, self.peer_done, self.peer_ready = {}, {}, {}
+        for q in range(n):
+            if q == me:
+                continue
+            pb = ce._open_ipc_handle(gathered[q])
+            pc = ce._tensor_from_dev_ptr(pb, _CTL_BYTES, f"cuda:{dev}").view(torch.int64)
+            self.peer_stage[q] = pb + _CTL_BYTES
+            self.peer_done[q], self.peer_ready[q] = pc[0:1], pc[1:2]
+        self._gate, self._arrive = ce._gate_kernel, ce._arrive_kernel
+        torch.cuda.synchronize(dev)
+        dist.barrier(group=group)
+        _log(f"group of {n} mapped (rank {me} reads {n - 1} peers); staging {cap / 2**20:.1f} MiB per rank "
+             f"((n-1) x shard {shard_bytes / 2**20:.1f} MiB)")
+
+    def phase(self, mine, peers):
+        """Publish my counter, then wait for every peer's to reach it (the [done] / [ready] half)."""
+        self._arrive[(1,)](mine)
+        for q in sorted(peers):
+            self._gate[(1,)](peers[q], mine, ADD=0)
+
+
+def _ensure_setup(group, shard_bytes):
+    """Map the group on first use. Idempotent; must run outside graph capture.
+
+    The staging is sized to max(configured shard, this first call's shard). The configured value is an upper bound
+    from the model config, but the sequence-parallel collectives do not all carry the same shape, and a caller can
+    present a larger one. A later, larger shard still gets the explicit refusal in the callers."""
+    st = _STATE.get(id(group))
+    if st is not None:
+        return st
+    _CFG["shard_bytes"] = max(_CFG["shard_bytes"], int(shard_bytes))
+    if not _CFG["shard_bytes"]:
+        raise RuntimeError("tccl_mode: no shard size (configure() was never called and the call is empty)")
+    st = _Peers(group, _CFG["shard_bytes"])
+    _STATE[id(group)] = st
+    return st
+
+
+def setup(group, rows, cols):
+    """Eager setup for a (rows x cols) bf16 shard. Collective; outside graph capture."""
+    return _ensure_setup(group, int(rows) * int(cols) * 2)
+
+
+def has_peer(group):
+    return id(group) in _STATE
+
+
+def _ctas(ctas):
+    return int(ctas or os.environ.get("TCCL_CTAS", "8"))
+
+
+def _tma(lib, src, dst, row_bytes, nrows, ctas, stream, do_reduce, what):
+    rc = lib.tma_rs_bf16(
+        ctypes.c_void_p(src), ctypes.c_void_p(dst), ctypes.c_ulonglong(row_bytes), ctypes.c_int(nrows),
+        ctypes.c_ulonglong(row_bytes), ctypes.c_ulonglong(row_bytes), ctypes.c_int(ctas),
+        ctypes.c_void_p(stream), ctypes.c_int(do_reduce))
+    if rc != 0:
+        raise RuntimeError(f"tccl_mode: tma_rs_bf16 ({what}) rc={rc}")
+
+
+def reduce_scatter(input_, group, ctas=None):
+    """Reduce-scatter along dim 0, for whatever rank the caller hands over.
+
+    Megatron's _reduce_scatter_along_first_dim passes the activation as [s, b, h], not the 2-D [N, cols] this
+    primitive works in. s leads, so splitting the flattened [s*b, h] rows over ranks is the SAME scatter as
+    splitting s -- verified against the s-split directly -- so this flattens, runs the 2-D path, and reshapes back
+    to [s/n, b, h].
+
+    2-D input and n=1 pass through unchanged.
+    """
+    if group is None or group.size() == 1 or input_.dim() == 2:
+        return _reduce_scatter_2d(input_, group, ctas)
+    lead = input_.shape
+    out = _reduce_scatter_2d(input_.contiguous().reshape(-1, lead[-1]), group, ctas)
+    return out.reshape(lead[0] // group.size(), *lead[1:])
+
+
+def _nccl_rs(x, group, ws):
+    _REPORT["skipped"] += 1
+    out = torch.empty((x.shape[0] // ws, x.shape[1]), dtype=x.dtype, device=x.device)
+    dist.reduce_scatter_tensor(out, x, group=group)
+    return out
+
+
+def _reduce_scatter_2d(input_, group, ctas=None):
+    """Reduce-scatter over the n ranks of `group`, via the TMA primitive.
+
+    input_ is [N, cols] bf16: this rank's partial over the FULL tensor. Output is [N/n, cols] holding the sum over
+    ranks of this rank's shard -- the semantics of torch.distributed.reduce_scatter_tensor. Sum order on rank r:
+    ((x_r + x_{r+1}) + x_{r+2}) + ... in bf16, one rounding per add (n = 2: one add, bitwise NCCL's result).
+
+    WHY THERE IS A STAGING COPY. A peer has to read *this call's* input, but a CUDA IPC mapping is fixed at setup
+    and input_ is a fresh allocation each call. So each rank copies the n-1 shards it serves into its fixed,
+    IPC-mapped staging, and the peers TMA-reduce from it: (n-1)/n of the payload, never its own shard. A native
+    integration inside TE's overlap would not pay even that; this is the price of doing it outside the
+    communicator, recorded here rather than hidden.
+
+    Returns a new tensor; input_ is not modified.
+    """
+    if group is None or group.size() == 1:
+        return input_
+
+    x = input_.contiguous()
+    n, cols = x.shape
+    ws = group.size()
+    if x.dtype != torch.bfloat16 or n % ws or (cols * x.element_size()) % 16:
+        return _nccl_rs(x, group, ws)
+    shard = n // ws
+    row_bytes = cols * x.element_size()
+
+    # Map the group on first use, exactly as symm_pool installs its pool: the process group does not exist where
+    # train.py configures this, and the mapping must not happen inside a graph capture. A capture in progress
+    # therefore falls back and is counted, rather than mapping mid-capture.
+    if id(group) not in _STATE:
+        if torch.cuda.is_current_stream_capturing():
+            return _nccl_rs(x, group, ws)
+        _ensure_setup(group, shard * row_bytes)
+    st = _STATE[id(group)]
+    if (ws - 1) * shard * row_bytes > st.cap:
+        raise RuntimeError(
+            f"tccl_mode: staging is {st.cap} B but this reduce-scatter needs {ws - 1} x a shard of "
+            f"({shard}, {cols}) bf16. Size it with TCCL_PEER_ROWS (the per-rank shard, not the full token count) "
+            f"and TCCL_PEER_COLS.")
+
+    lib = _load_lib()
+    ctas = _ctas(ctas)
+    me = st.me
+    stream = torch.cuda.current_stream().cuda_stream
+    sb = shard * row_bytes
+
+    st.phase(st.done, st.peer_done)
+    # Slot j <- my partial of rank (me + 1 + j) % n's shard: x from shard me+1 to the end, then from 0 to shard me.
+    stage = st.stage[:(ws - 1) * sb].view(torch.bfloat16).view((ws - 1) * shard, cols)
+    tail = (ws - 1 - me) * shard                        # rows of shards me+1 .. n-1
+    if tail:
+        stage[:tail].copy_(x[(me + 1) * shard:])
+    if me:
+        stage[tail:].copy_(x[:me * shard])
+    st.phase(st.ready, st.peer_ready)
+
+    out = x[me * shard:(me + 1) * shard].clone()      # start from my own contribution
+    for k in range(1, ws):
+        q = (me + k) % ws
+        slot = (me - q - 1) % ws                        # where q staged its partial of MY shard
+        _tma(lib, st.peer_stage[q] + slot * sb, out.data_ptr(), row_bytes, shard, ctas, stream, 1, "rs")
+    _REPORT["calls"] += 1
+    _REPORT["bytes"] += (ws - 1) * sb
+    return out
+
+
+def _row_for(nbytes):
+    for r in (16384, 8192, 4096, 2048, 1024, 512, 256, 128, 64, 32, 16):
+        if nbytes % r == 0:
+            return r
+    return 0
+
+
+def all_gather_into(output, input_, group, ctas=None):
+    """all_gather_into_tensor(output, input_) through the TMA primitive (byte copy, any dtype).
+
+    Returns True when the gather ran here, False when the caller must run NCCL (same decision on every rank: it
+    depends only on shapes, dtypes and whether the group is mapped). Raises when the input exceeds the staging, as
+    the reduce-scatter does. output is the n inputs concatenated in rank order, the semantics of
+    all_gather_into_tensor (an [n * k, ...] or [n, k, ...] output; only its bytes matter).
+    """
+    if group is None or group.size() == 1:
+        return False
+    ws = group.size()
+    if not (input_.is_contiguous() and output.is_contiguous()) or output.dtype != input_.dtype:
+        return False
+    nb = input_.numel() * input_.element_size()
+    if nb == 0 or output.numel() * output.element_size() != ws * nb:
+        return False
+    row = _row_for(nb)
+    if not row or (input_.data_ptr() | output.data_ptr()) % 16:
+        return False
+    if id(group) not in _STATE:
+        if torch.cuda.is_current_stream_capturing():
+            return False
+        _ensure_setup(group, nb)
+    st = _STATE[id(group)]
+    if nb > st.cap:
+        raise RuntimeError(f"tccl_mode: staging is {st.cap} B but this all-gather's input is {nb} B")
+
+    lib = _load_lib()
+    ctas = _ctas(ctas)
+    me = st.me
+    stream = torch.cuda.current_stream().cuda_stream
+    src = input_.view(-1).view(torch.uint8)
+    dst = output.view(-1).view(torch.uint8)
+
+    st.phase(st.done, st.peer_done)
+    st.stage[:nb].copy_(src)
+    st.phase(st.ready, st.peer_ready)
+    dst[me * nb:(me + 1) * nb].copy_(src)
+    base = output.data_ptr()
+    for k in range(1, ws):
+        q = (me + k) % ws
+        _tma(lib, st.peer_stage[q], base + q * nb, row, nb // row, ctas, stream, 0, "ag")
+    _REPORT["ag_calls"] += 1
+    _REPORT["ag_bytes"] += (ws - 1) * nb
+    return True
+
+
+def report():
+    if not (_REPORT["calls"] or _REPORT["skipped"] or _REPORT["ag_calls"]):
+        return
+    _log(f"reduce-scatter: calls {_REPORT['calls']}, skipped {_REPORT['skipped']}, "
+         f"{_REPORT['bytes'] / 1e6:.0f} MB via TMA reduce; all-gather: calls {_REPORT['ag_calls']}, "
+         f"{_REPORT['ag_bytes'] / 1e6:.0f} MB via TMA copy")
+    if _REPORT["skipped"] and not (_REPORT["calls"] or _REPORT["ag_calls"]):
+        _log("WARNING: tccl selected but every call fell back; this is NOT a T-CCL result.")
diff --git a/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/te_comm_takeover.py b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/te_comm_takeover.py
new file mode 100644
index 0000000..33872eb
--- /dev/null
+++ b/NVIDIA/benchmarks/llama2_70b_lora/implementations/nemo/te_comm_takeover.py
@@ -0,0 +1,363 @@
+"""Route TE's own TP collectives through the selected transport (TP_COMM_MODE symk / tccl).
+
+tp_comm_mode.py patches megatron.core.tensor_parallel.mappings, but with USE_TE_OPS=1 the transformer layers are
+TE modules, which reach NCCL through transformer_engine/pytorch/distributed.py (gather_along_first_dim,
+reduce_scatter_along_first_dim, the FP8/MXFP8/NVFP4 gathers). Those helpers are bound by name into nine TE modules
+(39 call sites), so patching distributed.py's helpers would miss most of them. Every one of them ends in
+torch.distributed.all_gather_into_tensor or torch.distributed.reduce_scatter_tensor, looked up as a module attribute
+at call time -- so this wraps those two functions instead. Installed whenever
+TP_COMM_MODE is symk or tccl, with or without TP_COMM_OVERLAP: there is no separate switch, so selecting a
+transport cannot leave TE's collectives silently on NCCL. Coverage is
+then by construction, at the cost of not knowing the TE call site.
+
+Scope of the wrap:
+  - symk and tccl: only the Megatron TP group. The CP group carries its attention exchange as all_to_all_single,
+    which this wrap never sees, so CP traffic is out of scope for both. Resolved lazily: parallel_state does not
+    exist when train.py installs this. Every other group goes straight to NCCL;
+  - not inside a torch.distributed._coalescing_manager (the op is deferred to the manager's exit, so a staged
+    copy could not be completed in order) -- passed through and counted;
+  - collectives issued from inside this wrapper (tccl_mode's and symm_pool's own NCCL fallbacks and handle
+    exchanges) are not re-routed: a thread-local guard sends nested calls to the originals.
+
+symk: both NCCL buffers must be inside the registered window or NCCL runs RING. TE owns its buffers, so a call whose
+buffers are outside the pool runs on pooled copies: the input is copied in, the collective writes a pooled output,
+and the result is copied into the caller's tensor (in wait() for async_op calls, which also keeps the temporaries
+alive until then). Calls whose buffers are already pooled go through untouched.
+
+tccl, any group size: bf16 SUM reduce-scatters go through tccl_mode._reduce_scatter_2d (2-D view of the input, n-1
+TMA reduces, result copied into the caller's output); all-gathers of any dtype go through tccl_mode.all_gather_into
+(n-1 TMA byte copies pulled straight into the caller's output). A shape the staging buffer cannot take, or any other
+refusal raised before the primitive launches, falls back to NCCL and is counted -- every rank of the group sees the
+same shape, so they fall back together.
+
+report() prints per-op calls / MB / fallback reasons. It is a module counter, so it is NOT the proof of coverage:
+NCCL's TUNING lines are (RING RS/AG at 64/128 MiB must collapse and the mode's kernels must appear).
+"""
+import os
+import threading
+
+import torch
+import torch.distributed as dist
+
+_INSTALLED = False
+_MODE = None
+_ORIG = {}
+_TLS = threading.local()
+_STATS = {}
+
+
+def _count(key, nbytes=0):
+    c, b = _STATS.get(key, (0, 0))
+    _STATS[key] = (c + 1, b + nbytes)
+
+
+def _tp_group():
+    try:
+        from megatron.core import parallel_state as ps
+        return ps.get_tensor_model_parallel_group(check_initialized=False)
+    except Exception:  # noqa: BLE001
+        return None
+
+
+def _is_tp(group):
+    return _same_group(group, _tp_group())
+
+
+def _same_group(group, ref):
+    if ref is None or group is None:
+        return False
+    if group is ref:
+        return True
+    try:
+        return dist.get_process_group_ranks(group) == dist.get_process_group_ranks(ref)
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def _tccl_groups():
+    """The TP group, resolved from parallel_state (lazily: it does not exist when this is installed).
+
+    The wrap covers all_gather_into_tensor and reduce_scatter_tensor only. On this model the CP group carries
+    its attention exchange as all_to_all_single, which this wrap never sees, so a CP entry would match zero
+    calls and read as a null result. The CP a2a is a separate implementation on the same primitive
+    (cp_a2a_ce.py), already on by default.
+    """
+    try:
+        from megatron.core import parallel_state as ps
+
+        g = ps.get_tensor_model_parallel_group(check_initialized=False)
+    except Exception:  # noqa: BLE001
+        return []
+    return [g] if g is not None else []
+
+
+def _in_scope(group):
+    """Is this collective's group one the selected transport covers? symk: the TP group (its pool is registered
+    there), plus the single-node DP group when SYMM_POOL_DP=1 registered the pool on it. tccl: the TP group."""
+    if _MODE == "tccl":
+        return any(_same_group(group, g) for g in _tccl_groups())
+    if _is_tp(group):
+        return True
+    if os.environ.get("SYMM_POOL_DP", "0") == "1" and group is None:
+        # all_reduce on the default group (world): the single-node DP group of
+        # TP1 x CP4 x DP2 is the whole world, which SYMM_POOL_DP registers.
+        return dist.get_world_size() == torch.cuda.device_count()
+    return False
+
+
+def _symk_all_reduce(tensor, op, async_op):
+    """all_reduce through the symmetric pool: stage BOTH buffers inside the
+    window (NCCL runs its symmetric kernels only when input and output are
+    registered memory), then the plain all_reduce on the staged copy.
+
+    The distributed optimizer's gradient all-reduce is f32 on the DP group;
+    with the pool registered there (SYMM_POOL_DP=1) this is the covered path.
+    """
+    import symm_pool
+    if not symm_pool.enabled():
+        with symm_pool.pool_buffers():  # first use installs the pool
+            pass
+    if not symm_pool.enabled():
+        return False, None
+    with symm_pool.pool_buffers() as in_pool:
+        if not in_pool:
+            return False, None
+        src = torch.empty_like(tensor).copy_(tensor)
+    work = dist.all_reduce(src, op=op, async_op=True)
+    if async_op:
+        return True, _CopyBackWork(work, tensor, src, (src,))
+    tensor.copy_(src)
+    return True, None
+
+
+def _coalescing(group):
+    try:
+        return group in dist.distributed_c10d._world.pg_coalesce_state
+    except Exception:  # noqa: BLE001
+        return False
+
+
+class _CopyBackWork:
+    """async_op handle: wait on the collective, then copy the pooled result into the caller's tensor."""
+
+    def __init__(self, work, dst, src, keep):
+        self._work, self._dst, self._src, self._keep, self._done = work, dst, src, keep, False
+
+    def wait(self, *a, **k):
+        if not self._done:
+            if self._work is not None:
+                self._work.wait(*a, **k)
+            self._dst.copy_(self._src)
+            self._done = True
+            self._keep = None
+        return True
+
+    def is_completed(self):
+        return self._done
+
+    def __getattr__(self, name):  # anything else a caller may ask of a Work
+        return getattr(self._work, name)
+
+
+class _DoneWork:
+    """async_op handle for a stream-ordered call that has already been issued on the current stream."""
+
+    def wait(self, *a, **k):
+        return True
+
+    def is_completed(self):
+        return True
+
+
+def _passthrough(name, reason, args, kwargs):
+    _count(f"{name}:passthrough:{reason}")
+    return _ORIG[name](*args, **kwargs)
+
+
+def _symk_call(name, output, input_, group, async_op, kwargs_rest):
+    import symm_pool
+    if not symm_pool.enabled():
+        with symm_pool.pool_buffers():  # first use installs the pool
+            pass
+    if not symm_pool.enabled():
+        return False, None  # caller passes through
+    out_in = symm_pool._in_window(output) if hasattr(symm_pool, "_in_window") else False
+    in_in = symm_pool._in_window(input_) if hasattr(symm_pool, "_in_window") else False
+    nbytes = output.numel() * output.element_size()
+    if out_in and in_in:
+        _count(f"{name}:symk:already_pooled", nbytes)
+        return True, _ORIG[name](output, input_, group=group, async_op=async_op, **kwargs_rest)
+    with symm_pool.pool_buffers() as in_pool:
+        if not in_pool:
+            return False, None
+        src = input_ if in_in else torch.empty_like(input_).copy_(input_)
+        dst = output if out_in else torch.empty_like(output)
+    work = _ORIG[name](dst, src, group=group, async_op=async_op, **kwargs_rest)
+    _count(f"{name}:symk:staged", nbytes)
+    if dst is output:
+        return True, work
+    if async_op:
+        return True, _CopyBackWork(work, output, dst, (src, dst))
+    output.copy_(dst)
+    return True, None
+
+
+def _rows2d(x, ws):
+    """x as a 2-D [rows, cols] view whose dim-0 split over ws ranks is reduce_scatter_tensor's split, or None."""
+    if x.dim() >= 2:
+        return x.reshape(-1, x.shape[-1])
+    chunk = x.numel() // ws
+    if x.numel() % ws:
+        return None
+    for c in (8192, 4096, 2048, 1024, 512, 256, 128, 64, 32, 16, 8):
+        if chunk % c == 0:
+            return x.view(-1, c)
+    return None
+
+
+def _tccl_rs(output, input_, group, async_op):
+    import tccl_mode
+    if input_.dtype != torch.bfloat16 or input_.dim() < 1 or not output.is_contiguous():
+        return False, None
+    x = input_.contiguous()
+    x2 = _rows2d(x, group.size())
+    if x2 is None:
+        return False, None
+    before = tccl_mode._REPORT["calls"]
+    try:
+        out = tccl_mode._reduce_scatter_2d(x2, group)
+    except RuntimeError as e:
+        _count(f"reduce_scatter_tensor:tccl:refused:{str(e)[:60]}")
+        return False, None
+    output.copy_(out.reshape(output.shape))
+    if tccl_mode._REPORT["calls"] == before:
+        # tccl_mode ran NCCL itself (ineligible shape/dtype, or first use inside a capture): the result is right,
+        # but it is not a tccl call, so it is counted as a fallback, not as tma.
+        _count("reduce_scatter_tensor:tccl:inner_fallback", output.numel() * output.element_size())
+    else:
+        _count("reduce_scatter_tensor:tccl:tma", output.numel() * output.element_size())
+    return True, (_DoneWork() if async_op else None)
+
+
+def _tccl_ag(output, input_, group, async_op):
+    """all_gather_into_tensor via tccl_mode.all_gather_into (TMA byte copy pulled from every peer's staging)."""
+    import tccl_mode
+    try:
+        done = tccl_mode.all_gather_into(output, input_, group)
+    except RuntimeError as e:
+        _count(f"all_gather_into_tensor:tccl:refused:{str(e)[:60]}")
+        return False, None
+    if not done:
+        return False, None
+    _count("all_gather_into_tensor:tccl:tma", output.numel() * output.element_size())
+    return True, (_DoneWork() if async_op else None)
+
+
+def _wrap(name):
+    orig = _ORIG[name]
+
+    def wrapper(*args, **kwargs):
+        if getattr(_TLS, "inside", False):
+            return orig(*args, **kwargs)
+        if name == "all_reduce":
+            # (tensor, op=SUM, group=None, async_op=False)
+            tensor = args[0]
+            rest = list(args[1:])
+            kw = dict(kwargs)
+            op = kw.pop("op", rest.pop(0) if rest else dist.ReduceOp.SUM)
+            group = kw.pop("group", rest.pop(0) if rest else None)
+            async_op = kw.pop("async_op", rest.pop(0) if rest else False)
+            if not (isinstance(tensor, torch.Tensor) and tensor.is_cuda) or not _in_scope(group):
+                return orig(*args, **kwargs)
+            if _coalescing(group):
+                return _passthrough(name, "coalescing", args, kwargs)
+            if _MODE == "symk":
+                _TLS.inside = True
+                try:
+                    handled, work = _symk_all_reduce(tensor, op, async_op)
+                finally:
+                    _TLS.inside = False
+                if handled:
+                    return work
+                return _passthrough(name, "symk_fallback", args, kwargs)
+            return _passthrough(name, "mode", args, kwargs)
+        # (output, input, [op,] group=None, async_op=False): normalise the positional forms TE and torch use.
+        output, input_ = args[0], args[1]
+        rest = list(args[2:])
+        kw = dict(kwargs)
+        op = None
+        if name == "reduce_scatter_tensor":
+            if rest:
+                op = rest.pop(0)
+            op = kw.pop("op", op)
+        group = kw.pop("group", rest.pop(0) if rest else None)
+        async_op = kw.pop("async_op", rest.pop(0) if rest else False)
+        if rest:
+            return _passthrough(name, "unexpected_args", args, kwargs)
+        if not (isinstance(output, torch.Tensor) and output.is_cuda) or not _in_scope(group):
+            return orig(*args, **kwargs)  # not a covered group (the TP group): not touched
+        if _coalescing(group):
+            return _passthrough(name, "coalescing", args, kwargs)
+        _TLS.inside = True
+        try:
+            if name == "reduce_scatter_tensor":
+                if op is not None and op != dist.ReduceOp.SUM:
+                    return _passthrough(name, "not_sum", args, kwargs)
+                if _MODE == "tccl":
+                    done, work = _tccl_rs(output, input_, group, async_op)
+                    if done:
+                        return work
+                    return _passthrough(name, "tccl_fallback", args, kwargs)
+                extra = {} if op is None else {"op": op}
+                if _MODE == "symk":
+                    handled, work = _symk_call(name, output, input_, group, async_op, extra)
+                    if handled:
+                        return work
+                return _passthrough(name, "mode", args, kwargs)
+            # all_gather_into_tensor
+            if _MODE == "tccl":
+                done, work = _tccl_ag(output, input_, group, async_op)
+                if done:
+                    return work
+                return _passthrough(name, "tccl_fallback", args, kwargs)
+            if _MODE == "symk":
+                handled, work = _symk_call(name, output, input_, group, async_op, {})
+                if handled:
+                    return work
+            return _passthrough(name, "mode", args, kwargs)
+        finally:
+            _TLS.inside = False
+
+    wrapper.__wrapped__ = orig
+    wrapper._te_comm_takeover = True
+    return wrapper
+
+
+def install(mode):
+    """Wrap torch.distributed.all_gather_into_tensor / reduce_scatter_tensor (and, under
+    SYMM_POOL_DP=1, all_reduce) for TP_COMM_MODE symk or tccl."""
+    global _INSTALLED, _MODE
+    if _INSTALLED:
+        return
+    # Unconditional for the two transports. nccl and ub need no wrap.
+    if mode not in ("symk", "tccl"):
+        return
+    _MODE = mode
+    names = ["all_gather_into_tensor", "reduce_scatter_tensor"]
+    if mode == "symk" and os.environ.get("SYMM_POOL_DP", "0") == "1":
+        names.append("all_reduce")
+    for name in names:
+        _ORIG[name] = getattr(dist, name)
+        setattr(dist, name, _wrap(name))
+    _INSTALLED = True
+    if int(os.environ.get("RANK", "0")) == 0:
+        print(f"[te_comm_takeover] mode {mode}: torch.distributed.{'/'.join(names)} "
+              f"wrapped for the TP group (TE-carried traffic included)", flush=True)
+
+
+def report():
+    if not _INSTALLED or int(os.environ.get("RANK", "0")) != 0:
+        return
+    for key in sorted(_STATS):
+        c, b = _STATS[key]
+        print(f"[te_comm_takeover] {key}: calls {c}, {b / 1e6:.0f} MB", flush=True)
