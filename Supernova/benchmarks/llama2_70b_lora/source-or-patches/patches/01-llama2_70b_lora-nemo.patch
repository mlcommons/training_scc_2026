+// SwiGLU fusion with cached FP8 activations and the original rounding boundaries.
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <cstdint>
+#include "util/math.h"
+
+template<class T, int N> struct alignas(sizeof(T) * N) Pack { T v[N]; };
+
+// Grid-stride position over [rows, cols/16] vectors without a division per step.
+struct VecPos {
+  int row, cv;
+  __device__ __forceinline__ void advance(int step_rows, int step_cv, int vpr) {
+    row += step_rows;
+    cv += step_cv;
+    if (cv >= vpr) { cv -= vpr; ++row; }
+  }
+};
+
+// 1.f / d as the compiler emits it for prec-div: the refined MUFU reciprocal is exact unless d is zero,
+// denormal, >= 2^126, inf or NaN; those set `slow` and the caller recomputes them with the division.
+__device__ __forceinline__ float rcp_fast(float d, bool& slow) {
+  float r;
+  asm("rcp.approx.ftz.f32 %0, %1;" : "=f"(r) : "f"(d));
+  const float e = -fmaf(d, r, -1.f);
+  r = fmaf(r, e, r);
+  slow |= ((__float_as_uint(d) + 0x1800000u) & 0x7f800000u) <= 0x1ffffffu;
+  return r;
+}
+
+__device__ __forceinline__ bool rcp_needs_div(float d) {
+  return ((__float_as_uint(d) + 0x1800000u) & 0x7f800000u) <= 0x1ffffffu;
+}
+
+// The BF16-input forward still evaluates sixteen independent sigmoid values.
+__device__ __forceinline__ void sigmoid16(const float* v, float* s) {
+  float d[16];
+  bool slow = false;
+  #pragma unroll
+  for (int j = 0; j < 16; ++j) {
+    d[j] = 1.f + expf(-v[j]);
+    s[j] = rcp_fast(d[j], slow);
+  }
+  if (slow) {
+    #pragma unroll
+    for (int j = 0; j < 16; ++j)
+      if (rcp_needs_div(d[j])) s[j] = 1.f / d[j];
+  }
+}
+
+__device__ __forceinline__ void e4m3_to_float16(const uint4& q, float* f) {
+  const __nv_fp8x2_storage_t* p = reinterpret_cast<const __nv_fp8x2_storage_t*>(&q);
+  #pragma unroll
+  for (int j = 0; j < 8; ++j) {
+    const float2 h = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(p[j], __NV_E4M3)));
+    f[2 * j] = h.x;
+    f[2 * j + 1] = h.y;
+  }
+}
+
+template <__nv_fp8_interpretation_t K>
+__device__ __forceinline__ uint4 float16_to_fp8(const float* f) {
+  uint4 q;
+  __nv_fp8x2_storage_t* p = reinterpret_cast<__nv_fp8x2_storage_t*>(&q);
+  #pragma unroll
+  for (int j = 0; j < 8; ++j) p[j] = __nv_cvt_float2_to_fp8x2(make_float2(f[2 * j], f[2 * j + 1]), __NV_SATFINITE, K);
+  return q;
+}
+
+__device__ __forceinline__ void bf16x16_to_float(const uint4& lo, const uint4& hi, float* f) {
+  const __nv_bfloat162* a = reinterpret_cast<const __nv_bfloat162*>(&lo);
+  const __nv_bfloat162* b = reinterpret_cast<const __nv_bfloat162*>(&hi);
+  #pragma unroll
+  for (int j = 0; j < 4; ++j) {
+    const float2 x = __bfloat1622float2(a[j]), y = __bfloat1622float2(b[j]);
+    f[2 * j] = x.x; f[2 * j + 1] = x.y;
+    f[8 + 2 * j] = y.x; f[8 + 2 * j + 1] = y.y;
+  }
+}
+
+__device__ __forceinline__ void block_amax(float m, float* out) {
+  // Amax is non-negative and non-NaN after the zero-initialized fmax fold;
+  // integer max therefore preserves the floating-point result exactly.
+  unsigned int bits = __reduce_max_sync(0xffffffff, __float_as_uint(m));
+  __shared__ unsigned int maxima[32];
+  int const lane = threadIdx.x & 31;
+  if (lane == 0) maxima[threadIdx.x / 32] = bits;
+  __syncthreads();
+  if (threadIdx.x < 32) {
+    bits = lane < blockDim.x / 32 ? maxima[lane] : 0;
+    bits = __reduce_max_sync(0xffffffff, bits);
+    if (lane == 0) atomicMax(reinterpret_cast<unsigned int*>(out), bits);
+  }
+}
+
+// Backward on the cached E4M3 input: per element the math of TE's dswiglu on the dequantized BF16 input,
+// a per-CTA table of exact gate results, U vectors of 16 per thread per step with all loads issued first.
+template <int U>
+__global__ void __launch_bounds__(256) swiglu_cached_fp8_bwd(
+    const __nv_fp8_e4m3* x, const float* x_inv, const __nv_bfloat16* dy,
+    __nv_fp8_e5m2* dx, const float* scale, float* amax, float* inv,
+    int rows, int cols) {
+  constexpr int V = 16;
+  const int vpr = cols / V;
+  const int stride = gridDim.x * blockDim.x;
+  const int step_rows = stride / vpr, step_cv = stride % vpr;
+  const int t0 = blockIdx.x * blockDim.x + threadIdx.x;
+  VecPos pos{t0 / vpr, t0 % vpr};
+  const float xs = *x_inv, s = *scale;
+  // There are only 256 cached gate codes. Build this CTA's table with the
+  // current device scale and the same BF16 boundary / sigmoid arithmetic.
+  // No persistent allocation or initialization state crosses graph replays.
+  __shared__ float2 gate_table[256];
+  const unsigned int code = threadIdx.x;
+  const auto pair = __nv_fp8x2_storage_t(code | (code << 8));
+  const float value = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(pair, __NV_E4M3))).x;
+  const float gate = float(__float2bfloat16_rn(value * xs));
+  const float denominator = 1.f + expf(-gate);
+  bool slow = false;
+  float sigmoid = rcp_fast(denominator, slow);
+  if (slow) sigmoid = 1.f / denominator;
+  const float ds = sigmoid * (1.f - sigmoid);
+  gate_table[code] = make_float2(gate * ds + sigmoid, gate * sigmoid);
+  __syncthreads();
+  float maximum = 0.f;
+  while (pos.row < rows) {
+    uint4 qa[U], qb[U], g0[U], g1[U];
+    int off[U], goff[U];
+    bool live[U];
+    VecPos p = pos;
+    #pragma unroll
+    for (int u = 0; u < U; ++u) {
+      live[u] = p.row < rows;
+      off[u] = goff[u] = 0;
+      if (live[u]) {
+        off[u] = p.row * 2 * cols + p.cv * V;
+        goff[u] = p.row * cols + p.cv * V;
+        qa[u] = *reinterpret_cast<const uint4*>(x + off[u]);
+        qb[u] = *reinterpret_cast<const uint4*>(x + off[u] + cols);
+        g0[u] = *reinterpret_cast<const uint4*>(dy + goff[u]);
+        g1[u] = *reinterpret_cast<const uint4*>(dy + goff[u] + 8);
+      }
+      p.advance(step_rows, step_cv, vpr);
+    }
+    pos = p;
+    #pragma unroll
+    for (int u = 0; u < U; ++u) {
+      if (!live[u]) continue;
+      float b[V], g[V], da[V], db[V];
+      e4m3_to_float16(qb[u], b);
+      bf16x16_to_float(g0[u], g1[u], g);
+      #pragma unroll
+      for (int j = 0; j < V; ++j) {
+        // Match the materialized dequantize-to-BF16 boundary before the TE math.
+        b[j] = float(__float2bfloat16_rn(b[j] * xs));
+      }
+      #pragma unroll
+      for (int j = 0; j < V; ++j) {
+        const float2 gate_values = gate_table[reinterpret_cast<const uint8_t*>(&qa[u])[j]];
+        const float dsilu = gate_values.x, silu = gate_values.y;
+        const float ga = dsilu * g[j] * b[j];
+        const float gb = g[j] * silu;
+        maximum = fmaxf(maximum, fmaxf(fabsf(ga), fabsf(gb)));
+        da[j] = ga * s;
+        db[j] = gb * s;
+      }
+      *reinterpret_cast<uint4*>(dx + off[u]) = float16_to_fp8<__NV_E5M2>(da);
+      *reinterpret_cast<uint4*>(dx + off[u] + cols) = float16_to_fp8<__NV_E5M2>(db);
+    }
+  }
+  block_amax(maximum, amax);
+  if (blockIdx.x == 0 && threadIdx.x == 0) *inv = 1.f / s;
+}
+
+// Vectors per thread per step (H200, production shapes): one in the backward, two in the one-pass forward.
+constexpr int kBwdUnroll = 1;
+constexpr int kFwdUnroll = 2;
+
+template <int U>
+static int launch_bwd(const void* x, const void* xi, const void* dy, void* dx, const void* s,
+                      void* a, void* si, int m, int n, int blocks, cudaStream_t st) {
+  swiglu_cached_fp8_bwd<U><<<blocks, 256, 0, st>>>(
+      static_cast<const __nv_fp8_e4m3*>(x), static_cast<const float*>(xi),
+      static_cast<const __nv_bfloat16*>(dy), static_cast<__nv_fp8_e5m2*>(dx),
+      static_cast<const float*>(s), static_cast<float*>(a), static_cast<float*>(si), m, n);
+  return int(cudaGetLastError());
+}
+
+extern "C" int launch_swiglu_cached_fp8(
+    const void* x, const void* xi, const void* dy, void* dx, const void* s,
+    void* a, void* si, int m, int n, int blocks, void* stream) {
+  if (m <= 0 || n <= 0 || n % 16 || blocks <= 0 || int64_t(m)*n*2 > INT32_MAX)
+    return int(cudaErrorInvalidValue);
+  return launch_bwd<kBwdUnroll>(x, xi, dy, dx, s, a, si, m, n, blocks, reinterpret_cast<cudaStream_t>(stream));
+}
+
+__global__ void swiglu_fwd_with_input_amax(
+    const __nv_bfloat16* x, __nv_fp8_e4m3* y, const float* scale,
+    float* y_amax, float* y_inv, float* x_amax, int rows, int cols) {
+  constexpr int V = 16;
+  const int vectors_per_row = cols / V;
+  const int total = rows * vectors_per_row;
+  float xm = 0.f, ym = 0.f;
+  const float s = *scale;
+  const transformer_engine::Empty p{};
+  for (int t = blockIdx.x * blockDim.x + threadIdx.x;
+       t < total; t += gridDim.x * blockDim.x) {
+    const int row = t / vectors_per_row, col = (t % vectors_per_row) * V;
+    const int off = row * 2 * cols + col;
+    auto a = *reinterpret_cast<const Pack<__nv_bfloat16,V>*>(x + off);
+    auto b = *reinterpret_cast<const Pack<__nv_bfloat16,V>*>(x + off + cols);
+    Pack<__nv_fp8_e4m3,V> out;
+    #pragma unroll
+    for (int j = 0; j < V; ++j) {
+      const float av = float(a.v[j]), bv = float(b.v[j]);
+      const float value = transformer_engine::silu<float,float>(av,p) * bv;
+      out.v[j] = __nv_fp8_e4m3(value * s);
+      xm = fmaxf(xm, fmaxf(fabsf(av), fabsf(bv)));
+      ym = fmaxf(ym, fabsf(value));
+    }
+    *reinterpret_cast<Pack<__nv_fp8_e4m3,V>*>(y + row * cols + col) = out;
+  }
+  unsigned int xb = __reduce_max_sync(0xffffffff, __float_as_uint(xm));
+  unsigned int yb = __reduce_max_sync(0xffffffff, __float_as_uint(ym));
+  __shared__ unsigned int xs[8], ys[8];
+  if ((threadIdx.x & 31) == 0) {
+    xs[threadIdx.x/32] = xb;
+    ys[threadIdx.x/32] = yb;
+  }
+  __syncthreads();
+  if (threadIdx.x < 32) {
+    xb = __reduce_max_sync(0xffffffff, threadIdx.x < 8 ? xs[threadIdx.x] : 0);
+    yb = __reduce_max_sync(0xffffffff, threadIdx.x < 8 ? ys[threadIdx.x] : 0);
+    if (threadIdx.x == 0) {
+      atomicMax(reinterpret_cast<unsigned int*>(x_amax), xb);
+      atomicMax(reinterpret_cast<unsigned int*>(y_amax), yb);
+      if (blockIdx.x == 0) *y_inv = 1.f / s;
+    }
+  }
+}
+
+__global__ void cache_input_current_fp8(
+    const __nv_bfloat16* x, __nv_fp8_e4m3* cached,
+    const float* amax, float* inv, int elements) {
+  // TE's default current-scaling recipe: epsilon=0, no power-of-two rounding.
+  const float a = *amax;
+  float s = (a == 0.f || isinf(a) || isnan(a)) ? 1.f : __fdiv_rn(448.f,a);
+  if (isinf(s)) s = __int_as_float(0x7f7fffff);
+  constexpr int V = 16;
+  for (int t = blockIdx.x * blockDim.x + threadIdx.x;
+       t < elements/V; t += gridDim.x * blockDim.x) {
+    auto in = *reinterpret_cast<const Pack<__nv_bfloat16,V>*>(x+t*V);
+    Pack<__nv_fp8_e4m3,V> out;
+    #pragma unroll
+    for (int j = 0; j < V; ++j) out.v[j] = __nv_fp8_e4m3(float(in.v[j])*s);
+    *reinterpret_cast<Pack<__nv_fp8_e4m3,V>*>(cached+t*V) = out;
+  }
+  if (blockIdx.x == 0 && threadIdx.x == 0) *inv = 1.f / s;
+}
+
+extern "C" int launch_swiglu_fwd_cache(
+    const void* x, void* y, void* cache, const void* s, void* ya, void* yi,
+    void* xa, void* xi, int m, int n, int blocks, void* stream) {
+  if (m <= 0 || n <= 0 || n % 16 || blocks <= 0 || int64_t(m)*n*2 > INT32_MAX)
+    return int(cudaErrorInvalidValue);
+  auto st = reinterpret_cast<cudaStream_t>(stream);
+  swiglu_fwd_with_input_amax<<<blocks,256,0,st>>>(
+      static_cast<const __nv_bfloat16*>(x),static_cast<__nv_fp8_e4m3*>(y),
+      static_cast<const float*>(s),static_cast<float*>(ya),static_cast<float*>(yi),
+      static_cast<float*>(xa),m,n);
+  auto err = cudaGetLastError();
+  if (err != cudaSuccess) return int(err);
+  cache_input_current_fp8<<<blocks,256,0,st>>>(
+      static_cast<const __nv_bfloat16*>(x),static_cast<__nv_fp8_e4m3*>(cache),
+      static_cast<const float*>(xa),static_cast<float*>(xi),m*n*2);
+  return int(cudaGetLastError());
+}
+
+// One pass over the BF16 fc1 output when its amax is already known (emitted by the GEMM epilogue):
+// the SwiGLU output (delayed-scale E4M3 plus its amax) and the current-scaled E4M3 cache come from a
+// single read. Per-element math is that of swiglu_fwd_with_input_amax and cache_input_current_fp8.
+template <int U, bool CACHE = true>
+__global__ void __launch_bounds__(256) swiglu_fwd_cache_known_amax(
+    const __nv_bfloat16* x, __nv_fp8_e4m3* y, __nv_fp8_e4m3* cached, const float* scale,
+    const float* x_amax, float* y_amax, float* y_inv, float* x_inv, int rows, int cols) {
+  constexpr int V = 16;
+  const int vpr = cols / V;
+  const int stride = gridDim.x * blockDim.x;
+  const int step_rows = stride / vpr, step_cv = stride % vpr;
+  const int t0 = blockIdx.x * blockDim.x + threadIdx.x;
+  VecPos pos{t0 / vpr, t0 % vpr};
+  const float s = *scale;
+  float cs = 1.f;
+  if constexpr (CACHE) {
+    const float a = *x_amax;
+    cs = (a == 0.f || isinf(a) || isnan(a)) ? 1.f : __fdiv_rn(448.f, a);
+    if (isinf(cs)) cs = __int_as_float(0x7f7fffff);
+  }
+  float ym = 0.f;
+  while (pos.row < rows) {
+    uint4 a0[U], a1[U], b0[U], b1[U];
+    int off[U], yoff[U];
+    bool live[U];
+    VecPos p = pos;
+    #pragma unroll
+    for (int u = 0; u < U; ++u) {
+      live[u] = p.row < rows;
+      off[u] = yoff[u] = 0;
+      if (live[u]) {
+        off[u] = p.row * 2 * cols + p.cv * V;
+        yoff[u] = p.row * cols + p.cv * V;
+        a0[u] = *reinterpret_cast<const uint4*>(x + off[u]);
+        a1[u] = *reinterpret_cast<const uint4*>(x + off[u] + 8);
+        b0[u] = *reinterpret_cast<const uint4*>(x + off[u] + cols);
+        b1[u] = *reinterpret_cast<const uint4*>(x + off[u] + cols + 8);
+      }
+      p.advance(step_rows, step_cv, vpr);
+    }
+    pos = p;
+    #pragma unroll
+    for (int u = 0; u < U; ++u) {
+      if (!live[u]) continue;
+      float av[V], bv[V], sg[V], out[V], ca[V], cb[V];
+      bf16x16_to_float(a0[u], a1[u], av);
+      bf16x16_to_float(b0[u], b1[u], bv);
+      sigmoid16(av, sg);
+      #pragma unroll
+      for (int j = 0; j < V; ++j) {
+        const float value = av[j] * sg[j] * bv[j];
+        out[j] = value * s;
+        ym = fmaxf(ym, fabsf(value));
+        ca[j] = av[j] * cs;
+        cb[j] = bv[j] * cs;
+      }
+      *reinterpret_cast<uint4*>(y + yoff[u]) = float16_to_fp8<__NV_E4M3>(out);
+      if constexpr (CACHE) {
+        *reinterpret_cast<uint4*>(cached + off[u]) = float16_to_fp8<__NV_E4M3>(ca);
+        *reinterpret_cast<uint4*>(cached + off[u] + cols) = float16_to_fp8<__NV_E4M3>(cb);
+      }
+    }
+  }
+  block_amax(ym, y_amax);
+  if (blockIdx.x == 0 && threadIdx.x == 0) {
+    *y_inv = 1.f / s;
+    if constexpr (CACHE) *x_inv = 1.f / cs;
+  }
+}
+
+template <int U>
+static int launch_fwd_known(const void* x, void* y, void* cache, const void* s, const void* xa, void* ya,
+                            void* yi, void* xi, int m, int n, int blocks, cudaStream_t st) {
+  swiglu_fwd_cache_known_amax<U><<<blocks, 256, 0, st>>>(
+      static_cast<const __nv_bfloat16*>(x), static_cast<__nv_fp8_e4m3*>(y),
+      static_cast<__nv_fp8_e4m3*>(cache), static_cast<const float*>(s),
+      static_cast<const float*>(xa), static_cast<float*>(ya), static_cast<float*>(yi),
+      static_cast<float*>(xi), m, n);
+  return int(cudaGetLastError());
+}
+
+extern "C" int launch_swiglu_fwd_cache_known_amax(
+    const void* x, void* y, void* cache, const void* s, const void* xa, void* ya, void* yi,
+    void* xi, int m, int n, int blocks, void* stream) {
+  if (m <= 0 || n <= 0 || n % 16 || blocks <= 0 || int64_t(m)*n*2 > INT32_MAX)
+    return int(cudaErrorInvalidValue);
+  return launch_fwd_known<kFwdUnroll>(x, y, cache, s, xa, ya, yi, xi, m, n, blocks,
+                                      reinterpret_cast<cudaStream_t>(stream));
+}
+
+extern "C" int launch_swiglu_fwd_eval(const void* x, void* y, const void* s, void* ya, void* yi, int m, int n,
+                                      int blocks, void* stream) {
+  if (m <= 0 || n <= 0 || n % 16 || blocks <= 0 || int64_t(m)*n*2 > INT32_MAX)
+    return int(cudaErrorInvalidValue);
+  swiglu_fwd_cache_known_amax<kFwdUnroll, false><<<blocks, 256, 0, reinterpret_cast<cudaStream_t>(stream)>>>(
+      static_cast<const __nv_bfloat16*>(x), static_cast<__nv_fp8_e4m3*>(y), nullptr, static_cast<const float*>(s),
+      nullptr, static_cast<float*>(ya), static_cast<float*>(yi), nullptr, m, n);
+  return int(cudaGetLastError());
+}
