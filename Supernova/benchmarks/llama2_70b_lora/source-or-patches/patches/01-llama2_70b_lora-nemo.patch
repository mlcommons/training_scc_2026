+"""LoRA 'pre' dropout folded into the LoRA-A GEMMs of TEFusedLoRALinear (TP1 te.ops path).
+
+Stock LoRA branch at TP1 (Bridge TEFusedLoRALinear._make_lora_branch):
+    te.ops.Dropout(p) -> te.ops.Linear(K, r) [A] -> te.ops.Linear(r, N) [B] -> ConstantScale -> AddExtraInput
+  fwd: dropout kernel (reads x, writes the bf16 dropped tensor and a 1-bit mask), then the A GEMM reads it.
+  bwd: A dgrad GEMM writes dx, apply_dropout_mask rereads it with the mask, and the A wgrad GEMM reads the
+       saved bf16 dropped tensor.
+
+Folded op (DropoutLoRAIn), replacing the first two ops:
+  fwd: one Triton kernel z = bf16(keep * x * 1/(1-p)) @ A^T, with the keep mask generated in the prologue
+       from a Philox stream (split-K partials in fp32, then a small sum kernel). Nothing but x and an 8-byte
+       seed is saved for backward.
+  bwd: one Triton kernel per K-tile that regenerates the mask, writes dx = keep * 1/(1-p) * bf16(dz @ A)
+       and accumulates the A wgrad dz^T @ bf16(keep * x * 1/(1-p)) for its row range; a small kernel adds
+       the split partials into main_grad.
+
+Mask distribution: identical to TE's dropout kernel. TE draws one Philox4x32-10 call per 16 elements and drops
+an element when its random byte is below floor(p * 256), scaling the kept ones by 1/(1-p). Here the same:
+one Philox4x32-10 call per 16 consecutive elements, element j of the chunk uses byte j % 4 of word j // 4,
+dropped when that byte is below floor(p * 256), kept values scaled by 1/(1-p) in fp32 then rounded to bf16
+(same operation order as TE, so for a given mask the GEMM operands are the bytes TE would produce).
+RNG source: lora_rng. The Philox key is the adapter's per-call key (lora_rng.call_seed, one on-device kernel,
+CUDA-graph safe) and the counter is the element's GLOBAL flat index (global row id * H + global hidden index,
+lora_rng.positions), so the mask of a token is the same under every TP x CP layout and matches the TP > 1
+path (lora_fused.FusedDropout), which uses the same helper. The mask stream differs from TE's (curand
+subsequence layout), so the result is not bitwise against TE. Without an adapter (unit gates) the key is
+drawn from the default CUDA generator and the counter is the local flat index.
+
+Input: a Float8Tensor with rowwise data (qkv, and proj when its input arrives in fp8) is read as fp8 bytes and
+dequantized in the kernel with its scale_inv; any other input is used as bf16 (quantized types are
+dequantized first).
+
+install() patches TEFusedLoRALinear._make_lora_branch. Branches that do
+not match (no 'pre' dropout, tensor parallel, rank not 16/32/64, K not a multiple of 128, non-bf16 weight) keep
+the stock ops.
+"""
+
+import weakref
+
+import torch
+import triton
+import triton.language as tl
+
+import lora_rng
+
+_ROUNDS = 10  # Philox4x32-10, as curand's Philox used by TE
+
+# Launch configs. Forward: (rows per tile, K per tile, splits, warps).
+# Backward, one config per input dtype: (rows per tile, K per tile, row splits, warps, pipeline stages,
+# K-tile-major grid).
+FWD_CFG = (64, 128, 4, 4)
+BWD_CFG_FP8 = (64, 64, 8, 4, 3, True)
+BWD_CFG_BF16 = (64, 32, 4, 4, 3, True)
+_SUM_BLOCK = 1024
+
+
+@triton.jit
+def _keep_mask(seed, rows, k0, K, thr, BM: tl.constexpr, BK: tl.constexpr, ROUNDS: tl.constexpr):
+    """keep[i, j] for element (rows[i], k0 + j); one Philox call per 16 consecutive elements of the flat index."""
+    C: tl.constexpr = BK // 16
+    chunk = (rows.to(tl.int64)[:, None] * K + k0) // 16 + tl.arange(0, C)[None, :]
+    r0, r1, r2, r3 = tl.randint4x(seed, chunk.to(tl.uint32), ROUNDS)
+    jj = tl.arange(0, 16)
+    q = (jj // 4)[None, None, :]
+    sh = ((jj % 4) * 8).to(tl.uint32)[None, None, :]
+    w = tl.where(q == 0, r0[:, :, None],
+                 tl.where(q == 1, r1[:, :, None], tl.where(q == 2, r2[:, :, None], r3[:, :, None])))
+    byte = (w >> sh) & 0xFF
+    return tl.reshape(byte.to(tl.int32) >= thr, (BM, BK))
+
+
+@triton.jit
+def _keep_byte(r, t, B: tl.constexpr):
+    return (((r >> (B * 8)) & 255) >= t).to(tl.int8)
+
+
+@triton.jit
+def _keep_words(r0, r1, r2, r3, t, B: tl.constexpr):
+    """keep of byte B of the four Philox words, [.., 2, 2] indexed (q // 2, q % 2)."""
+    return tl.join(tl.join(_keep_byte(r0, t, B), _keep_byte(r2, t, B)),
+                   tl.join(_keep_byte(r1, t, B), _keep_byte(r3, t, B)))
+
+
+@triton.jit
+def _keep_mask_join(seed, rows, k0, K, thr, BM: tl.constexpr, BK: tl.constexpr, ROUNDS: tl.constexpr):
+    """The mask of _keep_mask, expanded by per-byte compares on the Philox words and tl.join interleaving
+    ([BM, BK/16, q//2, q%2, b//2, b%2] flattens to 4q + b) instead of a select over [BM, BK/16, 16]."""
+    C: tl.constexpr = BK // 16
+    chunk = (rows.to(tl.int64)[:, None] * K + k0) // 16 + tl.arange(0, C)[None, :]
+    r0, r1, r2, r3 = tl.randint4x(seed, chunk.to(tl.uint32), ROUNDS)
+    t = thr.to(tl.uint32)
+    k = tl.join(tl.join(_keep_words(r0, r1, r2, r3, t, 0), _keep_words(r0, r1, r2, r3, t, 2)),
+                tl.join(_keep_words(r0, r1, r2, r3, t, 1), _keep_words(r0, r1, r2, r3, t, 3)))
+    return tl.reshape(k, (BM, BK)) != 0
+
+
+@triton.jit
+def _chunk_base(grows, KG, KOFF):
+    """Philox counter of each row's first element in 16-element chunks, (row id * KG + KOFF) / 16, as uint32
+    (KG and KOFF are multiples of 16; lora_rng.positions bounds the value below 2**32)."""
+    return ((grows.to(tl.int64) * KG + KOFF) // 16).to(tl.uint32)
+
+
+@triton.jit
+def _keep_mask_cb(seed, cb, k0, thr, BM: tl.constexpr, BK: tl.constexpr, ROUNDS: tl.constexpr):
+    """_keep_mask with the per-row chunk base precomputed (cb from _chunk_base); same bits."""
+    C: tl.constexpr = BK // 16
+    chunk = cb[:, None] + (k0 // 16 + tl.arange(0, C)).to(tl.uint32)[None, :]
+    r0, r1, r2, r3 = tl.randint4x(seed, chunk, ROUNDS)
+    jj = tl.arange(0, 16)
+    q = (jj // 4)[None, None, :]
+    sh = ((jj % 4) * 8).to(tl.uint32)[None, None, :]
+    w = tl.where(q == 0, r0[:, :, None],
+                 tl.where(q == 1, r1[:, :, None], tl.where(q == 2, r2[:, :, None], r3[:, :, None])))
+    byte = (w >> sh) & 0xFF
+    return tl.reshape(byte.to(tl.int32) >= thr, (BM, BK))
+
+
+@triton.jit
+def _keep_mask_join_cb(seed, cb, k0, thr, BM: tl.constexpr, BK: tl.constexpr, ROUNDS: tl.constexpr):
+    """_keep_mask_join with the per-row chunk base precomputed (cb from _chunk_base); same bits."""
+    C: tl.constexpr = BK // 16
+    chunk = cb[:, None] + (k0 // 16 + tl.arange(0, C)).to(tl.uint32)[None, :]
+    r0, r1, r2, r3 = tl.randint4x(seed, chunk, ROUNDS)
+    t = thr.to(tl.uint32)
+    k = tl.join(tl.join(_keep_words(r0, r1, r2, r3, t, 0), _keep_words(r0, r1, r2, r3, t, 2)),
+                tl.join(_keep_words(r0, r1, r2, r3, t, 1), _keep_words(r0, r1, r2, r3, t, 3)))
+    return tl.reshape(k, (BM, BK)) != 0
+
+
+@triton.jit
+def _dropped(x_ptr, sinv, rows, cols, M, K, keep, scale, IS_FP8: tl.constexpr):
+    """bf16(keep * dequant(x) * scale) for one tile, in TE's operation order."""
+    m = rows[:, None] < M
+    x = tl.load(x_ptr + rows.to(tl.int64)[:, None] * K + cols[None, :], mask=m, other=0.0).to(tl.float32)
+    if IS_FP8:
+        x = x * sinv
+    return (tl.where(keep, x, 0.0) * scale).to(tl.bfloat16)
+
+
+@triton.jit
+def _fwd_kernel(x_ptr, sinv_ptr, a_ptr, ws_ptr, seed_ptr, grow_ptr, M, K, KG, KOFF, KLEN, thr, scale,
+                IS_FP8: tl.constexpr, HAS_POS: tl.constexpr, R: tl.constexpr, BM: tl.constexpr,
+                BK: tl.constexpr, ROUNDS: tl.constexpr):
+    pid_m = tl.program_id(0)
+    pid_s = tl.program_id(1)
+    seed = tl.load(seed_ptr)
+    sinv = 1.0
+    if IS_FP8:
+        sinv = tl.load(sinv_ptr)
+    rows = pid_m * BM + tl.arange(0, BM)
+    if HAS_POS:
+        cb = _chunk_base(tl.load(grow_ptr + rows, mask=rows < M, other=0), KG, KOFF)
+    rr = tl.arange(0, R)
+    acc = tl.zeros((BM, R), dtype=tl.float32)
+    kbeg = pid_s * KLEN
+    for kk in range(0, KLEN, BK):
+        k0 = kbeg + kk
+        cols = k0 + tl.arange(0, BK)
+        if HAS_POS:
+            keep = _keep_mask_cb(seed, cb, k0, thr, BM, BK, ROUNDS)
+        else:
+            keep = _keep_mask(seed, rows, k0, K, thr, BM, BK, ROUNDS)
+        xd = _dropped(x_ptr, sinv, rows, cols, M, K, keep, scale, IS_FP8)
+        a = tl.load(a_ptr + rr[:, None] * K + cols[None, :])
+        acc = tl.dot(xd, tl.trans(a), acc)
+    off = (pid_s * M + rows.to(tl.int64))[:, None] * R + rr[None, :]
+    tl.store(ws_ptr + off, acc, mask=rows[:, None] < M)
+
+
+@triton.jit
+def _bwd_kernel(x_ptr, sinv_ptr, a_ptr, dz_ptr, dx_ptr, ws_ptr, seed_ptr, grow_ptr, M, K, KG, KOFF, MLEN,
+                thr, scale, IS_FP8: tl.constexpr, HAS_POS: tl.constexpr, WGRAD: tl.constexpr,
+                R: tl.constexpr, BM: tl.constexpr, BK: tl.constexpr, ROUNDS: tl.constexpr,
+                KMAJOR: tl.constexpr):
+    if KMAJOR:
+        pid_k = tl.program_id(0)
+        pid_s = tl.program_id(1)
+    else:
+        pid_s = tl.program_id(0)
+        pid_k = tl.program_id(1)
+    seed = tl.load(seed_ptr)
+    sinv = 1.0
+    if IS_FP8:
+        sinv = tl.load(sinv_ptr)
+    k0 = pid_k * BK
+    cols = k0 + tl.arange(0, BK)
+    rr = tl.arange(0, R)
+    a = tl.load(a_ptr + rr[:, None] * K + cols[None, :])
+    accw = tl.zeros((R, BK), dtype=tl.float32)
+    mbeg = pid_s * MLEN
+    for mm in range(0, MLEN, BM):
+        rows = mbeg + mm + tl.arange(0, BM)
+        rmask = rows[:, None] < M
+        dz = tl.load(dz_ptr + rows.to(tl.int64)[:, None] * R + rr[None, :], mask=rmask, other=0.0)
+        if HAS_POS:
+            cb = _chunk_base(tl.load(grow_ptr + rows, mask=rows < M, other=0), KG, KOFF)
+            keep = _keep_mask_join_cb(seed, cb, k0, thr, BM, BK, ROUNDS)
+        else:
+            keep = _keep_mask_join(seed, rows, k0, K, thr, BM, BK, ROUNDS)
+        g = tl.dot(dz, a).to(tl.bfloat16).to(tl.float32)
+        dx = (tl.where(keep, g, 0.0) * scale).to(tl.bfloat16)
+        tl.store(dx_ptr + rows.to(tl.int64)[:, None] * K + cols[None, :], dx, mask=rmask)
+        if WGRAD:
+            xd = _dropped(x_ptr, sinv, rows, cols, M, K, keep, scale, IS_FP8)
+            accw = tl.dot(tl.trans(dz), xd, accw)
+    if WGRAD:
+        tl.store(ws_ptr + (pid_s * R + rr)[:, None].to(tl.int64) * K + cols[None, :], accw)
+
+
+@triton.jit
+def _sum_splits_kernel(ws_ptr, out_ptr, n, S: tl.constexpr, ACC: tl.constexpr, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    tot = tl.zeros((BLOCK,), dtype=tl.float32)
+    if ACC:
+        tot = tl.load(out_ptr + offs, mask=m, other=0.0).to(tl.float32)
+    for s in tl.static_range(S):
+        tot += tl.load(ws_ptr + s * n + offs, mask=m, other=0.0)
+    tl.store(out_ptr + offs, tot.to(out_ptr.dtype.element_ty), mask=m)
+
+
+def _sum_splits(ws, out, accumulate):
+    n = out.numel()
+    _sum_splits_kernel[(triton.cdiv(n, _SUM_BLOCK),)](ws, out, n, S=ws.shape[0], ACC=accumulate,
+                                                       BLOCK=_SUM_BLOCK, num_warps=4)
+
+
+def _drop_threshold(p):
+    """TE's 8-bit drop threshold and keep scale for probability p."""
+    return int(p * 256), 1.0 / (1.0 - p)
+
+
+def _pick_split(nblocks, want):
+    s = max(1, min(want, nblocks))
+    while nblocks % s:
+        s -= 1
+    return s
+
+
+def fold_forward(x2d, sinv, a, seed, p, cfg=None, pos=None):
+    """z[M, R] (bf16) = bf16(keep * dequant(x) / (1-p)) @ a^T. x2d: [M, K] bf16 or float8 (then sinv [1] fp32).
+    pos: None keys the mask on the local flat index; (row ids [M], H, hidden offset) from lora_rng.positions
+    keys it on the global flat index row_id * H + offset + k."""
+    BM, BK, split, warps = cfg or FWD_CFG
+    M, K = x2d.shape
+    R = a.shape[0]
+    split = _pick_split(K // BK, split)
+    thr, scale = _drop_threshold(p)
+    is_fp8 = x2d.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+    ws = torch.empty((split, M, R), dtype=torch.float32, device=x2d.device)
+    grow, KG, KOFF = pos if pos is not None else (seed, K, 0)
+    _fwd_kernel[(triton.cdiv(M, BM), split)](
+        x2d, sinv if is_fp8 else seed, a, ws, seed, grow, M, K, KG, KOFF, K // split, thr, scale,
+        IS_FP8=is_fp8, HAS_POS=pos is not None, R=R, BM=BM, BK=BK, ROUNDS=_ROUNDS, num_warps=warps)
+    z = torch.empty((M, R), dtype=torch.bfloat16, device=x2d.device)
+    _sum_splits(ws, z, False)
+    return z
+
+
+def fold_backward(x2d, sinv, a, dz, seed, p, wgrad_out=None, accumulate=False, cfg=None, pos=None):
+    """dx[M, K] = keep / (1-p) * bf16(dz @ a); if wgrad_out is given, wgrad_out (+)= dz^T @ bf16(keep * x / (1-p))."""
+    base = BWD_CFG_FP8 if x2d.dtype in (torch.float8_e4m3fn, torch.float8_e5m2) else BWD_CFG_BF16
+    BM, BK, split, warps, stages, kmajor = tuple(cfg) + base[len(cfg):] if cfg else base
+    M, K = x2d.shape
+    R = a.shape[0]
+    thr, scale = _drop_threshold(p)
+    is_fp8 = x2d.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+    mtiles = triton.cdiv(M, BM)
+    split = max(1, min(split, mtiles))
+    mlen = triton.cdiv(mtiles, split) * BM
+    split = triton.cdiv(M, mlen)
+    wgrad = wgrad_out is not None
+    dx = torch.empty((M, K), dtype=torch.bfloat16, device=x2d.device)
+    ws = torch.empty((split, R, K) if wgrad else (1,), dtype=torch.float32, device=x2d.device)
+    grid = (K // BK, split) if kmajor else (split, K // BK)
+    grow, KG, KOFF = pos if pos is not None else (seed, K, 0)
+    _bwd_kernel[grid](
+        x2d, sinv if is_fp8 else seed, a, dz, dx, ws, seed, grow, M, K, KG, KOFF, mlen, thr, scale,
+        IS_FP8=is_fp8, HAS_POS=pos is not None, WGRAD=wgrad, R=R, BM=BM, BK=BK, ROUNDS=_ROUNDS,
+        KMAJOR=bool(kmajor), num_warps=warps, num_stages=stages)
+    if wgrad:
+        _sum_splits(ws, wgrad_out, accumulate)
+    return dx
+
+
+def _kernel_input(input_):
+    """(2-D tensor the kernels read, scale_inv or None)."""
+    from transformer_engine.pytorch.ops._common import maybe_dequantize
+    from transformer_engine.pytorch.tensor.storage.float8_tensor_storage import Float8TensorStorage
+    from transformer_engine.pytorch.constants import TE_DType_To_Torch
+
+    K = input_.shape[-1]
+    if isinstance(input_, Float8TensorStorage) and input_._data is not None:
+        data = input_._data
+        if data.is_contiguous():
+            return data.view(TE_DType_To_Torch[input_._fp8_dtype]).view(-1, K), input_._scale_inv
+    x = maybe_dequantize(input_, dtype=torch.bfloat16)
+    if x.dtype != torch.bfloat16:
+        x = x.to(torch.bfloat16)
+    return x.contiguous().view(-1, K), None
+
+
+def _make_op_class():
+    from transformer_engine.pytorch.ops.op import BasicOperation
+    from transformer_engine.pytorch.ops._common import (get_accumulate_flag_in_param, get_dummy_wgrads_for_params,
+                                                        get_main_grad_from_param)
+
+    class DropoutLoRAIn(BasicOperation):
+        """te.ops.Dropout(p) followed by the bias-free LoRA-A te.ops.Linear, as one op."""
+
+        def __init__(self, p, weight, accumulate_into_main_grad, adapter=None):
+            super().__init__()
+            self.dropout_probability = float(p)
+            self.weight = weight
+            self._accumulate_into_main_grad = bool(accumulate_into_main_grad)
+            # weakref: a Module attribute would register the adapter as a child of this op
+            self._adapter = weakref.ref(adapter) if adapter is not None else None
+
+        def op_forward(self, ctx, input_, prev_op_grad_output_quantizer=None, next_op_input_quantizer=None,
+                       **kwargs):
+            R, K = self.weight.shape
+            x2d, sinv = _kernel_input(input_)
+            p = self.dropout_probability if self.training else 0.0
+            adapter = self._adapter() if self._adapter is not None else None
+            pos = None
+            if p > 0.0 and adapter is not None:
+                # layout-invariant mask: per-call key and global element positions (lora_rng)
+                seed = lora_rng.call_seed(adapter, x2d.device)
+                pos = lora_rng.positions(adapter, input_.shape, x2d.device)
+            else:
+                seed = torch.randint(0, 2**62, (1,), dtype=torch.int64, device=x2d.device)
+            w = self.weight.detach()
+            z = fold_forward(x2d, sinv, w, seed, p, pos=pos)
+            if ctx.requires_grad:
+                ctx.save_for_backward(x2d, sinv if sinv is not None else seed, seed)
+                ctx.is_fp8 = sinv is not None
+                ctx.p = p
+                ctx.pos = pos
+                ctx.in_shape = input_.shape
+                ctx.weight_requires_grad = self.weight.requires_grad
+            return z.view(*input_.shape[:-1], R)
+
+        def op_backward(self, ctx, grad_output):
+            x2d, sinv, seed = ctx.saved_tensors
+            R, K = self.weight.shape
+            dz = grad_output.reshape(-1, R)
+            if dz.dtype != torch.bfloat16:
+                dz = dz.to(torch.bfloat16)
+            dz = dz.contiguous()
+            w = self.weight.detach()
+            grad_weight = None
+            accumulate = False
+            wgrad_out = None
+            use_main_grad = False
+            if ctx.weight_requires_grad:
+                if self._accumulate_into_main_grad:
+                    wgrad_out = get_main_grad_from_param(self.weight, op_label="DropoutLoRAIn").detach()
+                    accumulate = get_accumulate_flag_in_param(self.weight)
+                    use_main_grad = True
+                else:
+                    wgrad_out = torch.empty((R, K), dtype=torch.float32, device=dz.device)
+            dx = fold_backward(x2d, sinv if ctx.is_fp8 else None, w, dz, seed, ctx.p,
+                               wgrad_out=wgrad_out, accumulate=accumulate, pos=ctx.pos)
+            if ctx.weight_requires_grad:
+                if use_main_grad:
+                    grad_weight = get_dummy_wgrads_for_params([self.weight])[0]
+                else:
+                    grad_weight = wgrad_out.to(self.weight.dtype)
+            return dx.view(ctx.in_shape), [grad_weight]
+
+    return DropoutLoRAIn
+
+
+_OP = None
+
+
+def op_class():
+    global _OP
+    if _OP is None:
+        _OP = _make_op_class()
+    return _OP
+
+
+def fold_branch(branch, weight, accumulate_into_main_grad, tensor_parallel_mode=None, adapter=None):
+    """Return a te.ops.Sequential with [Dropout, Linear A] replaced by DropoutLoRAIn, or `branch` if ineligible."""
+    import transformer_engine.pytorch as te
+
+    mods = list(branch)
+    if len(mods) < 2 or not isinstance(mods[0], te.ops.Dropout) or not isinstance(mods[1], te.ops.Linear):
+        return branch
+    R, K = weight.shape
+    if (tensor_parallel_mode is not None or weight.dtype != torch.bfloat16 or R not in (16, 32, 64)
+            or K % 128 != 0 or not 0.0 < mods[0].dropout_probability < 1.0):
+        return branch
+    op = op_class()(mods[0].dropout_probability, weight, accumulate_into_main_grad, adapter)
+    return te.ops.Sequential(op, *mods[2:])
+
+
+_installed = False
+
+
+def install():
+    """Patch TEFusedLoRALinear._make_lora_branch to fold eligible LoRA branches (idempotent)."""
+    global _installed
+    if _installed:
+        return
+    from megatron.bridge.peft.lora_layers import TEFusedLoRALinear
+
+    orig = TEFusedLoRALinear._make_lora_branch
+
+    def _make_lora_branch(self, **kwargs):
+        branch = orig(self, **kwargs)
+        if getattr(self.adapter, "dropout_position", "pre") != "pre":
+            return branch
+        return fold_branch(branch, self.adapter.linear_in.weight, kwargs["accumulate_into_main_grad"],
+                           kwargs.get("tensor_parallel_mode"), adapter=self.adapter)
+
+    _make_lora_branch.lora_dropout_fold = True
+    TEFusedLoRALinear._make_lora_branch = _make_lora_branch
+    _installed = True
