+"""TP-local LoRA path (LORA_LOCAL=1): adapter compute stays on-rank and
+the adapter partials ride the main path's collectives instead of owning dedicated ones.
+
+The stock adapter (ParallelLinearAdapter) follows the base linear's sharding and
+pays its own cross-rank exchanges per adapted linear per microbatch:
+  column-parallel base (linear_qkv, linear_fc1):
+    dropout(ln_local) -> all-gather(ln) over the sequence axis   [duplicates the base
+    linear's own (fused) gather] -> A GEMM -> all-gather(z) over the rank axis -> B GEMM
+  row-parallel base (linear_proj, linear_fc2):
+    dropout(x) -> A GEMM -> all-reduce(z) -> B GEMM -> all-to-all hidden->sequence
+
+This module keeps the adapter parameters, their sharding, the optimizer state and
+the checkpoints exactly as stock; only the forward implementation changes. Each
+rank holds a replicated view of the one factor it lacks and forms a PARTIAL
+adapter product whose TP sum is the full delta -- the same sum the main path's
+own partials undergo in its reduce-scatter:
+  column: A_full = all-gather(A shards) lets the A projection run on the
+    sequence-local layernorm rows; z [s_local*b, rank] is gathered along the
+    sequence axis and every rank applies its own B shard, producing the delta in
+    the base's [s, b, out/TP] layout (sequence-replicated, output-sharded). The
+    duplicate input gather and the rank-axis z gather disappear; the remaining
+    gather moves rank values per token instead of hidden. The gather must carry
+    z, not the delta: a rank's delta covers only its own output shard, so
+    gathering deltas would add other ranks' output features into this rank's
+    shard for every non-local token.
+  row: B_full = all-gather(B shards) lets the A projection keep its local input
+    shard; delta_partial = s * (dropout(x) @ A_local^T) @ B_full^T is a partial
+    over the full sequence. delta_partial is accumulated into the row-parallel
+    GEMM's userbuffer chunk by chunk, before each chunk's fused reduce-scatter
+    (transformer_engine/pytorch/module/linear.py + the C++
+    split_overlap_rs hook; see patches/03-transformer-engine/03-te-lora-prers-join.patch).
+    The adapter then rides the main reduce-scatter itself: no dedicated adapter
+    collective remains forward or backward.
+
+Numerics: exact in exact arithmetic. The TP reduction of z moves from
+all-reduce(z)-then-B-GEMM (stock) to B-GEMM-then-reduce-scatter(delta partials)
+-- the reassociation the main row-parallel path already performs on its own
+partials. Dropout is bitwise identical to the stock path: the same FusedDropout
+module is called on the same tensors in the same order, so the philox seeds
+drawn from the shared default generator and the counter streams match. Adapter
+weight gradients accumulate straight into main_grad (mcore's
+gradient_accumulation_fusion contract); the gradients of the replicated
+factors (A_full, B_full) reduce-scatter to their shards first, which is
+exactly the TP sum each shard's gradient needs.
+"""
+import os
+import weakref
+
+import torch
+import torch.nn as nn
+
+import symm_pool
+
+# Marker set by te-lora-prers-join.patch inside transformer_engine's linear module.
+_TE_JOIN_FLAG = "_LORA_PRE_RS_JOIN"
+# Attribute used to hand the pre-RS delta to the base linear's fused forward.
+_TE_DELTA_ATTR = "_lora_pre_rs_delta"
+
+_installed = False
+_logged = False
+_PLA = None            # megatron.bridge.peft.utils.ParallelLinearAdapter
+_FUSED_FORWARD = None  # LoRALinear.forward installed by lora_fused (the fallback leg)
+_ADAPTERS = []  # weakrefs to every constructed ParallelLinearAdapter
+
+
+def _tp_size(group):
+    return torch.distributed.get_world_size(group) if torch.distributed.is_initialized() else 1
+
+
+def _te_join_available():
+    import transformer_engine.pytorch.module.linear as te_linear
+
+    return getattr(te_linear, _TE_JOIN_FLAG, False) is True
+
+
+def _pre_forward(*modules):
+    """Run the forward pre-hooks of adapter linears whose weights are read directly.
+
+    The local path never calls linear_in / linear_out, but mcore DDP finishes
+    (and, for the first bucket, dispatches) the distributed optimizer's
+    post-step param all-gather in those modules' forward pre-hooks
+    (overlap_param_gather). Skipping them leaves each DP rank with only its
+    own shard of the adapter weights updated.
+    """
+    for m in modules:
+        for hook in tuple(m._forward_pre_hooks.values()):
+            hook(m, ())
+
+
+def _has_main_grad(w):
+    return hasattr(w, "main_grad") and hasattr(w, "grad_added_to_main_grad")
+
+
+def _wgrad_done(w, dtype):
+    """Mark w's gradient as already accumulated into main_grad (mcore's
+    gradient_accumulation_fusion contract) and return the dummy .grad that
+    keeps the DDP backward hook on the main thread without re-adding it."""
+    from transformer_engine.pytorch.module.base import get_dummy_wgrad
+
+    w.grad_added_to_main_grad = True
+    return get_dummy_wgrad(
+        list(w.main_grad.shape), dtype, zero=getattr(w, "zero_out_wgrad", False)
+    )
+
+
+def _accum_wgrad(w, grad_out, inp):
+    """main_grad(w) += grad_out^T @ inp (one GEMM, beta=1, fp32 accumulate).
+
+    Returns the .grad to hand back to autograd: a dummy when fused, the real
+    gradient when the weight has no main_grad.
+    """
+    if _has_main_grad(w):
+        w.main_grad.addmm_(grad_out.t(), inp)
+        return _wgrad_done(w, grad_out.dtype)
+    return grad_out.t() @ inp
+
+
+def _accum_shard(w, g):
+    if _has_main_grad(w):
+        w.main_grad.add_(g)
+        return _wgrad_done(w, g.dtype)
+    return g.clone()
+
+
+def _all_gather_dim0(x, group):
+    # UB_TRANSPORT=symk_nccl: allocate from the NCCL symmetric pool so NCCL can run its
+    # symmetric kernel instead of RING (work-nemo/symm_pool.py).
+    # NCCL needs BOTH buffers in the window: a plain send buffer falls back to RING, so the
+    # send side is copied into the pool too.
+    x2 = x.reshape(-1, x.shape[-1])
+    with symm_pool.pool_buffers() as in_pool:
+        out = torch.empty(x2.shape[0] * _tp_size(group), x2.shape[1], dtype=x2.dtype, device=x2.device)
+        x2 = torch.empty(x2.shape, dtype=x2.dtype, device=x2.device).copy_(x2) if in_pool else x2.contiguous()
+    torch.distributed.all_gather_into_tensor(out, x2, group=group)
+    symm_pool.note(in_pool)
+    return out
+
+
+def _reduce_scatter_dim0(x, group):
+    with symm_pool.pool_buffers() as in_pool:
+        x2 = torch.empty(x.shape, dtype=x.dtype, device=x.device).copy_(x) if in_pool else x.contiguous()
+        out = torch.empty(x2.shape[0] // _tp_size(group), x2.shape[1], dtype=x2.dtype, device=x2.device)
+    torch.distributed.reduce_scatter_tensor(out, x2, group=group)
+    symm_pool.note(in_pool)
+    return out
+
+
+class _Plan:
+    """The replicated adapter factors (A of column adapters, B of row adapters).
+
+    Their TP shards travel in one all-gather per microbatch (at the first
+    adapter call of the forward) and their gradients in one reduce-scatter (in that
+    all-gather's backward, after every layer wrote its slot), instead of one
+    collective per adapter per direction. Slot k occupies [off, off+n) of each
+    rank's block of the flat [TP * N] buffers; rank t's block holds shard t,
+    so block-row t of a factor's full [TP * rows, cols] view is shard t.
+    """
+
+    def __init__(self, adapters):
+        self.adapters = adapters
+        self.group = adapters[0].tp_group
+        self.tp = _tp_size(self.group)
+        self.slots = {}
+        self.weights = []
+        off = 0
+        for ad in adapters:
+            if ad.tp_group is not self.group:
+                raise RuntimeError("LORA_LOCAL: adapters span different TP groups")
+            w = ad.linear_out.weight if ad.input_is_parallel else ad.linear_in.weight
+            self.slots[ad] = (off, w.numel(), w.shape[0], w.shape[1])
+            self.weights.append(w)
+            off += w.numel()
+        self.numel = off
+        w0 = self.weights[0]
+        # Each slot of the weight-grad buffer is written exactly once per
+        # microbatch (copy_, not add_), so it needs no zeroing.
+        # In the symmetric pool: it is the send buffer of the factor-grad reduce-scatter.
+        with symm_pool.pool_buffers():
+            self.grad_buf = torch.empty(self.tp * off, dtype=w0.dtype, device=w0.device)
+        self.gathered = None
+        self.round = 0
+        self.first = None  # the first adapter called in a microbatch
+
+    def full(self, ad):
+        off, n, rows, cols = self.slots[ad]
+        return self.gathered.view(self.tp, -1)[:, off:off + n].reshape(self.tp * rows, cols)
+
+    def put_grad(self, ad, full_grad):
+        off, n, _, _ = self.slots[ad]
+        self.grad_buf.view(self.tp, -1)[:, off:off + n].copy_(full_grad.reshape(self.tp, n))
+
+
+_plan = None
+
+
+class _GatherFactors(torch.autograd.Function):
+    """One TP all-gather of every replicated factor shard; its backward is the
+    one reduce-scatter of their gradients. Autograd runs it after the last
+    consumer's backward, so the grad buffer is complete by then."""
+
+    @staticmethod
+    def forward(ctx, plan, *shards):
+        with symm_pool.pool_buffers() as in_pool:
+            pack = torch.cat([w.reshape(-1) for w in shards])  # the send buffer: in the pool too
+            out = torch.empty(plan.tp * plan.numel, dtype=pack.dtype, device=pack.device)
+        torch.distributed.all_gather_into_tensor(out, pack, group=plan.group)
+        symm_pool.note(in_pool)
+        ctx.plan = plan
+        return out
+
+    @staticmethod
+    def backward(ctx, _unused):
+        plan = ctx.plan
+        with symm_pool.pool_buffers() as in_pool:
+            shard = torch.empty(plan.numel, dtype=plan.grad_buf.dtype, device=plan.grad_buf.device)
+        torch.distributed.reduce_scatter_tensor(shard, plan.grad_buf, group=plan.group)
+        symm_pool.note(in_pool)
+        grads = []
+        for ad, w in zip(plan.adapters, plan.weights):
+            off, n, _, _ = plan.slots[ad]
+            grads.append(_accum_shard(w, shard[off:off + n].view_as(w)))
+        return (None, *grads)
+
+
+def _gather_factors(ad):
+    """The gathered factors for this microbatch; gathers on the first adapter
+    called (the first call ever fixes which one that is)."""
+    global _plan
+    if _plan is None:
+        live = [r() for r in _ADAPTERS]
+        _plan = _Plan([
+            a for a in live
+            if a is not None and _local_eligible(a)
+            and a.linear_in.weight.is_cuda and a.linear_in.weight.requires_grad
+        ])
+        _plan.first = ad
+    plan = _plan
+    if ad is plan.first:
+        _pre_forward(*[m for a in plan.adapters for m in (a.linear_in, a.linear_out)])
+        plan.gathered = _GatherFactors.apply(plan, *plan.weights)
+        plan.round += 1
+    if ad not in plan.slots or plan.gathered is None or (
+        getattr(ad, "_lora_local_round", None) == plan.round
+    ):
+        raise RuntimeError(
+            "LORA_LOCAL: adapter called outside its gather round (the forward "
+            f"call order changed): {ad.base_linear_name}, in plan "
+            f"{ad in plan.slots}, gathered {plan.gathered is not None}, round "
+            f"{plan.round}, first {plan.first.base_linear_name}"
+        )
+    ad._lora_local_round = plan.round
+    return plan
+
+
+class _ColumnLoRA(torch.autograd.Function):
+    """Column-parallel adapter delta [T_full, out/TP] from sequence-local rows.
+
+    Forward: A_full from the coalesced gather; z = s * h @ A_full^T on the
+    local rows; z_full = AG(z) over the sequence; delta = z_full @ B_local^T.
+    Backward: dB accumulates straight into main_grad; dz_full = g @ B_local is
+    reduce-scattered back to the local rows (each rank's g covers only its
+    output shard, so the TP sum completes dz); dA (a TP partial over the local
+    rows) goes to the coalesced reduce-scatter.
+    """
+
+    @staticmethod
+    def forward(ctx, h2, gathered, b_local, plan, ad):
+        a_full = plan.full(ad)
+        z = (h2 @ a_full.t()) * (ad.alpha / ad.dim)
+        z_full = _all_gather_dim0(z, plan.group)
+        ctx.save_for_backward(h2, a_full, z_full)
+        ctx.b_local, ctx.plan, ctx.ad = b_local, plan, ad
+        return z_full @ b_local.t()
+
+    @staticmethod
+    def backward(ctx, g):
+        h2, a_full, z_full = ctx.saved_tensors
+        plan, ad = ctx.plan, ctx.ad
+        g = g.reshape(-1, g.shape[-1])
+        grad_b = _accum_wgrad(ctx.b_local, g, z_full)
+        dz = _reduce_scatter_dim0(g @ ctx.b_local, plan.group) * (ad.alpha / ad.dim)
+        plan.put_grad(ad, dz.t() @ h2)
+        # The gather's backward reads plan.grad_buf, not this value; one
+        # defined gradient keeps that node live.
+        g_gathered = plan.grad_buf if ad is plan.first else None
+        return dz @ a_full, g_gathered, grad_b, None, None
+
+
+class _RowLoRA(torch.autograd.Function):
+    """Row-parallel adapter TP-partial delta, token-major: [T_full, out].
+
+    Forward: B_full from the coalesced gather; z = s * h @ A_local^T (a TP
+    partial); delta = z @ B_full^T, joined into the base GEMM+RS by the TE
+    seam. Backward: the incoming gradient is the gathered full dy (identical
+    on every rank). dA accumulates straight into main_grad; dB (a TP partial,
+    each rank's z is partial) goes to the coalesced reduce-scatter.
+    """
+
+    @staticmethod
+    def forward(ctx, h2, gathered, a_local, plan, ad):
+        b_full = plan.full(ad)
+        z = (h2 @ a_local.t()) * (ad.alpha / ad.dim)
+        ctx.save_for_backward(h2, z, b_full)
+        ctx.a_local, ctx.plan, ctx.ad = a_local, plan, ad
+        return torch.matmul(z, b_full.t())
+
+    @staticmethod
+    def backward(ctx, dy):
+        h2, z, b_full = ctx.saved_tensors
+        plan, ad = ctx.plan, ctx.ad
+        plan.put_grad(ad, dy.t() @ z)
+        dz = (dy @ b_full) * (ad.alpha / ad.dim)
+        grad_a = _accum_wgrad(ctx.a_local, dz, h2)
+        g_gathered = plan.grad_buf if ad is plan.first else None
+        return dz @ ctx.a_local, g_gathered, grad_a, None, None
+
+
+def _local_eligible(ad):
+    """Whether the adapter runs the TP-local path.
+
+    Mirrors lora_fused._a2a_eligible: the stock adapter must be the one that
+    gathers its own sequence-local input (disable_sequence_parallel_comm=False),
+    dropout sits before the adapter, and the activation is identity. The
+    sequence-parallel path is also what ties the layouts below to the base
+    linear's, so it is required, not just assumed.
+    """
+    return (
+        type(ad) is _PLA
+        and not ad.is_expert
+        and not ad.replicate_adapter
+        and not ad.config.cpu_offloading
+        and not ad.disable_sequence_parallel_comm
+        and getattr(ad, "dropout_position", "pre") == "pre"
+        and isinstance(ad.activation, nn.Identity)
+        and _tp_size(ad.tp_group) > 1
+    )
+
+
+def _column_forward(self, ad, x, *args, **kwargs):
+    linear_output, bias, ln = self.base_linear_forward(x, *args, **kwargs)
+    ln = ln.contiguous()
+    # The stock column adapter consumes the sequence-local layernorm output and
+    # gathers it itself; the base output is sequence-replicated. Anything else
+    # (e.g. a pre-gathered layernorm output) is a different stock path.
+    if linear_output.shape[0] != ln.shape[0] * _tp_size(ad.tp_group):
+        raise RuntimeError(
+            "LORA_LOCAL: column-parallel adapter input is not sequence-local "
+            f"(ln {tuple(ln.shape)} vs base output {tuple(linear_output.shape)})"
+        )
+    if ad.linear_in.weight.shape[0] * _tp_size(ad.tp_group) != ad.dim:
+        raise RuntimeError("LORA_LOCAL: column adapter A is not sharded along the rank dim")
+    plan = _gather_factors(ad)
+    h = ad.dropout(ln)
+    delta = _ColumnLoRA.apply(
+        h.reshape(-1, h.shape[-1]), plan.gathered, ad.linear_out.weight, plan, ad
+    )
+    out = linear_output + delta.view(linear_output.shape)
+    return out if not self._base_returns_tuple else (out, bias)
+
+
+def _row_forward_te(self, ad, x, *args, **kwargs):
+    # The partial must exist before the base forward: it joins the fused
+    # GEMM+reduce-scatter inside it. Token-major [tokens, out], the layout of
+    # the userbuffer chunks the C++ hook adds it into.
+    plan = _gather_factors(ad)
+    h = ad.dropout(x)
+    delta = _RowLoRA.apply(
+        h.reshape(-1, h.shape[-1]), plan.gathered, ad.linear_in.weight, plan, ad
+    )
+    base = self.to_wrap
+    setattr(base, _TE_DELTA_ATTR, delta)
+    try:
+        linear_output, bias, _ = self.base_linear_forward(x, *args, **kwargs)
+        consumed = getattr(base, _TE_DELTA_ATTR, None) is None
+    finally:
+        if getattr(base, _TE_DELTA_ATTR, None) is not None:
+            delattr(base, _TE_DELTA_ATTR)
+    if not consumed:
+        raise RuntimeError(
+            "LORA_LOCAL=1: the base linear did not consume the pre-RS "
+            "delta (layer not ub-overlapped or the TE hook is inactive)"
+        )
+    return linear_output if not self._base_returns_tuple else (linear_output, bias)
+
+
+def _row_join_active(base):
+    """Whether the base linear's fused GEMM+RS join can consume the delta.
+
+    The row-parallel local path hands its delta to the base linear's fused
+    GEMM+reduce-scatter through _lora_pre_rs_delta. That join exists only
+    under the userbuffers RS overlap (ub_overlap_rs_fprop); without it the
+    GEMM runs plain and the delta is silently dropped while the backward
+    still routes gradients through it. The column-parallel path needs no
+    join and stays local in either case.
+    """
+    return bool(getattr(base, "ub_overlap_rs_fprop", False))
+
+
+def _local_forward(self, x, *args, **kwargs):
+    global _logged
+    ad = getattr(self, "adapter", None)
+    if (
+        self._adapter_enabled
+        and _local_eligible(ad)
+        and (not ad.input_is_parallel or _row_join_active(self.to_wrap))
+    ):
+        if not _logged and int(os.environ.get("RANK", "0")) == 0:
+            _logged = True
+            print(
+                f"[lora_local] local adapter path active; "
+                f"first module {type(self.to_wrap).__name__}",
+                flush=True,
+            )
+        if ad.input_is_parallel:
+            return _row_forward_te(self, ad, x, *args, **kwargs)
+        return _column_forward(self, ad, x, *args, **kwargs)
+    return _FUSED_FORWARD(self, x, *args, **kwargs)
+
+
+def install():
+    """Patch LoRALinear.forward with the TP-local side path (idempotent, env-gated)."""
+    global _installed, _PLA, _FUSED_FORWARD
+    if _installed or os.getenv("LORA_LOCAL", "0") != "1":
+        return
+    from megatron.bridge.peft.lora_layers import LoRALinear
+    from megatron.bridge.peft.utils import ParallelLinearAdapter
+
+    _PLA = ParallelLinearAdapter
+    orig_init = ParallelLinearAdapter.__init__
+
+    def init(self, *a, **kw):
+        orig_init(self, *a, **kw)
+        _ADAPTERS.append(weakref.ref(self))
+
+    ParallelLinearAdapter.__init__ = init
+    # lora_fused installs first; keep its forward as the fallback leg (stock
+    # and adapter-disabled cases).
+    _FUSED_FORWARD = LoRALinear.forward
+    if not _te_join_available():
+        raise RuntimeError(
+            "LORA_LOCAL=1 requires the TE pre-RS join "
+            "(patches/03-transformer-engine/03-te-lora-prers-join.patch)"
+        )
+    LoRALinear.forward = _local_forward
+    _installed = True
