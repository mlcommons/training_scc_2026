# pipeline.env: single source of truth for paths, pinned sources and software profiles.
# Sourced by setup.sh, run.sbatch and submit.sh. Any variable can be overridden from the environment.

# ---- where things live on the cluster
: "${ROOT:=/home/ssambhus/sc26/mlperf/v5-pipeline}"
: "${DATA_DIR:=/home/ssambhus/sc26/mlperf/data}"   # holds model/ and gov_report/, shared by all profiles
: "${ENV_NAME:=ngc}"                                  # software profile, see the case block below
PIPE_DIR=${PIPE_DIR:-$ROOT/pipeline}

# ---- system software (Bright modules; same paths on every node)
CUDA_HOME=/cm/shared/apps/cuda/13.2
MPI_HOME=/cm/shared/apps/openmpi5/gcc/5.0.6-cuda13
KEZ_BIN=${KEZ_BIN:-/scratch/ssambhus/.kez/env/system/bin}   # Kez provides cmake/ninja/gcc for the TE build
PY_VERSION=3.12.15

# ---- pinned sources
VENDOR_REPO=https://github.com/mlcommons/training_results_v6.0.git
VENDOR_COMMIT=eabf23a07b2a0c60a289ff871dc3a46fff0d0421
VENDOR_PATH=Dell/benchmarks/llama2_70b_lora/implementations/nemo
MBRIDGE_REPO=https://github.com/NVIDIA-NeMo/Megatron-Bridge.git
MBRIDGE_COMMIT=68d8bcc94cb5a25a36cf91413cb376103b2fa9dc   # tag 26.04-alpha.rc1, as in the vendor Dockerfile
MCORE_COMMIT=997896883b04dee1259d92889e7344be528eefa8     # Megatron-LM submodule pinned by that tag
TE_REPO=https://github.com/NVIDIA/TransformerEngine.git
MLPERF_LOGGING=git+https://github.com/mlcommons/logging.git@c28b863cc73d405e584b158238f58d6ad92bd257
MLPERF_COMMON=git+https://github.com/NVIDIA/mlperf-common.git@c02c93c0414071400a10716d9cd5cb8f668b78d4
MODEL_REPO=michal1270/llama2_70b_megatron_bridge
MODEL_REV=2ae1be85716a1f2c97d512e4d763010757f65f70
TORCH_INDEX=https://download.pytorch.org/whl/cu130

# ---- software profiles
case "$ENV_NAME" in
  # OVERRIDES replace torch's own pins for the CUDA libraries (uv --override). The pip torch 2.12.1 wheel
  # pins cuBLAS<=13.1/cuDNN 9.20/NCCL 2.29.7; the vendor container runs torch 2.12 on CUDA 13.2.1 libs instead,
  # and TE built against CUDA 13.2 headers needs cuBLAS 13.4 (cublasLtGroupedMatrixLayoutInit_internal).
  ngc) # mirrors the vendor's container nvcr.io/nvidia/pytorch:26.04 + vendor Dockerfile (TE v2.14, cuDNN 9.21.1.3)
       TORCH_VERSION=2.12.1; TE_COMMIT=f031cf87bd054c7558b887df7bed93975456667f
       OVERRIDES="nvidia-nccl-cu13==2.30.4 nvidia-cublas==13.4.1.3 nvidia-cudnn-cu13==9.21.1.3"
       # TE 2.14 bundles cudnn-frontend v1.21.0, which throws if both libcudart.so.12 and .so.13 dlopen
       # (sbrinz's ldconfig lists /usr/local/cuda-12). v1.25.0 is the first that honours
       # CUDNN_FRONTEND_CUDART_LIB_NAME (set in run.sbatch). Header-only build dep, no benchmark code change.
       TE_FE_REF=v1.25.0 ;;
  ref) # the env behind the 29.16 min single-node submission (v2-nemo-baremetal); graphs work on sbrinz only
       TORCH_VERSION=2.14.1; TE_COMMIT=27486e03cfc1fa41f6932dcecdc47c71c47eac3e
       OVERRIDES="nvidia-nccl-cu13==2.30.7 nvidia-cublas==13.1.1.3 nvidia-cudnn-cu13==9.24.0.43"
       TE_FE_REF="" ;;
  *)   echo "pipeline.env: unknown ENV_NAME=$ENV_NAME (use ngc or ref)" >&2; return 1 2>/dev/null || exit 1 ;;
esac

SRC=$ROOT/src
VENV=$ROOT/envs/$ENV_NAME
FTLLM=$SRC/training_results_v6.0/$VENDOR_PATH
export ROOT DATA_DIR ENV_NAME PIPE_DIR SRC VENV FTLLM CUDA_HOME MPI_HOME
